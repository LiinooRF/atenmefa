# Copiar a .env y completar. El .env real nunca va al repo.

# Postgres del sistema interno
BASE_DATOS=postgres://usuario:clave@localhost:5432/atenmefa

# Cadena larga y aleatoria. Generar con:
#   head -c 32 /dev/urandom | base64
AUTH_SECRETO=cambiar-esto

# URL desde la que se sirve el sistema
URL_BASE=http://localhost:4321

# ---- Correo (Mailgun) ----
# Mandarle el informe al paciente. El botón es manual: nada sale solo.
MAILGUN_CLAVE=
MAILGUN_DOMINIO=
MAILGUN_BASE=https://api.mailgun.net
MAILGUN_DE="Atenmefa <atenmefa@ejemplo.mailgun.org>"

# Interruptor. Sin esto en 1 el envío se SIMULA: la pantalla arma el
# mensaje y dice qué habría mandado, pero no manda nada. Tener la clave
# cargada no alcanza a propósito; le escribe a pacientes de un centro de
# salud y la primera vez tiene que ser una decisión de alguien.
CORREO_ACTIVO=0
