---
/**
 * Capa del sistema interno. Nada de esto se indexa ni comparte estilos de
 * marketing con el sitio público: es una herramienta de trabajo, se usa de
 * pie y con una tablet en la mano.
 */
import '../styles/fuentes.css';
import '@fontsource/noto-sans/latin-400.css';
import '@fontsource/noto-sans/latin-600.css';
import '../styles/global.css';
import '../styles/sistema.css';
import Icono from '../components/Icono.astro';
import { puede, nombreDelRol, type Permiso } from '../sistema/lib/permisos';

interface Props {
  titulo: string;
  /** La pantalla de entrada no lleva barra ni menú. */
  desnuda?: boolean;
}
const { titulo, desnuda = false } = Astro.props;
const usuario = Astro.locals.usuario;

/* El menú solo muestra lo que el rol puede abrir: una puerta visible que
   lleva a "no tiene permiso" es peor que no mostrarla. */
const todos: { href: string; texto: string; icono: 'latido' | 'mas' | 'reloj' | 'laboratorio' | 'escudo'; permiso: Permiso }[] = [
  { href: '/sistema/tablero', texto: 'Tablero', icono: 'latido', permiso: 'ver_cierre' },
  { href: '/sistema', texto: 'Casos', icono: 'estetoscopio', permiso: 'ver_casos' },
  { href: '/sistema/atencion/nueva', texto: 'Nueva atención', icono: 'mas', permiso: 'escribir_historia' },
  { href: '/sistema/borradores', texto: 'Borradores', icono: 'reloj', permiso: 'escribir_historia' },
  { href: '/sistema/pacientes', texto: 'Pacientes', icono: 'latido', permiso: 'ver_pacientes' },
  { href: '/sistema/marketing', texto: 'Marketing', icono: 'laboratorio', permiso: 'ver_marketing' },
  { href: '/sistema/cierre', texto: 'Cierre del mes', icono: 'laboratorio', permiso: 'ver_cierre' },
  { href: '/sistema/servicios', texto: 'Servicios', icono: 'escudo', permiso: 'editar_catalogo' },
  { href: '/sistema/usuarios', texto: 'Cuentas', icono: 'estetoscopio', permiso: 'administrar_usuarios' },
  { href: '/sistema/bitacora', texto: 'Bitácora', icono: 'escudo', permiso: 'ver_bitacora' },
];
const enlaces = todos.filter((e) => puede(usuario?.rol as string, e.permiso));
---

<!doctype html>
<html lang="es-VE">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titulo} · Atenmefa</title>
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#0b0f45" />
    <link rel="icon" href="/favicon.png" type="image/png" sizes="64x64" />
  </head>

  <body class:list={['sis', desnuda && 'sis--desnuda']}>
    {!desnuda && usuario && (
      <header class="sis__barra">
        <div class="sis__barra-int">
          <a class="sis__marca" href="/sistema">
            <img src="/logo.png" width="34" height="34" alt="" />
            <span>Atenmefa<small>Sistema interno</small></span>
          </a>

          <nav class="sis__nav" aria-label="Sistema">
            {enlaces.map((e) => (
              <a href={e.href} aria-current={Astro.url.pathname === e.href ? 'page' : undefined}>
                <Icono nombre={e.icono} tam={17} />
                {e.texto}
              </a>
            ))}
          </nav>

          <div class="sis__quien">
            <a class="sis__yo" href="/sistema/mi-clave" title="Cambiar mi clave">
              <strong>{usuario.name}</strong>
              <small>{nombreDelRol(usuario.rol as string)}</small>
            </a>
            <form method="post" action="/sistema/salir">
              <button type="submit" class="sis__salir">Salir</button>
            </form>
          </div>
        </div>
      </header>
    )}

    <main class:list={[!desnuda && 'sis__cuerpo']}><slot /></main>
  </body>
</html>
