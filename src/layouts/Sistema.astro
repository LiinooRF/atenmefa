---
/**
 * Capa del sistema interno. Nada de esto se indexa ni comparte estilos de
 * marketing con el sitio público: es una herramienta de trabajo, se usa de
 * pie y con una tablet en la mano.
 */
import '../styles/fuentes.css';
import { marca, variablesDeLaMarca } from '../data/marca';
import '@fontsource/noto-sans/latin-400.css';
import '@fontsource/noto-sans/latin-600.css';
import '../styles/global.css';
import '../styles/sistema.css';
import Icono from '../components/Icono.astro';
import { puede, nombreDelRol, type Permiso } from '../sistema/lib/permisos';

interface Props {
  titulo: string;
  /** La pantalla de entrada no lleva barra ni menú. */
  desnuda?: boolean;
}
const { titulo, desnuda = false } = Astro.props;
const usuario = Astro.locals.usuario;

/* El menú solo muestra lo que el rol puede abrir: una puerta visible que
   lleva a "no tiene permiso" es peor que no mostrarla.

   Va en grupos porque administración llegó a ver diez entradas sueltas y la
   barra se cortaba sola en la tablet: "Cierre de…" y lo de más a la derecha
   quedaba fuera de la pantalla. Lo del día a día —los casos, la gente— se
   queda arriba de un toque; lo que se abre una vez al mes se agrupa.

   Un grupo al que le queda UNA sola entrada visible se dibuja como enlace
   suelto, no como desplegable: así el médico, que no ve ninguno de los
   grupos completos, sigue teniendo su menú plano de siempre sin que haya que
   escribir un menú distinto por rol. */
type Icono = 'latido' | 'mas' | 'reloj' | 'laboratorio' | 'escudo' | 'estetoscopio' | 'recibo';

/* Una entrada puede abrirse con cualquiera de varios permisos: los
   borradores los ve el médico porque los escribe y administración porque
   los borra, y es la misma pantalla. */
interface Entrada { href: string; texto: string; permiso: Permiso | Permiso[] }
interface Bloque { texto: string; icono: Icono; entradas: Entrada[] }

const MENU: Bloque[] = [
  { texto: 'Casos', icono: 'estetoscopio', entradas: [
    { href: '/sistema', texto: 'Casos', permiso: 'ver_casos' },
  ] },
  { texto: 'Nueva atención', icono: 'mas', entradas: [
    { href: '/sistema/atencion/nueva', texto: 'Nueva atención', permiso: 'escribir_historia' },
  ] },
  { texto: 'Borradores', icono: 'reloj', entradas: [
    /* El médico porque los escribe; administración porque los borra. */
    { href: '/sistema/borradores', texto: 'Borradores', permiso: ['escribir_historia', 'anular_atencion'] },
  ] },
  { texto: 'Laboratorio', icono: 'laboratorio', entradas: [
    { href: '/sistema/laboratorio', texto: 'Laboratorio', permiso: 'cola_laboratorio' },
    /* Acá y no en Cobros: un rango de referencia depende del método y del
       equipo con el que se corre la prueba, no del precio. Lo escribe
       quien mide. */
    { href: '/sistema/plantillas', texto: 'Valores de referencia', permiso: 'editar_plantillas' },
  ] },
  { texto: 'Pacientes', icono: 'latido', entradas: [
    { href: '/sistema/pacientes', texto: 'Pacientes', permiso: 'ver_pacientes' },
  ] },
  { texto: 'Cobros', icono: 'recibo', entradas: [
    { href: '/sistema/cierre', texto: 'Cierre del mes', permiso: 'ver_cierre' },
    { href: '/sistema/servicios', texto: 'Servicios y precios', permiso: 'editar_catalogo' },
    { href: '/sistema/perfiles', texto: 'Perfiles del laboratorio', permiso: 'editar_catalogo' },
  ] },
  { texto: 'Reportes', icono: 'latido', entradas: [
    { href: '/sistema/tablero', texto: 'Tablero', permiso: 'ver_cierre' },
    { href: '/sistema/marketing', texto: 'Marketing del sitio', permiso: 'ver_marketing' },
  ] },
  { texto: 'Administración', icono: 'escudo', entradas: [
    { href: '/sistema/usuarios', texto: 'Cuentas', permiso: 'administrar_usuarios' },
    /* Acá y no en Cobros: es mantenimiento de un catálogo clínico, no
       tiene nada que ver con la plata. */
    { href: '/sistema/diagnosticos', texto: 'Diagnósticos frecuentes', permiso: 'editar_catalogo' },
    { href: '/sistema/bitacora', texto: 'Bitácora de accesos', permiso: 'ver_bitacora' },
  ] },
];

/* En qué pantalla estamos. /sistema es la lista de casos y calza exacta: con
   el prefijo se marcaría como actual en todas las demás, porque todas
   cuelgan de ahí. El resto sí marca sus pantallas hijas, para que la ficha
   de un paciente siga iluminando "Pacientes". */
const aqui = Astro.url.pathname;
const esLaDeAhora = (href: string) =>
  href === '/sistema' ? aqui === href : aqui === href || aqui.startsWith(`${href}/`);

const menu = MENU
  .map((b) => ({
    ...b,
    entradas: b.entradas.filter((e) =>
      (Array.isArray(e.permiso) ? e.permiso : [e.permiso])
        .some((p) => puede(usuario?.rol as string, p)),
    ),
  }))
  .filter((b) => b.entradas.length > 0)
  .map((b) => ({
    ...b,
    // Con una sola entrada el desplegable sobra: es un enlace y ya.
    sola: b.entradas.length === 1 ? b.entradas[0] : null,
    actual: b.entradas.some((e) => esLaDeAhora(e.href)),
  }));
---

<!doctype html>
<html lang="es-VE">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titulo} · {marca.nombre}</title>
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#0b0f45" />
    <link rel="icon" href="/favicon.png" type="image/png" sizes="64x64" />
    {marca.id !== 'atenmefa' && <style set:html={variablesDeLaMarca()} />}
  </head>

  <body class:list={['sis', desnuda && 'sis--desnuda']}>
    {!desnuda && usuario && (
      <header class="sis__barra">
        <div class="sis__barra-int">
          <a class="sis__marca" href="/sistema">
            <img src={marca.logo} width="34" height="34" alt="" />
            <span>{marca.nombre}<small>Sistema interno</small></span>
          </a>

          {/* Una sola caja para todo: cédula, nombre o número de atención.
              Antes había que saber en qué pantalla estaba lo que uno
              buscaba, y quien atiende en el mesón no piensa en pantallas:
              tiene una cédula escrita en un papel. */}
          <form class="sis__buscar" method="get" action="/sistema/buscar" role="search">
            <Icono nombre="latido" tam={16} />
            <input type="search" name="q" placeholder="Cédula, nombre o N°"
                   aria-label="Buscar en el sistema" autocomplete="off" />
          </form>

          <nav class="sis__nav" aria-label="Sistema">
            {menu.map((b) => b.sola ? (
              <a
                class="sis__nav-uno"
                href={b.sola.href}
                aria-current={esLaDeAhora(b.sola.href) ? 'page' : undefined}
              >
                <Icono nombre={b.icono} tam={17} />
                {b.sola.texto}
              </a>
            ) : (
              /* <details> y no un menú de JavaScript: se abre con el dedo,
                 funciona sin scripts y el navegador ya sabe cerrarlo. Lo
                 único que agrega el script de abajo es cerrarlo al tocar
                 afuera, que es lo que la gente espera. */
              <details class="sis__grupo" data-grupo>
                <summary aria-current={b.actual ? 'true' : undefined}>
                  <Icono nombre={b.icono} tam={17} />
                  {b.texto}
                  <svg class="sis__flecha" width="10" height="10" viewBox="0 0 10 10" aria-hidden="true">
                    <path d="M1 3.5 5 7.5 9 3.5" fill="none" stroke="currentColor" stroke-width="1.6"
                          stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                </summary>
                <div class="sis__menu">
                  {b.entradas.map((e) => (
                    <a href={e.href} aria-current={esLaDeAhora(e.href) ? 'page' : undefined}>
                      {e.texto}
                    </a>
                  ))}
                </div>
              </details>
            ))}
          </nav>

          <script>
            /* Lo único que le falta a <details> para sentirse un menú: que se
               cierre al tocar afuera, con Escape, y que abrir uno cierre el
               otro. Sin esto quedan dos desplegables abiertos a la vez y hay
               que volver a tocar el mismo para cerrarlo.

               Si no corre, el menú sigue funcionando: se abre, se navega y
               se cierra al cambiar de pantalla. */
            const grupos = Array.from(document.querySelectorAll('[data-grupo]'));

            /* En el teléfono el desplegable se cuelga de la ventana y necesita
               saber dónde termina la barra. Se mide en vez de escribirlo a
               mano porque la barra cambia de alto con el ancho. */
            const barra = document.querySelector('.sis__barra');
            const medirBarra = () => {
              document.documentElement.style.setProperty(
                '--alto-barra', `${Math.round(barra.getBoundingClientRect().height)}px`,
              );
            };
            if (barra) {
              medirBarra();
              addEventListener('resize', medirBarra, { passive: true });
            }

            const cerrarMenos = (dejar) => {
              for (const g of grupos) if (g !== dejar) g.open = false;
            };

            /* Dónde cae el desplegable. Se calcula al abrir y no antes: el
               menú se desplaza de lado, así que la posición del grupo
               cambia. Si no corre, el CSS lo deja a lo ancho. */
            const ubicar = (grupo) => {
              /* La marca va PRIMERO. Sin ella el desplegable todavía está a
                 lo ancho de la pantalla, y medirlo así daba 1260 px: la
                 cuenta lo empujaba al borde izquierdo y todos los grupos
                 abrían en el mismo sitio. */
              grupo.dataset.x = '';
              const menu = grupo.querySelector('.sis__menu');
              const caja = grupo.getBoundingClientRect();
              const tope = document.documentElement.clientWidth - 10;
              const ancho = menu.offsetWidth || 196;
              const x = Math.max(10, Math.min(caja.left, tope - ancho));
              grupo.style.setProperty('--x', `${Math.round(x)}px`);
            };

            for (const grupo of grupos) {
              grupo.addEventListener('toggle', () => {
                if (!grupo.open) return;
                cerrarMenos(grupo);
                ubicar(grupo);
              });
            }

            document.addEventListener('pointerdown', (ev) => {
              /* closest() sobre el objetivo: tocar DENTRO de un desplegable
                 no lo cierra, que si no el enlace no alcanza a navegar. */
              const dentro = ev.target instanceof Element && ev.target.closest('[data-grupo]');
              if (!dentro) cerrarMenos(null);
            });

            document.addEventListener('keydown', (ev) => {
              if (ev.key !== 'Escape') return;
              const abierto = grupos.find((g) => g.open);
              if (!abierto) return;
              abierto.open = false;
              abierto.querySelector('summary')?.focus();
            });
          </script>

          <div class="sis__quien">
            {/* El título lleva el nombre completo: en la barra se recorta
                para no empujar el menú. */}
            <a class="sis__yo" href="/sistema/mi-clave"
               title={`${usuario.name} · ${nombreDelRol(usuario.rol as string)} · Mi cuenta`}>
              <strong>{usuario.name}</strong>
              <small>{nombreDelRol(usuario.rol as string)}</small>
            </a>
            <form method="post" action="/sistema/salir">
              <button type="submit" class="sis__salir">Salir</button>
            </form>
          </div>
        </div>
      </header>
    )}

    <main class:list={[!desnuda && 'sis__cuerpo']}><slot /></main>
  </body>
</html>
