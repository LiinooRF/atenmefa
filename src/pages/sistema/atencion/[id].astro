<script>
  /* Se ve solo el campo del tipo elegido. Sin JS se ven los tres y el
     servidor toma el que corresponde al tipo marcado. */
  const form = document.querySelector<HTMLFormElement>('[data-agregar]');
  if (form) {
    const mostrar = () => {
      const tipo = form.querySelector<HTMLInputElement>('input[name="tipo"]:checked')?.value ?? 'nota';
      form.querySelectorAll<HTMLElement>('[data-para]').forEach((b) => {
        b.hidden = b.dataset.para !== tipo;
      });
    };
    form.addEventListener('change', (e) => {
      if ((e.target as HTMLInputElement).name === 'tipo') mostrar();
    });
    mostrar();
  }

  /* Se ven solo los campos del tipo de derivación elegido, y «¿Cuál?» solo
     con «Otra». La casilla de recepción toma lo que el centro dejó marcado
     para ese tipo, mientras el médico no la haya tocado. Sin JS se ve todo. */
  const ic = document.querySelector<HTMLFormElement>('[data-interconsulta]');
  if (ic) {
    const lista = ic.querySelector<HTMLSelectElement>('select[name="especialidad"]')!;
    const recepcion = ic.querySelector<HTMLInputElement>('input[name="por_recepcion"]');
    let porDefecto: Record<string, boolean> = {};
    try { porDefecto = JSON.parse(ic.dataset.recepcion ?? '{}'); } catch { porDefecto = {}; }
    // Si volvió con un error, la casilla dice lo que el médico había elegido.
    let tocada = ic.hasAttribute('data-tocada');
    recepcion?.addEventListener('change', () => { tocada = true; });
    const ver = () => {
      const tipo = ic.querySelector<HTMLInputElement>('input[name="tipo_derivacion"]:checked')?.value ?? 'externa';
      ic.querySelectorAll<HTMLElement>('[data-para-d]').forEach((b) => {
        b.hidden = b.dataset.paraD !== tipo || (b.hasAttribute('data-otra') && lista.value !== '__otra');
      });
      if (recepcion && !tocada) recepcion.checked = Boolean(porDefecto[tipo]);
    };
    ic.addEventListener('change', (e) => {
      const nombre = (e.target as HTMLInputElement).name;
      if (nombre === 'tipo_derivacion' || nombre === 'especialidad') ver();
    });
    ver();
  }
</script>
