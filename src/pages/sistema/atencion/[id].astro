---
import Sistema from '../../../layouts/Sistema.astro';
import Icono from '../../../components/Icono.astro';
import { historia } from '../../../sistema/historia';
import { bd, esquema } from '../../../sistema/lib/base';
import { anotar } from '../../../sistema/lib/atenciones';
import { eq, desc, and, ne } from 'drizzle-orm';

export const prerender = false;

const { id } = Astro.params;
const usuario = Astro.locals.usuario!;

const [caso] = await bd
  .select({
    id: esquema.atencion.id,
    numero: esquema.atencion.numero,
    estado: esquema.atencion.estado,
    fecha: esquema.atencion.fecha,
    aseguradora: esquema.atencion.aseguradora,
    poliza: esquema.atencion.poliza,
    casoNumero: esquema.atencion.casoNumero,
    datos: esquema.atencion.datos,
    creada: esquema.atencion.creada,
    anuladaMotivo: esquema.atencion.anuladaMotivo,
    pacienteId: esquema.paciente.id,
    paciente: esquema.paciente.nombre,
    cedula: esquema.paciente.cedula,
    telefono: esquema.paciente.telefono,
    medico: esquema.user.name,
    colegiatura: esquema.user.colegiatura,
  })
  .from(esquema.atencion)
  .innerJoin(esquema.paciente, eq(esquema.paciente.id, esquema.atencion.pacienteId))
  .innerJoin(esquema.user, eq(esquema.user.id, esquema.atencion.medicoId))
  .where(eq(esquema.atencion.id, id!))
  .limit(1);

if (!caso) return Astro.redirect('/sistema');

await anotar(usuario.id, 'vio', caso.id);

const renglones = await bd
  .select()
  .from(esquema.renglon)
  .where(eq(esquema.renglon.atencionId, caso.id))
  .orderBy(esquema.renglon.creado);

const previasCrudas = await bd
  .select({
    id: esquema.atencion.id,
    numero: esquema.atencion.numero,
    fecha: esquema.atencion.fecha,
    datos: esquema.atencion.datos,
  })
  .from(esquema.atencion)
  .where(and(eq(esquema.atencion.pacienteId, caso.pacienteId), ne(esquema.atencion.id, caso.id)))
  .orderBy(desc(esquema.atencion.fecha))
  .limit(6);

/* El cast va acá y no en el template: un genérico dentro del JSX se parsea
   como etiqueta y rompe la compilación. */
const anteriores = previasCrudas.map((a) => ({
  id: a.id,
  numero: a.numero,
  fecha: a.fecha,
  idx: (a.datos as Record<string, string> | null)?.idx ?? 'Sin diagnóstico',
}));

const datos = (caso.datos ?? {}) as Record<string, string>;
const total = renglones.reduce((s, r) => s + Number(r.precio) * Number(r.cantidad), 0);

const dinero = (v: number) => new Intl.NumberFormat('es-VE', { minimumFractionDigits: 2 }).format(v);
const fechaLarga = (f: string) =>
  new Date(`${f}T12:00:00`).toLocaleDateString('es-VE', { day: 'numeric', month: 'long', year: 'numeric' });

/* Solo se muestran las secciones que tienen algo escrito: una historia de
   consulta simple no debe verse como un formulario medio vacío. */
const conContenido = historia
  .map((s) => ({ ...s, campos: s.campos.filter((c) => datos[c.clave]) }))
  .filter((s) => s.campos.length > 0);

const etiqueta = {
  borrador: { texto: 'Borrador', clase: 'borrador' },
  cerrada: { texto: 'Cerrada', clase: 'cerrada' },
  anulada: { texto: 'Anulada', clase: 'anulada' },
}[caso.estado];
---

<Sistema titulo={`Atención ${caso.numero}`}>
  <nav class="miga"><a href="/sistema">Casos</a> <span>/</span> Atención {caso.numero}</nav>

  <header class="cab">
    <div>
      <div class="cab__linea">
        <h1>{caso.paciente}</h1>
        <span class:list={['chapa', `chapa--${etiqueta.clase}`]}>{etiqueta.texto}</span>
      </div>
      <p class="cab__meta">
        Atención <strong class="cifra">N° {caso.numero}</strong> ·
        {fechaLarga(caso.fecha)} ·
        {caso.cedula} ·
        atendió {caso.medico}{caso.colegiatura && ` (C.M. ${caso.colegiatura})`}
      </p>
    </div>
    <div class="cab__acciones">
      <a class="sis-boton sis-boton--azul" href={`/sistema/atencion/${caso.id}/documento`} target="_blank">
        <Icono nombre="laboratorio" tam={18} />
        Documento
      </a>
    </div>
  </header>

  {caso.estado === 'anulada' && caso.anuladaMotivo && (
    <p class="sis-error anulada"><Icono nombre="escudo" tam={18} />Anulada: {caso.anuladaMotivo}</p>
  )}

  <div class="col">
    <div class="col__principal">
      {conContenido.map((s) => (
        <section class="ficha">
          <h2>{s.titulo}</h2>
          <dl>
            {s.campos.map((c) => (
              <div class="ficha__fila">
                <dt>{c.rotulo}</dt>
                <dd>{datos[c.clave]}{c.unidad && <small> {c.unidad}</small>}</dd>
              </div>
            ))}
          </dl>
        </section>
      ))}
    </div>

    <aside class="col__lado">
      <section class="ficha">
        <h2>Cobro</h2>
        {renglones.length === 0 ? (
          <p class="lado__vacio">Todavía no se cargó nada que cobrar.</p>
        ) : (
          <ul class="renglones">
            {renglones.map((r) => (
              <li>
                <span>
                  <strong>{r.descripcion}</strong>
                  <small>{r.paga === 'aseguradora' ? 'Lo paga el seguro' : r.paga === 'empresa' ? 'Lo paga la empresa' : 'Lo paga el paciente'}</small>
                </span>
                <em class="cifra">{dinero(Number(r.precio) * Number(r.cantidad))}</em>
              </li>
            ))}
            <li class="renglones__total">
              <span><strong>Total</strong></span>
              <em class="cifra">{dinero(total)}</em>
            </li>
          </ul>
        )}
        <p class="lado__quien">
          {caso.aseguradora
            ? <>Se le cobra a <strong>{caso.aseguradora}</strong>{caso.poliza && <> · póliza {caso.poliza}</>}</>
            : <>Lo paga el paciente directamente.</>}
        </p>
      </section>

      {anteriores.length > 0 && (
        <section class="ficha">
          <h2>Atenciones anteriores</h2>
          <ul class="previas">
            {anteriores.map((a) => (
              <li>
                <a href={`/sistema/atencion/${a.id}`}>
                  <strong class="cifra">N° {a.numero}</strong>
                  <span>{a.idx}</span>
                  <em>{fechaLarga(a.fecha)}</em>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )}
    </aside>
  </div>
</Sistema>

<style>
  .miga { font-size: var(--u-sm); color: var(--tinta-tenue); margin-bottom: 14px; }
  .miga a { color: var(--tinta-suave); text-decoration: none; }
  .miga a:hover { color: var(--azul); text-decoration: underline; }
  .miga span { margin-inline: 5px; }

  .cab { display: flex; flex-wrap: wrap; gap: 14px; align-items: flex-start; justify-content: space-between; }
  .cab__linea { display: flex; flex-wrap: wrap; align-items: center; gap: 11px; }
  .cab__meta { margin-top: 7px; font-size: var(--u-sm); color: var(--tinta-tenue); }
  .cab__meta strong { color: var(--tinta-suave); }

  .chapa {
    font-size: var(--u-xs);
    font-weight: 700;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    padding: 4px 10px;
    border-radius: 999px;
  }
  .chapa--borrador { background: #fdf0d9; color: #7a5200; }
  .chapa--cerrada  { background: #e4f2ea; color: #15663f; }
  .chapa--anulada  { background: #fdeced; color: #8f1017; }

  .anulada { margin-top: 16px; }

  .col { display: grid; grid-template-columns: minmax(0, 1fr); gap: 14px; margin-top: 20px; }
  @media (min-width: 1000px) { .col { grid-template-columns: minmax(0, 1fr) 340px; align-items: start; } }
  .col__principal, .col__lado { display: grid; gap: 14px; align-content: start; }

  .ficha { background: var(--papel); border: 1px solid var(--linea); border-radius: 10px; padding: 18px; }
  .ficha h2 { font-size: var(--u-md); margin-bottom: 12px; }
  .ficha dl { margin: 0; display: grid; gap: 1px; }
  .ficha__fila { display: grid; grid-template-columns: minmax(0, 1fr); gap: 2px; padding: 9px 0; border-top: 1px solid var(--linea-tenue); }
  .ficha__fila:first-child { border-top: 0; padding-top: 0; }
  @media (min-width: 620px) { .ficha__fila { grid-template-columns: 210px minmax(0, 1fr); gap: 16px; align-items: baseline; } }
  .ficha dt { font-size: var(--u-sm); color: var(--tinta-tenue); }
  .ficha dd { margin: 0; color: var(--tinta); white-space: pre-wrap; }
  .ficha dd small { color: var(--tinta-tenue); }

  .lado__vacio { font-size: var(--u-sm); color: var(--tinta-tenue); }
  .lado__quien { margin-top: 14px; padding-top: 13px; border-top: 1px solid var(--linea-tenue); font-size: var(--u-sm); color: var(--tinta-suave); }

  .renglones { list-style: none; margin: 0; padding: 0; display: grid; gap: 1px; }
  .renglones li { display: flex; align-items: baseline; justify-content: space-between; gap: 14px; padding: 9px 0; border-top: 1px solid var(--linea-tenue); }
  .renglones li:first-child { border-top: 0; padding-top: 0; }
  .renglones span { display: flex; flex-direction: column; min-width: 0; }
  .renglones strong { font-size: var(--u-sm); font-weight: 600; }
  .renglones small { font-size: var(--u-xs); color: var(--tinta-tenue); }
  .renglones em { font-style: normal; font-weight: 600; color: var(--azul); flex: none; }
  .renglones__total { border-top: 2px solid var(--linea) !important; margin-top: 5px; padding-top: 11px !important; }
  .renglones__total em { font-size: var(--u-md); }

  .previas { list-style: none; margin: 0; padding: 0; display: grid; gap: 1px; }
  .previas a {
    display: grid;
    gap: 2px;
    padding: 10px 0;
    border-top: 1px solid var(--linea-tenue);
    text-decoration: none;
    color: var(--tinta);
  }
  .previas li:first-child a { border-top: 0; padding-top: 0; }
  .previas a:hover strong { color: var(--rojo); }
  .previas strong { font-size: var(--u-sm); color: var(--azul); }
  .previas span { font-size: var(--u-sm); color: var(--tinta-suave); }
  .previas em { font-style: normal; font-size: var(--u-xs); color: var(--tinta-tenue); }
</style>
