---
import Sistema from '../../../layouts/Sistema.astro';
import Icono from '../../../components/Icono.astro';
import { historia } from '../../../sistema/historia';
import { laboratorio, type Resultado } from '../../../sistema/laboratorio';
import { bd, esquema } from '../../../sistema/lib/base';
import { anotar, esIdentificador } from '../../../sistema/lib/atenciones';
import { dinero, frasePagador, montoRenglon, renglonesDe, resumir } from '../../../sistema/lib/cobro';
import { eq, desc, and, ne } from 'drizzle-orm';
import { exigir } from '../../../sistema/lib/guardia';
import {
  puede, puedeBorrarBorrador, puedeCargarResultados, puedeEditarAtencion, puedeEditarOrden,
  puedeTomarCaso,
} from '../../../sistema/lib/permisos';
import { yaLaEscribioElMedico } from '../../../sistema/historia';
import { alias } from 'drizzle-orm/pg-core';
import { examenesPedidos, ordenesDe } from '../../../sistema/lib/laboratorio';
import { fueraDeRango, comoSeDice } from '../../../sistema/rangos';
import { comoSeLee } from '../../../sistema/lib/documento';
import {
  ROTULO_AGREGADO, agregadosDe, agregar, anularAgregado, lineasDeExamenes,
} from '../../../sistema/lib/agregados';
import Diagnostico from '../../../components/sistema/Diagnostico.astro';
import { ajustes } from '../../../sistema/lib/ajustes';
import {
  ROTULO_TIPO, destinoDe, especialidades, especialistasDelCentro, interconsultasDe,
  pedirInterconsulta, rotuloEstado,
} from '../../../sistema/lib/interconsultas';

export const prerender = false;

/* "user" entra dos veces: el médico al que está puesta la atención y quien
   la admitió en el mesón. Sin alias, Postgres no sabe de cuál se habla. */
const admisor = alias(esquema.user, 'admisor');

/* La puerta se abre con 'ver_historia' o con 'ver_laboratorio', y después
   se comprueba contra lo que de verdad se abrió: así el bioanalista puede
   mirar la indicación del médico cuando el resultado le llama la atención,
   y el que solo tiene laboratorio no entra a una consulta. */
const usuario = Astro.locals.usuario;
if (!usuario) return Astro.redirect('/sistema/entrar');

const { id } = Astro.params;

/* Un id que no tiene forma de uuid hace que Postgres rechace el cast y la
   pantalla termina en error de servidor. Un enlace viejo o mal copiado se
   contesta como lo que es: un caso que no está. */
if (!id || !esIdentificador(id)) return Astro.redirect('/sistema');

const [caso] = await bd
  .select({
    id: esquema.atencion.id,
    numero: esquema.atencion.numero,
    estado: esquema.atencion.estado,
    tipo: esquema.atencion.tipo,
    origenId: esquema.atencion.origenId,
    resultados: esquema.atencion.resultados,
    resultadosEn: esquema.atencion.resultadosEn,
    fecha: esquema.atencion.fecha,
    aseguradora: esquema.atencion.aseguradora,
    poliza: esquema.atencion.poliza,
    casoNumero: esquema.atencion.casoNumero,
    datos: esquema.atencion.datos,
    creada: esquema.atencion.creada,
    anuladaMotivo: esquema.atencion.anuladaMotivo,
    pacienteId: esquema.paciente.id,
    paciente: esquema.paciente.nombre,
    cedula: esquema.paciente.cedula,
    tipoDoc: esquema.paciente.tipoDoc,
    telefono: esquema.paciente.telefono,
    medicoId: esquema.atencion.medicoId,
    medico: esquema.user.name,
    colegiatura: esquema.user.colegiatura,
    /* Quién la admitió en el mesón. Nulo = la abrió el propio médico, que es
       como nacen las que él mismo empieza. Ver 019-admision.sql. */
    abiertaPor: esquema.atencion.abiertaPor,
    admitio: admisor.name,
  })
  .from(esquema.atencion)
  .innerJoin(esquema.paciente, eq(esquema.paciente.id, esquema.atencion.pacienteId))
  .innerJoin(esquema.user, eq(esquema.user.id, esquema.atencion.medicoId))
  /* Izquierdo: casi ninguna atención tiene quién la admitió, y con un join
     interno la pantalla devolvía "este caso no está". */
  .leftJoin(admisor, eq(admisor.id, esquema.atencion.abiertaPor))
  .where(eq(esquema.atencion.id, id))
  .limit(1);

if (!caso) return Astro.redirect('/sistema');

const esLab = caso.tipo === 'laboratorio';
const corte = exigir(Astro, esLab ? 'ver_laboratorio' : 'ver_historia');
if (corte) return corte;

/* Tomar un caso que admitió recepción y estaba puesto a nombre de otro.
   Va por POST porque cambia a quién pertenece el borrador: un enlace lo
   dispararía el primer bot que pase o el prefetch del navegador.

   La condición se vuelve a comprobar acá y no se confía en que el botón
   estuviera dibujado: el botón es una pista, el permiso es esto. */
const escrita = yaLaEscribioElMedico((caso.datos ?? {}) as Record<string, string>);
const tomable = puedeTomarCaso(usuario, { ...caso, escrita });

/* Lo que se le suma a una cerrada. Si sale mal, la pantalla se dibuja con
   el error y con lo que se había escrito, en vez de redirigir y perderlo:
   una nota larga que desaparece por un error es una nota que no se vuelve
   a escribir. Las reglas las mira lib/agregados.ts, no esto. */
let errorAgregado = '';
let tecleado = { tipo: 'nota', texto: '', dx: '', dxCodigo: '' };
let errorInterconsulta = '';
let pedido = {
  tipo: '', especialidad: '', otra: '', medico: '', centro: '', ambulancia: '', paramedico: '',
  motivo: '', porRecepcion: '',
};

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const accion = String(form.get('accion') ?? '');

  if (accion === 'tomar') {
    if (tomable) {
      const nuevos = { ...((caso.datos ?? {}) as Record<string, string>), medico: usuario.name };
      const cambiadas = await bd
        .update(esquema.atencion)
        .set({ medicoId: usuario.id, datos: nuevos })
        .where(and(
          eq(esquema.atencion.id, caso.id),
          /* Que siga siendo un borrador admitido y del mismo médico que
             estaba: entre que se dibujó el botón y se tocó, el otro médico
             pudo haber empezado a escribirla. */
          eq(esquema.atencion.estado, 'borrador'),
          eq(esquema.atencion.medicoId, caso.medicoId),
        ))
        .returning({ id: esquema.atencion.id });

      if (cambiadas.length) {
        await anotar(usuario.id, 'tomo', caso.id, {
          numero: caso.numero,
          antes: caso.medico,
        });
        return Astro.redirect(`/sistema/atencion/${caso.id}/editar`);
      }
    }
    return Astro.redirect(`/sistema/atencion/${caso.id}`);
  } else if (accion === 'agregar') {
    const tipo = String(form.get('tipo') ?? '');
    tecleado = {
      tipo,
      texto: String(form.get(tipo === 'examenes' ? 'examenes_texto' : 'nota_texto') ?? ''),
      dx: String(form.get('dx_agregado') ?? ''),
      dxCodigo: String(form.get('dx_agregado_codigo') ?? ''),
    };
    try {
      await agregar(usuario, caso.id, {
        tipo,
        texto: tipo === 'diagnostico' ? tecleado.dx : tecleado.texto,
        codigo: tipo === 'diagnostico' ? tecleado.dxCodigo : undefined,
      });
      return Astro.redirect(`/sistema/atencion/${caso.id}?agregado=1#agregados`);
    } catch (e) {
      errorAgregado = e instanceof Error ? e.message : 'No se pudo agregar.';
    }
  } else if (accion === 'pedir_interconsulta') {
    const campo = (k: string) => String(form.get(k) ?? '');
    pedido = {
      tipo: campo('tipo_derivacion'), especialidad: campo('especialidad'), otra: campo('otra'),
      medico: campo('medico_destino'), centro: campo('centro'), ambulancia: campo('ambulancia'),
      paramedico: campo('paramedico'), motivo: campo('motivo_interconsulta'), porRecepcion: campo('por_recepcion'),
    };
    try {
      await pedirInterconsulta(usuario, caso.id, {
        tipo: pedido.tipo,
        /* «Otra» es para la especialidad que todavía no tiene especialista
           cargado: el médico no tiene por qué saber quién está en la lista. */
        especialidad: pedido.especialidad === '__otra' ? pedido.otra : pedido.especialidad,
        medicoId: pedido.medico,
        centro: pedido.centro,
        ambulancia: pedido.ambulancia,
        paramedico: pedido.paramedico,
        motivo: pedido.motivo,
        porRecepcion: pedido.porRecepcion === 'si',
      });
      return Astro.redirect(`/sistema/atencion/${caso.id}?interconsulta=1#interconsultas`);
    } catch (e) {
      errorInterconsulta = e instanceof Error ? e.message : 'No se pudo pedir la interconsulta.';
    }
  } else if (accion === 'anular_agregado') {
    try {
      await anularAgregado(usuario, String(form.get('agregado') ?? ''), String(form.get('motivo') ?? ''));
      return Astro.redirect(`/sistema/atencion/${caso.id}?anulado=1#agregados`);
    } catch (e) {
      errorAgregado = e instanceof Error ? e.message : 'No se pudo anular.';
    }
  } else {
    return Astro.redirect(`/sistema/atencion/${caso.id}`);
  }
}

await anotar(usuario.id, 'vio', caso.id);

const renglones = await renglonesDe(caso.id);

/* Los dos lados del hilo con el laboratorio: si esto es una consulta, las
   órdenes que salieron de ella; si es una orden, de qué consulta salió.
   Ver 009-roles.sql. */
const ordenes = esLab ? [] : await ordenesDe(caso.id);
const pedidos = esLab ? await examenesPedidos(caso.id) : [];
const resultados = (caso.resultados ?? []) as Resultado[];

const [origenCrudo] = caso.origenId
  ? await bd
      .select({
        id: esquema.atencion.id,
        numero: esquema.atencion.numero,
        fecha: esquema.atencion.fecha,
        datos: esquema.atencion.datos,
      })
      .from(esquema.atencion)
      .where(eq(esquema.atencion.id, caso.origenId))
      .limit(1)
  : [];

/* El cast va acá y no en el template, igual que con las previas: un
   genérico dentro del JSX de Astro se parsea como etiqueta. */
const consultaOrigen = origenCrudo
  ? {
      id: origenCrudo.id,
      numero: origenCrudo.numero,
      fecha: origenCrudo.fecha,
      idx: (origenCrudo.datos as Record<string, string> | null)?.idx ?? 'Sin diagnóstico',
    }
  : null;

const previasCrudas = await bd
  .select({
    id: esquema.atencion.id,
    numero: esquema.atencion.numero,
    fecha: esquema.atencion.fecha,
    tipo: esquema.atencion.tipo,
    datos: esquema.atencion.datos,
  })
  .from(esquema.atencion)
  .where(and(eq(esquema.atencion.pacienteId, caso.pacienteId), ne(esquema.atencion.id, caso.id)))
  .orderBy(desc(esquema.atencion.fecha))
  .limit(6);

/* El cast va acá y no en el template: un genérico dentro del JSX se parsea
   como etiqueta y rompe la compilación. */
const anteriores = previasCrudas.map((a) => ({
  id: a.id,
  numero: a.numero,
  fecha: a.fecha,
  /* Una orden de laboratorio no tiene diagnóstico: decir "sin diagnóstico"
     hacía parecer que al médico se le olvidó escribirlo. */
  idx: a.tipo === 'laboratorio'
    ? 'Laboratorio'
    : (a.datos as Record<string, string> | null)?.idx ?? 'Sin diagnóstico',
}));

const datos = (caso.datos ?? {}) as Record<string, string>;

/* Lo agregado después del cierre. Solo en las consultas: una orden de
   laboratorio se corrige en sus resultados. */
const agregados = esLab ? [] : await agregadosDe(caso.id);
const puedeAgregar = !esLab && caso.estado === 'cerrada' && puede(usuario.rol as string, 'agregar_al_caso');
const puedeAnularAgregado = puede(usuario.rol as string, 'anular_atencion');
const puedeRegistrarOrden = puede(usuario.rol as string, 'registrar_laboratorio');
const avisoAgregado = Astro.url.searchParams.get('agregado') === '1'
  ? 'Quedó agregado. Lo cerrado no cambió.'
  : Astro.url.searchParams.get('anulado') === '1'
    ? 'Quedó anulado. Se ve tachado acá y ya no sale en el documento.'
    : '';
const cuando = (d: Date) => d.toLocaleString('es-VE', {
  timeZone: 'America/Caracas', day: 'numeric', month: 'short', year: 'numeric',
  hour: 'numeric', minute: '2-digit',
});
const campoDx = { clave: 'dx_agregado', rotulo: 'Diagnóstico', tipo: 'diagnostico', ancho: 4 } as const;

/* Las interconsultas de esta consulta. Se piden con el caso abierto o ya
   cerrado: lo que no se hace es pedir una desde una anulada. */
const interconsultas = esLab ? [] : await interconsultasDe(caso.id);
const puedePedirInterconsulta = !esLab && caso.estado !== 'anulada'
  && puede(usuario.rol as string, 'pedir_interconsulta');
const lasEspecialidades = puedePedirInterconsulta ? await especialidades() : [];
const delCentro = puedePedirInterconsulta
  ? (await especialistasDelCentro()).filter((m) => m.id !== usuario.id) : [];
/* Si existe el paso por recepción y qué viene marcado en cada tipo: lo
   decide cada centro en sus ajustes. */
const config = puedePedirInterconsulta ? await ajustes() : null;
const tipoInicial = pedido.tipo || (delCentro.length ? 'interna' : 'externa');
const recepcionDe = { interna: config?.recepcion_interna, externa: config?.recepcion_externa, traslado: config?.recepcion_traslado };
const abiertasAca = interconsultas.filter((i) => i.estado === 'pendiente' || i.estado === 'contactada').length;
const avisoInterconsulta = Astro.url.searchParams.get('interconsulta') === '1'
  ? 'Derivación pedida. Queda en el panel de derivaciones de quien la tiene que mover.'
  : '';

/* Una cuenta por moneda, como en la pantalla de cobro. Dólares y bolívares
   no se suman: el número que saldría de mezclarlos no se le puede pasar a
   nadie. El desglose por pagador aparece cuando hay más de uno, que es el
   caso que la metáfora de la bodega describe. */
const cuentas = resumir(renglones);

const fechaLarga = (f: string) =>
  new Date(`${f}T12:00:00`).toLocaleDateString('es-VE', { day: 'numeric', month: 'long', year: 'numeric' });

/* Solo se muestran las secciones que tienen algo escrito: una historia de
   consulta simple no debe verse como un formulario medio vacío. */
const conContenido = (esLab ? laboratorio : historia)
  .map((s) => ({ ...s, campos: s.campos.filter((c) => datos[c.clave]) }))
  .filter((s) => s.campos.length > 0);

/* Una orden de laboratorio en borrador no es una historia a medio escribir:
   es una muestra esperando resultados, y así se dice. */
const etiqueta = esLab
  ? {
      borrador: { texto: 'Esperando resultados', clase: 'borrador' },
      cerrada: { texto: 'Entregada', clase: 'cerrada' },
      anulada: { texto: 'Anulada', clase: 'anulada' },
    }[caso.estado]
  : {
      borrador: { texto: 'Borrador', clase: 'borrador' },
      cerrada: { texto: 'Cerrada', clase: 'cerrada' },
      anulada: { texto: 'Anulada', clase: 'anulada' },
    }[caso.estado];

const comoSeLlama = esLab ? 'Orden' : 'Atención';
---

<Sistema titulo={`${comoSeLlama} ${caso.numero}`}>
  <nav class="miga">
    {esLab
      ? <><a href="/sistema/laboratorio">Laboratorio</a> <span>/</span> Orden {caso.numero}</>
      : <><a href="/sistema">Casos</a> <span>/</span> Atención {caso.numero}</>}
  </nav>

  <header class="cab">
    <div>
      <div class="cab__linea">
        {/* El nombre lleva a la ficha de la persona: desde una atención se
            llega a sus otras atenciones, sus antecedentes y sus alergias.
            Si el rol no puede ver el registro, queda como texto y ya. */}
        <h1>
          {puede(usuario.rol as string, 'ver_pacientes') ? (
            <a class="cab__persona" href={`/sistema/pacientes/${caso.pacienteId}`}>
              {caso.paciente}
            </a>
          ) : (
            caso.paciente
          )}
        </h1>
        <span class:list={['chapa', `chapa--${etiqueta.clase}`]}>{etiqueta.texto}</span>
      </div>
      <p class="cab__meta">
        {comoSeLlama} <strong class="cifra">N° {caso.numero}</strong> ·
        {fechaLarga(caso.fecha)} ·
        {comoSeLee(caso.tipoDoc, caso.cedula)} ·
        {esLab ? 'registró' : caso.estado === 'borrador' ? 'para' : 'atendió'} {caso.medico}{caso.colegiatura && ` (${caso.colegiatura})`}
        {caso.admitio && <> · admitió {caso.admitio}</>}
      </p>
    </div>
    <div class="cab__acciones">
      {puedeCargarResultados(usuario, caso) && (
        <a class="sis-boton sis-boton--primario" href={`/sistema/atencion/${caso.id}/resultados`}>
          <Icono nombre="laboratorio" tam={18} />
          Cargar resultados
        </a>
      )}
      {/* Puesta a otro médico y todavía sin escribir: se la puede llevar
          quien de verdad va a atender, sin pasar otra vez por el mesón. */}
      {tomable && (
        <form method="post" class="tomar">
          <input type="hidden" name="accion" value="tomar" />
          <button type="submit" class="sis-boton sis-boton--primario">
            <Icono nombre="estetoscopio" tam={18} />
            Tomar el caso
          </button>
        </form>
      )}
      {(esLab ? puedeEditarOrden(usuario, caso) : puedeEditarAtencion(usuario, caso)) && (
        <a class:list={['sis-boton', esLab ? 'sis-boton--suave' : 'sis-boton--primario']}
           href={`/sistema/atencion/${caso.id}/editar`}>
          <Icono nombre="flecha" tam={18} />
          {esLab ? 'Corregir la orden' : 'Continuar la atención'}
        </a>
      )}
      {/* Pedir exámenes desde la consulta: la orden queda colgada de acá y
          el resultado vuelve a esta misma pantalla. */}
      {!esLab && puede(usuario.rol as string, 'registrar_laboratorio') && (
        <a class="sis-boton sis-boton--suave"
           href={`/sistema/atencion/nueva?tipo=laboratorio&cedula=${encodeURIComponent(caso.cedula)}&doc=${caso.tipoDoc}&origen=${caso.id}`}>
          <Icono nombre="laboratorio" tam={18} />
          Pedir exámenes
        </a>
      )}
      {puede(usuario.rol as string, 'cargar_cobro') && (
        <a class="sis-boton sis-boton--suave" href={`/sistema/atencion/${caso.id}/cobro`}>
          <Icono nombre="mas" tam={18} />
          Cargar cobro
        </a>
      )}
      {caso.estado === 'cerrada' && puede(usuario.rol as string, 'anular_atencion') && (
        <a class="sis-boton sis-boton--suave anular" href={`/sistema/atencion/${caso.id}/anular`}>
          Anular
        </a>
      )}
      {/* Un borrador se borra; lo cerrado se anula con motivo. Son dos
          cosas distintas y nunca aparecen las dos a la vez. */}
      {puedeBorrarBorrador(usuario, caso) && (
        <a class="sis-boton sis-boton--suave anular" href={`/sistema/atencion/${caso.id}/borrar`}>
          Borrar
        </a>
      )}
      <a class="sis-boton sis-boton--azul" href={`/sistema/atencion/${caso.id}/documento`} target="_blank">
        <Icono nombre="recibo" tam={18} />
        Documento
      </a>
      {puede(usuario.rol as string, 'enviar_documento') && (
        <a class="sis-boton sis-boton--suave" href={`/sistema/atencion/${caso.id}/enviar`}>
          <Icono nombre="correo" tam={18} />
          Enviar al paciente
        </a>
      )}
    </div>
  </header>

  {caso.estado === 'anulada' && caso.anuladaMotivo && (
    <p class="sis-error anulada"><Icono nombre="escudo" tam={18} />Anulada: {caso.anuladaMotivo}</p>
  )}

  {/* El índice de la consulta. La ficha fue creciendo —la historia, lo
      agregado después del cierre, las derivaciones, el cobro— y en una
      tablet ya eran siete tarjetas en fila: lo de abajo no se veía y no
      había nada que dijera que estaba. Salta a cada parte y dice cuánto
      trae. Enlaces y no pestañas: no esconde nada, se imprime entero y
      anda sin JavaScript. */}
  {!esLab && (
    <nav class="indice" aria-label="Partes de la atención">
      <a href="#historia">Historia</a>
      {(agregados.length > 0 || puedeAgregar) && (
        <a href="#agregados">
          Agregados {agregados.length > 0 && <span class="indice__n cifra">{agregados.length}</span>}
        </a>
      )}
      {(interconsultas.length > 0 || puedePedirInterconsulta) && (
        <a href="#interconsultas">
          Derivaciones
          {abiertasAca > 0 && <span class="indice__n indice__n--abiertas cifra" title="Abiertas">{abiertasAca}</span>}
        </a>
      )}
      <a href="#cobro">Cobro {cuentas.length > 0 && <span class="indice__n cifra">{renglones.length}</span>}</a>
    </nav>
  )}

  <div class="col">
    <div class="col__principal">
      {esLab && pedidos.length > 0 && (
        <section class="ficha">
          <h2>Exámenes pedidos</h2>
          <ul class="pedidos">
            {pedidos.map((p) => <li>{p.nombre}</li>)}
          </ul>
        </section>
      )}

      {esLab && (
        <section class="ficha">
          <h2>Resultados</h2>
          {resultados.length === 0 ? (
            <p class="lado__vacio">
              Todavía no se cargó ningún resultado.
              {puedeCargarResultados(usuario, caso) && (
                <> <a href={`/sistema/atencion/${caso.id}/resultados`}>Cargarlos</a>.</>
              )}
            </p>
          ) : (
            <div class="tablon">
              <table class="res">
                <thead>
                  <tr>
                    <th scope="col">Examen</th>
                    <th scope="col">Resultado</th>
                    <th scope="col">Referencia</th>
                  </tr>
                </thead>
                <tbody>
                  {resultados.map((r) => (
                    <tr>
                      <td>{r.examen}</td>
                      <td class="res__valor">
                        <strong class="cifra">{r.valor || '—'}</strong>
                        {r.unidad && <small> {r.unidad}</small>}
                      </td>
                      <td class="res__ref">{r.referencia || '—'}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          )}
        </section>
      )}

      {conContenido.map((s, i) => (
        <section class="ficha" id={i === 0 ? 'historia' : undefined}>
          <h2>{s.titulo}</h2>
          <dl>
            {s.campos.map((c) => (
              <div class="ficha__fila">
                <dt>{c.rotulo}</dt>
                <dd>
                  {/* Una fecha se lee como fecha, igual que en la cabecera:
                      «2026-11-15» abajo y «15 de noviembre» arriba parecían
                      dos datos distintos. */}
                  {c.tipo === 'fecha' && /^\d{4}-\d{2}-\d{2}$/.test(datos[c.clave] ?? '')
                    ? fechaLarga(datos[c.clave])
                    : datos[c.clave]}
                  {/* El código CIE-10, cuando el diagnóstico se eligió del
                      catálogo. Escrito a mano va el texto solo. */}
                  {c.clave === 'idx' && datos.idx_codigo && (
                    <span class="codigo cifra">{datos.idx_codigo}</span>
                  )}
                  {c.unidad && <small> {c.unidad}</small>}
                </dd>
              </div>
            ))}
          </dl>
        </section>
      ))}

      {!esLab && (agregados.length > 0 || puedeAgregar || errorAgregado) && (
        <section class="ficha agregados" id="agregados">
          <h2>Agregado después del cierre</h2>
          <p class="lado__vacio">
            Lo de arriba es lo que se cerró y no se toca. Lo que vino después
            va acá, con la fecha y quién lo escribió.
          </p>

          {avisoAgregado && <p class="msj--bien" role="status">{avisoAgregado}</p>}
          {errorAgregado && <p class="sis-error" role="alert">{errorAgregado}</p>}

          {agregados.length > 0 && (
            <ol class="agregados__lista">
              {agregados.map((a) => (
                <li class:list={['agregado', a.anuladoEn && 'agregado--anulado']}>
                  <p class="agregado__cabeza">
                    <strong>{ROTULO_AGREGADO[a.tipo]}</strong>
                    <span>{cuando(a.creado)}</span>
                    <span>{a.autor}{a.colegiatura && ` (${a.colegiatura})`}</span>
                  </p>

                  {a.tipo === 'examenes' ? (
                    <ul class="agregado__examenes">
                      {lineasDeExamenes(a.texto).map((l) => <li>{l}</li>)}
                    </ul>
                  ) : (
                    <p class="agregado__texto">
                      {a.texto}
                      {a.codigo && <span class="codigo cifra">{a.codigo}</span>}
                    </p>
                  )}

                  {a.anuladoEn ? (
                    <p class="agregado__anulado">
                      Anulado{a.anuladoPor && ` por ${a.anuladoPor}`} el {cuando(a.anuladoEn)}: {a.anuladoMotivo}
                    </p>
                  ) : (
                    <>
                      {a.tipo === 'examenes' && (
                        a.ordenId ? (
                          <p class="agregado__orden">
                            <a href={`/sistema/atencion/${a.ordenId}`}>Ver la orden registrada</a>
                          </p>
                        ) : puedeRegistrarOrden ? (
                          <p class="agregado__orden">
                            <a class="sis-boton sis-boton--suave"
                               href={`/sistema/atencion/nueva?tipo=laboratorio&cedula=${encodeURIComponent(caso.cedula)}&doc=${caso.tipoDoc}&origen=${caso.id}&indicacion=${a.id}`}>
                              <Icono nombre="laboratorio" tam={18} />
                              Registrar la orden
                            </a>
                          </p>
                        ) : (
                          <p class="agregado__orden lado__vacio">Falta que recepción registre la orden.</p>
                        )
                      )}
                      {puedeAnularAgregado && (
                        <details class="agregado__anular">
                          <summary>Anular</summary>
                          <form method="post" class="sis-campo">
                            <input type="hidden" name="accion" value="anular_agregado" />
                            <input type="hidden" name="agregado" value={a.id} />
                            <label for={`motivo-${a.id}`}>¿Por qué se anula?</label>
                            <input id={`motivo-${a.id}`} name="motivo" type="text" required maxlength="1000" />
                            <button type="submit" class="sis-boton sis-boton--suave">Anular</button>
                          </form>
                        </details>
                      )}
                    </>
                  )}
                </li>
              ))}
            </ol>
          )}

          {puedeAgregar && (
            <form method="post" class="agregar" data-agregar>
              <input type="hidden" name="accion" value="agregar" />
              <fieldset class="agregar__tipo">
                <legend>Qué va a agregar</legend>
                {(['nota', 'diagnostico', 'examenes'] as const).map((t) => (
                  <label>
                    <input type="radio" name="tipo" value={t} checked={tecleado.tipo === t} />
                    {ROTULO_AGREGADO[t]}
                  </label>
                ))}
              </fieldset>

              <div class="agregar__campo sis-campo" data-para="nota">
                <label for="nota_texto">Nota</label>
                <textarea id="nota_texto" name="nota_texto" rows="4" maxlength="4000">{tecleado.tipo === 'nota' ? tecleado.texto : ''}</textarea>
              </div>
              <div class="agregar__campo sis-campo" data-para="diagnostico">
                <Diagnostico campo={campoDx} valor={tecleado.dx} codigo={tecleado.dxCodigo} />
              </div>
              <div class="agregar__campo sis-campo" data-para="examenes">
                <label for="examenes_texto">Exámenes indicados <span class="lado__vacio">· uno por línea</span></label>
                <textarea id="examenes_texto" name="examenes_texto" rows="4" maxlength="4000">{tecleado.tipo === 'examenes' ? tecleado.texto : ''}</textarea>
                <p class="lado__vacio">Recepción los ve en su cola y registra la orden con su precio.</p>
              </div>

              <button type="submit" class="sis-boton sis-boton--azul">Agregar</button>
            </form>
          )}
        </section>
      )}

      {!esLab && (interconsultas.length > 0 || puedePedirInterconsulta || errorInterconsulta) && (
        <section class="ficha interconsultas" id="interconsultas">
          <h2>Derivaciones</h2>
          {avisoInterconsulta && <p class="msj--bien" role="status">{avisoInterconsulta}</p>}
          {errorInterconsulta && <p class="sis-error" role="alert">{errorInterconsulta}</p>}

          {interconsultas.length > 0 && (
            <ul class="ic__lista">
              {interconsultas.map((ic) => (
                <li class:list={['ic', `ic--${ic.estado}`]}>
                  <p class="ic__cabeza">
                    <strong>{destinoDe(ic)}</strong>
                    <span class="ic__estado">{rotuloEstado(ic.estado, ic.tipo)}</span>
                  </p>
                  <p class="lado__vacio">{ROTULO_TIPO[ic.tipo]}{ic.porRecepcion && ' · pasa por recepción'}</p>
                  {ic.motivo && <p class="ic__motivo">{ic.motivo}</p>}
                  <p class="lado__vacio">
                    Pedida por {ic.medico}, {cuando(ic.pedida)}
                    {ic.especialista && <> · se le escribió a {ic.especialista}</>}
                    {ic.atencionDestinoId && <> · <a href={`/sistema/atencion/${ic.atencionDestinoId}`}>ver la consulta del especialista</a></>}
                    {ic.anuladaMotivo && <> · anulada: {ic.anuladaMotivo}</>}
                  </p>
                </li>
              ))}
            </ul>
          )}

          {puedePedirInterconsulta && (
            <form method="post" class="ic__pedir" data-interconsulta
                  data-recepcion={JSON.stringify(recepcionDe)}
                  data-tocada={pedido.tipo ? '' : undefined}>
              <input type="hidden" name="accion" value="pedir_interconsulta" />
              <fieldset class="agregar__tipo">
                <legend>A dónde se deriva</legend>
                {(['interna', 'externa', 'traslado'] as const).map((t) => (
                  <label>
                    <input type="radio" name="tipo_derivacion" value={t} checked={tipoInicial === t}
                           disabled={t === 'interna' && delCentro.length === 0} />
                    {ROTULO_TIPO[t]}
                  </label>
                ))}
              </fieldset>
              {delCentro.length === 0 && (
                <p class="lado__vacio">
                  No hay especialistas del centro cargados: administración les pone la especialidad en Cuentas.
                </p>
              )}

              <div class="agregar__campo sis-campo" data-para-d="interna">
                <label for="medico_destino">Especialista del centro</label>
                <select id="medico_destino" name="medico_destino">
                  <option value="" disabled selected={!pedido.medico}>Elija uno</option>
                  {delCentro.map((m) => (
                    <option value={m.id} selected={pedido.medico === m.id}>{m.especialidad} · {m.nombre}</option>
                  ))}
                </select>
              </div>

              <div class="agregar__campo sis-campo" data-para-d="externa">
                <label for="especialidad">Especialidad</label>
                <select id="especialidad" name="especialidad">
                  <option value="" disabled selected={!pedido.especialidad}>Elija una</option>
                  {lasEspecialidades.map((e) => (
                    <option value={e} selected={pedido.especialidad === e}>{e}</option>
                  ))}
                  <option value="__otra" selected={pedido.especialidad === '__otra'}>
                    {lasEspecialidades.length ? 'Otra, que no está en la lista' : 'Escribirla'}
                  </option>
                </select>
              </div>
              <div class="agregar__campo sis-campo" data-para-d="externa" data-otra>
                <label for="otra">¿Cuál?</label>
                <input id="otra" name="otra" type="text" maxlength="120" value={pedido.otra}
                       placeholder="Oftalmología, nefrología…" />
              </div>

              <div class="agregar__campo sis-campo" data-para-d="traslado">
                <label for="centro">A qué centro u hospital</label>
                <input id="centro" name="centro" type="text" maxlength="160" value={pedido.centro} />
              </div>
              <div class="agregar__campo sis-campo" data-para-d="traslado">
                <label for="ambulancia">¿En ambulancia?</label>
                <select id="ambulancia" name="ambulancia">
                  <option value="si" selected={pedido.ambulancia !== 'no'}>Sí</option>
                  <option value="no" selected={pedido.ambulancia === 'no'}>No</option>
                </select>
              </div>
              <div class="agregar__campo sis-campo" data-para-d="traslado">
                <label for="paramedico">Paramédico <span class="lado__vacio">· si ya se sabe</span></label>
                <input id="paramedico" name="paramedico" type="text" maxlength="120" value={pedido.paramedico} />
              </div>

              <div class="agregar__campo sis-campo">
                <label for="motivo_interconsulta">Para qué <span class="lado__vacio">· lo que tiene que saber quien lo recibe</span></label>
                <textarea id="motivo_interconsulta" name="motivo_interconsulta" rows="3" maxlength="2000">{pedido.motivo}</textarea>
              </div>

              {config?.recepcion_derivaciones && (
                <label class="ic__recepcion">
                  <input type="checkbox" name="por_recepcion" value="si"
                         checked={pedido.tipo ? pedido.porRecepcion === 'si' : Boolean(recepcionDe[tipoInicial as 'interna'])} />
                  Que pase por recepción <span class="lado__vacio">· para admitirlo, cobrar o coordinar la ambulancia</span>
                </label>
              )}

              <button type="submit" class="sis-boton sis-boton--azul">Derivar</button>
            </form>
          )}
        </section>
      )}
    </div>

    <aside class="col__lado">
      <section class="ficha" id="cobro">
        <h2>Cobro</h2>
        {cuentas.length === 0 ? (
          <p class="lado__vacio">Todavía no se cargó nada que cobrar.</p>
        ) : (
          cuentas.map((c) => (
            <ul class="renglones">
              {renglones.filter((r) => r.moneda === c.moneda).map((r) => (
                <li>
                  <span>
                    <strong>{r.descripcion}</strong>
                    <small>{frasePagador(r.paga)}</small>
                  </span>
                  <em class="cifra">{dinero(montoRenglon(r.cantidad, r.precio))}</em>
                </li>
              ))}
              <li class="renglones__total">
                <span><strong>Total {c.moneda}</strong></span>
                <em class="cifra">{dinero(c.total)}</em>
              </li>
              {c.pagadores.length > 1 && c.pagadores.map((p) => (
                <li class="renglones__parte">
                  <span>{p.rotulo}</span>
                  <em class="cifra">{dinero(p.monto)}</em>
                </li>
              ))}
            </ul>
          ))
        )}
        <p class="lado__quien">
          {caso.aseguradora
            ? <>El caso lo cubre <strong>{caso.aseguradora}</strong>{caso.poliza && <> · póliza {caso.poliza}</>}. Cada renglón dice quién lo paga.</>
            : <>Nadie cubre el caso: lo que se cargue lo paga el paciente.</>}
        </p>
      </section>

      {/* El hilo con el laboratorio, de los dos lados.

          Los resultados se muestran ACÁ y no solo enlazados: el médico
          pedía los exámenes desde su consulta y después tenía que irse al
          laboratorio a buscarlos, con el paciente delante. El circuito se
          cierra donde empezó. */}
      {!esLab && ordenes.length > 0 && (
        <section class="ficha">
          <h2>Laboratorio</h2>
          {ordenes.map((o) => {
            const cargados = (o.resultados ?? []).filter((r) => r.valor?.trim());
            const afuera = cargados.filter(
              (r) => fueraDeRango(r.valor, r.referencia, datos.sexo) !== null,
            ).length;
            return (
              <details class="orden" open={cargados.length > 0 && ordenes.length === 1}>
                <summary>
                  <strong class="cifra">Orden N° {o.numero}</strong>
                  <span class="orden__estado">
                    {o.estado === 'anulada' ? 'Anulada'
                      : cargados.length ? `${cargados.length} resultados`
                      : 'Esperando resultados'}
                  </span>
                  {afuera > 0 && (
                    <span class="orden__ojo">
                      {afuera} fuera de rango
                    </span>
                  )}
                  <em>{fechaLarga(o.fecha)}</em>
                </summary>

                {cargados.length > 0 ? (
                  <table class="res">
                    <thead>
                      <tr><th>Examen</th><th>Resultado</th><th>Unidad</th><th>Referencia</th></tr>
                    </thead>
                    <tbody>
                      {cargados.map((r) => (
                        <tr data-fuera={fueraDeRango(r.valor, r.referencia, datos.sexo) ?? undefined}>
                          <td>{r.examen}</td>
                          <td class="res__dato cifra">
                            {r.valor}
                            <span class="oculto">
                              {' '}{comoSeDice(fueraDeRango(r.valor, r.referencia, datos.sexo))}
                            </span>
                          </td>
                          <td>{r.unidad}</td>
                          <td>{r.referencia}</td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                ) : (
                  <p class="orden__nada">
                    Todavía no hay resultados cargados en esta orden.
                  </p>
                )}

                <p class="orden__pie">
                  <a href={`/sistema/atencion/${o.id}`}>Abrir la orden completa</a>
                </p>
              </details>
            );
          })}
        </section>
      )}

      {esLab && consultaOrigen && (
        <section class="ficha">
          <h2>De qué consulta salió</h2>
          <ul class="previas">
            <li>
              <a href={`/sistema/atencion/${consultaOrigen.id}`}>
                <strong class="cifra">N° {consultaOrigen.numero}</strong>
                <span>{consultaOrigen.idx}</span>
                <em>{fechaLarga(consultaOrigen.fecha)}</em>
              </a>
            </li>
          </ul>
        </section>
      )}

      {anteriores.length > 0 && (
        <section class="ficha">
          {/* «Otras» y no «anteriores»: la lista trae también las que
              vinieron después, como la orden de laboratorio de esa misma
              consulta. */}
          <h2>Otras atenciones</h2>
          <ul class="previas">
            {anteriores.map((a) => (
              <li>
                <a href={`/sistema/atencion/${a.id}`}>
                  <strong class="cifra">N° {a.numero}</strong>
                  <span>{a.idx}</span>
                  <em>{fechaLarga(a.fecha)}</em>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )}
    </aside>
  </div>
</Sistema>

<style>
  /* El de tomar el caso es un formulario y los demás son enlaces: sin esto
     la fila de botones lo baja de línea él solo. */
  .tomar { display: contents; }

  /* Los resultados dentro de la consulta. Plegados cuando hay varias
     órdenes y abiertos cuando hay una sola: con una, esconderla detrás de
     un clic es un clic de más. */
  .orden {
    border: 1px solid var(--linea);
    border-radius: 10px;
    background: var(--papel);
    margin-bottom: 8px;
  }
  .orden summary {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
    min-height: 48px;
    padding: 0 14px;
    cursor: pointer;
    font-size: var(--u-sm);
  }
  .orden summary::-webkit-details-marker { display: none; }
  .orden__estado { color: var(--tinta-tenue); font-size: var(--u-xs); }
  .orden__ojo {
    padding: 2px 8px;
    border-radius: 999px;
    background: #fdecec;
    color: var(--rojo);
    font-size: var(--u-xs);
    font-weight: 700;
  }
  .orden summary em { margin-left: auto; font-style: normal; font-size: var(--u-xs); color: var(--tinta-tenue); }

  .res { width: 100%; border-collapse: collapse; font-size: var(--u-sm); }
  .res th {
    text-align: left;
    padding: 7px 14px;
    border-block: 1px solid var(--linea-tenue);
    font-size: var(--u-xs);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--tinta-tenue);
    background: var(--panel);
  }
  .res td { padding: 7px 14px; border-bottom: 1px solid var(--linea-tenue); }
  .res tbody tr:last-child td { border-bottom: 0; }
  .res__dato { font-weight: 700; }
  /* Fuera de rango: color y flecha. En una captura en blanco y negro el
     color solo no dice nada. */
  .res tr[data-fuera] .res__dato { color: var(--rojo); }
  .res tr[data-fuera] .res__dato::after { content: ' ▲'; font-size: 0.75em; }
  .res tr[data-fuera='bajo'] .res__dato::after { content: ' ▼'; }

  .orden__nada { margin: 0; padding: 12px 14px; font-size: var(--u-sm); color: var(--tinta-tenue); }
  .orden__pie { margin: 0; padding: 10px 14px; border-top: 1px solid var(--linea-tenue); font-size: var(--u-xs); }
  .orden__pie a { color: var(--azul); font-weight: 600; }

  .codigo {
    margin-left: 7px;
    padding: 2px 8px;
    border-radius: 999px;
    background: var(--azul-tenue);
    color: var(--azul);
    font-size: var(--u-xs);
    font-weight: 700;
  }

  .pedidos { list-style: none; margin: 0; padding: 0; display: grid; gap: 1px; }
  .pedidos li {
    padding: 9px 0;
    border-bottom: 1px solid var(--linea-tenue);
    font-size: var(--u-sm);
  }
  .pedidos li:last-child { border-bottom: 0; }

  /* La tabla se desplaza dentro de su caja: a 390 px tres columnas de texto
     no caben, y arrastrar la página entera era peor. */
  .tablon { overflow-x: auto; }
  .res { width: 100%; border-collapse: collapse; min-width: 380px; }
  .res th {
    text-align: left;
    padding: 0 10px 8px 0;
    font-size: var(--u-xs);
    letter-spacing: 0.03em;
    text-transform: uppercase;
    color: var(--tinta-tenue);
    border-bottom: 1px solid var(--linea);
    white-space: nowrap;
  }
  .res td { padding: 9px 10px 9px 0; border-bottom: 1px solid var(--linea-tenue); font-size: var(--u-sm); }
  .res tr:last-child td { border-bottom: 0; }
  .res__valor strong { color: var(--azul); }
  .res__valor small { color: var(--tinta-tenue); }
  .res__ref { color: var(--tinta-tenue); }

  .cab__persona { color: inherit; text-decoration: none; }
  .cab__persona:hover,
  .cab__persona:focus-visible { color: var(--azul); text-decoration: underline; }

  .miga { font-size: var(--u-sm); color: var(--tinta-tenue); margin-bottom: 14px; }
  .miga a { color: var(--tinta-suave); text-decoration: none; }
  .miga a:hover { color: var(--azul); text-decoration: underline; }
  .miga span { margin-inline: 5px; }

  .cab { display: flex; flex-wrap: wrap; gap: 14px; align-items: flex-start; justify-content: space-between; }
  .cab__linea { display: flex; flex-wrap: wrap; align-items: center; gap: 11px; }
  .cab__meta { margin-top: 7px; font-size: var(--u-sm); color: var(--tinta-tenue); }
  .cab__meta strong { color: var(--tinta-suave); }

  .chapa {
    font-size: var(--u-xs);
    font-weight: 700;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    padding: 4px 10px;
    border-radius: 999px;
  }
  .chapa--borrador { background: #fdf0d9; color: #7a5200; }
  .chapa--cerrada  { background: #e4f2ea; color: #15663f; }
  .chapa--anulada  { background: #fdeced; color: #8f1017; }

  .anulada { margin-top: 16px; }

  .col { display: grid; grid-template-columns: minmax(0, 1fr); gap: 14px; margin-top: 20px; }

  /* El índice queda pegado debajo de la barra mientras se baja por la
     ficha. En el teléfono la barra no es fija, así que va arriba del todo. */
  .indice {
    position: sticky; top: var(--alto-barra, 0px); z-index: 20;
    display: flex; flex-wrap: wrap; gap: 6px; margin-top: 16px; padding: 8px 0;
    background: var(--bruma);
  }
  @media (max-width: 560px) { .indice { top: 0; } }
  .indice a {
    display: inline-flex; align-items: center; gap: 6px; min-height: 44px; padding: 0 14px;
    border: 1px solid var(--linea); border-radius: 999px; background: var(--papel);
    color: var(--tinta-suave); text-decoration: none; font-size: var(--u-sm);
  }
  .indice a:hover { color: var(--tinta); border-color: var(--tinta-tenue); }
