---
import Sistema from '../../../layouts/Sistema.astro';
import Icono from '../../../components/Icono.astro';
import { historia } from '../../../sistema/historia';
import { laboratorio, type Resultado } from '../../../sistema/laboratorio';
import { bd, esquema } from '../../../sistema/lib/base';
import { anotar, esIdentificador } from '../../../sistema/lib/atenciones';
import { dinero, frasePagador, montoRenglon, renglonesDe, resumir } from '../../../sistema/lib/cobro';
import { eq, desc, and, ne } from 'drizzle-orm';
import { exigir } from '../../../sistema/lib/guardia';
import {
  puede, puedeBorrarBorrador, puedeCargarResultados, puedeEditarAtencion, puedeEditarOrden,
} from '../../../sistema/lib/permisos';
import { examenesPedidos, ordenesDe } from '../../../sistema/lib/laboratorio';
import { comoSeLee } from '../../../sistema/lib/documento';

export const prerender = false;

/* La puerta se abre con 'ver_historia' o con 'ver_laboratorio', y después
   se comprueba contra lo que de verdad se abrió: así el bioanalista puede
   mirar la indicación del médico cuando el resultado le llama la atención,
   y el que solo tiene laboratorio no entra a una consulta. */
const usuario = Astro.locals.usuario;
if (!usuario) return Astro.redirect('/sistema/entrar');

const { id } = Astro.params;

/* Un id que no tiene forma de uuid hace que Postgres rechace el cast y la
   pantalla termina en error de servidor. Un enlace viejo o mal copiado se
   contesta como lo que es: un caso que no está. */
if (!id || !esIdentificador(id)) return Astro.redirect('/sistema');

const [caso] = await bd
  .select({
    id: esquema.atencion.id,
    numero: esquema.atencion.numero,
    estado: esquema.atencion.estado,
    tipo: esquema.atencion.tipo,
    origenId: esquema.atencion.origenId,
    resultados: esquema.atencion.resultados,
    resultadosEn: esquema.atencion.resultadosEn,
    fecha: esquema.atencion.fecha,
    aseguradora: esquema.atencion.aseguradora,
    poliza: esquema.atencion.poliza,
    casoNumero: esquema.atencion.casoNumero,
    datos: esquema.atencion.datos,
    creada: esquema.atencion.creada,
    anuladaMotivo: esquema.atencion.anuladaMotivo,
    pacienteId: esquema.paciente.id,
    paciente: esquema.paciente.nombre,
    cedula: esquema.paciente.cedula,
    tipoDoc: esquema.paciente.tipoDoc,
    telefono: esquema.paciente.telefono,
    medicoId: esquema.atencion.medicoId,
    medico: esquema.user.name,
    colegiatura: esquema.user.colegiatura,
  })
  .from(esquema.atencion)
  .innerJoin(esquema.paciente, eq(esquema.paciente.id, esquema.atencion.pacienteId))
  .innerJoin(esquema.user, eq(esquema.user.id, esquema.atencion.medicoId))
  .where(eq(esquema.atencion.id, id))
  .limit(1);

if (!caso) return Astro.redirect('/sistema');

const esLab = caso.tipo === 'laboratorio';
const corte = exigir(Astro, esLab ? 'ver_laboratorio' : 'ver_historia');
if (corte) return corte;

await anotar(usuario.id, 'vio', caso.id);

const renglones = await renglonesDe(caso.id);

/* Los dos lados del hilo con el laboratorio: si esto es una consulta, las
   órdenes que salieron de ella; si es una orden, de qué consulta salió.
   Ver 009-roles.sql. */
const ordenes = esLab ? [] : await ordenesDe(caso.id);
const pedidos = esLab ? await examenesPedidos(caso.id) : [];
const resultados = (caso.resultados ?? []) as Resultado[];

const [origenCrudo] = caso.origenId
  ? await bd
      .select({
        id: esquema.atencion.id,
        numero: esquema.atencion.numero,
        fecha: esquema.atencion.fecha,
        datos: esquema.atencion.datos,
      })
      .from(esquema.atencion)
      .where(eq(esquema.atencion.id, caso.origenId))
      .limit(1)
  : [];

/* El cast va acá y no en el template, igual que con las previas: un
   genérico dentro del JSX de Astro se parsea como etiqueta. */
const consultaOrigen = origenCrudo
  ? {
      id: origenCrudo.id,
      numero: origenCrudo.numero,
      fecha: origenCrudo.fecha,
      idx: (origenCrudo.datos as Record<string, string> | null)?.idx ?? 'Sin diagnóstico',
    }
  : null;

const previasCrudas = await bd
  .select({
    id: esquema.atencion.id,
    numero: esquema.atencion.numero,
    fecha: esquema.atencion.fecha,
    tipo: esquema.atencion.tipo,
    datos: esquema.atencion.datos,
  })
  .from(esquema.atencion)
  .where(and(eq(esquema.atencion.pacienteId, caso.pacienteId), ne(esquema.atencion.id, caso.id)))
  .orderBy(desc(esquema.atencion.fecha))
  .limit(6);

/* El cast va acá y no en el template: un genérico dentro del JSX se parsea
   como etiqueta y rompe la compilación. */
const anteriores = previasCrudas.map((a) => ({
  id: a.id,
  numero: a.numero,
  fecha: a.fecha,
  /* Una orden de laboratorio no tiene diagnóstico: decir "sin diagnóstico"
     hacía parecer que al médico se le olvidó escribirlo. */
  idx: a.tipo === 'laboratorio'
    ? 'Laboratorio'
    : (a.datos as Record<string, string> | null)?.idx ?? 'Sin diagnóstico',
}));

const datos = (caso.datos ?? {}) as Record<string, string>;

/* Una cuenta por moneda, como en la pantalla de cobro. Dólares y bolívares
   no se suman: el número que saldría de mezclarlos no se le puede pasar a
   nadie. El desglose por pagador aparece cuando hay más de uno, que es el
   caso que la metáfora de la bodega describe. */
const cuentas = resumir(renglones);

const fechaLarga = (f: string) =>
  new Date(`${f}T12:00:00`).toLocaleDateString('es-VE', { day: 'numeric', month: 'long', year: 'numeric' });

/* Solo se muestran las secciones que tienen algo escrito: una historia de
   consulta simple no debe verse como un formulario medio vacío. */
const conContenido = (esLab ? laboratorio : historia)
  .map((s) => ({ ...s, campos: s.campos.filter((c) => datos[c.clave]) }))
  .filter((s) => s.campos.length > 0);

/* Una orden de laboratorio en borrador no es una historia a medio escribir:
   es una muestra esperando resultados, y así se dice. */
const etiqueta = esLab
  ? {
      borrador: { texto: 'Esperando resultados', clase: 'borrador' },
      cerrada: { texto: 'Entregada', clase: 'cerrada' },
      anulada: { texto: 'Anulada', clase: 'anulada' },
    }[caso.estado]
  : {
      borrador: { texto: 'Borrador', clase: 'borrador' },
      cerrada: { texto: 'Cerrada', clase: 'cerrada' },
      anulada: { texto: 'Anulada', clase: 'anulada' },
    }[caso.estado];

const comoSeLlama = esLab ? 'Orden' : 'Atención';
---

<Sistema titulo={`${comoSeLlama} ${caso.numero}`}>
  <nav class="miga">
    {esLab
      ? <><a href="/sistema/laboratorio">Laboratorio</a> <span>/</span> Orden {caso.numero}</>
      : <><a href="/sistema">Casos</a> <span>/</span> Atención {caso.numero}</>}
  </nav>

  <header class="cab">
    <div>
      <div class="cab__linea">
        {/* El nombre lleva a la ficha de la persona: desde una atención se
            llega a sus otras atenciones, sus antecedentes y sus alergias.
            Si el rol no puede ver el registro, queda como texto y ya. */}
        <h1>
          {puede(usuario.rol as string, 'ver_pacientes') ? (
            <a class="cab__persona" href={`/sistema/pacientes/${caso.pacienteId}`}>
              {caso.paciente}
            </a>
          ) : (
            caso.paciente
          )}
        </h1>
        <span class:list={['chapa', `chapa--${etiqueta.clase}`]}>{etiqueta.texto}</span>
      </div>
      <p class="cab__meta">
        {comoSeLlama} <strong class="cifra">N° {caso.numero}</strong> ·
        {fechaLarga(caso.fecha)} ·
        {comoSeLee(caso.tipoDoc, caso.cedula)} ·
        {esLab ? 'registró' : 'atendió'} {caso.medico}{caso.colegiatura && ` (${caso.colegiatura})`}
      </p>
    </div>
    <div class="cab__acciones">
      {puedeCargarResultados(usuario, caso) && (
        <a class="sis-boton sis-boton--primario" href={`/sistema/atencion/${caso.id}/resultados`}>
          <Icono nombre="laboratorio" tam={18} />
          Cargar resultados
        </a>
      )}
      {(esLab ? puedeEditarOrden(usuario, caso) : puedeEditarAtencion(usuario, caso)) && (
        <a class:list={['sis-boton', esLab ? 'sis-boton--suave' : 'sis-boton--primario']}
           href={`/sistema/atencion/${caso.id}/editar`}>
          <Icono nombre="flecha" tam={18} />
          {esLab ? 'Corregir la orden' : 'Continuar la atención'}
        </a>
      )}
      {/* Pedir exámenes desde la consulta: la orden queda colgada de acá y
          el resultado vuelve a esta misma pantalla. */}
      {!esLab && puede(usuario.rol as string, 'registrar_laboratorio') && (
        <a class="sis-boton sis-boton--suave"
           href={`/sistema/atencion/nueva?tipo=laboratorio&cedula=${encodeURIComponent(caso.cedula)}&doc=${caso.tipoDoc}&origen=${caso.id}`}>
          <Icono nombre="laboratorio" tam={18} />
          Pedir exámenes
        </a>
      )}
      {puede(usuario.rol as string, 'cargar_cobro') && (
        <a class="sis-boton sis-boton--suave" href={`/sistema/atencion/${caso.id}/cobro`}>
          <Icono nombre="mas" tam={18} />
          Cargar cobro
        </a>
      )}
      {caso.estado === 'cerrada' && puede(usuario.rol as string, 'anular_atencion') && (
        <a class="sis-boton sis-boton--suave anular" href={`/sistema/atencion/${caso.id}/anular`}>
          Anular
        </a>
      )}
      {/* Un borrador se borra; lo cerrado se anula con motivo. Son dos
          cosas distintas y nunca aparecen las dos a la vez. */}
      {puedeBorrarBorrador(usuario, caso) && (
        <a class="sis-boton sis-boton--suave anular" href={`/sistema/atencion/${caso.id}/borrar`}>
          Borrar
        </a>
      )}
      <a class="sis-boton sis-boton--azul" href={`/sistema/atencion/${caso.id}/documento`} target="_blank">
        <Icono nombre="recibo" tam={18} />
        Documento
      </a>
      {puede(usuario.rol as string, 'enviar_documento') && (
        <a class="sis-boton sis-boton--suave" href={`/sistema/atencion/${caso.id}/enviar`}>
          <Icono nombre="correo" tam={18} />
          Enviar al paciente
        </a>
      )}
    </div>
  </header>

  {caso.estado === 'anulada' && caso.anuladaMotivo && (
    <p class="sis-error anulada"><Icono nombre="escudo" tam={18} />Anulada: {caso.anuladaMotivo}</p>
  )}

  <div class="col">
    <div class="col__principal">
      {esLab && pedidos.length > 0 && (
        <section class="ficha">
          <h2>Exámenes pedidos</h2>
          <ul class="pedidos">
            {pedidos.map((p) => <li>{p.nombre}</li>)}
          </ul>
        </section>
      )}

      {esLab && (
        <section class="ficha">
          <h2>Resultados</h2>
          {resultados.length === 0 ? (
            <p class="lado__vacio">
              Todavía no se cargó ningún resultado.
              {puedeCargarResultados(usuario, caso) && (
                <> <a href={`/sistema/atencion/${caso.id}/resultados`}>Cargarlos</a>.</>
              )}
            </p>
          ) : (
            <div class="tablon">
              <table class="res">
                <thead>
                  <tr>
                    <th scope="col">Examen</th>
                    <th scope="col">Resultado</th>
                    <th scope="col">Referencia</th>
                  </tr>
                </thead>
                <tbody>
                  {resultados.map((r) => (
                    <tr>
                      <td>{r.examen}</td>
                      <td class="res__valor">
                        <strong class="cifra">{r.valor || '—'}</strong>
                        {r.unidad && <small> {r.unidad}</small>}
                      </td>
                      <td class="res__ref">{r.referencia || '—'}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          )}
        </section>
      )}

      {conContenido.map((s) => (
        <section class="ficha">
          <h2>{s.titulo}</h2>
          <dl>
            {s.campos.map((c) => (
              <div class="ficha__fila">
                <dt>{c.rotulo}</dt>
                <dd>
                  {datos[c.clave]}
                  {/* El código CIE-10, cuando el diagnóstico se eligió del
                      catálogo. Escrito a mano va el texto solo. */}
                  {c.clave === 'idx' && datos.idx_codigo && (
                    <span class="codigo cifra">{datos.idx_codigo}</span>
                  )}
                  {c.unidad && <small> {c.unidad}</small>}
                </dd>
              </div>
            ))}
          </dl>
        </section>
      ))}
    </div>

    <aside class="col__lado">
      <section class="ficha">
        <h2>Cobro</h2>
        {cuentas.length === 0 ? (
          <p class="lado__vacio">Todavía no se cargó nada que cobrar.</p>
        ) : (
          cuentas.map((c) => (
            <ul class="renglones">
              {renglones.filter((r) => r.moneda === c.moneda).map((r) => (
                <li>
                  <span>
                    <strong>{r.descripcion}</strong>
                    <small>{frasePagador(r.paga)}</small>
                  </span>
                  <em class="cifra">{dinero(montoRenglon(r.cantidad, r.precio))}</em>
                </li>
              ))}
              <li class="renglones__total">
                <span><strong>Total {c.moneda}</strong></span>
                <em class="cifra">{dinero(c.total)}</em>
              </li>
              {c.pagadores.length > 1 && c.pagadores.map((p) => (
                <li class="renglones__parte">
                  <span>{p.rotulo}</span>
                  <em class="cifra">{dinero(p.monto)}</em>
                </li>
              ))}
            </ul>
          ))
        )}
        <p class="lado__quien">
          {caso.aseguradora
            ? <>El caso lo cubre <strong>{caso.aseguradora}</strong>{caso.poliza && <> · póliza {caso.poliza}</>}. Cada renglón dice quién lo paga.</>
            : <>Nadie cubre el caso: lo que se cargue lo paga el paciente.</>}
        </p>
      </section>

      {/* El hilo con el laboratorio, de los dos lados. */}
      {!esLab && ordenes.length > 0 && (
        <section class="ficha">
          <h2>Laboratorio</h2>
          <ul class="previas">
            {ordenes.map((o) => (
              <li>
                <a href={`/sistema/atencion/${o.id}`}>
                  <strong class="cifra">Orden N° {o.numero}</strong>
                  <span>
                    {o.estado === 'cerrada'
                      ? `${(o.resultados ?? []).filter((r) => r.valor).length} resultados`
                      : o.estado === 'anulada' ? 'Anulada' : 'Esperando resultados'}
                  </span>
                  <em>{fechaLarga(o.fecha)}</em>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )}

      {esLab && consultaOrigen && (
        <section class="ficha">
          <h2>De qué consulta salió</h2>
          <ul class="previas">
            <li>
              <a href={`/sistema/atencion/${consultaOrigen.id}`}>
                <strong class="cifra">N° {consultaOrigen.numero}</strong>
                <span>{consultaOrigen.idx}</span>
                <em>{fechaLarga(consultaOrigen.fecha)}</em>
              </a>
            </li>
          </ul>
        </section>
      )}

      {anteriores.length > 0 && (
        <section class="ficha">
          <h2>{esLab ? 'Otras atenciones' : 'Atenciones anteriores'}</h2>
          <ul class="previas">
            {anteriores.map((a) => (
              <li>
                <a href={`/sistema/atencion/${a.id}`}>
                  <strong class="cifra">N° {a.numero}</strong>
                  <span>{a.idx}</span>
                  <em>{fechaLarga(a.fecha)}</em>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )}
    </aside>
  </div>
</Sistema>

<style>
  .codigo {
    margin-left: 7px;
    padding: 2px 8px;
    border-radius: 999px;
    background: var(--azul-tenue);
    color: var(--azul);
    font-size: var(--u-xs);
    font-weight: 700;
  }

  .pedidos { list-style: none; margin: 0; padding: 0; display: grid; gap: 1px; }
  .pedidos li {
    padding: 9px 0;
    border-bottom: 1px solid var(--linea-tenue);
    font-size: var(--u-sm);
  }
  .pedidos li:last-child { border-bottom: 0; }

  /* La tabla se desplaza dentro de su caja: a 390 px tres columnas de texto
     no caben, y arrastrar la página entera era peor. */
  .tablon { overflow-x: auto; }
  .res { width: 100%; border-collapse: collapse; min-width: 380px; }
  .res th {
    text-align: left;
    padding: 0 10px 8px 0;
    font-size: var(--u-xs);
    letter-spacing: 0.03em;
    text-transform: uppercase;
    color: var(--tinta-tenue);
    border-bottom: 1px solid var(--linea);
    white-space: nowrap;
  }
  .res td { padding: 9px 10px 9px 0; border-bottom: 1px solid var(--linea-tenue); font-size: var(--u-sm); }
  .res tr:last-child td { border-bottom: 0; }
  .res__valor strong { color: var(--azul); }
  .res__valor small { color: var(--tinta-tenue); }
  .res__ref { color: var(--tinta-tenue); }

  .cab__persona { color: inherit; text-decoration: none; }
  .cab__persona:hover,
  .cab__persona:focus-visible { color: var(--azul); text-decoration: underline; }

  .miga { font-size: var(--u-sm); color: var(--tinta-tenue); margin-bottom: 14px; }
  .miga a { color: var(--tinta-suave); text-decoration: none; }
  .miga a:hover { color: var(--azul); text-decoration: underline; }
  .miga span { margin-inline: 5px; }

  .cab { display: flex; flex-wrap: wrap; gap: 14px; align-items: flex-start; justify-content: space-between; }
  .cab__linea { display: flex; flex-wrap: wrap; align-items: center; gap: 11px; }
  .cab__meta { margin-top: 7px; font-size: var(--u-sm); color: var(--tinta-tenue); }
  .cab__meta strong { color: var(--tinta-suave); }

  .chapa {
    font-size: var(--u-xs);
    font-weight: 700;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    padding: 4px 10px;
    border-radius: 999px;
  }
  .chapa--borrador { background: #fdf0d9; color: #7a5200; }
  .chapa--cerrada  { background: #e4f2ea; color: #15663f; }
  .chapa--anulada  { background: #fdeced; color: #8f1017; }

  .anulada { margin-top: 16px; }

  .col { display: grid; grid-template-columns: minmax(0, 1fr); gap: 14px; margin-top: 20px; }
  @media (min-width: 1000px) { .col { grid-template-columns: minmax(0, 1fr) 340px; align-items: start; } }
  /* La columna declarada evita que un hijo ancho —una tabla con su propio
     min-width— estire la rejilla más allá del teléfono. */
  .col__principal, .col__lado {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 14px;
    align-content: start;
    min-width: 0;
  }

  .ficha { background: var(--papel); border: 1px solid var(--linea); border-radius: 10px; padding: 18px; }
  .ficha h2 { font-size: var(--u-md); margin-bottom: 12px; }
  .ficha dl { margin: 0; display: grid; gap: 1px; }
  .ficha__fila { display: grid; grid-template-columns: minmax(0, 1fr); gap: 2px; padding: 9px 0; border-top: 1px solid var(--linea-tenue); }
  .ficha__fila:first-child { border-top: 0; padding-top: 0; }
  @media (min-width: 620px) { .ficha__fila { grid-template-columns: 210px minmax(0, 1fr); gap: 16px; align-items: baseline; } }
  .ficha dt { font-size: var(--u-sm); color: var(--tinta-tenue); }
  .ficha dd { margin: 0; color: var(--tinta); white-space: pre-wrap; }
  .ficha dd small { color: var(--tinta-tenue); }

  .lado__vacio { font-size: var(--u-sm); color: var(--tinta-tenue); }
  .lado__quien { margin-top: 14px; padding-top: 13px; border-top: 1px solid var(--linea-tenue); font-size: var(--u-sm); color: var(--tinta-suave); }

  .renglones { list-style: none; margin: 0; padding: 0; display: grid; gap: 1px; }
  .renglones li { display: flex; align-items: baseline; justify-content: space-between; gap: 14px; padding: 9px 0; border-top: 1px solid var(--linea-tenue); }
  .renglones li:first-child { border-top: 0; padding-top: 0; }
  .renglones span { display: flex; flex-direction: column; min-width: 0; }
  .renglones strong { font-size: var(--u-sm); font-weight: 600; }
  .renglones small { font-size: var(--u-xs); color: var(--tinta-tenue); }
  .renglones em { font-style: normal; font-weight: 600; color: var(--azul); flex: none; }
  .renglones + .renglones { margin-top: 16px; }
  .renglones__total { border-top: 2px solid var(--linea) !important; margin-top: 5px; padding-top: 11px !important; }
  .renglones__total em { font-size: var(--u-md); }
  /* El reparto por pagador: es lectura de apoyo del total, no otro renglón. */
  .renglones__parte span, .renglones__parte em { font-size: var(--u-sm); color: var(--tinta-tenue); }
  .renglones__parte em { font-weight: 600; }

  .previas { list-style: none; margin: 0; padding: 0; display: grid; gap: 1px; }
  .previas a {
    display: grid;
    gap: 2px;
    padding: 10px 0;
