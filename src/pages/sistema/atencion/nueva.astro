---
/**
 * Nueva atención.
 *
 * Primero la cédula, siempre. Si el paciente ya existe no tiene sentido
 * volver a preguntar su nombre, su edad ni su dirección: el sistema los
 * tiene y el médico los confirma de un vistazo.
 *
 * La pantalla tiene dos momentos:
 *   · sin cédula en la dirección, se pregunta solo eso;
 *   · con cédula, se abre el formulario con lo que ya se sabe cargado.
 *
 * Hay una salida para cuando no hay cédula, porque pasa: un extranjero con
 * pasaporte, un recién nacido, alguien que llega inconsciente sin nada
 * encima. Está cerrada a propósito —hay que abrir «El paciente no tiene
 * cédula»— para que en una recepción apurada no se use por comodidad y el
 * registro no se llene de personas imposibles de cruzar con su seguro.
 */
import Sistema from '../../../layouts/Sistema.astro';
import Pasos from '../../../components/sistema/Pasos.astro';
import { historia } from '../../../sistema/historia';
import { laboratorio } from '../../../sistema/laboratorio';
import Icono from '../../../components/Icono.astro';
import { exigir } from '../../../sistema/lib/guardia';
import { bd, esquema } from '../../../sistema/lib/base';
import {
  limpiarDatos, faltantes, pacienteDe, anotar, hoyEnVenezuela, ahoraEnVenezuela,
  guardarBorrador, esIdentificador, soloDigitos,
} from '../../../sistema/lib/atenciones';
import {
  ROTULO, PISTA, TIPOS, alcanza, comoSeLee, esTipo, formatearInterno,
  llaveDe, numeroInterno, type TipoDocumento,
} from '../../../sistema/lib/documento';
import { asegurarPin } from '../../../sistema/lib/verificacion';
import { eq, desc, and, ne, sql } from 'drizzle-orm';

export const prerender = false;

const corte = exigir(Astro, 'escribir_historia');
if (corte) return corte;

const usuario = Astro.locals.usuario!;
let error = '';

/* Qué se le va a hacer: la historia completa o una toma de laboratorio.
   Se pregunta DESPUÉS de la cédula y no antes, porque lo primero es saber a
   quién se atiende: con eso el sistema ya puede rellenar lo que sabe, y la
   pregunta del tipo llega con el paciente en pantalla. */
const crudoClase = Astro.url.searchParams.get('tipo');
const clase = crudoClase === 'laboratorio' ? 'laboratorio' : crudoClase === 'general' ? 'general' : null;
const esLaboratorio = clase === 'laboratorio';
const modelo = esLaboratorio ? laboratorio : historia;

const crudoTipo = Astro.url.searchParams.get('doc');
const tipoDoc: TipoDocumento = esTipo(crudoTipo) ? crudoTipo : 'cedula';
let cedulaPedida = (Astro.url.searchParams.get('cedula') ?? '').trim();

/* Al que no trae documento el sistema le pone uno: SD-000001, SD-000002…
   El número sale de una secuencia de la base y no de un contador de acá,
   porque dos emergencias a la vez sacarían el mismo.

   Se reserva y se redirige con él puesto en la dirección. Si se dejara solo
   en la pantalla, recargar quemaría un número nuevo cada vez; así la
   segunda carga reusa el que ya salió. Que la secuencia salte algún número
   cuando alguien abandona la pantalla es lo normal en un correlativo. */
if (tipoDoc === 'interno' && !numeroInterno(cedulaPedida)) {
  const [fila] = await bd.execute<{ n: string }>(
    sql`SELECT nextval('paciente_interno_seq') AS n`,
  );
  const asignado = formatearInterno(Number(fila.n));
  /* Se conserva lo que ya venía en la dirección. Antes se armaba una nueva
     con doc y cedula nada más, y si ya se había elegido el tipo de atención
     se perdía en el camino: volvía a preguntar algo ya contestado. */
  const destino = new URL(Astro.url);
  destino.searchParams.set('cedula', asignado);
  return Astro.redirect(destino.pathname + destino.search);
}

const llave = llaveDe(tipoDoc, cedulaPedida);

/* ----------------------------------------------------------------
   Momento 1: todavía no sabemos a quién se atiende.
   ---------------------------------------------------------------- */
let conocido: {
  nombre: string; cedula: string; tipoDoc: TipoDocumento; telefono: string;
  sexo: string; edad: string; direccion: string; ciudad: string; referencia: string;
  ultima: { numero: number; fecha: string; idx: string } | null;
} | null = null;

let antecedentesPrevios: Record<string, string> = {};

if (alcanza(tipoDoc, cedulaPedida)) {
  const [paciente] = await bd
    .select()
    .from(esquema.paciente)
    .where(eq(esquema.paciente.cedulaBusca, llave))
    .limit(1);

  if (paciente) {
    const [ultima] = await bd
      .select({
        numero: esquema.atencion.numero,
        fecha: esquema.atencion.fecha,
        datos: esquema.atencion.datos,
      })
      .from(esquema.atencion)
      .where(and(
        eq(esquema.atencion.pacienteId, paciente.id),
        ne(esquema.atencion.estado, 'anulada'),
      ))
      .orderBy(desc(esquema.atencion.fecha), desc(esquema.atencion.numero))
      .limit(1);

    const d = (ultima?.datos ?? {}) as Record<string, string>;

    /* La edad se recalcula si pasó más de un año: copiarla tal cual deja
       niños de 8 que ya tienen 11. */
    let edad = d.edad ?? '';
    if (edad && ultima?.fecha) {
      const anios = Math.floor(
        (Date.now() - new Date(`${ultima.fecha}T12:00:00`).getTime()) / 31_557_600_000,
      );
      if (anios >= 1) edad = String(Number(edad) + anios);
    }

    antecedentesPrevios = {
      alergias: d.alergias ?? '',
      medicacion: d.medicacion ?? '',
      antecedentes_medicos: d.antecedentes_medicos ?? '',
      quirurgicos: d.quirurgicos ?? '',
      tabaco: d.tabaco ?? '',
      alcohol: d.alcohol ?? '',
    };

    conocido = {
      nombre: paciente.nombre,
      cedula: paciente.cedula,
      tipoDoc: paciente.tipoDoc,
      telefono: paciente.telefono ?? '',
      sexo: paciente.sexo ?? '',
      edad,
      direccion: d.direccion ?? '',
      ciudad: d.ciudad ?? '',
      referencia: d.referencia ?? '',
      ultima: ultima ? { numero: ultima.numero, fecha: ultima.fecha, idx: d.idx ?? '' } : null,
    };
  }
}

const hayPaciente = alcanza(tipoDoc, cedulaPedida);
/* Con paciente pero sin elegir todavía, la pantalla del medio pregunta qué
   se le va a hacer. */
const elegirClase = hayPaciente && !clase;
const abrirFormulario = hayPaciente && Boolean(clase);

/* ----------------------------------------------------------------
   Guardar.
   ---------------------------------------------------------------- */
let datos: Record<string, string> = {
  fecha: hoyEnVenezuela(),
  hora_inicio: ahoraEnVenezuela(),
  medico: usuario.name,
  ...(cedulaPedida ? { cedula: conocido?.cedula ?? cedulaPedida } : {}),
  /* Lo necesita pacienteDe para saber con qué llave buscar, y queda guardado
     en la atención como el documento con el que se identificó esa vez. */
  tipo_doc: conocido?.tipoDoc ?? tipoDoc,
  ...(conocido
    ? {
        nombre: conocido.nombre,
        telefono: conocido.telefono,
        sexo: conocido.sexo,
        edad: conocido.edad,
        direccion: conocido.direccion,
        ciudad: conocido.ciudad,
        referencia: conocido.referencia,
      }
    : {}),
};

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const cerrar = form.get('accion') === 'cerrar';
  datos = { ...datos, ...limpiarDatos(form) };

  /* El guardado automático pudo haber creado ya la atención mientras el
     médico escribía. Si llega su id, se termina ESA y no se crea otra. */
  const yaCreada = String(form.get('id') ?? '').trim();
  const faltan = cerrar ? faltantes(datos) : [];

  if (cerrar && faltan.length) {
    error = `Falta completar: ${faltan.map((c) => c.rotulo.toLowerCase()).join(', ')}.`;
  } else if (!datos.cedula || !datos.nombre) {
    error = 'Para guardar hace falta al menos el nombre y la cédula del paciente.';
  } else {
    try {
      if (yaCreada && esIdentificador(yaCreada)) {
        const guardada = await guardarBorrador(yaCreada, datos, cerrar, usuario.id);
        if (!guardada) {
          error = 'La atención cambió de estado mientras escribía. Ábrala desde los borradores.';
        } else {
          await anotar(usuario.id, cerrar ? 'cerro' : 'edito', guardada.id, { numero: guardada.numero });
          return Astro.redirect(`/sistema/atencion/${guardada.id}`);
        }
      } else {
        const paciente = await pacienteDe(datos);
        const [creada] = await bd
          .insert(esquema.atencion)
          .values({
            pacienteId: paciente.id,
            medicoId: usuario.id,
            estado: cerrar ? 'cerrada' : 'borrador',
            tipo: esLaboratorio ? 'laboratorio' : 'general',
            fecha: datos.fecha,
            aseguradora: datos.aseguradora ?? null,
            poliza: datos.poliza ?? null,
            casoNumero: datos.caso_numero ?? null,
            datos,
            cerrada: cerrar ? new Date() : null,
          })
          .returning({ id: esquema.atencion.id, numero: esquema.atencion.numero });

        // Cerrada de una: el documento nace acá y necesita su PIN.
        if (cerrar) await asegurarPin(creada.id);
        await anotar(usuario.id, cerrar ? 'cerro' : 'creo', creada.id, { numero: creada.numero });
        return Astro.redirect(`/sistema/atencion/${creada.id}`);
      }
    } catch (e) {
      error = e instanceof Error ? e.message : 'No se pudo guardar la atención.';
    }
  }
}

const fechaLarga = (f: string) =>
  new Date(`${f}T12:00:00`).toLocaleDateString('es-VE', { day: 'numeric', month: 'long', year: 'numeric' });
---

<Sistema titulo="Nueva atención">
  {elegirClase ? (
    /* La pantalla del medio: ya se sabe a quién, falta qué. Dos botones
       grandes y nada más; cualquier cosa que se le agregue acá es un paso
       entre el paciente y el formulario, y esto se hace con el paciente
       enfrente. */
    <div class="quien">
      <h1>¿Qué se le va a hacer?</h1>
      <p class="quien__nota">
        {conocido ? (
          <><strong>{conocido.nombre}</strong> · {comoSeLee(conocido.tipoDoc, conocido.cedula)}</>
        ) : (
          <>Paciente nuevo, {comoSeLee(tipoDoc, cedulaPedida)}.</>
        )}
      </p>

      <div class="clases">
        <a class="clase" href={`${Astro.url.pathname}${Astro.url.search}&tipo=general`}>
          <Icono nombre="estetoscopio" tam={22} />
          <strong>Atención general</strong>
          <span>Consulta, emergencia o procedimiento. Historia clínica completa.</span>
        </a>

        <a class="clase" href={`${Astro.url.pathname}${Astro.url.search}&tipo=laboratorio`}>
          <Icono nombre="laboratorio" tam={22} />
          <strong>Laboratorio</strong>
          <span>Toma de muestra y exámenes. Dos pasos.</span>
        </a>
      </div>

      <p class="quien__salida">
        <a href="/sistema/atencion/nueva">No es este paciente</a>
      </p>
    </div>
  ) : !abrirFormulario ? (
    <div class="quien">
      <h1>¿A quién va a atender?</h1>
      <p class="quien__nota">
        Empiece por la cédula. Si ya lo atendimos antes, no hace falta volver
        a escribir sus datos.
      </p>

      <form method="get" class="sis-tarjeta quien__form">
        <div class="sis-campo">
          <label for="cedula">Cédula del paciente</label>
          <input
            id="cedula" name="cedula" required autofocus autocomplete="off"
            inputmode="numeric" placeholder="V-12.345.678"
            pattern="[VvEeJjGg]?[-.\s0-9]{6,}"
          />
          <span class="pista">Con o sin puntos, con o sin letra. Da igual cómo se escriba.</span>
        </div>
        <button type="submit" class="sis-boton sis-boton--primario">
          Continuar
          <Icono nombre="flecha" tam={18} />
        </button>
      </form>

      {/* Cerrado a propósito: la cédula es el camino, esto es la salida.
          Un <details> no necesita JavaScript y deja claro que es otra cosa. */}
      <details class="otro">
        <summary>El paciente no tiene cédula</summary>

        <div class="otro__cuerpo">
          <form method="get" class="otro__forma">
            <div class="sis-campo">
              <label for="doc">¿Qué documento trae?</label>
              <select id="doc" name="doc">
                {TIPOS.filter((x) => x !== 'cedula' && x !== 'interno').map((x) => (
                  <option value={x}>{ROTULO[x]}</option>
                ))}
              </select>
            </div>
            <div class="sis-campo">
              <label for="otro-numero">Número</label>
              <input
                id="otro-numero" name="cedula" required autocomplete="off"
                placeholder="A1234567"
              />
              <span class="pista">Como viene impreso, con sus letras y números.</span>
            </div>
            <button type="submit" class="sis-boton">Continuar</button>
          </form>

          <form method="get" class="otro__nada">
            <input type="hidden" name="doc" value="interno" />
            <p>
              <strong>No trae ningún documento.</strong>
              Pasa en una emergencia. El sistema le asigna un número propio para
              poder registrar la atención ahora y reconocerlo si vuelve.
            </p>
            <button type="submit" class="sis-boton">Registrar sin documento</button>
          </form>
        </div>
      </details>

      <p class="quien__salida">
        <a href="/sistema">Volver a los casos</a>
      </p>
    </div>
  ) : (
    <form method="post" class="form">
      {/* Estos dos viajan con CADA guardado, incluido el automático, que es
          el que de hecho crea la atención. Sin ellos el autoguardado la
          creaba como atención general y con la llave de cédula aunque fuera
          un pasaporte: el tipo elegido en la puerta se perdía. */}
      <input type="hidden" name="tipo_atencion" value={esLaboratorio ? 'laboratorio' : 'general'} />
      <input type="hidden" name="tipo_doc" value={conocido?.tipoDoc ?? tipoDoc} />
      <header class="form__cab">
        <div>
          <h1>Nueva atención</h1>
          {conocido ? (
            <p class="form__nota">
              <strong>{conocido.nombre}</strong> · {comoSeLee(conocido.tipoDoc, conocido.cedula)}
              {conocido.ultima && (
                <> · última atención N° {conocido.ultima.numero} del {fechaLarga(conocido.ultima.fecha)}
                  {conocido.ultima.idx && <> por {conocido.ultima.idx.toLowerCase()}</>}</>
              )}
            </p>
          ) : (
            <p class="form__nota">
              Paciente nuevo, {comoSeLee(tipoDoc, cedulaPedida)}. Se registra con
              esta atención.
            </p>
          )}
        </div>
        <a class="sis-boton sis-boton--suave" href="/sistema/atencion/nueva">No es este paciente</a>
      </header>

      {error && (
        <p class="sis-error form__error">
          <Icono nombre="escudo" tam={18} />
          {error}
        </p>
      )}

      <Pasos
        datos={datos}
        modelo={modelo}
        pasoInicial={conocido && !esLaboratorio ? 1 : 0}
        previos={esLaboratorio ? {} : antecedentesPrevios}
        paciente={conocido?.nombre ?? ''}
        ultima={conocido?.ultima ?? null}
      />
    </form>
  )}
</Sistema>

<style>
  /* ---------- a quién se atiende ---------- */
  .quien { max-width: 520px; margin-inline: auto; padding-top: clamp(16px, 5vw, 48px); }
  .quien h1 { font-size: var(--u-2xl); }
  .quien__nota { margin-top: 8px; color: var(--tinta-suave); font-size: var(--u-sm); }
  .quien__form { margin-top: 20px; display: grid; gap: 16px; }
  .quien__form input { font-size: var(--u-lg); min-height: 54px; letter-spacing: 0.01em; }
  .quien__form .sis-boton { min-height: 48px; justify-self: start; }
  .quien__salida { margin-top: 18px; font-size: var(--u-sm); }

  .clases { display: grid; gap: 12px; }
  @media (min-width: 620px) { .clases { grid-template-columns: 1fr 1fr; } }

  .clase {
    display: grid;
    gap: 5px;
    padding: 20px;
    min-height: 44px;
    border: 1px solid var(--linea);
    border-radius: 12px;
    background: var(--papel);
    text-decoration: none;
    color: var(--tinta);
  }
  .clase:hover { border-color: var(--azul); background: var(--azul-suave, rgba(17, 22, 99, 0.05)); }
  .clase :global(svg) { color: var(--azul); }
  .clase strong { font-size: var(--u-lg); color: var(--azul); }
  .clase span { font-size: var(--u-sm); color: var(--tinta-suave); line-height: 1.45; }

  /* La salida para quien no trae cédula. Discreta y cerrada: está, pero no
     compite con el camino normal. */
  .otro { margin-top: 16px; }
  .otro > summary {
    display: flex;
    align-items: center;
    min-height: 44px;
    list-style: none;
    cursor: pointer;
    font-size: var(--u-sm);
    font-weight: 600;
    color: var(--azul);
  }
  .otro > summary::-webkit-details-marker { display: none; }
  .otro > summary::before {
    content: '+';
    display: inline-flex;
    justify-content: center;
    width: 1.2em;
    font-weight: 700;
  }
  .otro[open] > summary::before { content: '−'; }
  .otro > summary:hover { text-decoration: underline; }

  .otro__cuerpo {
    display: grid;
    gap: 14px;
    margin-top: 6px;
    padding: 16px;
    border: 1px solid var(--linea);
    border-radius: 12px;
    background: var(--papel);
  }
  .otro__forma { display: grid; gap: 12px; }
  .otro__forma select {
    min-height: 44px;
    padding: 8px 11px;
    border: 1px solid var(--linea);
    border-radius: 8px;
    background: var(--papel);
    font: inherit;
    font-family: var(--ui);
    color: var(--tinta);
  }
  .otro__nada {
    display: grid;
    gap: 10px;
    padding-top: 14px;
    border-top: 1px solid var(--linea-tenue);
    justify-items: start;
  }
  .otro__nada p { margin: 0; font-size: var(--u-sm); color: var(--tinta-suave); }
  .quien__salida a { color: var(--tinta-suave); }

  /* ---------- formulario ---------- */
  .form { padding-bottom: 0; }
  .form__cab { display: flex; flex-wrap: wrap; gap: 14px; align-items: flex-start; justify-content: space-between; }
  .form__cab h1 { font-size: var(--u-2xl); }
  .form__nota { margin-top: 6px; font-size: var(--u-sm); color: var(--tinta-tenue); max-width: 70ch; }
  .form__nota strong { color: var(--azul); }
  .form__error { margin-top: 18px; }
</style>
