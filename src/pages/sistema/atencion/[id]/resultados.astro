---
/**
 * Los resultados del laboratorio: la pantalla del bioanalista.
 *
 * Es la otra mitad de la orden. Recepción registró a quién y qué se le
 * pidió; acá «el propio licenciado va a colocar, de esos exámenes que se
 * mandó a hacer, los resultados… con los valores de referencia de esos
 * resultados, y que al cargar todo te genere para poder enviarlo».
 *
 * UNA LÍNEA POR VALOR, NO POR EXAMEN
 *
 * Una hematología completa no da un número: da hemoglobina, hematocrito,
 * leucocitos, plaquetas. Las líneas arrancan con lo que se pidió y se
 * agregan las que hagan falta; el nombre de cada línea se puede escribir,
 * porque «hematología completa» no es lo que va impreso al lado de un 13,4.
 *
 * LOS VALORES DE REFERENCIA SE ESCRIBEN
 *
 * No hay lista precargada y no la va a haber inventada: el rango depende
 * del método y del equipo de cada laboratorio. El cliente tiene su Excel
 * con todos sus valores y quedó en mandarlo; hasta entonces este campo lo
 * llena quien mide.
 *
 * EL SELLO ES HÚMEDO
 *
 * El cliente lo decidió así: «no vamos a manejar [sello digital], se
 * imprime y se usa un sello húmedo ya elaborado el informe». Por eso el
 * informe deja el espacio de la firma y no estampa ninguna imagen.
 */
import Sistema from '../../../../layouts/Sistema.astro';
import Icono from '../../../../components/Icono.astro';
import { exigir } from '../../../../sistema/lib/guardia';
import { puedeCargarResultados } from '../../../../sistema/lib/permisos';
import { anotar, atencionPara } from '../../../../sistema/lib/atenciones';
import {
  examenesPedidos, guardarResultados, leerResultados, plantillasDeExamen, sinNombre,
} from '../../../../sistema/lib/laboratorio';
import type { Resultado } from '../../../../sistema/laboratorio';
import { CALCULOS_EN_LLAVES, CALCULOS, SUMAN_CIEN } from '../../../../sistema/calculos';

export const prerender = false;

const corte = exigir(Astro, 'cargar_resultados');
if (corte) return corte;

const { id } = Astro.params;
const usuario = Astro.locals.usuario!;

const caso = await atencionPara(id!);
if (!caso) return Astro.redirect('/sistema/laboratorio');
if (caso.tipo !== 'laboratorio') return Astro.redirect(`/sistema/atencion/${caso.id}`);

const abierta = puedeCargarResultados(usuario, caso);

let error = '';
let aviso = '';
/* Lo cargado hasta ahora. Se lee de la columna y no de `datos`: son una
   lista de mediciones y `datos` es plano. */
let cargados = (caso.resultados ?? []) as Resultado[];

if (Astro.request.method === 'POST' && abierta) {
  const form = await Astro.request.formData();
  const entregar = form.get('accion') === 'entregar';
  const mandados = leerResultados(form);

  /* Entregar sin un solo valor escrito dejaría un informe en blanco con
     firma. Guardar a medias sí se puede: una corrida sale hoy y la otra
     mañana. */
  if (entregar && !mandados.some((r) => r.valor)) {
    error = 'Para dar los resultados por listos hace falta al menos un valor cargado.';
    cargados = mandados;
  } else if (entregar && sinNombre(mandados) > 0) {
    /* Un valor sin nombre se imprimiría como un número suelto al lado de
       una celda vacía. No se descarta: se devuelve y se pide nombrarlo. */
    error = sinNombre(mandados) === 1
      ? 'Hay una línea con resultado y sin decir de qué examen es.'
      : `Hay ${sinNombre(mandados)} líneas con resultado y sin decir de qué examen son.`;
    cargados = mandados;
  } else {
    const guardada = await guardarResultados(caso.id, mandados, usuario.id, entregar);
    if (!guardada) {
      error = 'Esta orden cambió de estado mientras la cargaba. Vuelva a abrirla.';
      cargados = mandados;
    } else {
      await anotar(usuario.id, entregar ? 'cerro' : 'edito', caso.id, {
        numero: guardada.numero,
        resultados: mandados.filter((r) => r.valor).length,
      });
      if (entregar) return Astro.redirect(`/sistema/atencion/${caso.id}`);
      cargados = mandados;
      aviso = 'Resultados guardados. La orden sigue abierta.';
    }
  }
} else if (Astro.request.method !== 'POST') {
  await anotar(usuario.id, 'vio', caso.id);
}

const registro = (caso.datos ?? {}) as Record<string, string>;
const pedidos = await examenesPedidos(caso.id);

/* Las plantillas del archivo del cliente: elegir una pone sus renglones con
   el analito y la unidad ya escritos. Van al navegador porque el agregado
   es inmediato —son unos 185 renglones en total, 12 KB— y pedirle al
   servidor una lista de ocho nombres sería un viaje por nada. */
const plantillas = await plantillasDeExamen();

/* Cuántos renglones vienen sin rango. Se cuenta del dato y no se escribe a
   mano: ya pasó que la pantalla dijera «92 de 188» cuando la cifra había
   cambiado, y una cifra vieja en una advertencia la vuelve mentira. */
/* Los encabezados de bloque no se cuentan: nunca van a tener rango. */
const renglones = plantillas.flatMap((p) => p.analitos).filter((a) => a.tipo !== 'titulo');
const sinRango = renglones.filter((a) => !a.referencia.trim()).length;

/**
 * Las líneas que se dibujan.
 *
 * Arrancan de lo que se pidió —el catálogo primero, después lo escrito a
 * mano en «Otros exámenes»— y se completan con lo que ya estaba cargado.
 * Un valor ya escrito no se pierde aunque después se le quite el examen a
 * la orden: borrarle a alguien una medición por destildar una casilla
 * sería mucho peor que dejar una línea de más.
 */
const nombresPedidos = [
  ...pedidos.map((p) => p.nombre),
  ...(registro.examenes ?? '').split('\n').map((t) => t.trim()).filter(Boolean),
];

const porNombre = new Map(cargados.map((r) => [r.examen, r]));

/* La unidad y el rango de cada analito, por nombre.
   
   Es el cruce que faltaba. Los renglones que vienen de una orden salen de
   los EXÁMENES PEDIDOS —el catálogo de cobro—, que solo guardan el nombre;
   la unidad y el rango viven en las plantillas. Resultado: una orden de
   hematología abría con los doce analitos y las tres columnas de la
   derecha en blanco, como si el laboratorio no tuviera rangos cargados.
   
   El catálogo se armó de las mismas plantillas, así que los nombres calzan
   uno a uno. El que no calce queda en blanco, como antes.
   
   Un analito que está en dos plantillas —la albúmina, el ácido úrico— gana
   el primero que traiga rango: son los mismos valores en las dos hojas del
   archivo, y si algún día dejan de serlo, el bioanalista lo corrige en la
   línea, que es editable. */
const deLaPlantilla = new Map<string, { unidad: string; referencia: string }>();
for (const p of plantillas) {
  for (const a of p.analitos) {
    if (a.tipo === 'titulo') continue;
    const antes = deLaPlantilla.get(a.analito);
    if (antes && antes.referencia.trim()) continue;
    deLaPlantilla.set(a.analito, { unidad: a.unidad, referencia: a.referencia });
  }
}

/* Lo ya guardado manda sobre la plantilla: si el bioanalista corrigió un
   rango para ESTE paciente, no se lo pisa. Solo se rellena lo vacío. */
const conPlantilla = (r: Resultado): Resultado => {
  const d = deLaPlantilla.get(r.examen);
  if (!d) return r;
  return {
    ...r,
    unidad: r.unidad.trim() ? r.unidad : d.unidad,
    referencia: r.referencia.trim() ? r.referencia : d.referencia,
  };
};

const lineas: Resultado[] = [
  ...nombresPedidos.map((nombre) =>
    conPlantilla(porNombre.get(nombre) ?? { examen: nombre, valor: '', unidad: '', referencia: '' }),
  ),
  // Lo cargado que no calza con ningún examen pedido: líneas agregadas a mano.
  ...cargados.filter((r) => !nombresPedidos.includes(r.examen)).map(conPlantilla),
];
if (lineas.length === 0) lineas.push({ examen: '', valor: '', unidad: '', referencia: '' });

const fechaLarga = (f: string) =>
  new Date(`${f}T12:00:00`).toLocaleDateString('es-VE', { day: 'numeric', month: 'long', year: 'numeric' });
---

<Sistema titulo={`Resultados ${caso.numero}`}>
  <nav class="miga">
    <a href="/sistema/laboratorio">Laboratorio</a> <span>/</span>
    Orden {caso.numero}
  </nav>

  {!abierta ? (
    <section class="sis-tarjeta trabada">
      <h1>Esta orden ya está entregada</h1>
      <p>
        Los resultados de la orden N° {caso.numero} de {caso.paciente} se dieron
        por listos y quedaron firmados: no se modifican. Si hay que corregir un
        valor, administración la anula y se registra una nueva.
      </p>
      <div class="trabada__acciones">
        <a class="sis-boton sis-boton--azul" href={`/sistema/atencion/${caso.id}`}>Ver la orden</a>
        <a class="sis-boton sis-boton--suave" href={`/sistema/atencion/${caso.id}/documento`}
           target="_blank" rel="noopener">Imprimir el informe</a>
        <a class="sis-boton sis-boton--suave" href="/sistema/laboratorio">Volver al laboratorio</a>
      </div>
    </section>
  ) : (
    <form method="post" class="form" id="res-form">
      <header class="form__cab">
        <div>
          <div class="form__linea">
            <h1>Resultados · orden N° <span class="cifra">{caso.numero}</span></h1>
            <span class="chapa">Abierta</span>
          </div>
          <p class="form__nota">
            <strong>{caso.paciente}</strong> · {caso.cedula}
            {registro.edad && <> · {registro.edad} años</>}
            {registro.sexo && <> · {registro.sexo.toLowerCase()}</>}
            · muestra del {fechaLarga(caso.fecha)}
            {registro.hora_muestra && <> a las {registro.hora_muestra}</>}
            {registro.ayuno === 'si' && <> · <strong>en ayunas</strong></>}
          </p>
          {registro.quien_indica && (
            <p class="form__nota">Indicados por {registro.quien_indica}.</p>
          )}
          {registro.observaciones_lab && (
            <p class="form__nota form__nota--ojo">
              <Icono nombre="escudo" tam={16} />
              {registro.observaciones_lab}
            </p>
          )}
        </div>
        <div class="form__acciones">
          {/* Imprimir desde acá y no solo desde la ficha: el bioanalista
              carga, mira cómo quedó y lo saca, sin salir de la pantalla. */}
          <a class="sis-boton sis-boton--suave" href={`/sistema/atencion/${caso.id}/documento`}
             target="_blank" rel="noopener">
            <Icono nombre="recibo" tam={18} />
            Imprimir
          </a>
          <a class="sis-boton sis-boton--suave" href={`/sistema/atencion/${caso.id}`}>Ver la orden</a>
        </div>
      </header>

      {error && <p class="sis-error form__aviso"><Icono nombre="escudo" tam={18} />{error}</p>}
      {aviso && <p class="form__aviso form__aviso--bien"><Icono nombre="escudo" tam={18} />{aviso}</p>}

      {/* Las cuentas del archivo del laboratorio. Viajan acá para que el
          campo se llene mientras se teclea, sin ir y volver al servidor. */}
      <div class="tablon" data-calculos={JSON.stringify(CALCULOS_EN_LLAVES)}
           data-suman-cien={JSON.stringify(SUMAN_CIEN)}
           data-sexo={registro.sexo ?? ''}>
        <table class="res">
          <thead>
            <tr>
              <th scope="col" class="res__que">Examen</th>
              <th scope="col">Resultado</th>
              <th scope="col">Unidad</th>
              <th scope="col">Valor de referencia</th>
              <th scope="col"><span class="oculto">Quitar</span></th>
            </tr>
          </thead>
          <tbody id="res-cuerpo">
            {lineas.map((l, i) => (
              <tr>
                <td data-rotulo="Examen">
                  <input type="text" name="examen" value={l.examen}
                         aria-label={`Examen de la línea ${i + 1}`} autocomplete="off" />
                </td>
                <td data-rotulo="Resultado">
                  <input type="text" name="valor" value={l.valor} inputmode="decimal"
                         aria-label={`Resultado de ${l.examen || `la línea ${i + 1}`}`} autocomplete="off" />
                </td>
                <td data-rotulo="Unidad">
                  <input type="text" name="unidad" value={l.unidad}
                         aria-label={`Unidad de ${l.examen || `la línea ${i + 1}`}`} autocomplete="off" />
                </td>
                <td data-rotulo="Valor de referencia">
                  <input type="text" name="referencia" value={l.referencia}
                         aria-label={`Valor de referencia de ${l.examen || `la línea ${i + 1}`}`} autocomplete="off" />
                </td>
                <td class="res__quitar">
                  <button type="button" class="quitar" data-quitar aria-label="Quitar esta línea">×</button>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <p class="suma" id="res-suma" hidden></p>

      <div class="agregar">
        <button type="button" class="sis-boton sis-boton--suave" id="res-mas">
          <Icono nombre="mas" tam={17} />
          Agregar línea
        </button>

        {plantillas.length > 0 && (
          <span class="agregar__plantilla">
            <label for="res-plantilla">o las líneas de</label>
            <select id="res-plantilla" data-plantillas={JSON.stringify(plantillas)}>
              <option value="">un examen…</option>
              {plantillas.map((p) => (
                <option value={p.examen}>{p.examen} ({p.analitos.length})</option>
              ))}
            </select>
            <button type="button" class="sis-boton sis-boton--azul" id="res-poner">Poner</button>
          </span>
        )}
      </div>

      <p class="nota-ref">
        Las plantillas salen del archivo de laboratorio del centro: traen el
        analito, su unidad y su valor de referencia.
        <strong>Reviselo antes de firmar</strong>: {sinRango} de los{' '}
        {renglones.length} analitos vienen sin rango porque su hoja no lo
        traía en ninguna columna de esa fila, y deducirlo habría puesto el
        rango de un examen al lado del resultado de otro.
      </p>

      <details class="cuentas">
        <summary>
          {CALCULOS.length} analitos <strong>se calculan solos</strong> con las
          fórmulas de ese mismo archivo
        </summary>
        <p class="nota-ref">
          Aparecen en cuanto están sus insumos y se vuelven a calcular si uno
          cambia. Si escribe encima, el suyo manda y deja de recalcularse.
        </p>
        <ul class="cuentas__lista">
          {CALCULOS.map((c) => (
            <li><strong>{c.resultado}</strong> = {c.comoSeLee}</li>
          ))}
        </ul>
        <p class="nota-ref">
          El INR no está en esa lista a propósito: depende del ISI del
          reactivo de cada lote, y en el archivo del centro también va
          escrito a mano.
        </p>
      </details>

      <div class="pie">
        <div class="pie__int">
          <span class="pie__estado">
            {cargados.filter((r) => r.valor).length} de {lineas.length}
            {lineas.length === 1 ? ' línea' : ' líneas'} con resultado
          </span>
          <div class="pie__botones">
            <button type="submit" name="accion" value="guardar" class="sis-boton sis-boton--suave">
              Guardar y seguir después
            </button>
            <button type="submit" name="accion" value="entregar" class="sis-boton sis-boton--primario">
              <Icono nombre="escudo" tam={17} />
              Dar por listos
            </button>
          </div>
        </div>
      </div>
    </form>
  )}
</Sistema>

<script>
  /* Agregar y quitar líneas. Sin esto, una hematología completa habría que
     cargarla en una sola celda. */
  const cuerpo = document.getElementById('res-cuerpo');
  const mas = document.getElementById('res-mas');

  if (cuerpo && mas) {
    /* El molde se guarda al cargar, no se busca cada vez. Al poner una
       plantilla la única fila vacía se reusa —se quita— y entonces no
       quedaba ninguna de donde clonar: la tabla se vaciaba y no se agregaba
       nada. */
    const molde = cuerpo.querySelector('tr')?.cloneNode(true) as HTMLTableRowElement | undefined;

    const nuevaFila = () => {
      if (!molde) return null;
      const fila = molde.cloneNode(true) as HTMLTableRowElement;
      fila.querySelectorAll('input').forEach((i) => {
        i.value = '';
        /* El rótulo accesible del modelo nombraba a OTRO examen. Acá no se
           sabe cuál va a ser, así que se nombra por la columna. */
        const columna = i.closest('td')?.dataset.rotulo ?? '';
        i.setAttribute('aria-label', `${columna} de una línea nueva`);
      });
      return fila;
    };

    /* ---------- las cuentas ---------- */

    type Op =
      | { tipo: 'resta' } | { tipo: 'division' } | { tipo: 'dividirPor'; por: number }
      | { tipo: 'divisionEscalada'; factor: number } | { tipo: 'productoSobre' }
      | { tipo: 'relacionDescontada'; descuento: number };
    type Calculo = {
      resultado: string; insumos: string[]; operacion: Op;
      decimales: number; comoSeLee: string;
    };

    const tablon = cuerpo.closest('[data-calculos]') as HTMLElement | null;
    let calculos: Calculo[] = [];
    try { calculos = JSON.parse(tablon?.dataset.calculos ?? '[]'); } catch { calculos = []; }

    /* La misma normalización que en sistema/calculos.ts. Se repite acá a
       propósito: el script del navegador no importa módulos del servidor, y
       copiar cuatro líneas es más barato que armar un paquete compartido
       para esto. Si una cambia, cambia la otra. */
    const MISMO: Record<string, string> = {
      globulina: 'globulinas',
      'relaciona/g': 'relacionag',
      'relacionaa/g': 'relacionag',
    };
    const llave = (n: string) => {
      const plano = n.normalize('NFD').replace(/[\u0300-\u036f]/g, '')
        .toLowerCase().replace(/\s+/g, '').trim();
      return MISMO[plano] ?? plano;
    };

    /** Lee un número escrito a la venezolana: «13,4» y «13.4» valen igual. */
    const numero = (t: string): number | null => {
      const limpio = t.trim().replace(/\s/g, '').replace(',', '.');
      if (!limpio || !/^-?\d*\.?\d+$/.test(limpio)) return null;
      const n = Number(limpio);
      return Number.isFinite(n) ? n : null;
    };

    /** Lo escribe como se lee acá: coma decimal. */
    const comoSeEscribe = (n: number, decimales: number) =>
      n.toFixed(decimales).replace('.', ',');

    const hacerCuentas = () => {
      const filas = [...cuerpo.querySelectorAll<HTMLTableRowElement>('tr')];
      const dame = (f: HTMLTableRowElement, n: string) =>
        f.querySelector<HTMLInputElement>(`input[name="${n}"]`);
      const nombreDe = (f: HTMLTableRowElement) => dame(f, 'examen')?.value.trim() ?? '';
      const llaves = filas.map((f) => llave(nombreDe(f)));

      /* Cada insumo se busca desde la fila que se calcula hacia ARRIBA, y
         solo si no aparece, hacia abajo.

         No por nombre en toda la orden: en coagulación hay dos filas
         «TIEMPO CONTROL» —una del tiempo de protrombina y otra del PTT— y
         buscando por nombre la actividad agarraba la del PTT, que está más
         abajo. Lo mismo con la albúmina cuando una orden lleva dos exámenes
         que la traen: cada relación A/G tiene que usar la de su bloque.
         La fila de arriba es la de su propio bloque. */
      const buscar = (desde: number, clave: string) => {
        for (let i = desde - 1; i >= 0; i--) if (llaves[i] === clave) return filas[i];
        for (let i = desde + 1; i < filas.length; i++) if (llaves[i] === clave) return filas[i];
        return null;
      };

      /* Dos pasadas: el LDL necesita el VLDL, que también se calcula y en
         su hoja va en la fila de abajo. Con dos alcanza para las cadenas
         que hay. */
      for (let vuelta = 0; vuelta < 2; vuelta++) {
        for (let i = 0; i < filas.length; i++) {
          const c = calculos.find((x) => x.resultado === llaves[i]);
          if (!c) continue;

          const campo = dame(filas[i], 'valor');
          if (!campo || campo.dataset.aMano !== undefined) continue;

          const valores = c.insumos.map((ins) => {
            const f = buscar(i, ins);
            return f ? numero(dame(f, 'valor')?.value ?? '') : null;
          });

          if (valores.some((v) => v === null)) {
            // Faltan insumos: se limpia lo que esta misma cuenta había puesto.
            if (campo.dataset.calculado !== undefined) {
              campo.value = '';
              delete campo.dataset.calculado;
            }
            continue;
          }

          const v = valores as number[];
          let r: number | null = null;
          switch (c.operacion.tipo) {
            case 'resta': r = v.slice(1).reduce((t, x) => t - x, v[0]); break;
            case 'division': r = v[1] === 0 ? null : v[0] / v[1]; break;
            case 'dividirPor': r = v[0] / c.operacion.por; break;
            case 'divisionEscalada':
              r = v[1] === 0 ? null : (v[0] / v[1]) * c.operacion.factor; break;
            case 'productoSobre': r = v[2] === 0 ? null : (v[0] * v[1]) / v[2]; break;
            case 'relacionDescontada': {
              const d = c.operacion.descuento;
              r = v[1] - d === 0 ? null : ((v[0] - d) / (v[1] - d)) * 100;
              break;
            }
          }
          if (r === null || !Number.isFinite(r)) continue;

          campo.value = comoSeEscribe(r, c.decimales);
          campo.dataset.calculado = '';
          campo.title = `Calculado: ${c.comoSeLee}. Se puede escribir encima.`;
        }
      }

      revisarDiferencial(filas, dame, llaves);
      marcarFueraDeRango(filas, dame);
    };

    /* ---------- fuera de rango ---------- */

    /* La misma lógica de sistema/rangos.ts, repetida acá porque este script
       no importa módulos del servidor. Si una cambia, cambia la otra: hay
       una prueba que compara las dos sobre los mismos casos. */
    const sexoDelPaciente = tablon?.dataset.sexo ?? '';

    const numeroDeTexto = (texto: string): number | null => {
      const limpio = String(texto ?? '').trim().replace(/\s+/g, '');
      if (!limpio || !/^[+-]?[\d.,]+$/.test(limpio)) return null;
      let t = limpio;
      if (t.includes(',')) t = t.replace(/\./g, '').replace(',', '.');
      else if (/^\d{1,3}(\.\d{3})+$/.test(t)) t = t.replace(/\./g, '');
      const n = Number(t);
      return Number.isFinite(n) ? n : null;
    };

    type Limites = { min: number | null; max: number | null };

    const limitesDeTexto = (trozo: string): Limites | null => {
      const t = trozo.normalize('NFD').replace(/[\u0300-\u036f]/g, '')
        .toLowerCase().replace(/[\u2013\u2014]/g, '-');
      const sinRotulo = t.replace(/^[^0-9<>+-]*:/, ' ');

      const tope = sinRotulo.match(/(?:hasta|menor\s*(?:que|a|de)?|inferior\s*a?|<=?)\s*([+-]?\d[\d.,]*)/);
      if (tope) { const n = numeroDeTexto(tope[1]); if (n !== null) return { min: null, max: n }; }
      const piso = sinRotulo.match(/(?:mayor\s*(?:que|a|de)?|superior\s*a?|>=?)\s*([+-]?\d[\d.,]*)/);
      if (piso) { const n = numeroDeTexto(piso[1]); if (n !== null) return { min: n, max: null }; }
      const rango = sinRotulo.match(/([+-]?\d[\d.,]*)\s*-\s*([+-]?\d[\d.,]*)/);
      if (rango) {
        const a = numeroDeTexto(rango[1]);
        const b = numeroDeTexto(rango[2]);
        if (a !== null && b !== null && b >= a) return { min: a, max: b };
      }
      return null;
    };

    const limitesPara = (texto: string): Limites | null => {
      const partes = texto.split('/').map((p) => p.trim()).filter(Boolean);
      const conRotulo = partes.filter((p) => /hombre|mujer|masculino|femenino|varon|adulto|ni[ñn]o/i.test(p));
      if (partes.length > 1 && conRotulo.length > 0) {
        const s = sexoDelPaciente.trim();
        const esMujer = /^f/i.test(s) || /^mu/i.test(s);
        const esHombre = /^m/i.test(s) && !esMujer;
        const suyo = partes.find((p) => {
          const x = p.toLowerCase();
          if (esHombre) return /hombre|masculino|varon/.test(x);
          if (esMujer) return /mujer|femenino/.test(x);
          return false;
        });
        if (suyo) { const l = limitesDeTexto(suyo); if (l) return l; }

        const tramos = conRotulo.map(limitesDeTexto).filter((x): x is Limites => x !== null);
        if (tramos.length > 1) {
          return {
            min: tramos.every((m) => m.min !== null) ? Math.min(...tramos.map((m) => m.min as number)) : null,
            max: tramos.every((m) => m.max !== null) ? Math.max(...tramos.map((m) => m.max as number)) : null,
          };
        }
        if (tramos.length === 1) return tramos[0];
      }
      return limitesDeTexto(texto);
    };

    const fueraDeRango = (valor: string, referencia: string): string => {
      const v = numeroDeTexto(valor);
      if (v === null) return '';
      const texto = String(referencia ?? '').trim();
      if (!texto) return '';
      const lim = limitesPara(texto);
      if (!lim) return '';
      if (lim.max !== null && v > lim.max) return 'alto';
      if (lim.min !== null && v < lim.min) return 'bajo';
      return '';
    };

    const marcarFueraDeRango = (
      filas: HTMLTableRowElement[],
      dame: (f: HTMLTableRowElement, n: string) => HTMLInputElement | null,
    ) => {
      for (const f of filas) {
        const campo = dame(f, 'valor');
        if (!campo) continue;
        const estado = fueraDeRango(campo.value, dame(f, 'referencia')?.value ?? '');
        if (estado) {
          f.dataset.fuera = estado;
          campo.title = estado === 'alto'
            ? 'Por encima del valor de referencia'
            : 'Por debajo del valor de referencia';
        } else {
          delete f.dataset.fuera;
          if (campo.dataset.calculado === undefined) campo.removeAttribute('title');
        }
      }
    };

    /* El diferencial tiene que sumar cien. En su hoja hay una celda aparte
       que lo suma y no se imprime; acá es un aviso debajo de la tabla. No
       bloquea nada: avisa. Un diferencial que suma 97 casi siempre es una
       cifra mal tecleada, y se ve antes de firmar. */
    const PARTES = JSON.parse(tablon?.dataset.sumanCien ?? '{"partes":[],"total":100}') as
      { partes: string[]; total: number };
    const avisoSuma = document.getElementById('res-suma');

    const revisarDiferencial = (
      filas: HTMLTableRowElement[],
      dame: (f: HTMLTableRowElement, n: string) => HTMLInputElement | null,
      llaves: string[],
    ) => {
      if (!avisoSuma || !PARTES.partes.length) return;

      const buscadas = PARTES.partes.map((p) => llave(p));
      let suma = 0;
      let cuantas = 0;
      for (let i = 0; i < filas.length; i++) {
        if (!buscadas.includes(llaves[i])) continue;
        const n = numero(dame(filas[i], 'valor')?.value ?? '');
        if (n === null) continue;
        suma += n;
        cuantas++;
      }

      // Solo avisa cuando están todas: a medio llenar nunca suma cien.
      if (cuantas < buscadas.length || Math.round(suma) === PARTES.total) {
        avisoSuma.hidden = true;
        return;
      }
      avisoSuma.hidden = false;
      avisoSuma.textContent =
        `El diferencial suma ${comoSeEscribe(suma, 0)} %, y tiene que sumar ${PARTES.total} %.`;
    };

    /* Si alguien escribe en un campo, el suyo manda y esa celda deja de
       recalcularse: un valor que no se puede corregir es peor que uno
       tecleado, y el equipo puede dar otra cosa que la fórmula.
       
       Se marca SIEMPRE que se teclee, también sobre un calculado. La
       primera versión solo marcaba los que no estaban calculados —al revés
       de lo que hacía falta— y la cuenta volvía a pisar el valor escrito a
       mano en cuanto cambiaba un insumo.
       
       Esto no se dispara cuando la cuenta escribe: asignar .value desde el
       script no genera un evento 'input'.
       
       Y si se vacía, vuelve a calcularse: un campo en blanco es «hágala
       usted». */
    cuerpo.addEventListener('input', (e) => {
      const campo = e.target as HTMLInputElement;
      if (campo.name === 'valor') {
        if (campo.value.trim()) {
          campo.dataset.aMano = '';
          delete campo.dataset.calculado;
        } else {
          delete campo.dataset.aMano;
        }
      }
      if (campo.name === 'valor' || campo.name === 'examen') hacerCuentas();
    });

    mas.addEventListener('click', () => {
      const fila = nuevaFila();
      if (!fila) return;
      cuerpo.appendChild(fila);
      fila.querySelector('input')?.focus();
    });

    /* Las líneas de una plantilla, de un golpe. Lo que se agrega es un
       punto de partida: el analito y la unidad escritos, el rango cuando la
       hoja del centro lo decía. Todo queda editable. */
    const elige = document.getElementById('res-plantilla') as HTMLSelectElement | null;
    const poner = document.getElementById('res-poner');

    if (elige && poner) {
      type Plantilla = { examen: string; analitos: { analito: string; unidad: string; referencia: string }[] };
      let plantillas: Plantilla[] = [];
      try { plantillas = JSON.parse(elige.dataset.plantillas ?? '[]'); } catch { plantillas = []; }

      poner.addEventListener('click', () => {
        const p = plantillas.find((x) => x.examen === elige.value);
        if (!p) { elige.focus(); return; }

        /* Si la única fila que hay está vacía, se reusa: apretar sin haber
           escrito nada dejaba un renglón en blanco arriba de la plantilla. */
        const filas = [...cuerpo.querySelectorAll('tr')];
        const soloUnaVacia = filas.length === 1 &&
          [...filas[0].querySelectorAll('input')].every((i) => !i.value.trim());
        if (soloUnaVacia) filas[0].remove();

        /* No se repite lo que ya está: poner dos veces la misma plantilla
           —o una que comparte analitos con otra— no duplica renglones. */
        const yaEstan = new Set(
          [...cuerpo.querySelectorAll<HTMLInputElement>('input[name="examen"]')]
            .map((i) => i.value.trim().toUpperCase())
            .filter(Boolean),
        );

        const faltan = p.analitos.filter((a) => !yaEstan.has(a.analito.toUpperCase()));
        if (!faltan.length) { elige.value = ''; return; }

        const poneFila = (examen: string, unidad = '', referencia = '') => {
          const fila = nuevaFila();
          if (!fila) return null;
          const dame = (n: string) => fila.querySelector<HTMLInputElement>(`input[name="${n}"]`);
          dame('examen')!.value = examen;
          dame('unidad')!.value = unidad;
          dame('referencia')!.value = referencia;
          cuerpo.appendChild(fila);
          return dame('valor');
        };

        /* El nombre del examen encabeza sus renglones. Una orden con tres
           exámenes salía impresa como una lista corrida de treinta filas
           sin decir dónde terminaba uno y empezaba el otro; en las hojas
           del laboratorio cada examen es su propia hoja con su título.
           
           Va como renglón sin valor, sin unidad y sin rango, que es la
           forma en que el informe reconoce un subtítulo. */
        poneFila(p.examen);

        let primera: HTMLInputElement | null = null;
        for (const a of faltan) {
          const campo = poneFila(a.analito, a.unidad, a.referencia);
          if (!campo) break;
          primera ??= campo;
        }
        elige.value = '';
        primera?.focus();
        hacerCuentas();
      });
    }

    // Y al cargar: una orden a medio llenar ya puede tener sus insumos.
    hacerCuentas();

    cuerpo.addEventListener('click', (e) => {
      const boton = (e.target as HTMLElement).closest('[data-quitar]');
      if (!boton) return;
      const fila = boton.closest('tr');
      /* Nunca se queda sin ninguna: si es la última, se vacía en vez de
         borrarse, para que quede dónde escribir. */
      if (cuerpo.querySelectorAll('tr').length > 1) fila?.remove();
      else fila?.querySelectorAll('input').forEach((i) => { i.value = ''; });
    });
  }
</script>

