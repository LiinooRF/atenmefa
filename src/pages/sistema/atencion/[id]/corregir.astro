---
/**
 * Corregir una atención ya cerrada.
 *
 * «Que quede en el mismo circuito de atención… para modificar esa consulta
 * paso a paso y modificar la información del paciente, dejando eso en el
 * historial» (16-11). Es el mismo formulario por pasos, lleno con lo que
 * se firmó, con tres diferencias: no se guarda solo, se pide el motivo, y
 * al guardar queda cada campo antes y después. Ver lib/correcciones.ts.
 *
 * De una orden de laboratorio se corrige acá el registro —quién es el
 * paciente—; los resultados, en su pantalla (resultados?corregir=1).
 */
import Sistema from '../../../../layouts/Sistema.astro';
import Pasos from '../../../../components/sistema/Pasos.astro';
import Icono from '../../../../components/Icono.astro';
import { historia } from '../../../../sistema/historia';
import { laboratorio } from '../../../../sistema/laboratorio';
import { puedeCorregir } from '../../../../sistema/lib/permisos';
import { atencionPara, limpiarDatos, anotar } from '../../../../sistema/lib/atenciones';
import { corregirAtencion } from '../../../../sistema/lib/correcciones';

export const prerender = false;

const usuario = Astro.locals.usuario;
if (!usuario) return Astro.redirect('/sistema/entrar');

const caso = await atencionPara(Astro.params.id!);
if (!caso) return Astro.redirect('/sistema');
const esLab = caso.tipo === 'laboratorio';
const permitido = puedeCorregir(usuario, caso);

let error = '';
let motivo = '';
let datos = (caso.datos ?? {}) as Record<string, string>;

if (Astro.request.method === 'POST' && permitido) {
  const form = await Astro.request.formData();
  motivo = String(form.get('motivo_correccion') ?? '');
  datos = limpiarDatos(form);
  try {
    const hecha = await corregirAtencion(usuario, caso.id, datos, motivo);
    await anotar(usuario.id, 'corrigio', caso.id, {
      numero: hecha.numero,
      campos: hecha.cambios.map((c) => c.campo),
      cambio_de_paciente: hecha.cambioDePaciente,
    });
    return Astro.redirect(`/sistema/atencion/${caso.id}?corregida=1#correcciones`);
  } catch (e) {
    error = e instanceof Error ? e.message : 'No se pudo guardar la corrección.';
  }
} else if (permitido) {
  await anotar(usuario.id, 'vio', caso.id);
}

/* Lo que tiene algo escrito se abre: es una historia completa. */
const secciones = esLab
  ? laboratorio
  : historia.map((s) => (s.plegable && s.campos.some((c) => datos[c.clave]) ? { ...s, plegable: false } : s));
---

<Sistema titulo={`Corregir ${esLab ? 'orden' : 'atención'} ${caso.numero}`}>
  <nav class="miga">
    <a href={esLab ? '/sistema/laboratorio' : '/sistema'}>{esLab ? 'Laboratorio' : 'Casos'}</a> <span>/</span>
    <a href={`/sistema/atencion/${caso.id}`}>{esLab ? 'Orden' : 'Atención'} {caso.numero}</a> <span>/</span>
    Corregir
  </nav>

  {!permitido ? (
    <section class="sis-tarjeta trabada">
      <h1>Esta atención no la puede corregir usted</h1>
      <p>
        {caso.estado !== 'cerrada'
          ? 'Solo se corrige una atención cerrada. Un borrador se sigue editando como siempre, y una anulada quedó fuera de juego.'
          : 'Una atención cerrada la corrige quien la firmó o administración. Si algo quedó mal, avísele a quien la firmó o a administración.'}
      </p>
      <div class="trabada__acciones">
        <a class="sis-boton sis-boton--azul" href={`/sistema/atencion/${caso.id}`}>Ver la ficha</a>
      </div>
    </section>
  ) : (
    <form method="post" class="form">
      <header class="form__cab">
        <div>
          <div class="form__linea">
            <h1>Corregir {esLab ? 'la orden' : 'la atención'} N° <span class="cifra">{caso.numero}</span></h1>
            <span class="chapa">Cerrada</span>
          </div>
          <p class="form__nota">
            {caso.paciente} · {caso.cedula}. Cambie lo que estaba mal, en el paso que sea, y guarde con el motivo.
            Queda en el historial qué decía antes cada campo. La fecha no se corrige: de ella sale el mes del cierre.
            {esLab && ' Los resultados se corrigen en su pantalla.'}
          </p>
        </div>
        <a class="sis-boton sis-boton--suave" href={`/sistema/atencion/${caso.id}`}>Dejar como está</a>
      </header>

      {error && <p class="sis-error form__error"><Icono nombre="escudo" tam={18} />{error}</p>}

      <div class="sis-tarjeta motivo">
        <label for="motivo_correccion">Motivo de la corrección <abbr title="Obligatorio">*</abbr></label>
        <textarea id="motivo_correccion" name="motivo_correccion" rows="2" maxlength="2000"
                  placeholder="La cédula estaba mal escrita: era 12.345.678.">{motivo}</textarea>
      </div>

      <Pasos
        datos={datos}
        atencionId={caso.id}
        numero={caso.numero}
        modelo={secciones}
        tipoAtencion={esLab ? 'laboratorio' : 'general'}
        tipoDoc={caso.tipoDoc}
        cierra={false}
        corrige
      />
    </form>
  )}
</Sistema>

<script>
  /* La fecha se ve pero no se cambia: ver la nota de arriba. */
  const fecha = document.getElementById('c-fecha') as HTMLInputElement | null;
  if (fecha && document.querySelector('[data-corrige]')) fecha.readOnly = true;
</script>

<style>
  .miga { font-size: var(--u-sm); color: var(--tinta-tenue); margin-bottom: 14px; }
  .miga a { color: var(--tinta-suave); text-decoration: none; }
  .miga a:hover { color: var(--azul); text-decoration: underline; }
  .miga span { margin-inline: 5px; }

  .trabada { max-width: 62ch; }
  .trabada h1 { font-size: var(--u-xl); }
  .trabada p { margin-top: 10px; color: var(--tinta-suave); }
  .trabada__acciones { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 20px; }

  .form__cab { display: flex; flex-wrap: wrap; gap: 14px; align-items: flex-start; justify-content: space-between; }
  .form__linea { display: flex; flex-wrap: wrap; align-items: center; gap: 11px; }
  .form__nota { margin-top: 6px; font-size: var(--u-sm); color: var(--tinta-tenue); max-width: 70ch; }
  .form__error { margin-top: 18px; }
  .chapa {
    font-size: var(--u-xs); font-weight: 700; letter-spacing: 0.03em; text-transform: uppercase;
    padding: 4px 10px; border-radius: 999px; background: #e4f2ea; color: #105433;
  }

  .motivo { display: grid; gap: 6px; margin: 16px 0; border-color: #e8c66a; background: #fffaf0; }
  .motivo label { font-size: var(--u-sm); font-weight: 600; color: var(--tinta-suave); }
  .motivo abbr { color: var(--rojo); text-decoration: none; }
  .motivo textarea {
    width: 100%; min-height: 64px; padding: 9px 12px; border: 1px solid var(--linea);
    border-radius: 8px; background: var(--papel); color: var(--tinta); font: inherit;
  }
</style>
