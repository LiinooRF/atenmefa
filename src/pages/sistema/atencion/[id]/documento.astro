---
/**
 * El "2 en 1": informe de atención y récipe, en un solo documento.
 *
 * No hay librería de PDF. Es HTML con una hoja de impresión: el médico
 * toca Imprimir y el navegador saca el PDF. Sale idéntico en pantalla y en
 * papel, y no hay plantilla aparte que se desincronice del formulario.
 */
import QR from 'qrcode';
import { historia } from '../../../../sistema/historia';
import { laboratorio, type Resultado } from '../../../../sistema/laboratorio';
import { examenesPedidos } from '../../../../sistema/lib/laboratorio';
import { puede } from '../../../../sistema/lib/permisos';
import { ROTULO } from '../../../../sistema/lib/documento';
import { bd, esquema } from '../../../../sistema/lib/base';
import { anotar } from '../../../../sistema/lib/atenciones';
import { clinica } from '../../../../data/clinica';
import { eq } from 'drizzle-orm';
import { exigir } from '../../../../sistema/lib/guardia';
import { entorno } from '../../../../sistema/lib/entorno';

export const prerender = false;

const corte = exigir(Astro, 'imprimir_documento');
if (corte) return corte;

const { id } = Astro.params;
const usuario = Astro.locals.usuario!;

const [caso] = await bd
  .select({
    id: esquema.atencion.id,
    numero: esquema.atencion.numero,
    estado: esquema.atencion.estado,
    tipo: esquema.atencion.tipo,
    resultados: esquema.atencion.resultados,
    resultadosPor: esquema.atencion.resultadosPor,
    fecha: esquema.atencion.fecha,
    aseguradora: esquema.atencion.aseguradora,
    poliza: esquema.atencion.poliza,
    casoNumero: esquema.atencion.casoNumero,
    datos: esquema.atencion.datos,
    paciente: esquema.paciente.nombre,
    cedula: esquema.paciente.cedula,
    tipoDoc: esquema.paciente.tipoDoc,
    pin: esquema.atencion.pin,
    telefono: esquema.paciente.telefono,
    medico: esquema.user.name,
    colegiatura: esquema.user.colegiatura,
    msds: esquema.user.msds,
  })
  .from(esquema.atencion)
  .innerJoin(esquema.paciente, eq(esquema.paciente.id, esquema.atencion.pacienteId))
  .innerJoin(esquema.user, eq(esquema.user.id, esquema.atencion.medicoId))
  .where(eq(esquema.atencion.id, id!))
  .limit(1);

if (!caso) return Astro.redirect('/sistema');

await anotar(usuario.id, 'imprimio', caso.id);

const d = (caso.datos ?? {}) as Record<string, string>;

/* ----------------------------------------------------------------
   Laboratorio.
   ----------------------------------------------------------------

   Un informe de laboratorio no es un informe de atención recortado: no
   tiene examen físico, ni diagnóstico, ni récipe, y la firma que vale es
   la del bioanalista con su colegio. Por eso es su propia hoja y no esta
   con campos vacíos.

   El sello va húmedo: «no vamos a manejar [sello digital], se imprime y se
   usa un sello húmedo ya elaborado el informe», dijo el cliente. De ahí
   que la hoja deje el espacio y no estampe ninguna imagen. */
const esLab = caso.tipo === 'laboratorio';
const resultados = (caso.resultados ?? []) as Resultado[];
const conValor = resultados.filter((r) => r.valor);
const pedidos = esLab ? await examenesPedidos(caso.id) : [];

const examenesPedidosTexto = esLab
  ? [
      ...pedidos.map((p) => p.nombre),
      ...(d.examenes ?? '').split('\n').map((t) => t.trim()).filter(Boolean),
    ]
  : [];

/* Quien firma el informe de laboratorio. Si todavía no hay resultados
   cargados no hay a quién atribuirlo, y la hoja sale con el renglón en
   blanco para firmar a mano: es lo honesto. */
const [firmante] = caso.resultadosPor
  ? await bd
      .select({ nombre: esquema.user.name, colegiatura: esquema.user.colegiatura })
      .from(esquema.user)
      .where(eq(esquema.user.id, caso.resultadosPor))
      .limit(1)
  : [];

const bloquesLab = esLab
  ? laboratorio
      .map((s) => ({
        ...s,
        campos: s.campos.filter(
          (c) => d[c.clave] && !['nombre', 'cedula', 'edad', 'sexo', 'telefono',
            'whatsapp', 'correo', 'fecha', 'aseguradora', 'poliza', 'examenes'].includes(c.clave),
        ),
      }))
      .filter((s) => s.campos.length > 0)
  : [];

/* Lo que ya sale en la cabecera o en la fila de signos vitales no se
   repite abajo: en papel la repetición hace parecer que falta algo. */
const yaArriba = new Set([
  'nombre', 'cedula', 'edad', 'sexo', 'telefono', 'titular', 'direccion',
  'ciudad', 'aseguradora', 'poliza', 'fecha', 'caso_numero',
  /* El WhatsApp y el correo sirven para mandarle el informe, no para que
     salgan impresos en él: en el papel serían dos renglones de datos de
     contacto en medio de una historia clínica. El teléfono ya va arriba. */
  'whatsapp', 'correo',
  'ta', 'fc', 'fr', 'temperatura', 'glicemia', 'glasgow', 'saturacion', 'hora_signos',
]);

const formatear = (clave: string, valor: string) => {
  const campo = historia.flatMap((s) => s.campos).find((c) => c.clave === clave);
  if (campo?.tipo === 'fecha') {
    return new Date(`${valor}T12:00:00`).toLocaleDateString('es-VE', {
      day: '2-digit', month: '2-digit', year: 'numeric',
    });
  }
  /* El diagnóstico sale con su código CIE-10 cuando se eligió del
     catálogo. Es lo que una aseguradora busca en el papel, y es la razón
     de ser del catálogo: sin el código impreso, codificar no sirve de
     nada. Si se escribió a mano, va el texto solo. */
  if (clave === 'idx' && d.idx_codigo) return `${valor} (${d.idx_codigo})`;
  return valor;
};

/* El récipe es la segunda página: no se repite en el informe. */
const bloques = historia
  .filter((s) => s.clave !== 'recipe' && s.clave !== 'signos')
  .map((s) => ({ ...s, campos: s.campos.filter((c) => d[c.clave] && !yaArriba.has(c.clave)) }))
  .filter((s) => s.campos.length > 0);

const hayRecipe = !esLab && Boolean(d.recipe || d.indicaciones);

/* ----------------------------------------------------------------
   El sello de verificación.
   ----------------------------------------------------------------

   El papel se puede rehacer en cualquier procesador de texto. Con esto,
   quien lo recibe —una aseguradora, una empresa, una farmacia— puede
   comprobar que lo emitió el centro.

   El QR se dibuja acá como SVG y no se guarda en ninguna parte: ni archivo,
   ni imagen, ni PDF. Se arma cada vez que se abre el documento. */
/* La dirección donde el sistema REALMENTE está, no el dominio final.
   clinica.dominio es atenmefa.site, que sirve para la canónica del sitio
   público pero hoy todavía apunta a la web vieja: un QR impreso con esa
   dirección da 404. Un código que funciona hoy vale más que uno que va a
   funcionar algún día, y el día que se mude el dominio esto cambia solo,
   porque sale de URL_BASE. Los papeles ya impresos quedan con la de
   entonces: por eso también va el N° para verificar a mano. */
const dondeVive = (entorno('URL_BASE') ?? clinica.dominio).replace(/\/$/, '');
const urlVerificacion = `${dondeVive}/verificar/${caso.id}`;
const dominioCorto = dondeVive.replace(/^https?:\/\//, '');
const qr = caso.pin
  ? await QR.toString(urlVerificacion, {
      type: 'svg', margin: 0, errorCorrectionLevel: 'M', width: 132,
    })
  : null;

const fechaLarga = (f: string) =>
  new Date(`${f}T12:00:00`).toLocaleDateString('es-VE', { day: '2-digit', month: '2-digit', year: 'numeric' });

const vitales = [
  ['T/A', d.ta, 'mmHg'], ['FC', d.fc, 'lpm'], ['FR', d.fr, 'rpm'],
  ['Temp', d.temperatura, '°C'], ['Glicemia', d.glicemia, 'mg/dL'],
  ['Glasgow', d.glasgow, ''], ['Sat O₂', d.saturacion, '%'],
].filter(([, v]) => v);
---

<!doctype html>
<html lang="es-VE">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Atención {caso.numero} · {caso.paciente}</title>
    <meta name="robots" content="noindex, nofollow" />
  </head>

  <body>
    <div class="acciones">
      <a href={`/sistema/atencion/${caso.id}`}>← Volver a la {esLab ? 'orden' : 'atención'}</a>
      <div class="acciones__grupo">
        {/* Las tres salidas que pidió el cliente para el laboratorio:
            «descargar el PDF o el Excel, o para imprimir, o la opción que te
            envíe por el WhatsApp del usuario». El PDF lo saca el navegador
            con el botón de imprimir; los otros dos son estos. */}
        {esLab && conValor.length > 0 && (
          <a class="acciones__otro" href={`/sistema/atencion/${caso.id}/resultados.xlsx`}>
            Excel
          </a>
        )}
        {puede(usuario.rol as string, 'enviar_documento') && (
          <a class="acciones__otro" href={`/sistema/atencion/${caso.id}/enviar`}>
            Enviar al paciente
          </a>
        )}
        <span class="acciones__rotulo" id="papel-rotulo">Papel</span>
        <div class="papel" role="radiogroup" aria-labelledby="papel-rotulo">
          <button type="button" role="radio" data-papel="carta" aria-checked="true">
            Carta <em>21,6 × 27,9 cm</em>
          </button>
          <button type="button" role="radio" data-papel="oficio" aria-checked="false">
            Oficio <em>21,6 × 33 cm</em>
          </button>
        </div>
        {/* Tres salidas distintas, no una. Lo pidió el cliente y tiene
            sentido: el informe va a la aseguradora, el récipe va a la
            farmacia, y a veces hace falta el juego completo. Cada uno sigue
            generándose en vivo: lo único que cambia es qué hoja se imprime. */}
        {hayRecipe ? (
          <div class="papel" role="group" aria-label="Qué imprimir">
            <button type="button" class="acciones__imprimir" data-imprimir="informe">Informe</button>
            <button type="button" class="acciones__imprimir" data-imprimir="recipe">Récipe</button>
            <button type="button" class="acciones__imprimir acciones__imprimir--todo" data-imprimir="todo">Los dos</button>
          </div>
        ) : (
          <button type="button" class="acciones__imprimir acciones__imprimir--todo" data-imprimir="todo">
            Imprimir o guardar en PDF
          </button>
        )}
      </div>
    </div>

    {caso.estado !== 'cerrada' && (
      <p class="aviso">
        Esta atención está en <strong>{caso.estado}</strong>. El documento definitivo
        se imprime una vez cerrada.
      </p>
    )}

    <!-- La hoja mide 215 mm y tiene que medir eso: es papel, no una pantalla.
         Pero en un teléfono de 390 px eso arrastraba la página entera de lado
         y se llevaba consigo la barra de arriba. Se desplaza dentro de esta
         caja, que es la regla de la casa para cualquier cosa ancha. -->
    <div class="lienzo">
    <!-- ===== Informe de laboratorio ===== -->
    {esLab && (
      <article class="hoja">
       <table class="corrida">
        <tfoot>
          <tr>
            <td>
              <div class="pie">
                <span><strong>Atenmefa</strong> · Informe de laboratorio N.° {caso.numero}</span>
                <span>{caso.paciente} · {caso.cedula} · {fechaLarga(caso.fecha)}</span>
              </div>
              {qr && (
                <div class="sello">
                  <div class="sello__qr" set:html={qr} />
                  <div class="sello__texto">
                    <strong>Verifique que este documento es auténtico</strong>
                    <span>Escanee el código o entre a {dominioCorto}/verificar</span>
                    <span>Hacen falta la cédula del paciente y el PIN <b class="cifra">{caso.pin}</b></span>
                  </div>
                </div>
              )}
            </td>
          </tr>
        </tfoot>
        <tbody>
         <tr>
          <td>
            <header class="enc">
              <img src="/logo.png" width="62" height="62" alt="" />
              <div class="enc__marca">
                <strong>Atenmefa</strong>
                <span>Laboratorio clínico</span>
                <small>{clinica.direccion.calle} · {clinica.direccion.ciudad}, estado {clinica.direccion.estado}</small>
                <small>{clinica.contacto.whatsapp.visible}{clinica.contacto.segundo && ` · ${clinica.contacto.segundo.visible}`}</small>
              </div>
              <div class="enc__titulo">
                <span>Informe de laboratorio</span>
                <strong class="cifra">N° {caso.numero}</strong>
                <small>{fechaLarga(caso.fecha)}</small>
              </div>
            </header>

            <table class="cabecera">
              <tbody>
                <tr><th>Paciente</th><td colspan="3">{caso.paciente}</td></tr>
                <tr>
                  <th>{ROTULO[caso.tipoDoc]}</th><td>{caso.cedula}</td>
                  <th>Edad</th><td>{d.edad ? `${d.edad} años` : '—'}{d.sexo && ` · ${d.sexo}`}</td>
                </tr>
                <tr>
                  <th>Muestra</th>
                  <td>{fechaLarga(caso.fecha)}{d.hora_muestra && ` · ${d.hora_muestra}`}{d.ayuno === 'si' && ' · en ayunas'}</td>
                  <th>Seguro</th><td>{caso.aseguradora ?? 'Paga el paciente'}</td>
                </tr>
                {d.quien_indica && (
                  <tr><th>Indicado por</th><td colspan="3">{d.quien_indica}</td></tr>
                )}
              </tbody>
            </table>

            {conValor.length > 0 ? (
              <section class="bloque">
                <h2>Resultados</h2>
                <table class="valores">
                  <thead>
                    <tr>
                      <th>Examen</th>
                      <th>Resultado</th>
                      <th>Unidad</th>
                      <th>Valor de referencia</th>
                    </tr>
                  </thead>
                  <tbody>
                    {conValor.map((r) => (
                      <tr>
                        <td>{r.examen}</td>
                        <td class="valores__dato cifra">{r.valor}</td>
                        <td>{r.unidad}</td>
                        <td>{r.referencia}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </section>
            ) : (
              <section class="bloque">
                <h2>Exámenes solicitados</h2>
                <p class="suelto">
                  {examenesPedidosTexto.length > 0
                    ? examenesPedidosTexto.join(' · ')
                    : 'Sin exámenes registrados.'}
                </p>
                <p class="suelto suelto--ojo">
                  Los resultados todavía no están cargados. Este papel sirve como
                  constancia de la toma de muestra, no como informe de resultados.
                </p>
              </section>
            )}

            {bloquesLab.map((s) => (
              <section class="bloque">
                <h2>{s.titulo}</h2>
                <dl>
                  {s.campos.map((c) => (
                    <div>
                      <dt>{c.rotulo}</dt>
                      <dd>{d[c.clave]}{c.unidad && ` ${c.unidad}`}</dd>
                    </div>
                  ))}
                </dl>
              </section>
            ))}

            <footer class="firma firma--una">
              <div class="firma__linea">
                <span>{firmante?.nombre ?? '\u00a0'}</span>
                <small>{firmante?.colegiatura ?? '\u00a0'}</small>
                <em>Bioanalista · sello y firma</em>
              </div>
            </footer>
          </td>
         </tr>
        </tbody>
       </table>
      </article>
    )}

    <!-- ===== Página 1: informe de atención ===== -->
    {!esLab && (
    <article class="hoja">
     <table class="corrida">
      <!-- Se repite al pie de CADA hoja impresa. Un <tfoot> es la única
           manera fiable: el navegador lo vuelve a dibujar en cada página y,
           a diferencia de position:fixed, además le reserva el sitio, así que
           nunca se le monta encima del texto. Sin esto, de un informe de tres
           hojas las dos últimas salían sin nada que dijera de quién son. -->
      <tfoot>
        <tr>
          <td>
            <div class="pie">
              <span><strong>Atenmefa</strong> · Informe de atención N.° {caso.numero}</span>
              <span>{caso.paciente} · {caso.cedula} · {fechaLarga(caso.fecha)}</span>
            </div>
            {qr && (
              /* El QR y el PIN, al pie de la hoja. Se dibuja en el momento y
                 no se guarda en ningún lado: ni archivo, ni imagen, ni PDF.
                 Van juntos a propósito: la dirección del QR sola no verifica
                 nada, hacen falta además la cédula y el PIN, y los dos están
                 impresos acá. */
              <div class="sello">
                <div class="sello__qr" set:html={qr} />
                <div class="sello__texto">
                  <strong>Verifique que este documento es auténtico</strong>
                  <span>Escanee el código o entre a {dominioCorto}/verificar</span>
                  <span>Hacen falta la cédula del paciente y el PIN <b class="cifra">{caso.pin}</b></span>
                </div>
              </div>
            )}

          </td>
        </tr>
      </tfoot>
      <tbody>
       <tr>
        <td>
      <header class="enc">
        <img src="/logo.png" width="62" height="62" alt="" />
        <div class="enc__marca">
          <strong>Atenmefa</strong>
          <span>Atención médica familiar</span>
          <small>{clinica.direccion.calle} · {clinica.direccion.ciudad}, estado {clinica.direccion.estado}</small>
          <small>{clinica.contacto.whatsapp.visible}{clinica.contacto.segundo && ` · ${clinica.contacto.segundo.visible}`}</small>
        </div>
        <div class="enc__titulo">
          <span>Informe de atención médica</span>
          <strong class="cifra">N° {caso.numero}</strong>
          <small>{fechaLarga(caso.fecha)}</small>
        </div>
      </header>

      <table class="cabecera">
        <tbody>
          <tr>
            <th>Paciente</th><td colspan="3">{caso.paciente}</td>
          </tr>
          <tr>
            <th>{ROTULO[caso.tipoDoc]}</th><td>{caso.cedula}</td>
            <th>Edad</th><td>{d.edad ? `${d.edad} años` : '—'}{d.sexo && ` · ${d.sexo}`}</td>
          </tr>
          <tr>
            <th>Seguro</th><td>{caso.aseguradora ?? 'Paga el paciente'}</td>
            <th>Póliza</th><td>{caso.poliza ?? '—'}</td>
          </tr>
          {(d.hora_inicio || d.hora_fin) && (
            <tr>
              <th>Atención</th>
              <td>{d.hora_inicio ? `Inicio ${d.hora_inicio}` : '—'}{d.hora_fin && ` · cierre ${d.hora_fin}`}</td>
              <th>Lugar</th><td>{d.lugar ?? '—'}</td>
            </tr>
          )}
          {(d.direccion || caso.telefono) && (
            <tr>
              <th>Dirección</th><td>{d.direccion ?? '—'}</td>
              <th>Teléfono</th><td>{caso.telefono ?? d.telefono ?? '—'}</td>
            </tr>
          )}
        </tbody>
      </table>

      {vitales.length > 0 && (
        <section class="vitales">
          <h2>Signos vitales</h2>
          <ul>
            {vitales.map(([r, v, u]) => (
              <li><span>{r}</span><strong class="cifra">{v}{u && <em> {u}</em>}</strong></li>
            ))}
          </ul>
        </section>
      )}

      {bloques.map((s) => (
        <section class="bloque">
          <h2>{s.titulo}</h2>
          <dl>
            {s.campos.map((c) => (
              <div>
                <dt>{c.rotulo}</dt>
                <dd>{formatear(c.clave, d[c.clave])}{c.unidad && ` ${c.unidad}`}</dd>
              </div>
            ))}
          </dl>
        </section>
      ))}

      <footer class="firma">
        <div class="firma__linea">
          <span>{caso.medico}</span>
          <small>
            {caso.colegiatura && `C.M. ${caso.colegiatura}`}
            {caso.msds && ` · M.S.D.S. ${caso.msds}`}
          </small>
          <em>Médico que atiende</em>
        </div>
        <div class="firma__linea">
          <span>&nbsp;</span>
          <small>&nbsp;</small>
          <em>Firma del paciente o familiar</em>
        </div>
      </footer>
        </td>
       </tr>
      </tbody>
     </table>
    </article>
    )}

    <!-- ===== Página 2: récipe ===== -->
    {hayRecipe && (
      <article class="hoja hoja--recipe">
       <table class="corrida">
      <!-- Se repite al pie de CADA hoja impresa. Un <tfoot> es la única
           manera fiable: el navegador lo vuelve a dibujar en cada página y,
           a diferencia de position:fixed, además le reserva el sitio, así que
           nunca se le monta encima del texto. Sin esto, de un informe de tres
           hojas las dos últimas salían sin nada que dijera de quién son. -->
      <tfoot>
        <tr>
          <td>
            <div class="pie">
              <span><strong>Atenmefa</strong> · Récipe N.° {caso.numero}</span>
              <span>{caso.paciente} · {caso.cedula} · {fechaLarga(caso.fecha)}</span>
            </div>
            {qr && (
              /* El QR y el PIN, al pie de la hoja. Se dibuja en el momento y
                 no se guarda en ningún lado: ni archivo, ni imagen, ni PDF.
                 Van juntos a propósito: la dirección del QR sola no verifica
                 nada, hacen falta además la cédula y el PIN, y los dos están
                 impresos acá. */
              <div class="sello">
                <div class="sello__qr" set:html={qr} />
                <div class="sello__texto">
                  <strong>Verifique que este documento es auténtico</strong>
                  <span>Escanee el código o entre a {dominioCorto}/verificar</span>
                  <span>Hacen falta la cédula del paciente y el PIN <b class="cifra">{caso.pin}</b></span>
                </div>
              </div>
            )}

          </td>
        </tr>
      </tfoot>
        <tbody>
         <tr>
          <td>
        <header class="enc">
          <img src="/logo.png" width="62" height="62" alt="" />
          <div class="enc__marca">
            <strong>Atenmefa</strong>
            <span>Atención médica familiar</span>
            <small>{clinica.direccion.calle} · {clinica.direccion.ciudad}</small>
          </div>
          <div class="enc__titulo">
            <span>Récipe</span>
            <strong class="cifra">N° {caso.numero}</strong>
            <small>{fechaLarga(caso.fecha)}</small>
          </div>
        </header>

        <table class="cabecera">
          <tbody>
            <tr><th>Paciente</th><td colspan="3">{caso.paciente}</td></tr>
            <tr><th>{ROTULO[caso.tipoDoc]}</th><td>{caso.cedula}</td><th>Edad</th><td>{d.edad ? `${d.edad} años` : '—'}</td></tr>
          </tbody>
        </table>

        {d.recipe && (
          <section class="receta">
            <h2>Récipe</h2>
            <p>{d.recipe}</p>
          </section>
        )}

        {d.indicaciones && (
          <section class="receta">
            <h2>Indicaciones</h2>
            <p>{d.indicaciones}</p>
          </section>
        )}

        <footer class="firma firma--una">
          <div class="firma__linea">
            <span>{caso.medico}</span>
            <small>
              {caso.colegiatura && `C.M. ${caso.colegiatura}`}
              {caso.msds && ` · M.S.D.S. ${caso.msds}`}
            </small>
            <em>Médico</em>
          </div>
        </footer>
          </td>
         </tr>
        </tbody>
       </table>
      </article>
    )}
    </div>

    <style is:global>
      :root {
        --azul: #111663;
        --rojo: #d31c24;
        --tinta: #1a1a1a;
        --gris: #666;
        --linea: #c9c9c9;
      }

      * { box-sizing: border-box; }

      body {
        margin: 0;
        padding: 26px 16px 60px;
        background: #e9ecf3;
        color: var(--tinta);
        font: 11pt/1.4 'Noto Sans', system-ui, sans-serif;
      }

      .acciones {
        max-width: 215mm;
        margin: 0 auto 18px;
        display: flex;
        gap: 12px;
        align-items: center;
        justify-content: space-between;
      }
      /* 44 px de alto en todo lo que se toca con el dedo, igual que el panel. */
      /* La tabla de resultados del laboratorio. Las cuatro columnas tienen
         ancho fijo para que el valor y su referencia queden alineados hoja
         tras hoja: un informe donde la columna del medio se mueve según el
         largo del nombre se lee mal. */
      .valores { width: 100%; border-collapse: collapse; margin-top: 4px; }
      .valores th {
        text-align: left;
        padding: 4px 6px;
        border-bottom: 1px solid var(--tinta);
        font-size: 8.5pt;
        letter-spacing: 0.02em;
        text-transform: uppercase;
        color: var(--gris);
      }
      .valores td { padding: 4.5px 6px; border-bottom: 1px solid var(--linea); font-size: 10pt; }
      .valores tr:last-child td { border-bottom: 0; }
      /* Ninguna fila se corta entre dos hojas: un resultado partido a la
         mitad es ilegible. */
      .valores tr { break-inside: avoid; }
      .valores th:nth-child(2), .valores td:nth-child(2) { width: 22mm; }
      .valores th:nth-child(3), .valores td:nth-child(3) { width: 20mm; }
      .valores th:nth-child(4), .valores td:nth-child(4) { width: 46mm; }
      .valores__dato { font-weight: 700; color: var(--azul); }

      .suelto { margin: 4px 0 0; font-size: 10pt; line-height: 1.5; }
      .suelto--ojo { margin-top: 8px; color: var(--gris); font-size: 9pt; }

      .acciones__otro {
        padding: 0 14px;
        border: 1px solid var(--linea);
        border-radius: 7px;
        background: #fff;
        color: var(--azul) !important;
        font-weight: 600;
      }
      .acciones__otro:hover { border-color: var(--azul); }

      .acciones a {
        display: inline-flex;
        align-items: center;
        min-height: 44px;
        color: var(--azul);
        font-size: 10pt;
        text-decoration: none;
      }
      .acciones a:hover { text-decoration: underline; }
      .acciones__grupo { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; }
      .acciones__rotulo { font-size: 9pt; color: var(--gris); font-weight: 600; }

      .papel {
        display: inline-flex;
        border: 1px solid #bcc4d6;
        border-radius: 7px;
        overflow: hidden;
        background: #fff;
      }
      .papel button {
        display: flex;
        flex-direction: column;
        justify-content: center;
        gap: 1px;
        min-height: 44px;
        padding: 7px 14px;
        border: 0;
        background: transparent;
        color: var(--gris);
        font: inherit;
        font-size: 9.5pt;
        font-weight: 600;
        line-height: 1.25;
        text-align: left;
        cursor: pointer;
      }
      .papel button + button { border-left: 1px solid #bcc4d6; }
      .papel button em { font-style: normal; font-size: 7.5pt; font-weight: 400; opacity: 0.75; }
      .papel button[aria-checked='true'] { background: var(--azul); color: #fff; }

      .papel { display: inline-flex; gap: 8px; flex-wrap: wrap; }
      /* El juego completo es lo que más se usa: va en rojo, los otros dos
         como alternativa. */
      .acciones__imprimir--todo { background: var(--rojo); color: #fff; }

      .acciones__imprimir {
        min-height: 44px;
        padding: 10px 20px;
        border: 0;
        border-radius: 7px;
        background: var(--papel);
        color: var(--azul);
        border: 1px solid #bcc4d6;
        font: inherit;
        font-size: 10pt;
        font-weight: 600;
        cursor: pointer;
      }
      .acciones__imprimir--todo { border-color: var(--rojo); }

      @media (max-width: 760px) {
        .acciones { flex-direction: column; align-items: flex-start; }
      }

      .aviso {
        max-width: 215mm;
        margin: 0 auto 14px;
        padding: 10px 14px;
        border-radius: 7px;
        background: #fdf0d9;
        border: 1px solid #e8c98a;
        color: #7a5200;
        font-size: 10pt;
      }

      /* Solo en pantalla: en papel un ancestro con overflow puede recortar
         la paginación. La hoja conserva sus 215 mm y se desplaza acá dentro. */
      @media screen {
        .lienzo { overflow-x: auto; padding-bottom: 4px; }
      }

      /* El relleno de acá es el MISMO margen que @page le da al papel, para
         que lo que se ve en pantalla sea lo que sale impreso. Si se cambian,
         se cambian los dos. El alto lo pone el script según el papel elegido. */
      .hoja {
        width: 215mm;
        min-height: var(--alto-papel, 279mm);
        margin: 0 auto 20px;
        padding: 13mm 14mm;
        background: #fff;
        box-shadow: 0 2px 14px rgba(0, 0, 0, 0.14);
      }

      .enc {
        break-inside: avoid;
        break-after: avoid;
        display: grid;
        grid-template-columns: auto 1fr auto;
        gap: 12px;
        align-items: center;
        padding-bottom: 10px;
        border-bottom: 2.5px solid var(--azul);
      }
      .enc img { border-radius: 50%; }
      .enc__marca { display: flex; flex-direction: column; line-height: 1.25; }
      .enc__marca strong { font-size: 16pt; font-weight: 800; color: var(--azul); letter-spacing: -0.02em; }
      .enc__marca span { font-size: 9pt; color: var(--rojo); font-weight: 600; }
      .enc__marca small { font-size: 7.5pt; color: var(--gris); }
      .enc__titulo { display: flex; flex-direction: column; align-items: flex-end; line-height: 1.3; }
      .enc__titulo span { font-size: 9pt; text-transform: uppercase; letter-spacing: 0.05em; color: var(--gris); font-weight: 600; }
      .enc__titulo strong { font-size: 15pt; color: var(--azul); font-weight: 800; }
      .enc__titulo small { font-size: 9pt; color: var(--gris); }

      .cabecera { width: 100%; border-collapse: collapse; margin-top: 12px; break-inside: avoid; }
      .cabecera th, .cabecera td { border: 1px solid var(--linea); padding: 5px 8px; font-size: 9.5pt; text-align: left; }
      .cabecera th { width: 88px; background: #f2f4f9; color: var(--gris); font-weight: 600; font-size: 8pt; text-transform: uppercase; letter-spacing: 0.03em; }

      .vitales { margin-top: 14px; break-inside: avoid; }
      .vitales ul { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0; border: 1px solid var(--linea); }
      .vitales li { flex: 1 1 auto; min-width: 80px; padding: 6px 10px; border-right: 1px solid var(--linea); display: flex; flex-direction: column; }
      .vitales li:last-child { border-right: 0; }
      .vitales span { font-size: 7.5pt; text-transform: uppercase; letter-spacing: 0.04em; color: var(--gris); font-weight: 600; }
      .vitales strong { font-size: 11pt; color: var(--azul); }
      .vitales em { font-style: normal; font-size: 8pt; font-weight: 400; color: var(--gris); }

      h2 {
        break-after: avoid; /* el título no se queda solo al pie de la hoja */
        margin: 0 0 6px;
        font-size: 9pt;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        color: var(--azul);
        font-weight: 700;
      }

      /* El bloque entero NO lleva break-inside: avoid. Lo tenía, y es lo que
         hacía que el corte saliera mal: un bloque con un diagnóstico largo no
         cabe en lo que queda de hoja, el navegador lo empuja completo a la
         siguiente y deja media página en blanco. Lo que no se puede partir es
         cada renglón y el título junto a lo que titula; el resto fluye. */
      .bloque { margin-top: 13px; }
      .bloque dl { margin: 0; border-top: 1px solid var(--linea); }
      .bloque dl > div {
        display: grid;
        grid-template-columns: 150px 1fr;
        gap: 10px;
        padding: 4px 0;
        border-bottom: 1px solid #eee;
        break-inside: avoid;
      }
      .bloque dt { font-size: 8.5pt; color: var(--gris); }
      .bloque dd { margin: 0; font-size: 9.5pt; white-space: pre-wrap; }

      .receta { margin-top: 18px; break-inside: avoid; }
      .receta p {
        margin: 0;
        min-height: 60mm;
        padding: 10px 12px;
        border: 1px solid var(--linea);
        font-size: 11pt;
        line-height: 1.7;
        white-space: pre-wrap;
      }
      .receta + .receta p { min-height: 40mm; }

      .firma {
        /* Eran 26 mm. Con el hueco tan grande, un informe que termina cerca
           del pie de la hoja se llevaba las firmas solas a la hoja siguiente. */
        margin-top: 16mm;
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 30px;
        break-inside: avoid;
      }
      .firma--una { grid-template-columns: 1fr; max-width: 70mm; }
      .firma__linea { display: flex; flex-direction: column; align-items: center; text-align: center; }
      .firma__linea span { font-size: 10pt; font-weight: 600; padding-bottom: 3px; }
      .firma__linea small { font-size: 8pt; color: var(--gris); padding-bottom: 5px; border-bottom: 1px solid var(--tinta); width: 100%; }
      .firma__linea em { font-style: normal; font-size: 8pt; color: var(--gris); padding-top: 4px; }

      .cifra { font-variant-numeric: tabular-nums; }

      /* La tabla no se ve: es solo el andamio que repite el pie en cada hoja.
         table-layout fijo para que la columna no se encoja al contenido. */
      .corrida { width: 100%; border-collapse: collapse; table-layout: fixed; }
      .corrida > tbody > tr > td,
      .corrida > tfoot > tr > td { padding: 0; border: 0; vertical-align: top; }

      /* En pantalla el pie y el sello sobran: la hoja ya se ve entera y con
         su membrete, y el QR es para el papel. */
      .pie, .sello { display: none; }


      /* ---------- impresión ---------- */
      /* El margen del papel va en @page, no en el relleno de .hoja.
         Antes era @page { margin: 0 }: el navegador armaba la página de borde
         a borde y el margen de verdad se lo acababa poniendo la impresora, que
         no recorta lo mismo arriba que abajo. De ahí el corte descentrado.
         La regla @page vive en su propia hoja de estilo (#papel) porque no se
         puede cambiar con una clase: para elegir carta u oficio hay que
         reescribirla. */

      @media print {
        body { background: #fff; padding: 0; }
        /* Que no quede un renglón suelto de un lado del corte. */
        .hoja { orphans: 3; widows: 3; }
        /* Los grises de las tablas son parte del formulario, no decoración:
           sin esto se pierden si la impresora trae los fondos apagados. */
        .cabecera th, .vitales { print-color-adjust: exact; -webkit-print-color-adjust: exact; }
        .acciones, .aviso { display: none; }
        .hoja {
          width: auto;
          min-height: auto;
          margin: 0;
          padding: 0; /* el margen ya lo da @page */
          box-shadow: none;
        }
        .hoja--recipe { break-before: page; }

        /* Solo una de las dos hojas. La que queda sola pierde el salto de
           página de adelante: si no, sale una hoja en blanco primero. */
        body[data-solo-imprime='informe'] .hoja--recipe { display: none; }
        body[data-solo-imprime='recipe'] .hoja:not(.hoja--recipe) { display: none; }
        body[data-solo-imprime='recipe'] .hoja--recipe { break-before: auto; }

        .pie {
          display: flex;
          justify-content: space-between;
          gap: 10mm;
          padding: 2mm 0 0;
          margin-top: 6mm;
          border-top: 1px solid var(--linea);
          color: var(--gris);
          font-size: 7.5pt;
        }
        .pie strong { color: var(--azul); }

        .sello {
          display: flex;
          align-items: center;
          gap: 9px;
          margin-top: 3mm;
          padding-top: 2mm;
          border-top: 1px dashed var(--linea);
        }
        /* Sin :global(). Esta hoja ya es is:global, y ahí :global() no es
           un selector válido: la regla se descartaba entera y el SVG salía a
           su tamaño natural —unos 35 mm— desbordando su caja y tapando el
           texto de al lado. Se veía solo en el papel. */
        .sello__qr { flex: none; width: 17mm; height: 17mm; }
        .sello__qr svg { width: 100%; height: 100%; display: block; }
        .sello__texto { display: flex; flex-direction: column; gap: 1px; font-size: 7pt; color: var(--gris); }
        .sello__texto strong { color: var(--azul); font-size: 7.5pt; }
        .sello__texto b { color: var(--tinta); letter-spacing: 0.08em; }
      }
    </style>

    <!-- La regla @page la reescribe el script, así que esta hoja tiene que
         seguir siendo un elemento del HTML: sin is:inline Astro se la lleva al
         CSS empaquetado, el id desaparece y el script no encuentra nada.
         El valor de acá es el que vale si el navegador no corre JavaScript:
         carta, que es el caso normal. -->
    <style id="papel" is:inline>@page { size: letter; margin: 13mm 14mm; }</style>

    <script>
      /* Carta u oficio. En Venezuela el oficio es de 21,6 × 33 cm, que no es
         el "legal" de 21,6 × 35,6 cm del que hablan los navegadores: hay que
         darlo en milímetros o el PDF sale del tamaño equivocado. */
      const PAPELES = {
        carta: { medida: 'letter', alto: '279mm' },
        oficio: { medida: '216mm 330mm', alto: '330mm' },
      };
      const MARGEN = '13mm 14mm'; // el mismo relleno que .hoja en pantalla
      const RECUERDO = 'atenmefa:papel';

      const estilo = document.getElementById('papel');
      const botones = Array.from(document.querySelectorAll('[data-papel]'));

      function elegir(cual) {
        const papel = PAPELES[cual];
        estilo.textContent = `@page { size: ${papel.medida}; margin: ${MARGEN}; }`;
        document.body.style.setProperty('--alto-papel', papel.alto);
        for (const boton of botones) {
          boton.setAttribute('aria-checked', String(boton.dataset.papel === cual));
        }
        try {
          localStorage.setItem(RECUERDO, cual);
        } catch {
          /* navegación privada: se queda con lo elegido en esta visita */
        }
      }

      for (const boton of botones) {
        boton.addEventListener('click', () => elegir(boton.dataset.papel));
      }

      /* Qué hoja sale. Se marca el <body> antes de imprimir y se desmarca
         después: si quedara puesto, la próxima impresión saldría recortada
         sin que nadie entienda por qué. El media print del CSS es el que
         esconde la hoja que no toca. */
      for (const boton of document.querySelectorAll('[data-imprimir]')) {
        boton.addEventListener('click', () => {
          document.body.dataset.soloImprime = boton.dataset.imprimir;
          window.print();
        });
      }
      addEventListener('afterprint', () => { delete document.body.dataset.soloImprime; });

      let guardado = null;
      try {
        guardado = localStorage.getItem(RECUERDO);
      } catch {
        /* sin localStorage no hay nada que recordar */
      }
      /* hasOwn y no `in`: `in` también acierta con 'constructor' y compañía. */
      elegir(guardado && Object.hasOwn(PAPELES, guardado) ? guardado : 'carta');
    </script>
  </body>
</html>
