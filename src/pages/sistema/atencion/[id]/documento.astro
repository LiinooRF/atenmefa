---
/**
 * El documento impreso, desde el sistema. El dibujo vive en
 * components/sistema/Documento.astro: la verificación pública muestra el
 * mismo (16-11). Acá solo se comprueba quién entra.
 */
import Documento from '../../../../components/sistema/Documento.astro';
import { exigir } from '../../../../sistema/lib/guardia';
import { esIdentificador } from '../../../../sistema/lib/atenciones';
import { bd, esquema } from '../../../../sistema/lib/base';
import { eq } from 'drizzle-orm';

export const prerender = false;

const corte = exigir(Astro, 'imprimir_documento');
if (corte) return corte;

const { id } = Astro.params;
if (!id || !esIdentificador(id)) return Astro.redirect('/sistema');
const [existe] = await bd.select({ id: esquema.atencion.id }).from(esquema.atencion)
  .where(eq(esquema.atencion.id, id)).limit(1);
if (!existe) return Astro.redirect('/sistema');
---

<Documento id={id} />
