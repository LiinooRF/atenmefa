---
import Sistema from '../../layouts/Sistema.astro';
import Icono from '../../components/Icono.astro';
import { bd, esquema } from '../../sistema/lib/base';
import { desc, eq, sql, and, ilike, or, isNotNull } from 'drizzle-orm';
import { exigir } from '../../sistema/lib/guardia';
import { puede } from '../../sistema/lib/permisos';
import { yaLaEscribioElMedico } from '../../sistema/historia';

export const prerender = false;

const corte = exigir(Astro, 'ver_casos');
if (corte) return corte;

const escribe = puede(Astro.locals.usuario?.rol as string, 'escribir_historia');

/* La cola del consultorio: lo que recepción admitió y nadie escribió
   todavía. El médico cae en esta pantalla al entrar y antes no tenía cómo
   enterarse de que lo estaban esperando; «Casos atendidos» es, por
   definición, lo que ya pasó.

   Solo al que las puede escribir: a administración no le toca y le sumaría
   un aviso más a una pantalla que ya tiene varios. */
const esperando = escribe
  ? await bd
      .select({
        id: esquema.atencion.id,
        numero: esquema.atencion.numero,
        paciente: esquema.paciente.nombre,
        datos: esquema.atencion.datos,
        mia: sql<boolean>`${esquema.atencion.medicoId} = ${Astro.locals.usuario!.id}`,
      })
      .from(esquema.atencion)
      .innerJoin(esquema.paciente, eq(esquema.paciente.id, esquema.atencion.pacienteId))
      .where(and(
        eq(esquema.atencion.estado, 'borrador'),
        eq(esquema.atencion.tipo, 'general'),
        isNotNull(esquema.atencion.abiertaPor),
      ))
      .orderBy(desc(esquema.atencion.creada))
      .limit(6)
  : [];

/* El cast va acá y no en el template: un genérico dentro del JSX de Astro
   se parsea como etiqueta.

   Las que ya tienen algo escrito salen de la cola: están a medio hacer y su
   sitio son los borradores, no la sala de espera. */
const cola = esperando
  .map((a) => {
    const campos = (a.datos ?? {}) as Record<string, string>;
    return {
      id: a.id,
      numero: a.numero,
      paciente: a.paciente,
      mia: Boolean(a.mia),
      motivo: campos.motivo ?? '',
      escrita: yaLaEscribioElMedico(campos),
    };
  })
  .filter((a) => !a.escrita);

const busca = (Astro.url.searchParams.get('q') ?? '').trim();
const mes = Astro.url.searchParams.get('mes') ?? '';

/* Solo atenciones generales. Las órdenes de laboratorio tienen su propia
   pantalla y no entran acá: el cliente lo pidió explícito —«la gente que
   llega para el laboratorio no es necesario que le salga al médico»—, y lo
   que el médico sí pidió lo ve colgado de su propia consulta. */
const filtros = [
  eq(esquema.atencion.estado, 'cerrada'),
  eq(esquema.atencion.tipo, 'general'),
];
if (busca) {
  const t = `%${busca.toLowerCase()}%`;
  filtros.push(
    or(
      ilike(esquema.paciente.nombreBusca, t),
      ilike(esquema.paciente.cedulaBusca, `%${busca.replace(/\D/g, '')}%`),
    )!,
  );
}
if (mes) filtros.push(eq(esquema.atencion.periodo, `${mes}-01`));

const casos = await bd
  .select({
    id: esquema.atencion.id,
    numero: esquema.atencion.numero,
    fecha: esquema.atencion.fecha,
    aseguradora: esquema.atencion.aseguradora,
    paciente: esquema.paciente.nombre,
    cedula: esquema.paciente.cedula,
    medico: esquema.user.name,
    idx: sql<string>`${esquema.atencion.datos} ->> 'idx'`,
    total: sql<string>`COALESCE((
      SELECT SUM(r.precio * r.cantidad) FROM renglon r WHERE r.atencion_id = ${esquema.atencion.id}
    ), 0)`,
    renglones: sql<number>`(
      SELECT COUNT(*) FROM renglon r WHERE r.atencion_id = ${esquema.atencion.id}
    )`,
  })
  .from(esquema.atencion)
  .innerJoin(esquema.paciente, eq(esquema.paciente.id, esquema.atencion.pacienteId))
  .innerJoin(esquema.user, eq(esquema.user.id, esquema.atencion.medicoId))
  .where(and(...filtros))
  .orderBy(desc(esquema.atencion.fecha), desc(esquema.atencion.numero))
  .limit(100);

const dinero = (v: string) =>
  new Intl.NumberFormat('es-VE', { minimumFractionDigits: 2 }).format(Number(v));

const fechaCorta = (f: string) =>
  new Date(`${f}T12:00:00`).toLocaleDateString('es-VE', { day: '2-digit', month: 'short' });
---

<Sistema titulo="Casos">
  <div class="cab">
    <div>
      <h1>Casos atendidos</h1>
      <p class="cab__nota">
        {casos.length === 100 ? 'Los 100 más recientes' : `${casos.length} ${casos.length === 1 ? 'caso' : 'casos'}`}
        {mes && ` · ${mes}`}
      </p>
    </div>
    {escribe && <a class="sis-boton sis-boton--primario cab__nueva" href="/sistema/atencion/nueva">
      <Icono nombre="mas" tam={19} />
      Nueva atención
    </a>}
  </div>

  {cola.length > 0 && (
    <section class="espera" aria-labelledby="espera-t">
      <h2 id="espera-t">
        <Icono nombre="reloj" tam={18} />
        {cola.length === 1
          ? 'Hay un paciente esperando'
          : `Hay ${cola.length} pacientes esperando`}
      </h2>
      <p class="espera__nota">
        Recepción los admitió y ya traen sus datos. Falta la consulta.
      </p>
      <ul class="espera__lista">
        {cola.map((a) => (
          <li>
            <a href={a.mia ? `/sistema/atencion/${a.id}/editar` : `/sistema/atencion/${a.id}`}>
              <span class="espera__num cifra">{a.numero}</span>
              <span class="espera__quien">
                <strong>{a.paciente}</strong>
                <small>{a.motivo || 'Sin motivo anotado'}</small>
              </span>
              {/* Puesta a otro médico: se puede tomar desde el caso. Se dice
                  acá para que no parezca que el enlace no funciona. */}
              {!a.mia && <span class="espera__ajena">de otro médico</span>}
            </a>
          </li>
        ))}
      </ul>
      <a class="espera__todos" href="/sistema/borradores">Ver todo lo que falta cerrar</a>
    </section>
  )}

  <form class="filtros" method="get">
    <div class="filtros__busca">
      <Icono nombre="latido" tam={18} />
      <input type="search" name="q" value={busca} placeholder="Buscar por nombre o cédula" aria-label="Buscar" />
    </div>
    <input type="month" name="mes" value={mes} aria-label="Mes" />
    <button type="submit" class="sis-boton sis-boton--azul">Filtrar</button>
    {(busca || mes) && <a class="sis-boton sis-boton--suave" href="/sistema">Limpiar</a>}
  </form>

  {casos.length === 0 ? (
    <div class="vacio sis-tarjeta">
      <h2>{busca || mes ? 'Ningún caso coincide' : 'Todavía no hay casos cerrados'}</h2>
      <p>
        {busca || mes
          ? 'Pruebe con otro nombre, otra cédula u otro mes.'
          : 'Las atenciones aparecen acá cuando el médico las cierra.'}
      </p>
      {!busca && !mes && escribe && (
        <a class="sis-boton sis-boton--primario" href="/sistema/atencion/nueva">Registrar la primera</a>
      )}
    </div>
  ) : (
    <ul class="casos">
      {casos.map((c) => (
        <li>
          <a href={`/sistema/atencion/${c.id}`}>
            <span class="casos__num cifra">{c.numero}</span>
            <span class="casos__cuerpo">
              <span class="casos__linea">
                <strong>{c.paciente}</strong>
                <em class="cifra">{fechaCorta(c.fecha)}</em>
              </span>
              <span class="casos__linea casos__linea--baja">
                <small>{c.idx ?? 'Sin diagnóstico'}</small>
                <span class="casos__paga">{c.aseguradora ?? 'Paga el paciente'}</span>
              </span>
            </span>
            <span class="casos__plata">
              <strong class="cifra">{dinero(c.total)}</strong>
              <small>{c.renglones} {c.renglones === 1 ? 'renglón' : 'renglones'}</small>
            </span>
          </a>
        </li>
      ))}
    </ul>
  )}
</Sistema>

<style>
  /* La sala de espera. Va arriba de los filtros porque es lo único de esta
     pantalla que pide algo AHORA; lo de abajo es historia. */
  .espera {
    margin-top: 18px;
    padding: 16px 18px;
    border: 1px solid var(--azul-medio);
    border-left: 4px solid var(--azul);
    border-radius: 10px;
    background: var(--bruma);
  }
  .espera h2 {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: var(--u-md);
    color: var(--azul);
  }
  .espera h2 :global(svg) { flex: none; }
  .espera__nota { margin-top: 4px; font-size: var(--u-xs); color: var(--tinta-suave); }

  .espera__lista { list-style: none; margin: 12px 0 0; padding: 0; display: grid; gap: 6px; }
  .espera__lista a {
    display: flex;
    align-items: center;
    gap: 12px;
    min-height: 50px;
    padding: 0 13px;
    border: 1px solid var(--linea);
    border-radius: 9px;
    background: var(--papel);
    color: var(--tinta);
    text-decoration: none;
  }
  .espera__lista a:hover { border-color: var(--azul-medio); }
  .espera__num {
    flex: none;
    min-width: 2.6em;
    font-weight: 700;
    font-size: var(--u-sm);
    color: var(--tinta-tenue);
  }
  .espera__quien { display: flex; flex-direction: column; line-height: 1.3; min-width: 0; flex: 1; }
  .espera__quien strong { font-size: var(--u-sm); font-weight: 600; }
  .espera__quien small {
    font-size: var(--u-xs);
    color: var(--tinta-tenue);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .espera__ajena {
    flex: none;
    font-size: var(--u-xs);
    font-weight: 600;
    color: var(--tinta-tenue);
    white-space: nowrap;
  }
  .espera__todos {
    display: inline-block;
    margin-top: 11px;
    font-size: var(--u-xs);
    font-weight: 600;
    color: var(--azul);
  }

  .cab { display: flex; flex-wrap: wrap; gap: 14px; align-items: center; justify-content: space-between; }
  
  .cab__nota { margin-top: 5px; font-size: 0.88rem; color: var(--tinta-tenue); }
  

  .filtros { display: flex; flex-wrap: wrap; gap: 9px; margin: 22px 0 18px; }
  .filtros__busca {
    display: flex;
    align-items: center;
    gap: 9px;
    flex: 1 1 240px;
    min-width: 0;
    padding: 0 14px;
    background: var(--papel);
    border: 1px solid var(--linea);
    border-radius: var(--radio-sm);
  }
  .filtros__busca :global(svg) { color: var(--tinta-tenue); flex: none; }
  .filtros__busca input { flex: 1; min-width: 0; border: 0; background: none; font: inherit; min-height: 46px; outline: none; }
  .filtros input[type='month'] {
    min-height: 48px;
    padding: 0 12px;
    border: 1px solid var(--linea);
    border-radius: var(--radio-sm);
    background: var(--papel);
    font: inherit;
  }
  

  .vacio { text-align: center; padding-block: 56px; }
  .vacio h2 { font-size: 1.2rem; }
  .vacio p { margin-top: 9px; color: var(--tinta-tenue); }
  .vacio .sis-boton { margin-top: 22px; }

  /* Lista tipo chat: cada fila es un caso, con la fecha y quién paga. */
  .casos { list-style: none; margin: 0; padding: 0; background: var(--papel);
           border: 1px solid var(--linea); border-radius: var(--radio); overflow: hidden; }
  .casos li + li { border-top: 1px solid var(--linea-tenue); }

  .casos a {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 14px;
    padding: 13px 16px;
    text-decoration: none;
    color: var(--tinta);
    transition: background-color 150ms ease;
  }
  .casos a:hover { background: var(--bruma); }

  .casos__num {
    display: grid;
    place-items: center;
    min-width: 46px;
    height: 46px;
    padding: 0 8px;
    border-radius: 12px;
    background: var(--azul-tenue);
    color: var(--azul);
    font-family: var(--titulares);
    font-weight: 700;
    font-size: 0.92rem;
  }

  .casos__cuerpo { display: flex; flex-direction: column; gap: 3px; min-width: 0; }
  .casos__linea { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; }
  .casos__linea strong {
    font-family: var(--titulares);
    font-size: 1rem;
    font-weight: 600;
    color: var(--azul);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .casos__linea em { font-style: normal; font-size: 0.78rem; color: var(--tinta-tenue); flex: none; }
  .casos__linea--baja small {
    font-size: 0.84rem;
    color: var(--tinta-suave);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .casos__paga {
    flex: none;
    font-size: 0.7rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    font-weight: 700;
    color: var(--tinta-tenue);
  }

  .casos__plata { display: none; flex-direction: column; align-items: flex-end; gap: 2px; }
  .casos__plata strong { font-family: var(--titulares); font-size: 1rem; font-weight: 700; color: var(--azul); }
  .casos__plata small { font-size: 0.72rem; color: var(--tinta-tenue); }
  @media (min-width: 620px) { .casos__plata { display: flex; } }
</style>
