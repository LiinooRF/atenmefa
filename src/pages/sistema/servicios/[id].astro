---
/**
 * Editar un servicio del catálogo.
 *
 * Corregir el precio acá cambia lo que se cobrará de ahora en adelante y
 * nada de lo ya cargado: el renglón se quedó con la copia del precio del
 * día. Por eso la pantalla dice en cuántos renglones está metido.
 */
import Sistema from '../../../layouts/Sistema.astro';
import Icono from '../../../components/Icono.astro';
import { bd, esquema } from '../../../sistema/lib/base';
import { anotar, esIdentificador } from '../../../sistema/lib/atenciones';
import {
  CATEGORIAS, MONEDAS, activarServicio, dinero, guardarServicio, rotuloCategoria,
} from '../../../sistema/lib/cobro';
import {
  componentesDePerfiles, examenesDelArchivo, examenesParaComponer, guardarComponentes, nombresDeHojas,
} from '../../../sistema/lib/laboratorio';
import { eq, sql } from 'drizzle-orm';
import { exigir } from '../../../sistema/lib/guardia';

export const prerender = false;

const corte = exigir(Astro, 'editar_catalogo');
if (corte) return corte;

const { id } = Astro.params;
const usuario = Astro.locals.usuario!;

/* Un id sin forma de uuid hace que Postgres rechace el cast y la pantalla
   termina en error de servidor. Un enlace viejo se contesta volviendo a la
   lista, que es lo que la persona quería ver. */
if (!id || !esIdentificador(id)) return Astro.redirect('/sistema/servicios');

let error = '';
/* Lo que la persona tenía escrito cuando el guardado falló. Se guarda acá
   porque el cuerpo del pedido se lee una sola vez. */
let tecleado: Record<string, string> | null = null;

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const accion = String(form.get('accion') ?? 'guardar');

  try {
    if (accion === 'componentes') {
      /* Los exámenes que trae un perfil: se marcan solos en la orden y
         recepción quita el que no va. Ver 031-componentes-de-perfil.sql. */
      const cuantos = await guardarComponentes(id, form.getAll('componente').map(String));
      await anotar(usuario.id, 'servicio', undefined, { accion: 'componentes', servicio: id, cuantos });
      return Astro.redirect(`/sistema/servicios/${id}?componentes=${cuantos}`);
    }
    if (accion === 'desactivar' || accion === 'reactivar') {
      const cambiado = await activarServicio(id, accion === 'reactivar');
      await anotar(usuario.id, 'servicio', undefined, { accion, servicio: cambiado.nombre });
    } else {
      tecleado = {
        nombre: String(form.get('nombre') ?? ''),
        categoria: String(form.get('categoria') ?? ''),
        precio: String(form.get('precio') ?? ''),
        moneda: String(form.get('moneda') ?? ''),
        plantilla: String(form.get('plantilla') ?? ''),
      };
      const guardado = await guardarServicio(id, tecleado);
      await anotar(usuario.id, 'servicio', undefined, { accion: 'edito', servicio: guardado.nombre });
    }
    return Astro.redirect('/sistema/servicios');
  } catch (e) {
    error = e instanceof Error ? e.message : 'No se pudo guardar el servicio.';
  }
}

const [servicio] = await bd
  .select()
  .from(esquema.servicio)
  .where(eq(esquema.servicio.id, id))
  .limit(1);

if (!servicio) return Astro.redirect('/sistema/servicios');

/* Cuántos renglones lo nombran. Es el argumento de por qué un servicio se
   desactiva en lugar de borrarse. */
const [cuenta] = await bd
  .select({ n: sql<number>`count(*)` })
  .from(esquema.renglon)
  .where(eq(esquema.renglon.servicioId, servicio.id));
const usos = Number(cuenta?.n ?? 0);

/* Si el guardado falló se muestra lo tecleado, no lo que está en la base:
   de otro modo se le borra la corrección a quien la escribió. */
const valor = (clave: 'nombre' | 'categoria' | 'moneda') =>
  tecleado?.[clave] ?? String(servicio[clave]);

/* El precio se muestra como se escribe acá —35,00, no 35.00— que es como lo
   devuelve la columna numeric y como lo lee de vuelta montoDe(). */
const precioVista = tecleado?.precio ?? dinero(servicio.precio);

/* Las hojas del archivo del laboratorio, para decir con cuál se informa
   este examen. Solo se ofrecen las que existen: elegir una y que después
   alguien la borre deja el informe como estaba, con una línea con su
   nombre. */
const hojas = await examenesDelArchivo();
const esDeLaboratorio = servicio.categoria === 'laboratorio';
const paraComponer = esDeLaboratorio ? await examenesParaComponer(servicio.id) : [];
const trae = esDeLaboratorio ? (await componentesDePerfiles([servicio.id])).get(servicio.id) ?? [] : [];
/* Recién creado desde Perfiles, o ya con exámenes adentro: se vuelve a
   Perfiles, no a la lista de precios. */
const perfilNuevo = Astro.url.searchParams.get('perfil') === 'nuevo';
const esPerfil = perfilNuevo || trae.length > 0;
const yaTrae = new Set(trae.map((c) => c.id));
const avisoComponentes = Astro.url.searchParams.get('componentes');
const nombreHoja = await nombresDeHojas();
const plantillaVista = tecleado?.plantilla ?? servicio.plantilla ?? '';
---

<Sistema titulo={servicio.nombre}>
  <nav class="miga">
    <a href="/sistema">Casos</a> <span>/</span>
    {esPerfil
      ? <><a href="/sistema/laboratorio">Laboratorio</a> <span>/</span> <a href="/sistema/perfiles">Perfiles</a> <span>/</span></>
      : <><a href="/sistema/servicios">Servicios</a> <span>/</span></>}
    {servicio.nombre}
  </nav>

  <header class="cab">
    <div>
      <div class="cab__linea">
        <h1>{servicio.nombre}</h1>
        {!servicio.activo && <span class="chapa">Desactivado</span>}
      </div>
      <p class="cab__meta">
        {rotuloCategoria(servicio.categoria)} ·
        {usos === 0
          ? 'todavía no se cargó en ninguna atención'
          : `cargado en ${usos} ${usos === 1 ? 'renglón' : 'renglones'}`}
      </p>
    </div>
  </header>

  {error && (
    <p class="sis-error edita__error">
      <Icono nombre="escudo" tam={18} />
      {error}
    </p>
  )}

  <form method="post" class="edita sis-tarjeta">
    <div class="edita__campos">
      <div class="sis-campo edita__nombre">
        <label for="nombre">Servicio</label>
        <input id="nombre" name="nombre" value={valor('nombre')} required autocomplete="off" />
      </div>

      <div class="sis-campo">
        <label for="categoria">Categoría</label>
        <select id="categoria" name="categoria">
          {CATEGORIAS.map((c) => (
            <option value={c.clave} selected={valor('categoria') === c.clave}>{c.rotulo}</option>
          ))}
        </select>
      </div>

      <div class="sis-campo">
        <label for="precio">Precio</label>
        <input id="precio" name="precio" value={precioVista} required
               inputmode="decimal" autocomplete="off" />
        <span class="pista">Lo ya cargado conserva el precio del día.</span>
      </div>

      <div class="sis-campo">
        <label for="moneda">Moneda</label>
        <select id="moneda" name="moneda">
          {MONEDAS.map((m) => (
            <option value={m} selected={valor('moneda') === m}>{m}</option>
          ))}
        </select>
      </div>

      {/* Solo los exámenes se informan con una hoja: una consulta o un
          traslado no tienen renglones. Si la categoría se cambia a otra, el
          select desaparece y el guardado deja la hoja en NULL. */}
      {valor('categoria') === 'laboratorio' && (
        <div class="sis-campo">
          <label for="plantilla">Se informa con la hoja</label>
          <select id="plantilla" name="plantilla">
            <option value="" selected={!plantillaVista}>Una línea con su nombre</option>
            {hojas.map((h) => (
              <option value={h} selected={plantillaVista === h}>{nombreHoja.get(h) ?? h}</option>
            ))}
          </select>
          <span class="pista">
            Con la hoja elegida, el informe de resultados abre con sus renglones.
          </span>
        </div>
      )}
    </div>

    <div class="edita__pie">
      <p class="edita__nota">
        Un servicio no se borra: se desactiva y deja de aparecer en el
        selector de cobro, pero sigue nombrado en los renglones ya cargados.
      </p>
      <div class="edita__acciones">
        <a class="sis-boton sis-boton--suave" href="/sistema/servicios">Volver</a>
        <button type="submit" name="accion" value={servicio.activo ? 'desactivar' : 'reactivar'}
                formnovalidate class="sis-boton sis-boton--suave">
          {servicio.activo ? 'Desactivar' : 'Reactivar'}
        </button>
        <button type="submit" name="accion" value="guardar" class="sis-boton sis-boton--primario">
          <Icono nombre="escudo" tam={18} />
          Guardar cambios
        </button>
      </div>
    </div>
  </form>

  {esDeLaboratorio && (
    <form method="post" class="sis-tarjeta componentes" id="componentes">
      <input type="hidden" name="accion" value="componentes" />
      <h2>Si es un perfil: los exámenes que trae</h2>
      <p class="edita__nota">
        En la orden, al marcar <strong>{servicio.nombre}</strong> se despliegan estos
        exámenes ya marcados, y recepción quita el que no va. Se cobra el precio del
        perfil menos el precio suelto de lo quitado; lo que no se vende suelto no
        descuenta. Al laboratorio le llegan solo los que quedaron.
      </p>
      {perfilNuevo && avisoComponentes === null && (
        <p class="componentes__ok" role="status">Perfil creado. Marque abajo los exámenes que trae y guarde.</p>
      )}
      {avisoComponentes !== null && (
        <p class="componentes__ok" role="status">Guardado: trae {avisoComponentes} exámenes.</p>
      )}
      <div class="sis-campo">
        <label for="filtro-componentes">Buscar</label>
        <input id="filtro-componentes" type="search" placeholder="Colesterol, TSH…" autocomplete="off" />
      </div>
      <ul class="componentes__lista">
        {paraComponer.map((e) => (
          <li data-busca={e.nombre.toLocaleLowerCase('es')}>
            <label>
              <input type="checkbox" name="componente" value={e.id} checked={yaTrae.has(e.id)} />
              <span>{e.nombre}</span>
              {!e.activo && <small>no se vende suelto</small>}
            </label>
          </li>
        ))}
      </ul>
      <button type="submit" class="sis-boton sis-boton--primario">Guardar los exámenes del perfil</button>
    </form>
  )}
</Sistema>

<script>
  // Filtra la lista larga sin esconder lo marcado.
  const filtro = document.getElementById('filtro-componentes') as HTMLInputElement | null;
  filtro?.addEventListener('input', () => {
    const q = filtro.value.trim().toLocaleLowerCase('es');
    document.querySelectorAll<HTMLElement>('.componentes__lista li').forEach((li) => {
      const marcado = li.querySelector<HTMLInputElement>('input')?.checked;
      li.hidden = Boolean(q) && !marcado && !(li.dataset.busca ?? '').includes(q);
    });
  });
</script>

<style>
  .miga { font-size: var(--u-sm); color: var(--tinta-tenue); margin-bottom: 14px; }
  .miga a { color: var(--tinta-suave); text-decoration: none; }
  .miga a:hover { color: var(--azul); text-decoration: underline; }
  .miga span { margin-inline: 5px; }

  .cab { display: flex; flex-wrap: wrap; gap: 14px; align-items: flex-start; justify-content: space-between; }
  .cab__linea { display: flex; flex-wrap: wrap; align-items: center; gap: 11px; }
  .cab__meta { margin-top: 6px; font-size: var(--u-sm); color: var(--tinta-tenue); }

  .chapa {
    font-size: var(--u-xs);
    font-weight: 700;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    padding: 4px 10px;
    border-radius: 999px;
    background: var(--panel);
    color: var(--tinta-tenue);
  }

  .edita__error { margin-top: 18px; }

  .edita { margin-top: 20px; max-width: 760px; padding: 20px; }
  .edita__campos { display: grid; grid-template-columns: minmax(0, 1fr); gap: 14px; }
  @media (min-width: 720px) {
    .edita__campos { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .edita__nombre { grid-column: 1 / -1; }
  }

  .edita__pie {
    margin-top: 20px;
    padding-top: 16px;
    border-top: 1px solid var(--linea-tenue);
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    align-items: center;
    justify-content: space-between;
  }
  .edita__nota { font-size: var(--u-sm); color: var(--tinta-tenue); max-width: 46ch; }
  .edita__acciones { display: flex; flex-wrap: wrap; gap: 10px; margin-left: auto; }
  .edita__acciones .sis-boton { min-height: 44px; }
  .componentes { display: grid; gap: 12px; margin-top: 18px; padding: 18px; }
  .componentes h2 { font-size: var(--u-md); }
  .componentes__ok { padding: 10px 13px; border-radius: 8px; background: #e4f2ea; border: 1px solid #a9d5bd; color: #105433; font-size: var(--u-sm); }
  .componentes__lista { list-style: none; margin: 0; padding: 0; max-height: 420px; overflow-y: auto; border: 1px solid var(--linea-tenue); border-radius: 8px; }
  .componentes__lista li { border-top: 1px solid var(--linea-tenue); }
  .componentes__lista li:first-child { border-top: 0; }
  .componentes__lista li[hidden] { display: none; }
  .componentes__lista label { display: flex; align-items: center; gap: 10px; min-height: 44px; padding: 0 12px; }
  .componentes__lista small { margin-left: auto; color: var(--tinta-tenue); font-size: var(--u-xs); }
  .componentes button { justify-self: start; }
</style>
