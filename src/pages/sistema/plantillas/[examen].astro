---
/**
 * Los renglones de un examen: analito, unidad y valor de referencia.
 *
 * Esto es lo que se carga solo cuando el bioanalista elige el examen en la
 * pantalla de resultados, y lo que sale impreso al lado de cada valor.
 * Corregirlo acá lo corrige para todas las órdenes que vengan; lo que ya
 * está guardado en una orden vieja no se toca, porque un informe firmado
 * dice lo que decía el día que se firmó.
 */
import Sistema from '../../../layouts/Sistema.astro';
import Icono from '../../../components/Icono.astro';
import { anotar } from '../../../sistema/lib/atenciones';
import { exigir } from '../../../sistema/lib/guardia';
import { plantillaDe, guardarPlantilla } from '../../../sistema/lib/laboratorio';

export const prerender = false;

const corte = exigir(Astro, 'editar_plantillas');
if (corte) return corte;

const usuario = Astro.locals.usuario!;
const examen = decodeURIComponent(Astro.params.examen ?? '');

let aviso = '';
let error = '';

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const analitos = form.getAll('analito').map(String);
  const unidades = form.getAll('unidad').map(String);
  const referencias = form.getAll('referencia').map(String);
  /* Las casillas sin marcar no viajan en un formulario, así que cada fila
     manda además un campo oculto con su número y la casilla manda el
     mismo: lo que queda marcado es lo que aparece en la lista corta. */
  const filaDe = form.getAll('fila').map(String);
  const titulos = new Set(form.getAll('titulo').map(String));

  /* Los tres arreglos vienen del mismo formulario y tienen que medir lo
     mismo. Si no, algo se perdió en el camino y guardar emparejaría el
     rango de un analito con el de al lado: se para acá. */
  if (analitos.length !== unidades.length || analitos.length !== referencias.length
      || analitos.length !== filaDe.length) {
    error = 'Los renglones llegaron incompletos. Vuelva a cargar la página y pruebe otra vez.';
  } else {
    const cuantos = await guardarPlantilla(
      examen,
      analitos.map((a, i) => ({
        analito: a,
        unidad: unidades[i],
        referencia: referencias[i],
        tipo: titulos.has(filaDe[i]) ? 'titulo' : 'analito',
      })),
    );
    await anotar(usuario.id, 'plantilla', undefined, { examen, renglones: cuantos });
    aviso = `Guardado. ${cuantos} ${cuantos === 1 ? 'renglón' : 'renglones'}.`;
  }
}

const filas = await plantillaDe(examen);
if (filas.length === 0 && !aviso) return Astro.redirect('/sistema/plantillas');

/* Un subtítulo —«TIEMPO DE PROTROMBINA:», «ANALISIS QUIMICO:»— no es un
   analito al que le falte el rango: no se cuenta ni se pinta en amarillo.
   Ya no se adivina por descarte; es un dato de la fila, y se cambia con la
   casilla de la derecha. */
const esTitulo = (f: { tipo: string }) => f.tipo === 'titulo';
const analitos = filas.filter((f) => !esTitulo(f));
const faltanDeVerdad = analitos.filter((f) => !f.referencia.trim()).length;
---

<Sistema titulo={`Referencia · ${examen}`}>
  <nav class="miga">
    <a href="/sistema/laboratorio">Laboratorio</a> <span>/</span>
    <a href="/sistema/plantillas">Valores de referencia</a> <span>/</span> {examen}
  </nav>

  <header class="cab">
    <h1>{examen}</h1>
    <p class="cab__nota">
      {analitos.length} {analitos.length === 1 ? 'analito' : 'analitos'}
      {filas.length !== analitos.length &&
        ` y ${filas.length - analitos.length} ${filas.length - analitos.length === 1 ? 'subtítulo' : 'subtítulos'}`}.
      {faltanDeVerdad > 0
        ? ` ${faltanDeVerdad} sin rango de referencia.`
        : ' Todos tienen su rango.'}
    </p>
  </header>

  {error && <p class="sis-error msj"><Icono nombre="escudo" tam={18} />{error}</p>}
  {aviso && <p class="msj msj--bien"><Icono nombre="escudo" tam={18} />{aviso}</p>}

  <form method="post">
    <div class="tablon">
      <table class="pl">
        <thead>
          <tr>
            <th scope="col" class="pl__que">Analito</th>
            <th scope="col">Unidad</th>
            <th scope="col">Valor de referencia</th>
            <th scope="col" class="pl__es">Subtítulo</th>
            <th scope="col"><span class="oculto">Quitar</span></th>
          </tr>
        </thead>
        <tbody id="pl-cuerpo">
          {filas.map((f, i) => (
            <tr data-falta={!f.referencia.trim() && !esTitulo(f) ? '' : undefined}
                data-titulo={esTitulo(f) ? '' : undefined}>
              <td data-rotulo="Analito">
                <input type="hidden" name="fila" value={String(i)} />
                <input type="text" name="analito" value={f.analito}
                       aria-label={`Analito del renglón ${i + 1}`} autocomplete="off" />
              </td>
              <td data-rotulo="Unidad">
                <input type="text" name="unidad" value={f.unidad}
                       aria-label={`Unidad de ${f.analito}`} autocomplete="off" />
              </td>
              <td data-rotulo="Valor de referencia">
                <input type="text" name="referencia" value={f.referencia}
                       aria-label={`Valor de referencia de ${f.analito}`} autocomplete="off" />
              </td>
              <td class="pl__es" data-rotulo="Subtítulo">
                <label class="marca">
                  <input type="checkbox" name="titulo" value={String(i)}
                         checked={esTitulo(f)}
                         aria-label={`${f.analito} es un subtítulo del informe`} />
                  <span class="oculto">Es un subtítulo</span>
                </label>
              </td>
              <td class="pl__quitar">
                <button type="button" class="quitar" data-quitar
                        aria-label={`Quitar ${f.analito}`}>×</button>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <div class="agregar">
      <button type="button" class="sis-boton sis-boton--suave" id="pl-mas">
        <Icono nombre="mas" tam={17} />
        Agregar renglón
      </button>
    </div>

    <p class="nota">
      Tal como se escriba acá sale impreso: «70 - 140 ml / min.», «Hombre:
      12-17 / Mujer: 11-15», «HASTA 200». No hace falta que sean números —el
      informe lo copia como texto— y por eso caben los cualitativos, que se
      informan «NEGATIVO».
    </p>
    <p class="nota">
      Marcar <strong>subtítulo</strong> convierte el renglón en un encabezado
      de bloque del informe —así separa la hoja de coagulación el tiempo de
      protrombina del PTT—: no lleva unidad ni rango y no cuenta entre los que
      faltan. Lo contrario también: el tipiaje y el VDRL no tienen rango
      porque se informan con una palabra, y son analitos igual.
    </p>

    <div class="pie">
      <span class="pie__estado">
        {analitos.length === 0
          ? 'Sin analitos: todos los renglones son subtítulos.'
          : `${analitos.length - faltanDeVerdad} de ${analitos.length} con rango.`}
      </span>
      <div class="pie__botones">
        <a class="sis-boton sis-boton--suave" href="/sistema/plantillas">Volver</a>
        <button type="submit" class="sis-boton sis-boton--primario">
          <Icono nombre="escudo" tam={17} />
          Guardar
        </button>
      </div>
    </div>
  </form>
</Sistema>

<script>
  /* Agregar y quitar renglones. El orden de la pantalla ES el orden del
     informe: al guardar se vuelven a numerar de arriba abajo. */
  const cuerpo = document.getElementById('pl-cuerpo');
  const mas = document.getElementById('pl-mas');

  if (cuerpo && mas) {
    /* El molde se saca de la primera fila al cargar, antes de que alguien
       la edite: clonar la ÚLTIMA copiaría lo que esa fila tenga escrito. */
    const molde = cuerpo.querySelector('tr')?.cloneNode(true) as HTMLTableRowElement | undefined;

    /* Cada fila lleva un número propio: el oculto y el de la casilla tienen
       que ser el mismo, y no se pueden repetir. Clonar la primera copiaba
       su número y al guardar dos filas distintas decían ser la misma. */
    let proximo = cuerpo.querySelectorAll('tr').length;

    mas.addEventListener('click', () => {
      if (!molde) return;
      const fila = molde.cloneNode(true) as HTMLTableRowElement;
      fila.removeAttribute('data-falta');
      fila.removeAttribute('data-titulo');

      const numero = String(proximo++);
      fila.querySelectorAll('input').forEach((i) => {
        const campo = i as HTMLInputElement;
        if (campo.type === 'checkbox') { campo.checked = false; campo.value = numero; return; }
        campo.value = campo.name === 'fila' ? numero : '';
      });

      cuerpo.appendChild(fila);
      fila.querySelector<HTMLInputElement>('input[name="analito"]')?.focus();
    });

    cuerpo.addEventListener('click', (e) => {
      const boton = (e.target as HTMLElement).closest('[data-quitar]');
      if (!boton) return;
      const fila = boton.closest('tr');
      /* Nunca se queda sin ninguna: si es la última se vacía en vez de
         borrarse, para que quede dónde escribir. */
      if (cuerpo.querySelectorAll('tr').length > 1) fila?.remove();
      else fila?.querySelectorAll('input').forEach((i) => { i.value = ''; });
    });

    /* El amarillo se apaga en cuanto se escribe el rango: ver que el aviso
       se va es la confirmación de que quedó cargado. */
    cuerpo.addEventListener('input', (e) => {
      const campo = e.target as HTMLInputElement;
      if (campo.name !== 'referencia') return;
      const fila = campo.closest('tr');
      if (campo.value.trim()) fila?.removeAttribute('data-falta');
    });

    /* Marcar «subtítulo» apaga la unidad y el rango en el acto: así se ve
       que ese renglón deja de ser un analito antes de guardar. */
    cuerpo.addEventListener('change', (e) => {
      const campo = e.target as HTMLInputElement;
      if (campo.name !== 'titulo') return;
      const fila = campo.closest('tr');
      if (!fila) return;
      if (campo.checked) {
        fila.setAttribute('data-titulo', '');
        fila.removeAttribute('data-falta');
        fila.querySelectorAll<HTMLInputElement>('input[name="unidad"], input[name="referencia"]')
          .forEach((i) => { i.value = ''; });
      } else {
        fila.removeAttribute('data-titulo');
        const rango = fila.querySelector<HTMLInputElement>('input[name="referencia"]');
        if (!rango?.value.trim()) fila.setAttribute('data-falta', '');
      }
    });
  }
</script>

<style>
  .miga { font-size: var(--u-sm); color: var(--tinta-tenue); margin-bottom: 14px; }
  .miga a { color: var(--tinta-suave); text-decoration: none; }
  .miga a:hover { color: var(--azul); text-decoration: underline; }
  .miga span { margin-inline: 5px; }

  .cab h1 { font-size: var(--u-xl); }
  .cab__nota { margin-top: 5px; font-size: var(--u-sm); color: var(--tinta-tenue); }

  .msj {
    display: flex; gap: 9px; align-items: center;
    margin: 16px 0; padding: 11px 13px; border-radius: 9px; font-size: var(--u-sm);
  }
  .msj--bien { border: 1px solid #2f8f5b; background: #eaf6ef; color: #1f6b43; }

  /* La tabla se desplaza dentro de su caja: el panel nunca se mueve de lado. */
  .tablon { margin-top: 16px; border: 1px solid var(--linea); border-radius: 10px; overflow-x: auto; background: var(--papel); }
  .pl { width: 100%; min-width: 680px; border-collapse: collapse; }
  .pl th {
    text-align: left; padding: 9px 12px;
    border-bottom: 1px solid var(--linea);
    font-size: var(--u-xs); text-transform: uppercase; letter-spacing: 0.05em;
    color: var(--tinta-tenue); background: var(--panel);
  }
  .pl td { padding: 4px 8px; border-bottom: 1px solid var(--linea-tenue); }
  .pl tbody tr:last-child td { border-bottom: 0; }
  .pl__que { width: 34%; }
  .pl__es { width: 86px; text-align: center; }
  .pl__quitar { width: 44px; text-align: center; }

  /* El subtítulo se ve como lo que es: un encabezado, no un renglón al que
     le falte algo. Y sus campos de unidad y rango quedan apagados. */
  .pl tr[data-titulo] { background: var(--panel); }
  .pl tr[data-titulo] input[name='analito'] { font-weight: 700; }
  .pl tr[data-titulo] input[name='unidad'],
  .pl tr[data-titulo] input[name='referencia'] { opacity: 0.35; pointer-events: none; }

  .marca { display: inline-flex; align-items: center; justify-content: center; min-height: 44px; min-width: 44px; cursor: pointer; }
  .marca input { width: 19px; height: 19px; accent-color: var(--azul); cursor: pointer; }

  .pl input {
    width: 100%;
    /* 44 px de alto: se escribe de pie, en el mesón. */
    min-height: 44px;
    padding: 6px 9px;
    border: 1px solid transparent;
    border-radius: 7px;
    background: transparent;
    font: inherit; font-family: var(--ui); font-size: var(--u-sm);
  }
  .pl input:hover { border-color: var(--linea); }
  .pl input:focus { border-color: var(--azul); background: var(--papel); outline: none; }

  /* El que no tiene rango se ve de lejos: es la razón de esta pantalla. */
  .pl tr[data-falta] { background: #fdf6e4; }
  .pl tr[data-falta] input[name='referencia'] { border-color: #e2b23d; }

  .quitar {
    width: 32px; height: 32px;
    border: 1px solid var(--linea); border-radius: 7px;
    background: var(--papel); color: var(--tinta-tenue);
    font-size: 1.1rem; line-height: 1; cursor: pointer;
  }
  .quitar:hover { border-color: var(--rojo); color: var(--rojo); }

  .agregar { margin-top: 12px; }
  .oculto {
    position: absolute; width: 1px; height: 1px;
    overflow: hidden; clip-path: inset(50%); white-space: nowrap;
  }

  .nota { margin: 12px 0 0; font-size: var(--u-xs); color: var(--tinta-tenue); max-width: 76ch; line-height: 1.55; }

  .pie {
    display: flex; flex-wrap: wrap; gap: 12px;
    align-items: center; justify-content: space-between;
    margin-top: 20px; padding-top: 16px; border-top: 1px solid var(--linea-tenue);
  }
  .pie__estado { font-size: var(--u-sm); color: var(--tinta-tenue); }
  .pie__botones { display: flex; flex-wrap: wrap; gap: 8px; }

  @media (max-width: 620px) {
    .pl { min-width: 0; }
    .pl thead { display: none; }
    .pl, .pl tbody, .pl tr, .pl td { display: block; width: 100%; }
    .pl tr { padding: 10px 12px; border-bottom: 1px solid var(--linea); position: relative; }
    .pl td { border: 0; padding: 2px 0; }
    .pl td::before {
      content: attr(data-rotulo);
      display: block;
      font-size: var(--u-xs); color: var(--tinta-tenue); margin-bottom: 2px;
    }
    .pl input { border-color: var(--linea); background: var(--papel); }
    .pl__quitar { position: absolute; top: 10px; right: 12px; width: auto; }
    .pl__quitar::before { content: none; }
  }
</style>
