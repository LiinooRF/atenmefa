---
/**
 * Las interconsultas que hay que resolver.
 *
 * El médico ya dijo qué especialidad hace falta y para qué. Acá
 * administración ve, para cada una, los especialistas de esa área con lo
 * que cobran, y les escribe por WhatsApp con un toque y el mensaje ya
 * armado. Antes había que buscar en una libreta a quién llamar, cuánto
 * cobra y cuál es su número.
 *
 * Contactar abre WhatsApp en otra pestaña y deja anotado a quién se le
 * escribió. Cuando el especialista ya vio al paciente, se da por atendida.
 */
import Sistema from '../../layouts/Sistema.astro';
import Icono from '../../components/Icono.astro';
import { exigir } from '../../sistema/lib/guardia';
import { dinero } from '../../sistema/lib/cobro';
import { comoSeLee } from '../../sistema/lib/telefono';
import {
  ROTULO_ESTADO, anularInterconsulta, contactar, especialistasPorEspecialidad,
  interconsultasAbiertas, marcarAtendida,
} from '../../sistema/lib/interconsultas';

export const prerender = false;

const corte = exigir(Astro, 'gestionar_interconsultas');
if (corte) return corte;
const usuario = Astro.locals.usuario!;

let error = '';

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const accion = String(form.get('accion') ?? '');
  const id = String(form.get('interconsulta') ?? '');
  try {
    if (accion === 'contactar') {
      // Se anota primero y recién después se abre el chat: ver contactar().
      const enlace = await contactar(usuario, id, String(form.get('especialista') ?? ''));
      return Astro.redirect(enlace, 303);
    }
    if (accion === 'atendida') {
      await marcarAtendida(usuario, id);
      return Astro.redirect('/sistema/interconsultas?hecho=atendida');
    }
    if (accion === 'anular') {
      await anularInterconsulta(usuario, id, form.get('motivo'));
      return Astro.redirect('/sistema/interconsultas?hecho=anulada');
    }
    return Astro.redirect('/sistema/interconsultas');
  } catch (e) {
    error = e instanceof Error ? e.message : 'No se pudo hacer.';
  }
}

const abiertas = await interconsultasAbiertas();
const porArea = await especialistasPorEspecialidad([...new Set(abiertas.map((a) => a.especialidadBusca))]);
const pendientes = abiertas.filter((a) => a.estado === 'pendiente').length;

const hecho = Astro.url.searchParams.get('hecho');
const aviso = hecho === 'atendida' ? 'Quedó como atendida.'
  : hecho === 'anulada' ? 'Quedó anulada. El médico la ve así en la consulta.' : '';

const cuando = (d: Date) => d.toLocaleString('es-VE', {
  timeZone: 'America/Caracas', day: 'numeric', month: 'short', hour: 'numeric', minute: '2-digit',
});
---

<Sistema titulo="Interconsultas">
  <div class="cab">
    <div>
      <h1>Interconsultas</h1>
      <p class="cab__nota">
        {abiertas.length === 0 ? 'Nada pendiente'
          : `${pendientes} sin contactar · ${abiertas.length - pendientes} esperando al especialista`}
      </p>
    </div>
    <a class="sis-boton sis-boton--suave" href="/sistema/especialistas">
      <Icono nombre="estetoscopio" tam={18} />
      Especialistas y precios
    </a>
  </div>

  {aviso && <p class="msj--bien" role="status"><Icono nombre="escudo" tam={18} />{aviso}</p>}
  {error && <p class="sis-error" role="alert">{error}</p>}

  {abiertas.length === 0 ? (
    <div class="sis-tarjeta vacio">
      <h2>No hay interconsultas abiertas</h2>
      <p>Cuando un médico pida una desde la consulta, aparece acá con los especialistas de esa área.</p>
    </div>
  ) : (
    <ul class="lista">
      {abiertas.map((ic) => {
        const especialistas = porArea.get(ic.especialidadBusca) ?? [];
        return (
          <li class:list={['sis-tarjeta', 'ic', `ic--${ic.estado}`]}>
            <div class="ic__cabeza">
              <div>
                <h2>{ic.especialidad}</h2>
                <p class="ic__quien">
                  <a href={`/sistema/atencion/${ic.atencionId}#interconsultas`}>{ic.paciente}</a>
                  <span class="cifra"> {ic.cedula}</span> · atención N° {ic.numero}
                </p>
              </div>
              <span class="ic__estado">{ROTULO_ESTADO[ic.estado]}</span>
            </div>
            {ic.motivo && <p class="ic__motivo">{ic.motivo}</p>}
            <p class="ic__meta">
              Pidió {ic.medico}, {cuando(ic.pedida)}
              {ic.contactada && <> · se le escribió a {ic.especialista}, {cuando(ic.contactada)}</>}
            </p>

            {especialistas.length === 0 ? (
              <p class="ic__falta">
                No hay especialistas de {ic.especialidad} cargados.
                <a href="/sistema/especialistas">Cargue uno</a> con su precio y su WhatsApp.
              </p>
            ) : (
              <table class="esp">
                <thead>
                  <tr><th scope="col">Especialista</th><th scope="col">Consulta</th><th scope="col"><span class="oculto">Contactar</span></th></tr>
                </thead>
                <tbody>
                  {especialistas.map((e) => (
                    <tr>
                      <td>
                        <strong>{e.nombre}</strong>
                        {e.notas && <small class="esp__notas">{e.notas}</small>}
                      </td>
                      <td class="cifra">{e.precio ? `${dinero(e.precio)} ${e.moneda}` : 'Sin precio'}</td>
                      <td class="esp__accion">
                        {e.whatsapp ? (
                          <form method="post" target="_blank" data-contactar>
                            <input type="hidden" name="accion" value="contactar" />
                            <input type="hidden" name="interconsulta" value={ic.id} />
                            <input type="hidden" name="especialista" value={e.id} />
                            <button type="submit" class="sis-boton sis-boton--azul"
                                    title={`Abre WhatsApp con ${comoSeLee(e.whatsapp)}`}>
                              <Icono nombre="correo" tam={17} />
                              Contactar
                            </button>
                          </form>
                        ) : (
                          <small>Sin WhatsApp cargado</small>
                        )}
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            )}

            <div class="ic__pie">
              {ic.estado === 'contactada' && (
                <form method="post">
                  <input type="hidden" name="accion" value="atendida" />
                  <input type="hidden" name="interconsulta" value={ic.id} />
                  <button type="submit" class="sis-boton sis-boton--suave">Ya lo atendió</button>
                </form>
              )}
              <details>
                <summary>Anular</summary>
                <form method="post" class="ic__anular sis-campo">
                  <input type="hidden" name="accion" value="anular" />
                  <input type="hidden" name="interconsulta" value={ic.id} />
                  <label for={`motivo-${ic.id}`}>¿Por qué se anula?</label>
                  <input id={`motivo-${ic.id}`} name="motivo" type="text" required maxlength="1000" />
                  <button type="submit" class="sis-boton sis-boton--suave">Anular</button>
                </form>
              </details>
            </div>
          </li>
        );
      })}
    </ul>
  )}
</Sistema>

<script>
  /* WhatsApp se abre en otra pestaña. Esta se recarga sola para que la
     interconsulta pase a «especialista contactado» sin tener que acordarse
     de actualizar. */
  document.querySelectorAll<HTMLFormElement>('[data-contactar]').forEach((f) => {
    f.addEventListener('submit', () => setTimeout(() => location.reload(), 1200));
  });
</script>

<style>
  .cab { display: flex; flex-wrap: wrap; gap: 14px; align-items: center; justify-content: space-between; }
  .cab h1 { font-size: var(--u-2xl); }
  .cab__nota { margin-top: 5px; font-size: var(--u-sm); color: var(--tinta-tenue); }
  .msj--bien {
    display: flex; align-items: flex-start; gap: 9px; margin-top: 16px; padding: 11px 14px;
    border-radius: 8px; background: #e4f2ea; border: 1px solid #a9d5bd; color: #105433; font-size: var(--u-sm);
  }
  .sis-error { margin-top: 16px; }
  .vacio { margin-top: 20px; text-align: center; padding-block: 48px; }
  .vacio h2 { font-size: var(--u-lg); }
  .vacio p { margin-top: 6px; color: var(--tinta-suave); }
  .lista { list-style: none; margin: 20px 0 0; padding: 0; display: grid; gap: 14px; }
  .ic { padding: 16px 18px; }
  .ic__cabeza { display: flex; flex-wrap: wrap; align-items: flex-start; justify-content: space-between; gap: 8px 14px; }
  .ic__cabeza h2 { font-size: var(--u-lg); }
  .ic__quien { margin-top: 3px; font-size: var(--u-sm); }
  .ic__estado { font-size: var(--u-xs); padding: 3px 10px; border-radius: 999px; background: var(--azul-tenue); }
  .ic--pendiente .ic__estado { background: #fff1cc; color: #6b4b00; }
  .ic__motivo { margin-top: 10px; white-space: pre-wrap; overflow-wrap: anywhere; }
  .ic__meta { margin-top: 6px; font-size: var(--u-sm); color: var(--tinta-tenue); }
  .ic__falta { margin-top: 12px; padding: 10px 12px; border-radius: 8px; background: #fff8e6; border: 1px solid #ecd28f; font-size: var(--u-sm); }
  .esp { width: 100%; margin-top: 12px; border-collapse: collapse; font-size: var(--u-sm); }
  .esp th { text-align: left; font-weight: 600; color: var(--tinta-suave); padding: 6px 8px 6px 0; border-bottom: 1px solid var(--linea); }
  .esp td { padding: 9px 8px 9px 0; border-bottom: 1px solid var(--linea-tenue); vertical-align: middle; }
  .esp__notas { display: block; color: var(--tinta-tenue); }
  .esp__accion { text-align: right; white-space: nowrap; }
  .ic__pie { display: flex; flex-wrap: wrap; align-items: center; gap: 10px 16px; margin-top: 14px; font-size: var(--u-sm); }
  .ic__pie summary { cursor: pointer; color: var(--tinta-suave); }
  .ic__anular { display: grid; gap: 7px; margin-top: 8px; max-width: 420px; }
  .oculto { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  @media (max-width: 560px) {
    .esp thead { display: none; }
    .esp tr { display: grid; grid-template-columns: 1fr auto; gap: 4px 10px; padding: 9px 0; border-bottom: 1px solid var(--linea-tenue); }
    .esp td { border: 0; padding: 0; }
    .esp__accion { grid-column: 1 / -1; text-align: left; }
  }
</style>
