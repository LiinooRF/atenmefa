---
/**
 * El catálogo de servicios: la lista de la que sale cada renglón de cobro.
 *
 * Nada se borra. Un servicio que deja de prestarse se desactiva: sigue
 * nombrado en los renglones ya cargados y en los cierres de mes viejos.
 */
import Sistema from '../../layouts/Sistema.astro';
import Icono from '../../components/Icono.astro';
import { anotar } from '../../sistema/lib/atenciones';
import { exigir } from '../../sistema/lib/guardia';
import {
  CATEGORIAS, MONEDAS, catalogo, crearServicio, activarServicio,
  dinero, porCategoria, rotuloCategoria,
} from '../../sistema/lib/cobro';
import { asegurarTasa, tasaPara, enBolivares, MONEDA_BASE } from '../../sistema/lib/tasa';
import {
  cargarExamenesAlCatalogo, determinacionesDelArchivo, faltanEnElCatalogo,
} from '../../sistema/lib/laboratorio';
import { hoyEnCaracas } from '../../sistema/lib/fechas';

export const prerender = false;

const corte = exigir(Astro, 'editar_catalogo');
if (corte) return corte;

const usuario = Astro.locals.usuario!;
const verTodos = Astro.url.searchParams.get('todos') === 'si';

/* Acá la tasa es la de HOY, y esa diferencia importa. En el cierre y en el
   cobro cada monto se convierte con la tasa de SU día, porque son cosas que
   ya pasaron y valen lo que valían. Un precio de catálogo no pasó: es lo que
   se cobra hoy, y lo que el paciente va a pagar hoy en bolívares. */
await asegurarTasa();
const tasaHoy = await tasaPara(hoyEnCaracas());

/* "6 de noviembre" y no "2026-11-06": lo lee una persona, no una máquina. */
const fechaDeLaTasa = tasaHoy
  ? new Date(`${tasaHoy.fecha}T12:00:00`).toLocaleDateString('es-VE', {
      day: 'numeric', month: 'long',
    })
  : '';

let error = '';
/* Lo tipeado vuelve a la pantalla si el alta falla: nadie quiere escribir
   el mismo servicio dos veces. */
let nuevo = { nombre: '', categoria: 'consulta', precio: '', moneda: 'USD' };
let aviso = '';

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const accion = form.get('accion');

  try {
    if (accion === 'cargar-laboratorio') {
      /* Lo que trae el archivo del laboratorio, de un golpe: las
         determinaciones como exámenes con precio y las hojas como perfiles.
         Entran en cero: no tenemos sus precios y uno inventado termina
         cobrado. Ver cargarExamenesAlCatalogo. */
      const r = await cargarExamenesAlCatalogo();
      if (r.examenes === 0 && r.perfiles === 0) {
        aviso = 'Ya estaba todo lo del archivo del laboratorio.';
      } else {
        await anotar(usuario.id, 'servicio', undefined, { accion: 'cargo_laboratorio', ...r });
        const partes = [
          r.examenes > 0 ? `${r.examenes} exámenes, todos sin precio` : '',
          r.perfiles > 0 ? `${r.perfiles} perfiles` : '',
          r.apagados > 0 ? `y se apagaron ${r.apagados} renglones viejos que ahora son perfiles` : '',
        ].filter(Boolean);
        aviso = `Se cargaron ${partes.join(', ')}. Póngales el precio acá abajo.`;
      }
    } else if (accion === 'desactivar' || accion === 'reactivar') {
      const cambiado = await activarServicio(String(form.get('id') ?? ''), accion === 'reactivar');
      await anotar(usuario.id, 'servicio', undefined, { accion, servicio: cambiado.nombre });
      /* Al desactivar se muestran también los apagados: si la fila
         desapareciera sin más, parecería que el servicio se borró. */
      return Astro.redirect(
        accion === 'desactivar' ? '/sistema/servicios?todos=si' : `/sistema/servicios${verTodos ? '?todos=si' : ''}`,
      );
    } else {
      nuevo = {
        nombre: String(form.get('nombre') ?? ''),
        categoria: String(form.get('categoria') ?? 'consulta'),
        precio: String(form.get('precio') ?? ''),
        moneda: String(form.get('moneda') ?? 'USD'),
      };
      const creado = await crearServicio(nuevo);
      await anotar(usuario.id, 'servicio', undefined, { accion: 'creo', servicio: creado.nombre });
      // Redirigir después de guardar: así recargar no vuelve a dar de alta.
      return Astro.redirect(`/sistema/servicios${verTodos ? '?todos=si' : ''}`);
    }
  } catch (e) {
    error = e instanceof Error ? e.message : 'No se pudo guardar el servicio.';
  }
}

const servicios = await catalogo(true);
const activos = servicios.filter((s) => s.activo);
/* Cuántos exámenes del archivo del laboratorio todavía no están en el
   catálogo, y cuántos de los que están siguen en cero. Las dos cifras son
   la misma pregunta vista de cerca: qué falta para que recepción pueda
   marcar un examen y que salga con su precio. */
const delArchivo = await determinacionesDelArchivo();
const faltanDelArchivo = await faltanEnElCatalogo();
const sinPrecio = servicios.filter((s) => s.activo && Number(s.precio) === 0).length;
const visibles = verTodos ? servicios : activos;
const grupos = porCategoria(visibles);
const apagados = servicios.length - activos.length;
---

<Sistema titulo="Servicios">
  <nav class="miga"><a href="/sistema">Casos</a> <span>/</span> Servicios</nav>

  <header class="cab">
    <div>
      <h1>Catálogo de servicios</h1>
      <p class="cab__nota">
        {activos.length} {activos.length === 1 ? 'servicio activo' : 'servicios activos'}
        {apagados > 0 && ` · ${apagados} desactivado${apagados > 1 ? 's' : ''}`}.
        El precio se copia al renglón cuando se carga el cobro, así que
        cambiarlo acá no mueve lo ya facturado.
      </p>
      {tasaHoy && (
        <p class="cab__tasa">
          <Icono nombre="escudo" tam={15} />
          <span>
            El equivalente en bolívares va a <strong class="cifra">{dinero(tasaHoy.bolivares)} Bs</strong>
            {tasaHoy.fecha === hoyEnCaracas()
              ? ' por dólar, la tasa oficial del BCV de hoy.'
              : ` por dólar, la última que publicó el BCV, del ${fechaDeLaTasa}.`}
            {' '}Es de referencia: lo que se factura es el precio en su moneda.
          </span>
        </p>
      )}
    </div>
    {servicios.length > 0 && (
      <a class="sis-boton sis-boton--suave" href={verTodos ? '/sistema/servicios' : '/sistema/servicios?todos=si'}>
        {verTodos ? 'Ver solo los activos' : 'Ver los desactivados'}
      </a>
    )}
  </header>

  {error && (
    <p class="sis-error alta__error">
      <Icono nombre="escudo" tam={18} />
      {error}
    </p>
  )}

  {aviso && (
    <p class="msj--bien">
      <Icono nombre="escudo" tam={18} />
      {aviso}
    </p>
  )}

  {/* El selector de exámenes de la orden sale de este catálogo, así que
      mientras esté vacío recepción no puede marcar nada. Los nombres los
      tenemos: son las hojas del archivo del laboratorio del centro. */}
  {faltanDelArchivo > 0 && (
    <section class="sis-tarjeta lab">
      <h2>Los exámenes del laboratorio</h2>
      <p>
        El archivo del laboratorio tiene <strong>{delArchivo.length} exámenes</strong> y
        {' '}{faltanDelArchivo === delArchivo.length
          ? 'ninguno está en el catálogo'
          : `${faltanDelArchivo} no están en el catálogo`}.
        Mientras falten, recepción no los puede marcar en la orden y la cuenta
        no sale.
      </p>
      <form method="post">
        <input type="hidden" name="accion" value="cargar-laboratorio" />
        <button type="submit" class="sis-boton sis-boton--primario">
          <Icono nombre="mas" tam={18} />
          Cargar los exámenes y los perfiles
        </button>
      </form>
      <p class="lab__nota">
        Entran <strong>sin precio</strong> y se les pone acá. No se inventa
        ninguno: un precio adivinado en el catálogo termina cobrado. Cada
        hoja del archivo con varios exámenes queda también como
        <a href="/sistema/perfiles">perfil</a>, para marcarlos de un toque.
      </p>
    </section>
  )}

  {sinPrecio > 0 && (
    <p class="aviso-precio">
      <Icono nombre="escudo" tam={18} />
      <span>
        Hay <strong>{sinPrecio} {sinPrecio === 1 ? 'servicio' : 'servicios'} sin precio</strong>.
        Se pueden marcar en una orden —queda registrado qué se le hizo— pero no
        suman al total hasta que tengan el suyo.
      </span>
    </p>
  )}

  <form method="post" class="alta sis-tarjeta">
    <div class="alta__campos">
      <div class="sis-campo alta__nombre">
        <label for="nombre">Servicio</label>
        <input id="nombre" name="nombre" value={nuevo.nombre} required
               placeholder="Consulta de emergencia" autocomplete="off" />
      </div>

      <div class="sis-campo alta__cat">
        <label for="categoria">Categoría</label>
        <select id="categoria" name="categoria">
          {CATEGORIAS.map((c) => (
            <option value={c.clave} selected={nuevo.categoria === c.clave}>{c.rotulo}</option>
          ))}
        </select>
      </div>

      <div class="sis-campo alta__precio">
        <label for="precio">Precio</label>
        <input id="precio" name="precio" value={nuevo.precio} required
               inputmode="decimal" placeholder="35,00" autocomplete="off" />
      </div>

      <div class="sis-campo alta__moneda">
        <label for="moneda">Moneda</label>
        <select id="moneda" name="moneda">
          {MONEDAS.map((m) => (
            <option value={m} selected={nuevo.moneda === m}>{m}</option>
          ))}
        </select>
      </div>
    </div>

    <button type="submit" class="sis-boton sis-boton--primario alta__boton">
      <Icono nombre="mas" tam={18} />
      Agregar al catálogo
    </button>
  </form>

  {visibles.length === 0 ? (
    <div class="vacio sis-tarjeta">
      <h2>El catálogo está vacío</h2>
      <p>Agregue el primer servicio con el formulario de arriba. Después se carga en cada atención.</p>
    </div>
  ) : (
    <div class="tabla">
      <table>
        <caption class="oculto">Servicios del catálogo con su categoría y su precio</caption>
        <thead>
          <tr>
            <th scope="col">Servicio</th>
            <th scope="col" class="num">Precio</th>
            <th scope="col">Moneda</th>
            <th scope="col"><span class="oculto">Acciones</span></th>
          </tr>
        </thead>
        {grupos.map((g) => (
          <tbody>
            <tr class="grupo">
              <th scope="colgroup" colspan="4">{g.rotulo}</th>
            </tr>
            {g.servicios.map((s) => (
              <tr class:list={[!s.activo && 'fila--apagada']}>
                <td>
                  <a class="fila__nombre" href={`/sistema/servicios/${s.id}`}>{s.nombre}</a>
                  {!s.activo && <span class="fila__apagado">Desactivado</span>}
                </td>
                <td class="num cifra">
                  {dinero(s.precio)}
                  {tasaHoy && s.moneda === MONEDA_BASE && (
                    <span class="fila__bs cifra">≈ {dinero(enBolivares(s.precio, tasaHoy))} Bs</span>
                  )}
                </td>
                <td class="moneda">{s.moneda}</td>
                <td class="acciones">
                  <a class="sis-boton sis-boton--suave" href={`/sistema/servicios/${s.id}`}>Editar</a>
                  <form method="post">
                    <input type="hidden" name="id" value={s.id} />
                    <button type="submit" name="accion" value={s.activo ? 'desactivar' : 'reactivar'}
                            class="sis-boton sis-boton--suave">
                      {s.activo ? 'Desactivar' : 'Reactivar'}
                    </button>
                  </form>
                </td>
              </tr>
            ))}
          </tbody>
        ))}
      </table>
    </div>
  )}

  <p class="pie">
    Lo que no está en la lista se puede cargar igual, escrito a mano, en la
    pantalla de cobro de cada atención. Las categorías son {CATEGORIAS.map((c) => rotuloCategoria(c.clave).toLowerCase()).join(', ')}.
  </p>
</Sistema>

<style>
  .msj--bien {
    display: flex;
    align-items: flex-start;
    gap: 9px;
    margin-top: 16px;
    padding: 11px 14px;
    border-radius: 8px;
    background: #e4f2ea;
    border: 1px solid #a9d5bd;
    color: #105433;
    font-size: var(--u-sm);
  }
  .msj--bien :global(svg) { flex: none; margin-top: 1px; }

  .lab { margin-top: 18px; border-color: var(--azul-medio); }
  .lab h2 { font-size: var(--u-lg); }
  .lab p { margin: 9px 0 14px; font-size: var(--u-sm); color: var(--tinta-suave); line-height: 1.55; max-width: 72ch; }
  .lab__nota { margin: 12px 0 0 !important; font-size: var(--u-xs) !important; color: var(--tinta-tenue) !important; }

  .aviso-precio {
    display: flex;
    align-items: flex-start;
    gap: 9px;
    margin-top: 16px;
    padding: 11px 14px;
    border-radius: 8px;
    background: #fdf0d9;
    color: #7a5200;
    font-size: var(--u-sm);
    line-height: 1.5;
  }
  .aviso-precio :global(svg) { flex: none; margin-top: 2px; }

  .miga { font-size: var(--u-sm); color: var(--tinta-tenue); margin-bottom: 14px; }
  .miga a { color: var(--tinta-suave); text-decoration: none; }
  .miga a:hover { color: var(--azul); text-decoration: underline; }
  .miga span { margin-inline: 5px; }

  .cab { display: flex; flex-wrap: wrap; gap: 14px; align-items: flex-start; justify-content: space-between; }
  .cab__nota { margin-top: 6px; font-size: var(--u-sm); color: var(--tinta-tenue); max-width: 68ch; }

  .oculto {
    position: absolute;
    width: 1px; height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .alta__error { margin-top: 18px; }

  /* El alta vive arriba de la lista: se agregan varios de corrido. */
  .alta { margin-top: 20px; display: flex; flex-wrap: wrap; gap: 14px; align-items: flex-end; padding: 18px; }
  .alta__campos { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; flex: 1 1 420px; }
  .alta__nombre { grid-column: 1 / -1; }
  @media (min-width: 860px) {
    .alta__campos { grid-template-columns: minmax(0, 1fr) 190px 130px 104px; }
    .alta__nombre { grid-column: auto; }
  }
  .alta__boton { min-height: 44px; }

  .vacio { margin-top: 18px; text-align: center; padding-block: 48px; }
  .vacio h2 { font-size: var(--u-lg); }
  .vacio p { margin-top: 8px; color: var(--tinta-tenue); }

  /* Precios y categorías son datos tabulares: se leen en columnas, no en
     tarjetas. En pantalla angosta la tabla se desplaza sola. */
  .tabla {
    margin-top: 18px;
    overflow-x: auto;
    /* Bloque contenedor de los rótulos absolutos (.oculto): sin él se
       posicionan contra la página y se llevan el ancho del documento. */
    position: relative;
    background: var(--papel);
    border: 1px solid var(--linea);
    border-radius: 10px;
  }
  table { width: 100%; border-collapse: collapse; min-width: 620px; }

  thead th {
    text-align: left;
    padding: 11px 16px;
    font-size: var(--u-xs);
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--tinta-tenue);
    border-bottom: 1px solid var(--linea);
    white-space: nowrap;
  }

  .grupo th {
    text-align: left;
    padding: 9px 16px;
    background: var(--bruma);
    border-bottom: 1px solid var(--linea-tenue);
    font-size: var(--u-xs);
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--tinta-suave);
  }

  tbody td { padding: 9px 16px; border-bottom: 1px solid var(--linea-tenue); vertical-align: middle; }
  tbody tr:last-child td { border-bottom: 0; }
  tbody tr:hover td { background: var(--bruma); }

  .fila__nombre { font-weight: 600; color: var(--azul); text-decoration: none; }
  .fila__nombre:hover { text-decoration: underline; }
  .fila--apagada .fila__nombre { color: var(--tinta-tenue); }
  .fila__apagado {
    margin-left: 9px;
    font-size: var(--u-xs);
    font-weight: 700;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    color: var(--tinta-tenue);
  }

  .num { text-align: right; }
  td.num { font-weight: 600; white-space: nowrap; }
  .moneda { font-size: var(--u-sm); color: var(--tinta-tenue); }

  /* Debajo del precio y más tenue: el dólar es lo que se factura, el
     bolívar es la lectura de apoyo. */
  .fila__bs { display: block; font-size: var(--u-xs); color: var(--tinta-tenue); font-weight: 600; }

  .cab__tasa {
    display: flex;
    align-items: flex-start;
    gap: 9px;
    margin: 10px 0 0;
    font-size: var(--u-sm);
    color: var(--tinta-suave);
    line-height: 1.5;
  }
  .cab__tasa :global(svg) { flex: none; margin-top: 2px; color: var(--azul); }

  .acciones { display: flex; justify-content: flex-end; gap: 8px; }
  /* Objetivo táctil completo: esta tabla se usa desde el teléfono. */
  .acciones .sis-boton { min-height: 44px; padding: 6px 14px; }

  .pie { margin-top: 16px; font-size: var(--u-sm); color: var(--tinta-tenue); max-width: 72ch; }
</style>
