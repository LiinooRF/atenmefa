---
/**
 * Los perfiles del laboratorio.
 *
 * Un perfil es un ítem del baremo con su precio que trae varios exámenes
 * adentro: al marcarlo en la orden se despliegan todos marcados, recepción
 * quita el que no va y se cobra el precio del perfil menos el precio suelto
 * de lo quitado. Los exámenes de cada uno salen de su hoja del Excel
 * (031-componentes-de-perfil.sql) y se cambian en la ficha del servicio.
 *
 * Esta pantalla vivía en «Cobros» y mostraba otra cosa: los combos sin
 * precio propio de la primera versión. En Atenmefa no queda ninguno y la
 * pantalla decía «0 perfiles» mientras había once andando. Ahora lista los
 * de verdad, cuelga de Laboratorio, y los combos viejos solo aparecen donde
 * todavía haya alguno (la demo).
 */
import Sistema from '../../layouts/Sistema.astro';
import Icono from '../../components/Icono.astro';
import { exigir } from '../../sistema/lib/guardia';
import { anotar } from '../../sistema/lib/atenciones';
import { catalogo, crearServicio, dinero } from '../../sistema/lib/cobro';
import {
  CATEGORIA, activarPerfil, componentesDePerfiles, guardarPerfil, listarPerfiles, perfilPorId,
} from '../../sistema/lib/laboratorio';

export const prerender = false;

const corte = exigir(Astro, 'editar_catalogo');
if (corte) return corte;

const usuario = Astro.locals.usuario!;
let error = '';
let aviso = '';

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const accion = String(form.get('accion') ?? '');
  const id = String(form.get('id') ?? '');

  try {
    if (accion === 'crear') {
      /* Un perfil nuevo es un ítem del baremo con precio; lo que trae se
         elige en su ficha, que es adonde se va. */
      const nombre = String(form.get('nombre') ?? '').trim();
      const busca = nombre.toLocaleLowerCase('es');
      const yaEsta = (await catalogo(true)).some((x) => x.categoria === CATEGORIA && x.nombre.toLocaleLowerCase('es') === busca)
        || (await listarPerfiles()).some((x) => x.nombre.toLocaleLowerCase('es') === busca);
      if (yaEsta) throw new Error('Ya hay un perfil o un examen con ese nombre.');
      const creado = await crearServicio({ nombre, categoria: CATEGORIA, precio: form.get('precio'), moneda: 'USD' });
      await anotar(usuario.id, 'servicio', undefined, { accion: 'creo_perfil', perfil: creado.nombre });
      return Astro.redirect(`/sistema/servicios/${creado.id}?perfil=nuevo#componentes`);
    }
    if (accion === 'guardar') {
      const examenes = form.getAll('examen').map((v) => String(v));
      const guardado = await guardarPerfil(id, form.get('nombre'), examenes);
      await anotar(usuario.id, 'servicio', undefined, {
        accion: 'guardo_perfil', perfil: guardado.nombre, examenes: guardado.cuantos,
      });
      aviso = guardado.cuantos === 0
        ? `${guardado.nombre} quedó sin exámenes: así no aparece en la orden.`
        : `${guardado.nombre}: ${guardado.cuantos} ${guardado.cuantos === 1 ? 'examen' : 'exámenes'}.`;
    }
    if (accion === 'apagar' || accion === 'prender') {
      const cambiado = await activarPerfil(id, accion === 'prender');
      await anotar(usuario.id, 'servicio', undefined, { accion: `${accion}_perfil`, perfil: cambiado.nombre });
      aviso = accion === 'apagar'
        ? `${cambiado.nombre} ya no sale en la orden. Sigue acá.`
        : `${cambiado.nombre} vuelve a salir en la orden.`;
    }
  } catch (e) {
    error = e instanceof Error ? e.message : 'No se pudo guardar el perfil.';
  }
}

/* Los de verdad: ítems del laboratorio que traen exámenes adentro. */
const [todos, deCadaUno] = await Promise.all([catalogo(true), componentesDePerfiles()]);
const conPrecio = todos
  .filter((x) => x.categoria === CATEGORIA && deCadaUno.has(x.id))
  .map((x) => ({ ...x, trae: deCadaUno.get(x.id)! }));

/* Los combos sin precio de la primera versión, donde todavía haya. */
const perfiles = await listarPerfiles();
const examenes = todos.filter((x) => x.categoria === CATEGORIA && x.activo);

const editando = Astro.url.searchParams.get('editar');
const abierto = editando ? await perfilPorId(editando) : null;
const suyos = new Set(abierto?.examenes ?? []);
---

<Sistema titulo="Perfiles">
  <nav class="miga"><a href="/sistema/laboratorio">Laboratorio</a> <span>/</span> Perfiles</nav>

  <header class="cab">
    <div>
      <h1>Perfiles del laboratorio</h1>
      <p class="cab__nota">
        Un perfil tiene <strong>su precio</strong> y trae varios exámenes. En la
        orden se despliegan todos marcados y recepción quita el que no va: se
        cobra el precio del perfil menos el precio suelto de lo quitado.
      </p>
    </div>
  </header>

  {error && <p class="sis-error msj"><Icono nombre="escudo" tam={18} />{error}</p>}
  {aviso && <p class="msj msj--bien"><Icono nombre="escudo" tam={18} />{aviso}</p>}

  <section class="sis-tarjeta bloque" id="con-precio">
    <h2>Los perfiles <span class="cuantos">{conPrecio.length}</span></h2>
    {conPrecio.length === 0 ? (
      <p class="suelto">Todavía no hay ninguno. Se crea abajo.</p>
    ) : (
      <ul class="lista">
        {conPrecio.map((p) => (
          <li class:list={[!p.activo && 'lista--apagado']}>
            <a class="lista__que" href={`/sistema/servicios/${p.id}#componentes`}>
              <strong>{p.nombre}</strong>
              <small>
                ${dinero(p.precio)} · {p.trae.length} {p.trae.length === 1 ? 'examen' : 'exámenes'}
                {!p.activo && ' · apagado'}
              </small>
              <small class="lista__trae">{p.trae.map((c) => c.nombre).join(' · ')}</small>
            </a>
            <a class="sis-boton sis-boton--suave" href={`/sistema/servicios/${p.id}#componentes`}>Cambiar</a>
          </li>
        ))}
      </ul>
    )}

    <form method="post" class="alta">
      <input type="hidden" name="accion" value="crear" />
      <div class="alta__campos">
        <div class="sis-campo">
          <label for="nombre">Un perfil nuevo</label>
          <input id="nombre" name="nombre" required autocomplete="off" placeholder="Control prenatal" />
        </div>
        <div class="sis-campo">
          <label for="precio">Precio en USD</label>
          <input id="precio" name="precio" required inputmode="decimal" autocomplete="off" placeholder="25,00" />
        </div>
      </div>
      <button type="submit" class="sis-boton sis-boton--primario">Crear</button>
      <p class="suelto suelto--nota">Después de crearlo se eligen los exámenes que trae.</p>
    </form>
  </section>

  {(perfiles.length > 0 || abierto) && (
    <section class="sis-tarjeta bloque" id="combos">
      <h2>Combos sin precio propio</h2>
      <p class="suelto suelto--nota">
        Los de la primera versión: marcan varios exámenes de un toque y se
        cobra la suma de los que queden. Siguen andando; los nuevos se crean
        arriba, con precio.
      </p>
    <div class="col">
      <section class="combo">
        <h3>Los combos <span class="cuantos">{perfiles.length}</span></h3>

        {perfiles.length === 0 ? (
          <p class="suelto">Todavía no hay ninguno.</p>
        ) : (
          <ul class="lista">
            {perfiles.map((p) => (
              <li class:list={[!p.activo && 'lista--apagado']}>
                <a class="lista__que" href={`/sistema/perfiles?editar=${p.id}`}>
                  <strong>{p.nombre}</strong>
                  <small>
                    {p.cuantos} {p.cuantos === 1 ? 'examen' : 'exámenes'}
                    {Number(p.suma) > 0 && ` · completo $${dinero(p.suma)}`}
                    {!p.activo && ' · apagado'}
                  </small>
                </a>
                <form method="post" class="enlinea">
                  <input type="hidden" name="id" value={p.id} />
                  <button type="submit" name="accion" value={p.activo ? 'apagar' : 'prender'}
                          class="sis-boton sis-boton--suave">
                    {p.activo ? 'Apagar' : 'Prender'}
                  </button>
                </form>
              </li>
            ))}
          </ul>
        )}

      </section>

      <section class="combo">
        {abierto ? (
          <form method="post">
            <input type="hidden" name="accion" value="guardar" />
            <input type="hidden" name="id" value={abierto.id} />

            <h3>Qué lleva este combo</h3>

            <div class="sis-campo">
              <label for="nombre-editar">Nombre</label>
              <input id="nombre-editar" name="nombre" required autocomplete="off"
                     value={abierto.nombre} />
              <span class="pista">
                Los que salieron de su archivo traen el nombre de la pestaña
                del Excel. Acá se le pone el que recepción tiene que leer.
              </span>
            </div>

            <p class="suelto suelto--nota">
              Marque los exámenes. Recepción va a poder quitar cualquiera en
              la orden; se cobra la suma de los que queden.
            </p>

            <ul class="examenes">
              {examenes.map((e) => (
                <li>
                  <label>
                    <input type="checkbox" name="examen" value={e.id} checked={suyos.has(e.id)} />
                    <span>{e.nombre}</span>
                    <em>{Number(e.precio) === 0 ? 'sin precio' : `$${dinero(e.precio)}`}</em>
                  </label>
                </li>
              ))}
            </ul>

            <div class="pie">
              <button type="submit" class="sis-boton sis-boton--primario">Guardar el perfil</button>
              <a class="sis-boton sis-boton--suave" href="/sistema/perfiles">Cerrar</a>
            </div>
          </form>
        ) : (
          <>
            <h3>Elija un combo</h3>
            <p class="suelto">
              Toque uno de la lista para ver y cambiar qué exámenes lleva.
            </p>
          </>
        )}
      </section>
    </div>
    </section>
  )}
</Sistema>

<style>
  .miga { font-size: var(--u-sm); color: var(--tinta-tenue); margin-bottom: 14px; }
  .miga a { color: var(--tinta-suave); text-decoration: none; }
  .miga a:hover { color: var(--azul); text-decoration: underline; }
  .miga span { margin-inline: 5px; }

  .cab h1 { font-size: var(--u-2xl); }
  .cab__nota { margin-top: 6px; font-size: var(--u-sm); color: var(--tinta-tenue); max-width: 76ch; line-height: 1.55; }
  .cab__nota strong { color: var(--tinta); }

  .msj { display: flex; align-items: flex-start; gap: 9px; margin-top: 16px; font-size: var(--u-sm); }
  .msj--bien {
    padding: 11px 14px;
    border-radius: 8px;
    background: #e4f2ea;
    border: 1px solid #a9d5bd;
    color: #105433;
  }

  .bloque { margin-top: 18px; }
  .bloque > h2 { display: flex; align-items: center; gap: 10px; font-size: var(--u-lg); margin-bottom: 12px; }
  .lista__trae { display: block; margin-top: 3px; }
  .lista li > .sis-boton { flex: none; }
  .alta__campos { display: flex; flex-wrap: wrap; gap: 10px; width: 100%; }
  .alta__campos .sis-campo:last-child { max-width: 16ch; }
  .col h3 { display: flex; align-items: center; gap: 10px; font-size: var(--u-md, 1.05rem); margin-bottom: 10px; }
  .combo { min-width: 0; }
  .col { display: grid; gap: 16px; margin-top: 12px; align-items: start; }
  @media (min-width: 900px) { .col { grid-template-columns: 1fr 1.1fr; } }

  .col h2 { display: flex; align-items: center; gap: 10px; font-size: var(--u-lg); margin-bottom: 12px; }
  .cuantos {
    padding: 2px 9px;
    border-radius: 999px;
    background: var(--azul-tenue);
    color: var(--azul);
    font-size: var(--u-xs);
    font-weight: 700;
  }

  .suelto { font-size: var(--u-sm); color: var(--tinta-suave); line-height: 1.55; }
  .suelto--nota { margin: 12px 0; font-size: var(--u-xs); color: var(--tinta-tenue); }

  .lista { list-style: none; margin: 0 0 16px; padding: 0; }
  .lista li {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 7px 0;
    border-top: 1px solid var(--linea-tenue);
  }
  .lista li:first-child { border-top: 0; }
  .lista--apagado { opacity: 0.55; }
  .lista__que {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-height: 44px;
    justify-content: center;
    text-decoration: none;
    color: var(--tinta);
  }
  .lista__que:hover strong { color: var(--azul); text-decoration: underline; }
  .lista__que strong { font-size: var(--u-sm); font-weight: 600; }
  .lista__que small { font-size: var(--u-xs); color: var(--tinta-tenue); }

  .alta { display: grid; gap: 10px; justify-items: start; padding-top: 14px; border-top: 1px solid var(--linea); }
  .alta .sis-campo { width: 100%; max-width: 34ch; }
  .enlinea { display: flex; }

  .examenes {
    list-style: none;
    margin: 0;
    padding: 4px;
    max-height: 50vh;
    overflow-y: auto;
    border: 1px solid var(--linea);
    border-radius: 10px;
  }
  .examenes label {
    display: flex;
    align-items: center;
    gap: 11px;
    min-height: 44px;
    padding: 0 10px;
    border-radius: 8px;
    cursor: pointer;
    font-size: var(--u-sm);
  }
  .examenes label:hover { background: var(--bruma); }
  .examenes input { width: 20px; height: 20px; flex: none; accent-color: var(--azul); }
  .examenes span { flex: 1; min-width: 0; }
  .examenes em { flex: none; font-style: normal; font-size: var(--u-xs); color: var(--tinta-tenue); }
  .examenes input:checked ~ span { font-weight: 600; color: var(--azul); }

  .pie { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 16px; }
</style>
