---
/**
 * Atenciones a medio llenar.
 *
 * Es la bandeja de pendientes del turno: el médico guarda un borrador
 * cuando lo interrumpen y vuelve acá a terminarlo. Lo que manda en cada
 * fila no es el dato clínico sino cuánto falta para poder cerrarla.
 */
import Sistema from '../../layouts/Sistema.astro';
import Icono from '../../components/Icono.astro';
import {
  DIAS_DE_BORRADOR, borradoresAbiertos, limpiarBorradoresViejos,
} from '../../sistema/lib/atenciones';
import { exigir } from '../../sistema/lib/guardia';
import { puede, puedeBorrarBorrador, puedeEditarAtencion } from '../../sistema/lib/permisos';

export const prerender = false;

/* Tres puertas a la misma pantalla, y cada rol ve lo suyo:
     · el médico, porque las escribe;
     · administración, porque las borra;
     · recepción, porque es donde queda lo que admitió y necesita ver si el
       médico ya lo pasó o si el paciente sigue esperando.
   Lo que se puede HACER en cada fila lo decide después cada botón. */
const usuario = Astro.locals.usuario;
if (!usuario) return Astro.redirect('/sistema/entrar');
const escribe = puede(usuario.rol as string, 'escribir_historia');
const corte = escribe || puede(usuario.rol as string, 'abrir_consulta')
  ? null
  : exigir(Astro, 'anular_atencion');
if (corte) return corte;

/* La limpieza de los veinte días corre acá, al abrir la lista. No hay cron
   y no hace falta: si nadie entra al sistema en veinte días, tampoco le
   molesta un borrador viejo. Ver limpiarBorradoresViejos. */
const limpiados = await limpiarBorradoresViejos();

/* Lo que admitió recepción y el médico todavía no tocó va primero: es la
   cola del consultorio y es lo que el médico abre al llegar. El resto queda
   abajo en el orden de siempre, el más reciente arriba. */
const todos = await borradoresAbiertos();
const esperando = todos.filter((b) => b.abiertaPor && !b.escrita);
const borradores = [...esperando, ...todos.filter((b) => !(b.abiertaPor && !b.escrita))];
const listos = borradores.filter((b) => b.faltan.length === 0).length;
const puedeNuevas = escribe;
const admite = puede(usuario.rol as string, 'abrir_consulta');

const fechaCorta = (f: string) =>
  new Date(`${f}T12:00:00`).toLocaleDateString('es-VE', { day: '2-digit', month: 'short' });

/* Se nombran los primeros tres que faltan y el resto se cuenta: la lista
   completa de catorce rótulos no dice más que el número. */
const queFalta = (faltan: { rotulo: string }[]) => {
  const nombres = faltan.slice(0, 3).map((c) => c.rotulo.toLowerCase());
  const resto = faltan.length - nombres.length;
  return resto > 0 ? `${nombres.join(', ')} y ${resto} más` : nombres.join(', ');
};
---

<Sistema titulo="Borradores">
  <div class="cab">
    <div>
      <h1>Atenciones sin cerrar</h1>
      <p class="cab__nota">
        {borradores.length === 0
          ? 'Nada pendiente'
          : `${borradores.length} ${borradores.length === 1 ? 'borrador' : 'borradores'}`}
        {listos > 0 && ` · ${listos} ${listos === 1 ? 'listo para cerrar' : 'listos para cerrar'}`}
      </p>
      {esperando.length > 0 && (
        <p class="cab__espera">
          <Icono nombre="reloj" tam={16} />
          {esperando.length === 1
            ? 'Hay 1 caso admitido en recepción esperando al médico.'
            : `Hay ${esperando.length} casos admitidos en recepción esperando al médico.`}
        </p>
      )}
    </div>
    {puedeNuevas ? (
      <a class="sis-boton sis-boton--primario" href="/sistema/atencion/nueva">
        <Icono nombre="mas" tam={19} />
        Nueva atención
      </a>
    ) : admite && (
      <a class="sis-boton sis-boton--primario" href="/sistema/atencion/abrir">
        <Icono nombre="mas" tam={19} />
        Admitir un caso
      </a>
    )}
  </div>

  {Astro.url.searchParams.get('borrado') === '1' && (
    <p class="msj--bien">
      <Icono nombre="escudo" tam={18} />
      El borrador se borró. Quedó anotado en la bitácora.
    </p>
  )}

  {limpiados > 0 && (
    <p class="msj--bien">
      <Icono nombre="reloj" tam={18} />
      Se fueron {limpiados} {limpiados === 1 ? 'borrador' : 'borradores'} que
      nadie tocó en {DIAS_DE_BORRADOR} días.
    </p>
  )}

  {borradores.length === 0 ? (
    <div class="vacio sis-tarjeta">
      <h2>No hay borradores</h2>
      <p>
        Las atenciones aparecen acá mientras estén a medio llenar. Al cerrarlas
        pasan a <a href="/sistema">la lista de casos</a>.
      </p>
      {puedeNuevas ? (
        <a class="sis-boton sis-boton--primario" href="/sistema/atencion/nueva">Registrar una atención</a>
      ) : admite && (
        <a class="sis-boton sis-boton--primario" href="/sistema/atencion/abrir">Admitir un caso</a>
      )}
    </div>
  ) : (
    <ul class="pend">
      {borradores.map((b) => (
        <li>
          {/* A dónde lleva la fila depende de quién mira. El médico al que
              está puesta entra a escribirla; recepción y el resto entran al
              caso, que es lo que sí pueden abrir. Antes llevaba siempre a
              «editar» y para recepción era un rebote a «no tiene permiso». */}
          <a href={puedeEditarAtencion(usuario, b)
                     ? `/sistema/atencion/${b.id}/editar`
                     : `/sistema/atencion/${b.id}`}>
            <span class="pend__num cifra">{b.numero}</span>

            <span class="pend__cuerpo">
              <span class="pend__linea">
                <strong>{b.paciente}</strong>
                {b.abiertaPor && !b.escrita && (
                  <span class="pend__chapa">Admitido en recepción</span>
                )}
                <em class="cifra">{fechaCorta(b.fecha)}</em>
              </span>
              <span class="pend__linea pend__linea--baja">
                <small>{b.idx || b.motivo || 'Sin motivo anotado'}</small>
                <span class="pend__quien">
                  {b.cedula}
                  {b.abiertaPor && !b.escrita && <> · para {b.medico}</>}
                </span>
              </span>
            </span>

            <span class="pend__falta">
              {b.faltan.length === 0 ? (
                <strong class="pend__falta-ok">Listo para cerrar</strong>
              ) : b.abiertaPor && !b.escrita ? (
                /* «Faltan 14 campos» es verdad pero asusta y no dice nada:
                   a una que acaba de admitirse le falta TODO lo clínico,
                   porque todavía no pasó a la consulta. */
                <>
                  <strong>Sin escribir</strong>
                  <small>El paciente está esperando</small>
                </>
              ) : (
                <>
                  <strong>
                    Faltan {b.faltan.length} {b.faltan.length === 1 ? 'campo' : 'campos'}
                  </strong>
                  <small>{queFalta(b.faltan)}</small>
                </>
              )}
            </span>
          </a>

          {/* Fuera del enlace de la fila: un enlace dentro de otro no es
              HTML válido y el toque se lo come el de afuera. Lleva a una
              pantalla que pregunta, no borra de un golpe. */}
          {puedeBorrarBorrador(usuario, b) && (
            <a class="pend__borrar" href={`/sistema/atencion/${b.id}/borrar`}
               aria-label={`Borrar el borrador de ${b.paciente}`}>
              Borrar
              {b.quieto >= DIAS_DE_BORRADOR - 5 && (
                <em>se va en {Math.max(0, DIAS_DE_BORRADOR - b.quieto)} días</em>
              )}
            </a>
          )}
        </li>
      ))}
    </ul>
  )}

  {borradores.length > 0 && (
    <p class="aviso-dias">
      Un borrador que nadie toca en {DIAS_DE_BORRADOR} días se borra solo,
      siempre que no tenga cobro ni resultados cargados. Si tiene algo de eso,
      se queda hasta que alguien lo borre a mano.
    </p>
  )}
</Sistema>

<style>
  .cab__espera {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    margin-top: 8px;
    font-size: var(--u-sm);
    font-weight: 600;
    color: var(--azul);
  }
  .cab__espera :global(svg) { flex: none; }

  /* Chapa de la fila, no botón: dice de dónde viene el caso. */
  .pend__chapa {
    flex: none;
    padding: 2px 8px;
    border-radius: 999px;
    background: var(--bruma);
    border: 1px solid var(--azul-medio);
    font-size: var(--u-xs);
    font-weight: 700;
    color: var(--azul);
    white-space: nowrap;
  }

  .msj--bien {
    display: flex;
    align-items: flex-start;
    gap: 9px;
    margin-top: 16px;
    padding: 11px 14px;
    border-radius: 8px;
    background: #e4f2ea;
    border: 1px solid #a9d5bd;
    color: #105433;
    font-size: var(--u-sm);
  }
  .msj--bien :global(svg) { flex: none; margin-top: 1px; }

  /* La fila es un enlace y el borrado es otro: van uno al lado del otro. */
  .pend li { display: flex; align-items: stretch; }
  .pend li > a:first-child { flex: 1; min-width: 0; }

  .pend__borrar {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-end;
    flex: none;
    gap: 2px;
    padding: 0 14px;
    border-left: 1px solid var(--linea-tenue);
    color: var(--tinta-tenue);
    text-decoration: none;
    font-size: var(--u-xs);
    font-weight: 700;
  }
  .pend__borrar:hover { background: #fdeced; color: var(--rojo); }
  .pend__borrar em { font-style: normal; font-weight: 400; color: var(--rojo); white-space: nowrap; }

  .aviso-dias {
    margin-top: 16px;
    font-size: var(--u-xs);
    color: var(--tinta-tenue);
    line-height: 1.6;
    max-width: 76ch;
  }

  .cab { display: flex; flex-wrap: wrap; gap: 14px; align-items: center; justify-content: space-between; }
  .cab__nota { margin-top: 5px; font-size: var(--u-sm); color: var(--tinta-tenue); }

  .vacio { text-align: center; padding-block: 56px; margin-top: 22px; }
  .vacio h2 { font-size: var(--u-lg); }
  .vacio p { margin-top: 9px; color: var(--tinta-tenue); }
  .vacio a:not(.sis-boton) { color: var(--azul-medio); }
  .vacio .sis-boton { margin-top: 22px; }

  /* Misma fila que la lista de casos: el médico ya sabe leerla. */
  .pend {
    list-style: none;
    margin: 22px 0 0;
    padding: 0;
    background: var(--papel);
    border: 1px solid var(--linea);
    border-radius: var(--radio);
    overflow: hidden;
  }
  .pend li + li { border-top: 1px solid var(--linea-tenue); }

  .pend a {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: center;
    gap: 14px;
    padding: 13px 16px;
    text-decoration: none;
    color: var(--tinta);
    transition: background-color 150ms ease;
  }
  .pend a:hover { background: var(--bruma); }
  .pend a:focus-visible { outline: 2px solid var(--azul-medio); outline-offset: -2px; }
  @media (min-width: 720px) { .pend a { grid-template-columns: auto minmax(0, 1fr) 230px; } }

  .pend__num {
    display: grid;
    place-items: center;
    min-width: 46px;
    height: 46px;
    padding: 0 8px;
    border-radius: 12px;
    background: #fdf0d9;
    color: #7a5200;
    font-weight: 700;
    font-size: var(--u-sm);
  }

  .pend__cuerpo { display: flex; flex-direction: column; gap: 3px; min-width: 0; }
  .pend__linea { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; }
  .pend__linea strong {
    font-size: var(--u-base);
    font-weight: 600;
    color: var(--azul);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .pend__linea em { font-style: normal; font-size: var(--u-xs); color: var(--tinta-tenue); flex: none; }
  .pend__linea--baja small {
    font-size: var(--u-sm);
    color: var(--tinta-suave);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .pend__quien { flex: none; font-size: var(--u-xs); color: var(--tinta-tenue); }

  /* En móvil lo que falta va bajo el nombre; desde tablet, en su columna. */
  .pend__falta {
    grid-column: 2;
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }
  .pend__falta strong { font-size: var(--u-sm); font-weight: 600; color: var(--rojo-hondo); }
  .pend__falta strong.pend__falta-ok { color: #15663f; }
  .pend__falta small { font-size: var(--u-xs); color: var(--tinta-tenue); }
  @media (min-width: 720px) {
    .pend__falta { grid-column: 3; text-align: right; align-items: flex-end; }
  }
</style>
