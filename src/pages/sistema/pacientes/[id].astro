---
/**
 * Ficha del paciente: todo lo que el centro sabe de una persona, junto.
 *
 * El orden de la pantalla es el orden en que lo necesita un médico que está
 * por atenderla: quién es, a qué es alérgica, qué toma, qué le pasó antes y
 * recién después la plata. Las alergias van arriba y con color propio
 * porque es el único dato de acá que, si no se ve, hace daño.
 *
 * Lo editable son los datos de contacto: teléfono, WhatsApp y correo. Es la
 * mitad del trabajo de recepción —«crear el paciente, actualizarlo, datos de
 * contacto»— y es a donde se le manda el informe.
 *
 * El nombre y la cédula NO. Vienen de cada atención firmada: corregirlos
 * desde el registro cambiaría el encabezado de historias que ya tienen
 * firma, y eso no es corregir, es reescribir.
 */
import Sistema from '../../../layouts/Sistema.astro';
import Icono from '../../../components/Icono.astro';
import { exigir } from '../../../sistema/lib/guardia';
import { comoSeLee, soloDigitos } from '../../../sistema/lib/documento';
import { puede } from '../../../sistema/lib/permisos';
import { anotar, esIdentificador } from '../../../sistema/lib/atenciones';
import { dinero } from '../../../sistema/lib/cobro';
import { saludoSuelto } from '../../../sistema/mensajes';
import {
  alergiaQueImporta, borrarPaciente, enlacesDeTelefono, fichaDePaciente,
  guardarPaciente, puedeBorrarse,
} from '../../../sistema/lib/pacientes';
import { ROTULO, TIPOS, esTipo } from '../../../sistema/lib/documento';


export const prerender = false;

const corte = exigir(Astro, 'ver_pacientes');
if (corte) return corte;

const usuario = Astro.locals.usuario!;
const { id } = Astro.params;

/* Un id sin forma de uuid hace que Postgres rechace el cast y la pantalla
   termina en error de servidor. Un enlace viejo se contesta como lo que es:
   un paciente que no está. */
if (!id || !esIdentificador(id)) return Astro.redirect('/sistema/pacientes');

let error = '';
let aviso = '';
/* Lo tecleado vuelve a la pantalla si rebota: nadie debería tener que
   escribir dos veces el mismo número. */
type Escrito = {
  nombre: string; tipoDoc: string; documento: string; sexo: string;
  telefono: string; whatsapp: string; correo: string;
};
let escritoAntes: Escrito | null = null;

/* En palabras y no con el nombre de la columna: el aviso decía "cambió
   telefono, correo", sin tilde, que es como se llama el campo en la base y
   no como se dice. */
const COMO_SE_DICE: Record<string, string> = {
  nombre: 'el nombre', documento: 'el documento', tipoDoc: 'el tipo de documento',
  sexo: 'el sexo', telefono: 'el teléfono', whatsapp: 'el WhatsApp', correo: 'el correo',
};

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const accion = String(form.get('accion') ?? '');

  if (accion === 'datos') {
    const crudoTipo = String(form.get('tipo_doc') ?? 'cedula');
    const escrito: Escrito = {
      nombre: String(form.get('nombre') ?? ''),
      tipoDoc: esTipo(crudoTipo) ? crudoTipo : 'cedula',
      documento: String(form.get('documento') ?? ''),
      sexo: String(form.get('sexo') ?? ''),
      telefono: String(form.get('telefono') ?? ''),
      whatsapp: String(form.get('whatsapp') ?? ''),
      correo: String(form.get('correo') ?? ''),
    };
    try {
      const { cambios, cuantos } = await guardarPaciente(id, escrito);
      if (cuantos > 0) {
        await anotar(usuario.id, 'cambio_paciente', undefined, { paciente: id, cambios });
        const lista = Object.keys(cambios).map((c) => COMO_SE_DICE[c] ?? c);
        aviso = `Guardado: cambió ${lista.join(', ')}.`;
      } else {
        aviso = 'No cambió nada: estaba igual.';
      }
    } catch (e) {
      error = e instanceof Error ? e.message : 'No se pudieron guardar los datos.';
      escritoAntes = escrito;
    }
  } else if (accion === 'borrar') {
    /* Se exige escribir el documento, como en la anulación se exige el
       motivo: es lo único que se borra de verdad en el sistema y un botón
       suelto se aprieta sin querer. */
    const confirma = String(form.get('confirma') ?? '').trim();
    try {
      const ficha = await fichaDePaciente(id);
      if (!ficha) throw new Error('Ese paciente ya no está en el registro.');
      if (soloDigitos(confirma) !== soloDigitos(ficha.paciente.cedula)
          && confirma.toUpperCase() !== ficha.paciente.cedula.toUpperCase()) {
        throw new Error('Para borrar hay que escribir el documento del paciente tal como aparece arriba.');
      }
      const borrado = await borrarPaciente(id);
      await anotar(usuario.id, 'borro_paciente', undefined, {
        paciente: id, nombre: borrado.nombre, documento: borrado.cedula,
      });
      return Astro.redirect('/sistema/pacientes?borrado=1');
    } catch (e) {
      error = e instanceof Error ? e.message : 'No se pudo borrar la ficha.';
    }
  }
}

const ficha = await fichaDePaciente(id);
if (!ficha) return Astro.redirect('/sistema/pacientes');

/* Abrir la ficha es leer datos de salud de una persona identificada, igual
   que abrir una historia. Queda registrado por lo mismo.
   Solo al abrirla: en un POST ya quedó anotado lo que se cambió, y sumarle
   un "vio" a cada guardado llena la bitácora de ruido. */
if (Astro.request.method !== 'POST') {
  await anotar(usuario.id, 'vio_paciente', undefined, { paciente: ficha.paciente.id });
}

const { paciente, atenciones, resumen, antecedentes, donde } = ficha;
const escribe = puede(usuario.rol as string, 'escribir_historia');

/* Lo tecleado vuelve si el guardado rebota; si no, lo que hay en la ficha. */
const enForma = {
  nombre: escritoAntes?.nombre ?? paciente.nombre,
  tipoDoc: escritoAntes?.tipoDoc ?? paciente.tipoDoc,
  documento: escritoAntes?.documento ?? paciente.cedula,
  sexo: escritoAntes?.sexo ?? paciente.sexo ?? '',
  telefono: escritoAntes?.telefono ?? paciente.telefono ?? '',
  whatsapp: escritoAntes?.whatsapp ?? paciente.whatsapp ?? '',
  correo: escritoAntes?.correo ?? paciente.correo ?? '',
};
const puedeEditar = puede(usuario.rol as string, 'editar_paciente');
/* Si la ficha se puede borrar, y si no, por qué no. Solo se pregunta a
   quien puede hacerlo. */
const borrable = puedeEditar ? await puedeBorrarse(id) : null;
const recienCreado = Astro.url.searchParams.get('nuevo') === '1';
/* El WhatsApp del paciente si dejó uno distinto, y si no el teléfono. El
   enlace abre el chat con el saludo puesto y el nombre de la persona: lo
   que sigue lo escribe quien está atendiendo. */
const contacto = enlacesDeTelefono(
  paciente.whatsapp ?? paciente.telefono,
  saludoSuelto(paciente.nombre),
);

const alergias = antecedentes?.campos.find((a) => a.clave === 'alergias')?.valor ?? '';
/* El enlace a la atención de donde salieron los antecedentes se resuelve
   acá: en el template quedaría un encadenado que puede caer en una
   dirección vacía. */
const idAntecedentes = antecedentes
  ? (atenciones.find((a) => a.numero === antecedentes.numero)?.id ?? null)
  : null;
const otros = antecedentes?.campos.filter((a) => a.clave !== 'alergias') ?? [];
const hayAlergia = alergiaQueImporta(alergias);
/* Tres situaciones distintas que la pantalla no puede confundir: nunca vino,
   vino y nadie le preguntó, o vino y quedó escrito. */
const hayAtenciones = resumen.atenciones > 0;

const fechaLarga = (f: string) =>
  new Date(`${f}T12:00:00`).toLocaleDateString('es-VE', {
    day: 'numeric', month: 'long', year: 'numeric',
  });
const fechaCorta = (f: string) =>
  new Date(`${f}T12:00:00`).toLocaleDateString('es-VE', {
    day: '2-digit', month: 'short', year: 'numeric',
  });
const soloFecha = (m: Date) =>
  new Intl.DateTimeFormat('es-VE', {
    timeZone: 'America/Caracas', day: 'numeric', month: 'long', year: 'numeric',
  }).format(m);

const ETIQUETAS: Record<string, { texto: string; clase: string }> = {
  borrador: { texto: 'Borrador', clase: 'borrador' },
  cerrada: { texto: 'Cerrada', clase: 'cerrada' },
  anulada: { texto: 'Anulada', clase: 'anulada' },
};

/* La primera moneda es el titular de la tarjeta y las demás van al pie: el
   catálogo cotiza en dólares, pero lo que se cobró en taquilla en bolívares
   no se le suma encima. */
const [principal, ...otrasMonedas] = resumen.facturado;

const nuevaConSuCedula = `/sistema/atencion/nueva?cedula=${encodeURIComponent(paciente.cedula)}`;
---

<Sistema titulo={paciente.nombre}>
  <nav class="miga"><a href="/sistema/pacientes">Pacientes</a> <span>/</span> {paciente.nombre}</nav>

  {recienCreado && (
    <p class="msj msj--bien">
      <Icono nombre="escudo" tam={18} />
      Quedó registrado. Cuando venga, su atención se abre con estos datos ya cargados.
    </p>
  )}

  <header class="cab">
    <div class="cab__quien">
      <h1>{paciente.nombre}</h1>
      <p class="cab__meta">
        <strong class="cifra">{comoSeLee(paciente.tipoDoc, paciente.cedula)}</strong>
        {paciente.sexo && <> · {paciente.sexo}</>}
        {donde?.edad && <> · {donde.edad} años</>}
        {resumen.desde
          ? <> · paciente desde {fechaLarga(resumen.desde)}</>
          : <> · registrado el {soloFecha(paciente.registrado)}</>}
      </p>
    </div>
    <div class="cab__acciones">
      {contacto && (
        <a class="sis-boton sis-boton--suave" href={contacto.llamar}>
          <Icono nombre="telefono" tam={18} />
          Llamar
        </a>
      )}
      {contacto?.whatsapp && (
        <a class="sis-boton sis-boton--suave" href={contacto.whatsapp} target="_blank" rel="noopener">
          <Icono nombre="whatsapp" tam={18} />
          WhatsApp
        </a>
      )}
      {escribe && (
        <a class="sis-boton sis-boton--primario" href={nuevaConSuCedula}>
          <Icono nombre="mas" tam={18} />
          Nueva atención
        </a>
      )}
    </div>
  </header>

  {error && <p class="sis-error msj"><Icono nombre="escudo" tam={18} />{error}</p>}
  {aviso && <p class="msj msj--bien"><Icono nombre="escudo" tam={18} />{aviso}</p>}

  <!-- Las alergias primero y con su propio color. Es el único dato de esta
       pantalla que, si no se ve, hace daño. -->
  <div
    class:list={[
      'alergia',
      !hayAtenciones ? 'alergia--sin'
      : hayAlergia ? 'alergia--ojo'
      : alergias ? 'alergia--limpia'
      : 'alergia--falta',
    ]}
  >
    <Icono nombre="escudo" tam={19} />
    <div>
      {!hayAtenciones ? (
        <p><strong>Sin antecedentes registrados.</strong> Todavía no tiene ninguna atención que cuente.</p>
      ) : hayAlergia ? (
        <p><strong>Alergias: {alergias}</strong></p>
      ) : alergias ? (
        <p><strong>Alergias: {alergias.toLowerCase()}.</strong> Así quedó escrito en su atención más reciente que lo anotó.</p>
      ) : antecedentes ? (
        <p>
          <strong>Sin dato de alergias.</strong> Esa atención dejó el campo en blanco, que no
          es lo mismo que "ninguna": hay que preguntarlo otra vez.
        </p>
      ) : (
        <p>
          <strong>Sin dato de alergias.</strong> Ninguna de sus atenciones lo dejó escrito, y en
          blanco no es lo mismo que "ninguna": hay que preguntarlo.
        </p>
      )}
      {antecedentes && (
        <small>
          De la atención {idAntecedentes
            ? <a href={`/sistema/atencion/${idAntecedentes}`}>N° {antecedentes.numero}</a>
            : <>N° {antecedentes.numero}</>}, del {fechaLarga(antecedentes.fecha)}.
        </small>
      )}
    </div>
  </div>

  <ul class="cifras">
    <li class="sis-tarjeta">
      <span class="cifras__rotulo">Atenciones</span>
      <strong class="cifras__dato cifra">{resumen.atenciones}</strong>
      <span class="cifras__pie">
        {resumen.borradores > 0 && `${resumen.borradores} sin terminar. `}
        {resumen.anuladas > 0
          ? `${resumen.anuladas} ${resumen.anuladas === 1 ? 'anulada' : 'anuladas'} aparte.`
          : 'ninguna anulada.'}
      </span>
    </li>
    <li class="sis-tarjeta">
      <span class="cifras__rotulo">Paciente desde</span>
      <strong class="cifras__dato cifras__dato--corto">
        {resumen.desde ? fechaCorta(resumen.desde) : '—'}
      </strong>
      <span class="cifras__pie">
        {resumen.desde ? 'fecha de su primera atención' : 'todavía sin atenciones'}
      </span>
    </li>
    <li class="sis-tarjeta">
      <span class="cifras__rotulo">Facturado en total</span>
      <strong class="cifras__dato cifra">{principal ? dinero(principal.total) : '0,00'}</strong>
      <span class="cifras__pie">
        {principal ? `en ${principal.moneda}` : 'nada cargado todavía'}
        {otrasMonedas.map((c) => <><br />y {dinero(c.total)} en {c.moneda}</>)}
      </span>
    </li>
    <li class="sis-tarjeta">
      <span class="cifras__rotulo">Con qué seguros vino</span>
      {resumen.seguros.length === 0 ? (
        <p class="cifras__texto">Siempre pagó directo.</p>
      ) : (
        <ul class="chapas">
          {resumen.seguros.map((s) => <li>{s}</li>)}
        </ul>
      )}
    </li>
  </ul>

  <div class="col">
    <section class="sis-tarjeta">
      <h2>Hábitos y antecedentes</h2>
      {otros.length === 0 ? (
        <p class="suelto">
          {!hayAtenciones
            ? 'Se llenan en la atención y aparecen acá en cuanto haya una.'
            : antecedentes
              ? 'Esa atención no dejó escrito nada más que las alergias.'
              : 'Ninguna de sus atenciones dejó escritos los hábitos ni los antecedentes.'}
        </p>
      ) : (
        <dl class="datos">
          {otros.map((a) => (
            <div>
              <dt>{a.rotulo}</dt>
              <dd>{a.valor}</dd>
            </div>
          ))}
        </dl>
      )}
      {antecedentes && (
        <p class="pie">
          Es lo que quedó escrito en la atención N° {antecedentes.numero}, del
          {' '}{fechaLarga(antecedentes.fecha)}. No se arrastra solo de una atención a la
          siguiente: el médico lo confirma cada vez.
        </p>
      )}
    </section>

    <section class="sis-tarjeta">
      <h2>{puedeEditar ? 'Datos del paciente' : 'Contacto'}</h2>

      {puedeEditar ? (
        <form method="post" class="tel">
          <input type="hidden" name="accion" value="datos" />

          <div class="sis-campo">
            <label for="nombre">Nombres y apellidos</label>
            <input id="nombre" name="nombre" required autocomplete="off" value={enForma.nombre} />
            <span class="pista">
              Corregirlo cambia el encabezado de los documentos que se vuelvan a
              imprimir. Lo que ya se imprimió queda como salió.
            </span>
          </div>

          <div class="sis-campo sis-campo--par">
            <span class="par">
              <span class="par__uno">
                <label for="tipo_doc">Documento</label>
                <select id="tipo_doc" name="tipo_doc">
                  {TIPOS.map((t) => (
                    <option value={t} selected={enForma.tipoDoc === t}>{ROTULO[t]}</option>
                  ))}
                </select>
              </span>
              <span class="par__uno">
                <label for="documento">Número</label>
                <input id="documento" name="documento" required autocomplete="off"
                       value={enForma.documento} />
              </span>
            </span>
            <span class="pista">
              Es con lo que el sistema reconoce a la persona. Si el número nuevo ya
              es de otro paciente, el guardado se rechaza: juntar dos fichas se
              hace a mano y con cuidado.
            </span>
          </div>

          <div class="sis-campo">
            <label for="sexo">Sexo</label>
            <select id="sexo" name="sexo">
              <option value="">—</option>
              <option value="Femenino" selected={enForma.sexo === 'Femenino'}>Femenino</option>
              <option value="Masculino" selected={enForma.sexo === 'Masculino'}>Masculino</option>
            </select>
          </div>

          <div class="sis-campo">
            <label for="telefono">Teléfono</label>
            <input
              id="telefono" name="telefono" type="tel" value={enForma.telefono}
              inputmode="tel" autocomplete="off" placeholder="0414-8939176"
            />
            <span class="pista">
              Se puede dejar en blanco: un número equivocado es peor que ninguno.
            </span>
          </div>
          <div class="sis-campo">
            <label for="whatsapp">WhatsApp</label>
            <input
              id="whatsapp" name="whatsapp" type="tel" value={enForma.whatsapp}
              inputmode="tel" autocomplete="off" placeholder="0414-8939176"
            />
            <span class="pista">Solo si es otro número. Vacío significa «use el teléfono».</span>
          </div>
          <div class="sis-campo">
            <label for="correo">Correo</label>
            <input
              id="correo" name="correo" type="email" value={enForma.correo}
              autocomplete="off" placeholder="nombre@correo.com"
            />
            <span class="pista">A donde se le manda el informe. Confirmarlo con el paciente.</span>
          </div>
          <button type="submit" class="sis-boton sis-boton--azul" name="guardar" value="1">
            Guardar los datos
          </button>
        </form>
      ) : (
        <dl class="contacto">
          <div><dt>Teléfono</dt><dd>{enForma.telefono || '—'}</dd></div>
          {enForma.whatsapp && <div><dt>WhatsApp</dt><dd>{enForma.whatsapp}</dd></div>}
          <div><dt>Correo</dt><dd>{enForma.correo || '—'}</dd></div>
        </dl>
      )}

      {contacto && !contacto.esMovil && (
        <p class="suelto suelto--nota">
          No parece un celular, así que no se ofrece WhatsApp: el enlace llevaría a una
          conversación que no existe.
        </p>
      )}

      {donde && (donde.direccion || donde.ciudad || donde.referencia) && (
        <dl class="datos datos--alto">
          {donde.direccion && <div><dt>Dirección</dt><dd>{donde.direccion}</dd></div>}
          {donde.ciudad && <div><dt>Ciudad</dt><dd>{donde.ciudad}</dd></div>}
          {donde.referencia && <div><dt>Punto de referencia</dt><dd>{donde.referencia}</dd></div>}
          <div><dt>De la atención</dt><dd class="cifra">N° {donde.numero}, del {fechaLarga(donde.fecha)}</dd></div>
        </dl>
      )}

      <p class="pie">
        {puedeEditar
          ? 'Lo que se corrija acá queda en bitácora, con lo que decía antes. Lo que ya se imprimió o se firmó no cambia.'
          : 'Los datos del paciente los corrige recepción o administración.'}
      </p>
    </section>

    {/* Borrar una ficha es lo único que se borra de verdad en todo el
        sistema, y se puede porque una ficha sin atenciones no tiene un solo
        dato clínico adentro: es un error de tipeo con nombre. Con historia
        no se borra nunca —se corrige— y la tarjeta lo dice en vez de
        esconder el botón sin explicación. */}
    {borrable && (
      <section class="sis-tarjeta borrar">
        <h2>Borrar la ficha</h2>
        {borrable.puede ? (
          <>
            <p class="suelto">
              No tiene ninguna atención, así que no hay nada clínico adentro: se
              puede borrar. Sirve para la ficha que quedó de un número mal
              tecleado. No se puede deshacer.
            </p>
            <form method="post" class="borrar__forma">
              <input type="hidden" name="accion" value="borrar" />
              <div class="sis-campo">
                <label for="confirma">
                  Escriba el documento del paciente para confirmar
                </label>
                <input id="confirma" name="confirma" required autocomplete="off"
                       placeholder={paciente.cedula} />
              </div>
              <button type="submit" class="sis-boton sis-boton--suave anular">
                Borrar esta ficha
              </button>
            </form>
          </>
        ) : (
          <p class="suelto">{borrable.motivo}</p>
        )}
      </section>
    )}
  </div>

  <section class="historial">
    <h2>Todas sus atenciones</h2>
    {atenciones.length === 0 ? (
      <div class="sis-tarjeta suelto suelto--vacio">
        <p>Está en el registro pero todavía no tiene ninguna atención cargada.</p>
        {escribe && (
          <a class="sis-boton sis-boton--primario" href={nuevaConSuCedula}>Registrar la primera</a>
        )}
      </div>
    ) : (
      <div class="sis-tarjeta tabla">
        <table>
          <thead>
            <tr>
              <th scope="col">Atención</th>
              <th scope="col">Fecha</th>
              <th scope="col">Diagnóstico</th>
              <th scope="col">Atendió</th>
              <th scope="col">Estado</th>
              <th scope="col" class="derecha">Cobrado</th>
            </tr>
          </thead>
          <tbody>
            {atenciones.map((a) => (
              <tr class:list={[a.estado === 'anulada' && 'muerta']}>
                <td class="numero">
                  <a href={`/sistema/atencion/${a.id}`} class="cifra">N° {a.numero}</a>
                </td>
                <td class="cifra">{fechaCorta(a.fecha)}</td>
                <td>
                  {/* Una orden de laboratorio no tiene diagnóstico y decir
                      «sin diagnóstico escrito» hacía parecer que al médico
                      se le había olvidado algo. */}
                  <span class="dx">
                    {a.tipo === 'laboratorio'
                      ? 'Laboratorio'
                      : a.idx ?? 'Sin diagnóstico escrito'}
                  </span>
                  {a.aseguradora && <small>{a.aseguradora}</small>}
                  {a.anuladaMotivo && <small class="motivo">Anulada: {a.anuladaMotivo}</small>}
                </td>
                <td>{a.medico ?? 'Cuenta borrada'}</td>
                <td>
                  <span class:list={['chapa', `chapa--${ETIQUETAS[a.estado]?.clase ?? 'cerrada'}`]}>
                    {ETIQUETAS[a.estado]?.texto ?? a.estado}
                  </span>
                </td>
                <td class="derecha">
                  {a.cuentas.length === 0 ? (
                    <span class="nada">Sin cobro</span>
                  ) : (
                    a.cuentas.map((c) => (
                      <span class="monto cifra">{dinero(c.total)} {c.moneda}</span>
                    ))
                  )}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )}
    <p class="pie pie--suelto">
      Las anuladas se muestran tachadas y no se esconden: quedaron sin efecto, pero
      pasaron. Tampoco entran en los totales de arriba.
    </p>
  </section>
</Sistema>

