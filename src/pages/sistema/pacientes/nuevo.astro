---
/**
 * Registrar un paciente sin abrirle una atención.
 *
 * Es la mitad del trabajo de recepción que faltaba. Hasta acá una persona
 * solo existía si alguien le abría una historia clínica, así que para
 * anotar a quien llamó por teléfono había que inventarle una consulta que
 * no tuvo.
 *
 * El cliente lo pidió para administración y para recepción: «crear el
 * paciente, actualizarlo, datos de contacto».
 *
 * Lo mismo de siempre con el documento: la cédula es el camino y lo demás
 * es la salida, cerrada a propósito. Ver src/sistema/lib/documento.ts.
 */
import Sistema from '../../../layouts/Sistema.astro';
import Icono from '../../../components/Icono.astro';
import { exigir } from '../../../sistema/lib/guardia';
import { anotar } from '../../../sistema/lib/atenciones';
import { crearPaciente } from '../../../sistema/lib/pacientes';
import { ROTULO, TIPOS, esTipo, formatearInterno } from '../../../sistema/lib/documento';
import { bd } from '../../../sistema/lib/base';
import { sql } from 'drizzle-orm';

export const prerender = false;

const corte = exigir(Astro, 'editar_paciente');
if (corte) return corte;

const usuario = Astro.locals.usuario!;

let error = '';
/* Lo tecleado vuelve si el guardado rebota: nadie debería escribir dos
   veces los datos de la misma persona. */
let puesto = {
  nombre: '', tipoDoc: 'cedula', documento: '', sexo: '',
  telefono: '', whatsapp: '', correo: '',
};

/* El que no trae documento: el sistema le pone uno, igual que en la puerta
   de la atención. El número sale de la secuencia de la base y no de un
   contador de acá, porque dos recepciones a la vez sacarían el mismo. */
const sinDocumento = Astro.url.searchParams.get('doc') === 'interno';
let internoSugerido = '';
if (sinDocumento) {
  const [fila] = await bd.execute<{ n: string }>(
    sql`SELECT nextval('paciente_interno_seq') AS n`,
  );
  internoSugerido = formatearInterno(Number(fila.n));
  puesto = { ...puesto, tipoDoc: 'interno', documento: internoSugerido };
}

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const crudoTipo = String(form.get('tipo_doc') ?? 'cedula');
  puesto = {
    nombre: String(form.get('nombre') ?? ''),
    tipoDoc: esTipo(crudoTipo) ? crudoTipo : 'cedula',
    documento: String(form.get('documento') ?? ''),
    sexo: String(form.get('sexo') ?? ''),
    telefono: String(form.get('telefono') ?? ''),
    whatsapp: String(form.get('whatsapp') ?? ''),
    correo: String(form.get('correo') ?? ''),
  };

  try {
    const creado = await crearPaciente(puesto);
    await anotar(usuario.id, 'creo_paciente', undefined, {
      paciente: creado.id, nombre: creado.nombre, documento: creado.cedula,
    });
    return Astro.redirect(`/sistema/pacientes/${creado.id}?nuevo=1`);
  } catch (e) {
    error = e instanceof Error ? e.message : 'No se pudo registrar al paciente.';
  }
}
---

<Sistema titulo="Nuevo paciente">
  <nav class="miga">
    <a href="/sistema/pacientes">Pacientes</a> <span>/</span> Nuevo
  </nav>

  <div class="caja">
    <h1>Registrar un paciente</h1>
    <p class="nota">
      Para anotar a alguien sin abrirle una atención: el que llamó para pedir
      cita, el que pasó a preguntar. Cuando venga, su historia se abre con
      los datos ya cargados.
    </p>

    {error && <p class="sis-error msj"><Icono nombre="escudo" tam={18} />{error}</p>}

    <form method="post" class="sis-tarjeta forma">
      <div class="sis-campo campo--ancho">
        <label for="nombre">Nombres y apellidos<abbr title="Obligatorio">*</abbr></label>
        <input id="nombre" name="nombre" required autofocus autocomplete="off" value={puesto.nombre} />
      </div>

      <div class="sis-campo">
        <label for="tipo_doc">Documento</label>
        <select id="tipo_doc" name="tipo_doc">
          {TIPOS.map((t) => (
            <option value={t} selected={puesto.tipoDoc === t}>{ROTULO[t]}</option>
          ))}
        </select>
        <span class="pista">
          {sinDocumento
            ? 'Sin documento: el sistema le asignó el número de abajo.'
            : 'Casi siempre la cédula. Lo demás, para quien no la tiene.'}
        </span>
      </div>

      <div class="sis-campo">
        <label for="documento">Número<abbr title="Obligatorio">*</abbr></label>
        <input
          id="documento" name="documento" required autocomplete="off"
          value={puesto.documento} placeholder="V-12.345.678"
          readonly={sinDocumento && puesto.documento === internoSugerido}
        />
        <span class="pista">Con o sin puntos, con o sin letra. Da igual cómo se escriba.</span>
      </div>

      <div class="sis-campo">
        <label for="sexo">Sexo</label>
        <select id="sexo" name="sexo">
          <option value="">—</option>
          <option value="Femenino" selected={puesto.sexo === 'Femenino'}>Femenino</option>
          <option value="Masculino" selected={puesto.sexo === 'Masculino'}>Masculino</option>
        </select>
      </div>

      <div class="sis-campo">
        <label for="telefono">Teléfono</label>
        <input id="telefono" name="telefono" type="tel" inputmode="tel"
               autocomplete="off" value={puesto.telefono} placeholder="0414-8939176" />
      </div>

      <div class="sis-campo">
        <label for="whatsapp">WhatsApp</label>
        <input id="whatsapp" name="whatsapp" type="tel" inputmode="tel"
               autocomplete="off" value={puesto.whatsapp} />
        <span class="pista">Solo si es otro número.</span>
      </div>

      <div class="sis-campo campo--ancho">
        <label for="correo">Correo</label>
        <input id="correo" name="correo" type="email" autocomplete="off"
               value={puesto.correo} placeholder="nombre@correo.com" />
        <span class="pista">A donde se le manda el informe. Confirmarlo con el paciente.</span>
      </div>

      <div class="forma__pie">
        <button type="submit" class="sis-boton sis-boton--primario">Registrar</button>
        <a class="sis-boton sis-boton--suave" href="/sistema/pacientes">Cancelar</a>
      </div>
    </form>

    {!sinDocumento && (
      <p class="salida">
        <a href="/sistema/pacientes/nuevo?doc=interno">El paciente no tiene documento</a>
      </p>
    )}
  </div>
</Sistema>

<style>
  .miga { font-size: var(--u-sm); color: var(--tinta-tenue); margin-bottom: 14px; }
  .miga a { color: var(--tinta-suave); text-decoration: none; }
  .miga a:hover { color: var(--azul); text-decoration: underline; }
  .miga span { margin-inline: 5px; }

  .caja { max-width: 680px; }
  .caja h1 { font-size: var(--u-xl); }
  .nota { margin-top: 7px; font-size: var(--u-sm); color: var(--tinta-tenue); line-height: 1.55; }
  .msj { display: flex; align-items: flex-start; gap: 9px; margin-top: 16px; font-size: var(--u-sm); }

  .forma { margin-top: 18px; display: grid; gap: 14px; }
  @media (min-width: 620px) { .forma { grid-template-columns: 1fr 1fr; } }
  .campo--ancho { grid-column: 1 / -1; }
  .forma__pie { grid-column: 1 / -1; display: flex; flex-wrap: wrap; gap: 10px; }

  abbr { color: var(--rojo); text-decoration: none; font-weight: 700; margin-left: 4px; }
  .salida { margin-top: 16px; font-size: var(--u-sm); }
  .salida a { color: var(--tinta-suave); }
</style>
