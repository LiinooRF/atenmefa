---
/**
 * El panel de derivaciones.
 *
 * Una derivación es interna (a un especialista del centro con cuenta),
 * externa (a uno de afuera, por WhatsApp) o un traslado a otro centro. Cada
 * quien ve acá lo suyo:
 *
 *   administración  todas, y las mueve.
 *   recepción       las que el médico mandó a pasar por recepción: admitir
 *                   al paciente para el especialista, escribirle al de
 *                   afuera, coordinar la ambulancia.
 *   un médico       las que le derivaron a él, para atenderlas, y las que
 *                   pidió, para ver en qué van.
 *
 * Las reglas de quién puede qué están en lib/interconsultas.ts: la pantalla
 * solo dibuja los botones que corresponden.
 */
import Sistema from '../../layouts/Sistema.astro';
import Icono from '../../components/Icono.astro';
import { exigir } from '../../sistema/lib/guardia';
import { puede } from '../../sistema/lib/permisos';
import { dinero } from '../../sistema/lib/cobro';
import { comoSeLee } from '../../sistema/lib/telefono';
import {
  ROTULO_TIPO, abrirConsultaDerivada, anularInterconsulta, contactar, destinoDe,
  especialistasPorEspecialidad, interconsultasAbiertas, marcarAtendida, rotuloEstado,
  type TipoDerivacion,
} from '../../sistema/lib/interconsultas';

export const prerender = false;

const usuario = Astro.locals.usuario;
const rol = (usuario?.rol ?? '') as string;
const administra = puede(rol, 'gestionar_interconsultas');
const deRecepcion = puede(rol, 'derivaciones_recepcion');
const esMedico = puede(rol, 'pedir_interconsulta');
if (!administra && !deRecepcion && !esMedico) {
  const corte = exigir(Astro, 'gestionar_interconsultas');
  if (corte) return corte;
}

let error = '';

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const accion = String(form.get('accion') ?? '');
  const id = String(form.get('interconsulta') ?? '');
  try {
    if (accion === 'contactar') {
      // Se anota primero y recién después se abre el chat: ver contactar().
      const enlace = await contactar(usuario!, id, String(form.get('especialista') ?? ''));
      return Astro.redirect(enlace, 303);
    }
    if (accion === 'atender') {
      const { id: consulta, esElEspecialista } = await abrirConsultaDerivada(usuario!, id);
      /* El especialista entra a escribirla; recepción la deja admitida y
         el especialista la encuentra en sus casos, como cualquier admisión. */
      return Astro.redirect(esElEspecialista
        ? `/sistema/atencion/${consulta}/editar`
        : `/sistema/derivaciones?hecho=admitida`);
    }
    if (accion === 'atendida') {
      await marcarAtendida(usuario!, id);
      return Astro.redirect('/sistema/derivaciones?hecho=atendida');
    }
    if (accion === 'anular') {
      await anularInterconsulta(usuario!, id, form.get('motivo'));
      return Astro.redirect('/sistema/derivaciones?hecho=anulada');
    }
    return Astro.redirect('/sistema/derivaciones');
  } catch (e) {
    error = e instanceof Error ? e.message : 'No se pudo hacer.';
  }
}

const todas = await interconsultasAbiertas(usuario!);
const filtro = (Astro.url.searchParams.get('ver') ?? 'todas') as TipoDerivacion | 'todas';
const abiertas = filtro === 'todas' ? todas : todas.filter((d) => d.tipo === filtro);
const externas = abiertas.filter((d) => d.tipo === 'externa');
const porArea = await especialistasPorEspecialidad([...new Set(externas.map((d) => d.especialidadBusca))]);

/** ¿Quien mira puede mover esta? Lo mismo que decide el servidor. */
const gestiona = (d: { porRecepcion: boolean }) => administra || (deRecepcion && d.porRecepcion);

const cuenta = (t: TipoDerivacion | 'todas') => (t === 'todas' ? todas.length : todas.filter((d) => d.tipo === t).length);
const FILTROS: { valor: TipoDerivacion | 'todas'; rotulo: string }[] = [
  { valor: 'todas', rotulo: 'Todas' },
  { valor: 'interna', rotulo: 'Del centro' },
  { valor: 'externa', rotulo: 'De afuera' },
  { valor: 'traslado', rotulo: 'Traslados' },
];

const hecho = Astro.url.searchParams.get('hecho');
const aviso = {
  atendida: 'Quedó cerrada.',
  anulada: 'Quedó anulada. El médico la ve así en la consulta.',
  admitida: 'Paciente admitido: la consulta quedó a nombre del especialista, en sus casos.',
}[hecho ?? ''] ?? '';

const cuando = (d: Date) => d.toLocaleString('es-VE', {
  timeZone: 'America/Caracas', day: 'numeric', month: 'short', hour: 'numeric', minute: '2-digit',
});
const titulo = administra ? 'Derivaciones' : deRecepcion ? 'Derivaciones para recepción' : 'Mis derivaciones';
---

<Sistema titulo={titulo}>
  <div class="cab">
    <div>
      <h1>{titulo}</h1>
      <p class="cab__nota">
        {todas.length === 0 ? 'Nada pendiente'
          : `${todas.length} ${todas.length === 1 ? 'abierta' : 'abiertas'}`}
      </p>
    </div>
    {administra && (
      <a class="sis-boton sis-boton--suave" href="/sistema/especialistas">
        <Icono nombre="estetoscopio" tam={18} />
        Especialistas de afuera
      </a>
    )}
  </div>

  {aviso && <p class="msj--bien" role="status"><Icono nombre="escudo" tam={18} />{aviso}</p>}
  {error && <p class="sis-error" role="alert">{error}</p>}

  <nav class="filtros" aria-label="Qué derivaciones ver">
    {FILTROS.map((f) => (
      <a class:list={['filtros__uno', filtro === f.valor && 'filtros__uno--actual']}
         href={f.valor === 'todas' ? '/sistema/derivaciones' : `/sistema/derivaciones?ver=${f.valor}`}
         aria-current={filtro === f.valor ? 'page' : undefined}>
        {f.rotulo} <span class="cifra">{cuenta(f.valor)}</span>
      </a>
    ))}
  </nav>

  {abiertas.length === 0 ? (
    <div class="sis-tarjeta vacio">
      <h2>No hay derivaciones abiertas</h2>
      <p>Cuando un médico derive a un paciente desde la consulta, aparece acá.</p>
    </div>
  ) : (
    <ul class="lista">
      {abiertas.map((d) => {
        const especialistas = d.tipo === 'externa' ? porArea.get(d.especialidadBusca) ?? [] : [];
        const mueve = gestiona(d);
        const esParaMi = d.tipo === 'interna' && d.destinoMedicoId === usuario!.id;
        return (
          <li class:list={['sis-tarjeta', 'ic', `ic--${d.estado}`]}>
            <div class="ic__cabeza">
              <div>
                <p class="ic__tipo">{ROTULO_TIPO[d.tipo]}{d.porRecepcion && ' · pasa por recepción'}</p>
                <h2>{destinoDe(d)}</h2>
                <p class="ic__quien">
                  <a href={`/sistema/atencion/${d.atencionId}#interconsultas`}>{d.paciente}</a>
                  <span class="cifra"> {d.cedula}</span> · atención N° {d.numero}
                </p>
              </div>
              <span class="ic__estado">{rotuloEstado(d.estado, d.tipo)}</span>
            </div>
            {d.motivo && <p class="ic__motivo">{d.motivo}</p>}
            <p class="ic__meta">
              Pidió {d.medico}, {cuando(d.pedida)}
              {d.contactada && <> · se le escribió a {d.especialista}, {cuando(d.contactada)}</>}
              {d.tipo === 'traslado' && <> · {d.ambulancia ? 'en ambulancia' : 'sin ambulancia'}{d.paramedico && `, paramédico ${d.paramedico}`}</>}
            </p>

            {d.tipo === 'externa' && mueve && (especialistas.length === 0 ? (
              <p class="ic__falta">
                No hay especialistas de {d.especialidad} cargados.
                {administra && <><a href="/sistema/especialistas">Cargue uno</a> con su precio y su WhatsApp.</>}
              </p>
            ) : (
              <table class="esp">
                <thead>
                  <tr><th scope="col">Especialista</th><th scope="col">Consulta</th><th scope="col"><span class="oculto">Contactar</span></th></tr>
                </thead>
                <tbody>
                  {especialistas.map((e) => (
                    <tr>
                      <td>
                        <strong>{e.nombre}</strong>
                        {e.notas && <small class="esp__notas">{e.notas}</small>}
                      </td>
                      <td class="cifra">{e.precio ? `${dinero(e.precio)} ${e.moneda}` : 'Sin precio'}</td>
                      <td class="esp__accion">
                        {e.whatsapp ? (
                          <form method="post" target="_blank" data-contactar>
                            <input type="hidden" name="accion" value="contactar" />
                            <input type="hidden" name="interconsulta" value={d.id} />
                            <input type="hidden" name="especialista" value={e.id} />
                            <button type="submit" class="sis-boton sis-boton--azul"
                                    title={`Abre WhatsApp con ${comoSeLee(e.whatsapp)}`}>
                              <Icono nombre="correo" tam={17} />
                              Contactar
                            </button>
                          </form>
                        ) : (
                          <small>Sin WhatsApp cargado</small>
                        )}
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            ))}

            <div class="ic__pie">
              {d.tipo === 'interna' && d.estado === 'pendiente' && (esParaMi || mueve) && (
                <form method="post">
                  <input type="hidden" name="accion" value="atender" />
                  <input type="hidden" name="interconsulta" value={d.id} />
                  <button type="submit" class="sis-boton sis-boton--primario">
                    {esParaMi ? 'Atenderlo' : `Admitirlo para ${d.destinoMedico}`}
                  </button>
                </form>
              )}
              {mueve && d.tipo === 'externa' && d.estado === 'contactada' && (
                <form method="post">
                  <input type="hidden" name="accion" value="atendida" />
                  <input type="hidden" name="interconsulta" value={d.id} />
                  <button type="submit" class="sis-boton sis-boton--suave">Ya lo atendió</button>
                </form>
              )}
              {mueve && d.tipo === 'traslado' && d.estado === 'pendiente' && (
                <form method="post">
                  <input type="hidden" name="accion" value="atendida" />
                  <input type="hidden" name="interconsulta" value={d.id} />
                  <button type="submit" class="sis-boton sis-boton--suave">Ya se trasladó</button>
                </form>
              )}
              {mueve && (
                <details>
                  <summary>Anular</summary>
                  <form method="post" class="ic__anular sis-campo">
                    <input type="hidden" name="accion" value="anular" />
                    <input type="hidden" name="interconsulta" value={d.id} />
                    <label for={`motivo-${d.id}`}>¿Por qué se anula?</label>
                    <input id={`motivo-${d.id}`} name="motivo" type="text" required maxlength="1000" />
                    <button type="submit" class="sis-boton sis-boton--suave">Anular</button>
                  </form>
                </details>
              )}
            </div>
          </li>
        );
      })}
    </ul>
  )}
</Sistema>

<script>
  /* WhatsApp se abre en otra pestaña. Esta se recarga sola para que la
     derivación pase a «especialista contactado» sin acordarse de actualizar. */
  document.querySelectorAll<HTMLFormElement>('[data-contactar]').forEach((f) => {
    f.addEventListener('submit', () => setTimeout(() => location.reload(), 1200));
  });
</script>

<style>
  .cab { display: flex; flex-wrap: wrap; gap: 14px; align-items: center; justify-content: space-between; }
  .cab h1 { font-size: var(--u-2xl); }
  .cab__nota { margin-top: 5px; font-size: var(--u-sm); color: var(--tinta-tenue); }
  .msj--bien {
    display: flex; align-items: flex-start; gap: 9px; margin-top: 16px; padding: 11px 14px;
    border-radius: 8px; background: #e4f2ea; border: 1px solid #a9d5bd; color: #105433; font-size: var(--u-sm);
  }
  .sis-error { margin-top: 16px; }
  .filtros { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 18px; }
  .filtros__uno {
    display: inline-flex; align-items: center; gap: 6px; min-height: 44px; padding: 0 14px;
    border: 1px solid var(--linea); border-radius: 999px; color: var(--tinta-suave); text-decoration: none; font-size: var(--u-sm);
  }
  .filtros__uno--actual { background: var(--azul); border-color: var(--azul); color: #fff; }
  .vacio { margin-top: 20px; text-align: center; padding-block: 48px; }
  .vacio h2 { font-size: var(--u-lg); }
  .vacio p { margin-top: 6px; color: var(--tinta-suave); }
  .lista { list-style: none; margin: 16px 0 0; padding: 0; display: grid; gap: 14px; }
  .ic { padding: 16px 18px; }
  .ic__cabeza { display: flex; flex-wrap: wrap; align-items: flex-start; justify-content: space-between; gap: 8px 14px; }
  .ic__tipo { font-size: var(--u-xs); font-weight: 600; color: var(--tinta-tenue); text-transform: none; }
  .ic__cabeza h2 { font-size: var(--u-lg); margin-top: 2px; }
  .ic__quien { margin-top: 3px; font-size: var(--u-sm); }
  .ic__estado { font-size: var(--u-xs); padding: 3px 10px; border-radius: 999px; background: var(--azul-tenue); }
  .ic--pendiente .ic__estado { background: #fff1cc; color: #6b4b00; }
  .ic__motivo { margin-top: 10px; white-space: pre-wrap; overflow-wrap: anywhere; }
  .ic__meta { margin-top: 6px; font-size: var(--u-sm); color: var(--tinta-tenue); }
  .ic__falta { margin-top: 12px; padding: 10px 12px; border-radius: 8px; background: #fff8e6; border: 1px solid #ecd28f; font-size: var(--u-sm); }
  .esp { width: 100%; margin-top: 12px; border-collapse: collapse; font-size: var(--u-sm); }
  .esp th { text-align: left; font-weight: 600; color: var(--tinta-suave); padding: 6px 8px 6px 0; border-bottom: 1px solid var(--linea); }
  .esp td { padding: 9px 8px 9px 0; border-bottom: 1px solid var(--linea-tenue); vertical-align: middle; }
  .esp__notas { display: block; color: var(--tinta-tenue); }
  .esp__accion { text-align: right; white-space: nowrap; }
  .ic__pie { display: flex; flex-wrap: wrap; align-items: center; gap: 10px 16px; margin-top: 14px; font-size: var(--u-sm); }
  .ic__pie summary { cursor: pointer; color: var(--tinta-suave); }
  .ic__anular { display: grid; gap: 7px; margin-top: 8px; max-width: 420px; }
  .oculto { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  @media (max-width: 560px) {
    .esp thead { display: none; }
    .esp tr { display: grid; grid-template-columns: 1fr auto; gap: 4px 10px; padding: 9px 0; border-bottom: 1px solid var(--linea-tenue); }
    .esp td { border: 0; padding: 0; }
    .esp__accion { grid-column: 1 / -1; text-align: left; }
  }
</style>
