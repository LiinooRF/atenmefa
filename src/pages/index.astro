---
import Base from '../layouts/Base.astro';
import Tapa from '../components/Tapa.astro';
import { marca } from '../data/marca';
import Hero from '../components/Hero.astro';
import Accesos from '../components/Accesos.astro';
import Respaldo from '../components/Respaldo.astro';
import Nosotros from '../components/Nosotros.astro';
import Especialidades from '../components/Especialidades.astro';
import Servicios from '../components/Servicios.astro';
import Equipo from '../components/Equipo.astro';
import Preguntas from '../components/Preguntas.astro';
import Ubicacion from '../components/Ubicacion.astro';
import Instagram from '../components/Instagram.astro';
import Cierre from '../components/Cierre.astro';
---

{marca.demo ? <Tapa /> : (
<Base
  titulo="Atenmefa — Centro médico y ambulancia en Ciudad Bolívar"
  descripcion="Centro médico en Ciudad Bolívar: consultas especializadas, laboratorio clínico propio, ecosonografías, atención a domicilio y traslados en ambulancia. C.C. Santa Catalina, Av. Sucre."
  ruta="/"
  conPreguntas={true}
>
  <Hero />
  <Accesos />
  <Respaldo />
  <Servicios />
  <Especialidades />
  <Nosotros />
  <Equipo />
  <Preguntas />
  <Instagram />
  <Ubicacion />
  <Cierre />
</Base>
)}
