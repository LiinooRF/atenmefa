---
import Base from '../../layouts/Base.astro';
import Icono from '../../components/Icono.astro';
import Falta from '../../components/Falta.astro';
import Cierre from '../../components/Cierre.astro';
import {
  servicios, preguntasDe, catalogoDePreguntas, clinica, wa, type Servicio,
} from '../../data/clinica';
import Lamina from '../../components/Lamina.astro';
import { iconoDe } from '../../lib/iconos';
import { ruta } from '../../lib/rutas';
import { enRevision } from '../../lib/revision';

export function getStaticPaths() {
  return servicios.map((s) => ({ params: { slug: s.slug }, props: { servicio: s } }));
}

interface Props { servicio: Servicio }
const { servicio: s } = Astro.props;

const tel = clinica.contacto.fijo ?? clinica.contacto.whatsapp;
const preguntas = preguntasDe(s);
const otros = servicios.filter((o) => o.slug !== s.slug).slice(0, 4);

/* Las preguntas de este servicio que ya tienen página propia, para enlazar
   a ellas desde acá: es lo que convierte las páginas sueltas en un conjunto
   que Google recorre. */
const conPagina = new Set(
  catalogoDePreguntas.filter((q) => q.servicio?.slug === s.slug).map((q) => q.slug),
);

const fichas = [
  { rotulo: 'Precio', valor: s.precioDesde ? `Desde ${s.precioDesde}` : null, falta: 'precio' },
  { rotulo: 'Duración', valor: s.duracion, falta: 'cuánto tarda' },
  { rotulo: 'Preparación', valor: s.preparacion, falta: 'si hace falta preparación' },
  { rotulo: 'Entrega', valor: s.entrega, falta: 'cuándo se entrega' },
];

const icono = iconoDe(s.slug);
---

<Base
  titulo={`${s.titulo} | Atenmefa`}
  descripcion={s.entrada}
  ruta={`/servicios/${s.slug}/`}
  servicio={s}
>
  <nav class="miga" aria-label="Ruta">
    <div class="contenedor">
      <a href={ruta('/')}>Inicio</a>
      <Icono nombre="flecha" tam={14} />
      <a href={ruta('/#servicios')}>Servicios</a>
      <Icono nombre="flecha" tam={14} />
      <span aria-current="page">{s.nombre}</span>
    </div>
  </nav>

  <article>
    <header class="encabezado">
      <div class="contenedor encabezado__rejilla">
        <div class="encabezado__caja">
        <h1>{s.titulo}</h1>
        <p class="encabezado__entrada">{s.entrada}</p>
        <div class="encabezado__acciones">
          <a class="boton boton--rojo" href={`tel:${tel.e164}`}>
            <Icono nombre="telefono" tam={19} />
            Llamar al {tel.visible}
          </a>
          <a class="boton boton--contorno" href={wa(`Hola, quisiera información sobre: ${s.nombre}.`)} target="_blank" rel="noopener">
            <Icono nombre="whatsapp" tam={19} />
            Escribir por WhatsApp
          </a>
        </div>
        </div>

        {/* La placa de color del servicio. Ocupaba media pantalla en
            blanco: el título quedaba solo a la izquierda y el lado
            derecho vacío parecía una imagen que no cargó. */}
        <Lamina icono={icono} rotulo={`Lámina de ${s.nombre}`} ancho={5} alto={4} />
      </div>
    </header>

    <section class="seccion">
      <div class="contenedor dos-columnas">
        <div>
          <h2>Qué incluye</h2>
          <ul class="incluye">
            {s.incluye.map((i) => (
              <li><Icono nombre="escudo" tam={19} />{i}</li>
            ))}
          </ul>

          <p class="cobertura">
            <Icono nombre="ubicacion" tam={18} />
            Cobertura: <strong>{s.cobertura}</strong>
          </p>
        </div>

        <aside class="ficha">
          <h2>Datos del servicio</h2>
          <dl>
            {fichas.map((f) => (
              <div class="ficha__fila">
                <dt>{f.rotulo}</dt>
                <dd>{f.valor ?? <Falta que={f.falta} />}</dd>
              </div>
            ))}
          </dl>
        </aside>
      </div>
    </section>

    {preguntas.length > 0 && (
      <section class="seccion seccion--bruma">
        <div class="contenedor estrecho">
          <h2>Preguntas sobre {s.nombre.toLowerCase()}</h2>
          <ul class="preguntas">
            {preguntas.map((p, i) => (
              <li>
                <details open={i === 0}>
                  <summary>
                    <span>{p.pregunta}</span>
                    <span class="preguntas__signo" aria-hidden="true"><Icono nombre="mas" tam={19} /></span>
                  </summary>
                  <div class="preguntas__respuesta"><p>{p.respuesta}</p></div>
                </details>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )}

    {/* Solo en la copia de revisión: es la lista de pendientes del encargo,
        no contenido del sitio. Publicada le decía a cualquier visitante que
        la página está a medias. */}
    {enRevision && s.preguntas.length > preguntas.length && (
      <section class="seccion">
        <div class="contenedor estrecho">
          <h2>Lo que falta responder</h2>
          <p class="guia">
            Estas preguntas ya están escritas y esperando el dato del cliente.
            Son las que más pesan para que el servicio aparezca en las respuestas
            de Google y Gemini.
          </p>
          <ul class="sin-respuesta">
            {s.preguntas.filter((p) => p.respuesta === null).map((p) => (
              <li>{p.pregunta}</li>
            ))}
          </ul>
        </div>
      </section>
    )}

    <section class="seccion seccion--bruma">
      <div class="contenedor">
        <h2>Otros servicios</h2>
        <ul class="otros">
          {otros.map((o) => (
            <li>
              <a href={ruta(`/servicios/${o.slug}/`)}>
                <strong>{o.nombre}</strong>
                <small>{o.resumen}</small>
                <span class="otros__flecha"><Icono nombre="flecha" tam={18} /></span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  </article>

  <Cierre />
</Base>

<style>
  .miga { border-bottom: 1px solid var(--linea-tenue); background: var(--bruma); }
  .miga .contenedor {
    display: flex;
    align-items: center;
    gap: 9px;
    padding-block: 13px;
    font-size: var(--t-sm);
    color: var(--tinta-tenue);
    overflow-x: auto;
    white-space: nowrap;
  }
  .miga a { color: var(--tinta-suave); text-decoration: none; }
  .miga a:hover { color: var(--azul); text-decoration: underline; }
  .miga :global(svg) { color: var(--linea); flex: none; }
  .miga span { color: var(--azul); font-weight: 600; }

  .encabezado { padding-block: clamp(38px, 6vw, 68px) clamp(30px, 4vw, 48px); }
  .encabezado__caja { max-width: min(68ch, 100%); }

  /* La lámina al lado del título solo cuando hay ancho de verdad. Abajo
     de 980 px se va: en el teléfono, lo primero tiene que ser el nombre
     del servicio y el botón de llamar, no una placa decorativa. */
  .encabezado__rejilla { display: grid; gap: clamp(26px, 4vw, 44px); align-items: center; }
  .encabezado__rejilla > :global(.lamina) { display: none; }
  @media (min-width: 980px) {
    .encabezado__rejilla { grid-template-columns: 1.15fr 0.85fr; }
    .encabezado__rejilla > :global(.lamina) { display: grid; }
  }
  .encabezado__entrada {
    margin-top: 20px;
    font-size: var(--t-md);
    color: var(--tinta-suave);
    max-width: min(62ch, 100%);
  }
  .encabezado__acciones { display: flex; flex-wrap: wrap; gap: 11px; margin-top: 28px; }

  .dos-columnas { display: grid; grid-template-columns: minmax(0, 1fr); gap: clamp(30px, 4vw, 52px); }
  @media (min-width: 900px) { .dos-columnas { grid-template-columns: 1.25fr 0.75fr; align-items: start; } }

  .incluye { list-style: none; margin: 20px 0 0; padding: 0; display: grid; gap: 12px; }
  .incluye li { display: flex; align-items: flex-start; gap: 11px; color: var(--tinta-suave); }
  .incluye :global(svg) { color: var(--rojo); margin-top: 3px; flex: none; }

  .cobertura {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    margin-top: 26px;
    padding: 11px 16px;
    border-radius: 999px;
    background: var(--azul-tenue);
    color: var(--azul);
    font-size: var(--t-sm);
  }
  .cobertura :global(svg) { color: var(--rojo); }

  .ficha {
    border: 1px solid var(--linea);
    border-radius: var(--radio);
    padding: 24px;
  }
  .ficha h2 { font-size: var(--t-md); margin-bottom: 6px; }
  .ficha dl { margin: 0; }
  .ficha__fila { padding-block: 15px; border-bottom: 1px solid var(--linea-tenue); }
  .ficha__fila:last-child { border-bottom: 0; padding-bottom: 0; }
  .ficha dt {
    font-size: var(--t-xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--tinta-tenue);
    font-weight: 700;
    margin-bottom: 7px;
  }
  .ficha dd { margin: 0; color: var(--azul); font-weight: 600; }

  .estrecho { max-width: 840px; }

  .preguntas { list-style: none; margin: 24px 0 0; padding: 0; border-top: 1px solid var(--linea); }
  .preguntas li { border-bottom: 1px solid var(--linea); }
  summary {
    list-style: none;
    cursor: pointer;
    padding: 19px 2px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    font-family: var(--titulares);
    font-size: 1.04rem;
    font-weight: 700;
    letter-spacing: -0.015em;
    color: var(--azul);
  }
  summary::-webkit-details-marker { display: none; }
  summary:hover { color: var(--rojo); }
  .preguntas__signo { flex: none; color: var(--rojo); transition: transform 220ms cubic-bezier(0.22, 1, 0.36, 1); }
  details[open] .preguntas__signo { transform: rotate(135deg); }
  .preguntas__respuesta { padding: 0 2px 21px; color: var(--tinta-suave); max-width: min(66ch, 100%); }

  .sin-respuesta { list-style: none; margin: 24px 0 0; padding: 0; display: grid; gap: 9px; }
  .sin-respuesta li {
    display: flex;
    align-items: center;
    gap: 11px;
    padding: 14px 17px;
    border: 1.5px dashed var(--linea);
    border-radius: var(--radio-sm);
    background: var(--bruma);
    color: var(--tinta-suave);
    font-family: var(--titulares);
    font-size: var(--t-sm);
    font-weight: 600;
  }
  .sin-respuesta li::before {
    content: '';
    width: 7px; height: 7px;
    border-radius: 50%;
    background: var(--rojo);
    flex: none;
  }

  .otros {
    list-style: none;
    margin: 24px 0 0;
    padding: 0;
    display: grid;
    gap: 12px;
    grid-template-columns: repeat(auto-fit, minmax(min(260px, 100%), 1fr));
  }
  .otros a {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    grid-template-areas: 'nombre flecha' 'resumen flecha';
    gap: 5px 16px;
    align-items: center;
    padding: 19px 21px;
    background: var(--papel);
    border: 1px solid var(--linea);
    border-radius: var(--radio);
    text-decoration: none;
    transition: border-color 180ms ease, transform 180ms ease;
  }
  .otros a:hover { border-color: var(--azul); transform: translateY(-2px); }
  .otros strong {
    grid-area: nombre;
    font-family: var(--titulares);
    font-size: 1.04rem;
    font-weight: 700;
    letter-spacing: -0.015em;
    color: var(--azul);
  }
  .otros small { grid-area: resumen; font-size: var(--t-sm); color: var(--tinta-tenue); line-height: 1.45; }
  .otros__flecha { grid-area: flecha; color: var(--linea); transition: color 180ms ease, transform 180ms ease; }
  .otros a:hover .otros__flecha { color: var(--rojo); transform: translateX(3px); }
</style>
