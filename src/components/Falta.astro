---
/**
 * Slot para un dato que el cliente todavía no entregó.
 *
 * Se ve SOLO en la copia de revisión (PREVIA=1): ahí salta a la vista qué
 * falta. En el sitio publicado no se dibuja nada. Estaba saliendo en
 * producción y Google lo indexó.
 */
import { enRevision } from '../lib/revision';

interface Props {
  /** Qué dato falta, en pocas palabras. Lo lee el cliente. */
  que: string;
}
const { que } = Astro.props;
---

{enRevision && <p class="falta">Falta el dato de {que}</p>}

<style>
  .falta {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    border: 1.5px dashed var(--linea);
    border-radius: var(--radio-sm);
    background: var(--bruma);
    padding: 13px 17px;
    font-family: var(--titulares);
    font-size: var(--t-sm);
    font-weight: 600;
    color: var(--tinta-suave);
  }
  .falta::before {
    content: '';
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--rojo);
    flex: none;
  }



  .falta__porque { font-size: var(--t-sm); line-height: 1.5; color: var(--tinta-suave); }
</style>
