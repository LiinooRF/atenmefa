---
/**
 * Slot para un dato que el cliente todavía no entregó.
 * Se ve a propósito: al revisar la página salta a la vista qué falta.
 * Cuando el dato se llena en src/data/clinica.ts, el bloque desaparece solo.
 */
interface Props {
  que: string;
  porque?: string;
}
const { que, porque } = Astro.props;
---

<div class="falta">
  <span class="falta__sello">Falta el dato</span>
  <strong>{que}</strong>
  {porque && <span class="falta__porque">{porque}</span>}
</div>

<style>
  .falta {
    display: flex;
    flex-direction: column;
    gap: 6px;
    border: 1.5px dashed var(--linea);
    border-radius: var(--radio-sm);
    background: var(--bruma);
    padding: 16px 18px;
    max-width: min(58ch, 100%);
  }

  .falta__sello {
    font-family: var(--titulares);
    font-size: var(--t-xs);
    letter-spacing: 0.15em;
    text-transform: uppercase;
    font-weight: 700;
    color: var(--rojo);
  }

  .falta strong {
    font-family: var(--titulares);
    font-size: 1.02rem;
    font-weight: 700;
    letter-spacing: -0.015em;
    color: var(--azul);
  }

  .falta__porque { font-size: var(--t-sm); line-height: 1.5; color: var(--tinta-suave); }
</style>
