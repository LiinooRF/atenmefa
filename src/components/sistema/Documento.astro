---
/**
 * El documento impreso: el "2 en 1" de la consulta —informe y récipe— o el
 * informe del laboratorio.
 *
 * Es un componente y no una página porque lo dibujan dos: el sistema
 * (/sistema/atencion/[id]/documento, con sesión) y la verificación pública
 * (/verificar/[id]/informe, con la cédula y el PIN), que es a donde lleva el
 * correo al paciente. Así lo que le llega es EXACTAMENTE el mismo informe que
 * se imprime en el laboratorio, no una copia armada aparte (16-11). En modo
 * `publico` no hay vuelta al sistema, ni Excel, ni «enviar».
 *
 * Quien lo usa ya comprobó el acceso y que la atención existe.
 *
 * El "2 en 1": informe de atención y récipe, en un solo documento.
 *
 * No hay librería de PDF. Es HTML con una hoja de impresión: el médico
 * toca Imprimir y el navegador saca el PDF. Sale idéntico en pantalla y en
 * papel, y no hay plantilla aparte que se desincronice del formulario.
 */
import QR from 'qrcode';
import { marca } from '../../data/marca';
import { fueraDeRango, comoSeDice } from '../../sistema/rangos';
import { historia } from '../../sistema/historia';
import { laboratorio, type Resultado } from '../../sistema/laboratorio';
import { examenesPedidos } from '../../sistema/lib/laboratorio';
import { ROTULO_AGREGADO, agregadosDe, lineasDeExamenes } from '../../sistema/lib/agregados';
import { puede } from '../../sistema/lib/permisos';
import { ROTULO } from '../../sistema/lib/documento';
import { bd, esquema } from '../../sistema/lib/base';
import { anotar } from '../../sistema/lib/atenciones';
import { asegurarPin } from '../../sistema/lib/verificacion';
import { clinica } from '../../data/clinica';
import { eq } from 'drizzle-orm';
import { ROTULO_TIPO, destinoDe, interconsultasDe } from '../../sistema/lib/interconsultas';
import { correccionesDe } from '../../sistema/lib/correcciones';
import { entorno } from '../../sistema/lib/entorno';

interface Props { id: string; publico?: boolean }
const { id, publico = false } = Astro.props;
const usuario = publico ? null : Astro.locals.usuario ?? null;

const [caso] = await bd
  .select({
    id: esquema.atencion.id,
    numero: esquema.atencion.numero,
    estado: esquema.atencion.estado,
    tipo: esquema.atencion.tipo,
    resultados: esquema.atencion.resultados,
    resultadosPor: esquema.atencion.resultadosPor,
    fecha: esquema.atencion.fecha,
    aseguradora: esquema.atencion.aseguradora,
    poliza: esquema.atencion.poliza,
    casoNumero: esquema.atencion.casoNumero,
    datos: esquema.atencion.datos,
    paciente: esquema.paciente.nombre,
    cedula: esquema.paciente.cedula,
    tipoDoc: esquema.paciente.tipoDoc,
    pin: esquema.atencion.pin,
    telefono: esquema.paciente.telefono,
    medico: esquema.user.name,
    colegiatura: esquema.user.colegiatura,
    msds: esquema.user.msds,
    firmaMedico: esquema.user.firma,
  })
  .from(esquema.atencion)
  .innerJoin(esquema.paciente, eq(esquema.paciente.id, esquema.atencion.pacienteId))
  .innerJoin(esquema.user, eq(esquema.user.id, esquema.atencion.medicoId))
  .where(eq(esquema.atencion.id, id!))
  .limit(1);

if (!caso) throw new Error('El documento no existe: la página que lo dibuja tiene que comprobarlo antes.');

if (usuario) await anotar(usuario.id, 'imprimio', caso.id);

const d = (caso.datos ?? {}) as Record<string, string>;

/* ----------------------------------------------------------------
   Laboratorio.
   ----------------------------------------------------------------

   Un informe de laboratorio no es un informe de atención recortado: no
   tiene examen físico, ni diagnóstico, ni récipe, y la firma que vale es
   la del bioanalista con su colegio. Por eso es su propia hoja y no esta
   con campos vacíos.

   El sello va húmedo: «no vamos a manejar [sello digital], se imprime y se
   usa un sello húmedo ya elaborado el informe», dijo el cliente. De ahí
   que la hoja deje el espacio y no estampe ninguna imagen. */
const esLab = caso.tipo === 'laboratorio';
const resultados = (caso.resultados ?? []) as Resultado[];
const conValor = resultados.filter((r) => r.valor);

/* Los subtítulos del informe.
   
   Las hojas del laboratorio no son una lista plana: la de coagulación
   tiene dos bloques —«TIEMPO DE PROTROMBINA:» y el PTT— y la de depuración
   tres. Esos renglones traen nombre y nada más: ni valor, ni unidad, ni
   rango. Filtrando por «tiene valor» desaparecían, y el informe impreso
   salía como una lista corrida donde el tiempo control del PTT quedaba
   pegado al del protrombina sin que se supiera cuál era cuál.
   
   Un subtítulo sin nada debajo tampoco se imprime: si el bioanalista cargó
   solo el primer bloque, el encabezado del segundo no tiene por qué salir. */
/* Un texto y no un número: varias líneas, o largo, y sin unidad ni rango. */
const esRedactado = (r: Resultado) =>
  !r.unidad?.trim() && !r.referencia?.trim() && (r.valor.includes('\n') || r.valor.trim().length > 40);


const pedidos = esLab ? await examenesPedidos(caso.id) : [];

/* Un examen por bloque (16-11).

   «Que esté más clasificado… que diga examen general de orina y diga
   examen químico, microscópico, macroscópico, titulado de qué es ese
   examen… y una separación, dos dedos, para que sepa que es otro examen.»

   Los resultados son una lista plana. Un renglón sin valor, unidad ni rango
   es un título, pero hay dos clases: el NOMBRE DEL EXAMEN pedido («Examen
   de Orina», que el plan de resultados.astro pone arriba de su hoja) y las
   PARTES de su hoja («EXAMEN MACROSCOPICO», «ANALISIS QUIMICO»). Se
   distinguen porque el primero se llama como un examen de la orden.

   Antes se trataban igual, y la regla que no imprime un subtítulo vacío
   borraba el nombre del examen: debajo de «Examen de Orina» viene otro
   título, no un valor. Por eso la hematología —sin partes— salía titulada
   y la orina y las heces no.

   Un examen suelto, sin hoja —una glicemia—, es su propio renglón y no
   lleva título encima: va en su bloque, separado del examen anterior. */
const comoNombre = (t: string) =>
  t.normalize('NFD').replace(/[\u0300-\u036f]/g, '').trim().toUpperCase();
const nombresDeExamen = new Set(pedidos.map((p) => comoNombre(p.nombre)));
const sueltos = new Set([
  ...pedidos.filter((p) => !p.plantilla && !p.incluye?.length).map((p) => comoNombre(p.nombre)),
  ...(d.examenes ?? '').split('\n').map((t) => comoNombre(t)).filter(Boolean),
]);
/* Qué es un título: el nombre de un examen pedido o un subtítulo de una
   hoja. NO cualquier renglón vacío: en la orina casi nada trae unidad ni
   rango, y un renglón sin llenar —«ASPECTO»— se imprimía como subtítulo y
   se comía el «EXAMEN MACROSCOPICO» de arriba (16-11). */
const titulosDeHoja = esLab
  ? new Set((await bd.selectDistinct({ a: esquema.plantillaExamen.analito })
      .from(esquema.plantillaExamen)
      .where(eq(esquema.plantillaExamen.tipo, 'titulo'))).map((x) => comoNombre(x.a)))
  : new Set<string>();
const esTitulo = (r: Resultado) => {
  if (!r.examen?.trim() || r.valor?.trim() || r.unidad?.trim() || r.referencia?.trim()) return false;
  const n = comoNombre(r.examen);
  return titulosDeHoja.has(n) || nombresDeExamen.has(n);
};
type Grupo = { titulo: string | null; filas: Resultado[] };
const grupos: Grupo[] = [];
for (const r of resultados) {
  const nombre = comoNombre(r.examen ?? '');
  const actual = grupos.at(-1);
  if (esTitulo(r) && nombresDeExamen.has(nombre)) {
    grupos.push({ titulo: r.examen.trim(), filas: [] });
  } else if (!esTitulo(r) && sueltos.has(nombre) && (!actual || actual.titulo !== null)) {
    grupos.push({ titulo: null, filas: [r] });
  } else if (actual) {
    actual.filas.push(r);
  } else {
    grupos.push({ titulo: null, filas: [r] });
  }
}
/* Dentro de cada examen, una parte sin ningún valor debajo no se imprime
   —un subtítulo vacío en un informe firmado es un hueco—, y un examen sin
   ningún valor, tampoco. */
const gruposAImprimir = grupos
  .map((g) => ({
    ...g,
    filas: g.filas.filter((r, i) => {
      if (r.valor?.trim()) return true;
      if (!esTitulo(r)) return false;
      for (let j = i + 1; j < g.filas.length; j++) {
        if (esTitulo(g.filas[j])) return false;
        if (g.filas[j].valor?.trim()) return true;
      }
      return false;
    }),
  }))
  .filter((g) => g.filas.some((r) => r.valor?.trim()));

/* MEDIA HOJA POR EXAMEN (16-11), el formato por defecto.

   «Mejor mitad mitad, porque todos los laboratorios no lo colocan juntos
   así: una página, la mitad de esa página un examen, para que se pueda
   cortar por la mitad y la otra mitad se imprime con el otro examen.»
   Cada mitad vale sola: su encabezado, el paciente, el examen, la firma,
   el timbre y el QR —el mismo, es la misma orden—. Al imprimir se eligen
   los cortes. La hoja completa de antes queda como la otra opción.

   Un examen largo —la orina son veinticuatro renglones— no entra en media
   hoja en una columna: se reparte en dos, cortando en el subtítulo más
   cercano a la mitad («EXAMEN MICROSCOPICO» queda a la derecha). Un grupo
   sin título —exámenes sueltos— se titula con su único examen, o «Otros
   exámenes». */
const RENGLONES_POR_COLUMNA = 16;
const medias = gruposAImprimir.map((g) => {
  const propios = g.filas.filter((r) => !esTitulo(r));
  const titulo = g.titulo ?? (propios.length === 1 ? propios[0].examen.trim() : 'Otros exámenes');
  let partes = [g.filas];
  if (g.filas.length > RENGLONES_POR_COLUMNA) {
    const mitad = Math.ceil(g.filas.length / 2);
    let corte = -1;
    let distancia = Infinity;
    g.filas.forEach((r, i) => {
      if (i > 0 && esTitulo(r) && Math.abs(i - mitad) < distancia) { distancia = Math.abs(i - mitad); corte = i; }
    });
    if (corte < 0 || distancia > g.filas.length / 4) corte = mitad;
    partes = [g.filas.slice(0, corte), g.filas.slice(corte)];
  }
  return { titulo, partes };
});

/* Dos por hoja (16-11): con más de un examen, dos columnas. Cada examen va
   a la columna que va más corta —por renglones—, no en fila: si se llenan
   en orden, una orina larga en la segunda columna empuja las heces a otra
   hoja aunque debajo de la hematología quede lugar. Se lee columna por
   columna. */
const columnas: Grupo[][] = gruposAImprimir.length > 1 ? [[], []] : [gruposAImprimir];
if (gruposAImprimir.length > 1) {
  const alto = [0, 0];
  for (const g of gruposAImprimir) {
    const i = alto[0] <= alto[1] ? 0 : 1;
    columnas[i].push(g);
    alto[i] += g.filas.length + (g.titulo ? 2 : 1) + 1;
  }
}

const examenesPedidosTexto = esLab
  ? [
      ...pedidos.map((p) => p.nombre),
      ...(d.examenes ?? '').split('\n').map((t) => t.trim()).filter(Boolean),
    ]
  : [];

/* Quien firma el informe de laboratorio. Si todavía no hay resultados
   cargados no hay a quién atribuirlo, y la hoja sale con el renglón en
   blanco para firmar a mano: es lo honesto. */
const [firmante] = caso.resultadosPor
  ? await bd
      .select({
        nombre: esquema.user.name,
        colegiatura: esquema.user.colegiatura,
        firma: esquema.user.firma,
      })
      .from(esquema.user)
      .where(eq(esquema.user.id, caso.resultadosPor))
      .limit(1)
  : [];

const bloquesLab = esLab
  ? laboratorio
      .map((s) => ({
        ...s,
        campos: s.campos.filter(
          (c) => d[c.clave] && !['nombre', 'cedula', 'edad', 'nacimiento', 'sexo', 'telefono',
            'whatsapp', 'correo', 'fecha', 'aseguradora', 'poliza', 'examenes'].includes(c.clave),
        ),
      }))
      .filter((s) => s.campos.length > 0)
  : [];

/* Lo que ya sale en la cabecera o en la fila de signos vitales no se
   repite abajo: en papel la repetición hace parecer que falta algo. */
const yaArriba = new Set([
  'nombre', 'cedula', 'edad', 'nacimiento', 'sexo', 'telefono', 'titular', 'direccion',
  'ciudad', 'aseguradora', 'poliza', 'fecha', 'caso_numero',
  /* El WhatsApp y el correo sirven para mandarle el informe, no para que
     salgan impresos en él: en el papel serían dos renglones de datos de
     contacto en medio de una historia clínica. El teléfono ya va arriba. */
  'whatsapp', 'correo',
  'ta', 'fc', 'fr', 'temperatura', 'glicemia', 'glasgow', 'saturacion', 'hora_signos',
]);

const formatear = (clave: string, valor: string) => {
  const campo = historia.flatMap((s) => s.campos).find((c) => c.clave === clave);
  if (campo?.tipo === 'fecha') {
    return new Date(`${valor}T12:00:00`).toLocaleDateString('es-VE', {
      day: '2-digit', month: '2-digit', year: 'numeric',
    });
  }
  /* El diagnóstico sale con su código CIE-10 cuando se eligió del
     catálogo. Es lo que una aseguradora busca en el papel, y es la razón
     de ser del catálogo: sin el código impreso, codificar no sirve de
     nada. Si se escribió a mano, va el texto solo. */
  if (clave === 'idx' && d.idx_codigo) return `${valor} (${d.idx_codigo})`;
  return valor;
};

/* «Referido a» en el papel sale de las derivaciones que se hicieron desde
   la atención, sin las anuladas. Lo que una historia vieja traía escrito a
   mano en ese campo se conserva arriba. Solo en esta vista: no se guarda. */
if (!esLab) {
  const derivadas = (await interconsultasDe(caso.id)).filter((x) => x.estado !== 'anulada');
  const lineas = derivadas.map((x) => `${destinoDe(x)} (${ROTULO_TIPO[x.tipo].toLowerCase()})`);
  if (lineas.length) d.referido = [d.referido, ...lineas].filter(Boolean).join('\n');
}

/* Si se corrigió después de firmada, el papel lo dice al pie: así uno
   viejo y uno nuevo no se confunden (16-11). La última corrección. */
const ultimaCorreccion = (await correccionesDe(caso.id)).at(-1) ?? null;
const lineaDeCorreccion = ultimaCorreccion
  ? `Corregido el ${ultimaCorreccion.creado.toLocaleDateString('es-VE', { timeZone: 'America/Caracas', day: '2-digit', month: '2-digit', year: 'numeric' })} por ${ultimaCorreccion.autor}.`
  : '';

/* El récipe es la segunda página: no se repite en el informe. */
const bloques = historia
  .filter((s) => s.clave !== 'recipe' && s.clave !== 'signos')
  .map((s) => ({ ...s, campos: s.campos.filter((c) => d[c.clave] && !yaArriba.has(c.clave)) }))
  .filter((s) => s.campos.length > 0);

const hayRecipe = !esLab && Boolean(d.recipe || d.indicaciones);

/* Lo que se le sumó después de cerrar, sin lo anulado. Va DESPUÉS de la
   firma del médico que atendió: él firmó lo de arriba, no esto, y cada
   agregado lleva su propio autor. */
const agregados = esLab ? [] : (await agregadosDe(caso.id)).filter((a) => !a.anuladoEn);
const cuandoAgrego = (f: Date) => f.toLocaleString('es-VE', {
  timeZone: 'America/Caracas', day: 'numeric', month: 'long', year: 'numeric',
  hour: 'numeric', minute: '2-digit',
});

/* ----------------------------------------------------------------
   El sello de verificación.
   ----------------------------------------------------------------

   El papel se puede rehacer en cualquier procesador de texto. Con esto,
   quien lo recibe —una aseguradora, una empresa, una farmacia— puede
   comprobar que lo emitió el centro.

   El QR se dibuja acá como SVG y no se guarda en ninguna parte: ni archivo,
   ni imagen, ni PDF. Se arma cada vez que se abre el documento. */
/* La dirección donde el sistema REALMENTE está, no el dominio final.
   clinica.dominio es atenmefa.site, que sirve para la canónica del sitio
   público pero hoy todavía apunta a la web vieja: un QR impreso con esa
   dirección da 404. Un código que funciona hoy vale más que uno que va a
   funcionar algún día, y el día que se mude el dominio esto cambia solo,
   porque sale de URL_BASE. Los papeles ya impresos quedan con la de
   entonces: por eso también va el N° para verificar a mano. */
const dondeVive = (entorno('URL_BASE') ?? clinica.dominio).replace(/\/$/, '');
const urlVerificacion = `${dondeVive}/verificar/${caso.id}`;
const dominioCorto = dondeVive.replace(/^https?:\/\//, '');
/* Las órdenes de laboratorio se entregaban sin PIN —se creaba solo al
   cerrar una consulta— y su informe salía sin QR. Una cerrada que no lo
   tiene lo recibe acá, la primera vez que se abre (16-11). */
let pin = caso.pin;
if (!pin && caso.estado === 'cerrada') {
  await asegurarPin(caso.id);
  [{ pin }] = await bd.select({ pin: esquema.atencion.pin }).from(esquema.atencion).where(eq(esquema.atencion.id, caso.id));
}
const qr = pin
  ? await QR.toString(urlVerificacion, {
      type: 'svg', margin: 0, errorCorrectionLevel: 'M', width: 132,
    })
  : null;

const fechaLarga = (f: string) =>
  new Date(`${f}T12:00:00`).toLocaleDateString('es-VE', { day: '2-digit', month: '2-digit', year: 'numeric' });

const vitales = [
  ['T/A', d.ta, 'mmHg'], ['FC', d.fc, 'lpm'], ['FR', d.fr, 'rpm'],
  ['Temp', d.temperatura, '°C'], ['Glicemia', d.glicemia, 'mg/dL'],
  ['Glasgow', d.glasgow, ''], ['Sat O₂', d.saturacion, '%'],
].filter(([, v]) => v);
---

<!doctype html>
<html lang="es-VE">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Atención {caso.numero} · {caso.paciente}</title>
    <meta name="robots" content="noindex, nofollow" />
  </head>

  <body>
    <div class="acciones">
      {publico
        ? <span>{marca.nombre} · Informe de laboratorio N° {caso.numero}</span>
        : <a href={`/sistema/atencion/${caso.id}`}>← Volver a la {esLab ? 'orden' : 'atención'}</a>}
      <div class="acciones__grupo">
        {/* Las tres salidas que pidió el cliente para el laboratorio:
            «descargar el PDF o el Excel, o para imprimir, o la opción que te
            envíe por el WhatsApp del usuario». El PDF lo saca el navegador
            con el botón de imprimir; los otros dos son estos. */}
        {!publico && esLab && conValor.length > 0 && (
          <a class="acciones__otro" href={`/sistema/atencion/${caso.id}/resultados.xlsx`}>
            Excel
          </a>
        )}
        {usuario && puede(usuario.rol as string, 'enviar_documento') && (
          <a class="acciones__otro" href={`/sistema/atencion/${caso.id}/enviar`}>
            Enviar al paciente
          </a>
        )}
        {esLab && medias.length > 0 && (
          <>
            <span class="acciones__rotulo" id="formato-rotulo">Formato</span>
            <div class="papel" role="radiogroup" aria-labelledby="formato-rotulo">
              <button type="button" role="radio" data-formato="medias" aria-checked="true">
                Media hoja <em>un examen por corte</em>
              </button>
              <button type="button" role="radio" data-formato="completa" aria-checked="false">
                Hoja completa <em>todo junto</em>
              </button>
            </div>
          </>
        )}
        <span class="acciones__rotulo" id="papel-rotulo">Papel</span>
        <div class="papel" role="radiogroup" aria-labelledby="papel-rotulo">
          <button type="button" role="radio" data-papel="carta" aria-checked="true">
            Carta <em>21,6 × 27,9 cm</em>
          </button>
          <button type="button" role="radio" data-papel="oficio" aria-checked="false">
            Oficio <em>21,6 × 33 cm</em>
          </button>
        </div>
        {/* Tres salidas distintas, no una. Lo pidió el cliente y tiene
            sentido: el informe va a la aseguradora, el récipe va a la
            farmacia, y a veces hace falta el juego completo. Cada uno sigue
            generándose en vivo: lo único que cambia es qué hoja se imprime. */}
        {hayRecipe ? (
          <div class="papel" role="group" aria-label="Qué imprimir">
            <button type="button" class="acciones__imprimir" data-imprimir="informe">Informe</button>
            <button type="button" class="acciones__imprimir" data-imprimir="recipe">Récipe</button>
            <button type="button" class="acciones__imprimir acciones__imprimir--todo" data-imprimir="todo">Los dos</button>
          </div>
        ) : (
          <button type="button" class="acciones__imprimir acciones__imprimir--todo" data-imprimir="todo">
            Imprimir o guardar en PDF
          </button>
        )}
      </div>
    </div>

    {/* Qué cortes salen: se destilda el examen que no se quiere imprimir
        —uno que ya se entregó, otro que se reimprime solo—. */}
    {esLab && medias.length > 1 && (
      <fieldset class="cortes" data-solo-medias>
        <legend>Qué cortes imprimir</legend>
        {medias.map((m, i) => (
          <label><input type="checkbox" checked data-corte={i} /> {m.titulo}</label>
        ))}
      </fieldset>
    )}

    {caso.estado !== 'cerrada' && (
      <p class="aviso">
        Esta atención está en <strong>{caso.estado}</strong>. El documento definitivo
        se imprime una vez cerrada.
      </p>
    )}

    <!-- La hoja mide 215 mm y tiene que medir eso: es papel, no una pantalla.
         Pero en un teléfono de 390 px eso arrastraba la página entera de lado
         y se llevaba consigo la barra de arriba. Se desplaza dentro de esta
         caja, que es la regla de la casa para cualquier cosa ancha. -->
    <div class="lienzo">
    <!-- ===== Informe de laboratorio ===== -->
    {esLab && (
      <article class:list={['hoja', 'hoja--lab', medias.length > 0 && 'hoja--con-medias']}>
       <table class="corrida">
        <tfoot>
