    <style is:global>
      :root {
        --azul: #111663;
        --rojo: #d31c24;
        --tinta: #1a1a1a;
        --gris: #666;
        --linea: #c9c9c9;
      }

      * { box-sizing: border-box; }

      body {
        margin: 0;
        padding: 26px 16px 60px;
        background: #e9ecf3;
        color: var(--tinta);
        font: 11pt/1.4 'Noto Sans', system-ui, sans-serif;
      }

      .acciones {
        max-width: 215mm;
        margin: 0 auto 18px;
        display: flex;
        gap: 12px;
        align-items: center;
        justify-content: space-between;
      }
      /* 44 px de alto en todo lo que se toca con el dedo, igual que el panel. */
      /* La tabla de resultados del laboratorio. Las cuatro columnas tienen
         ancho fijo para que el valor y su referencia queden alineados hoja
         tras hoja: un informe donde la columna del medio se mueve según el
         largo del nombre se lee mal. */
      .valores { width: 100%; border-collapse: collapse; margin-top: 4px; }
      .valores th {
        text-align: left;
        padding: 4px 6px;
        border-bottom: 1px solid var(--tinta);
        font-size: 8.5pt;
        letter-spacing: 0.02em;
        text-transform: uppercase;
        color: var(--gris);
      }
      .valores td { padding: 4.5px 6px; border-bottom: 1px solid var(--linea); font-size: 10pt; }
      .valores tr:last-child td { border-bottom: 0; }
      /* Ninguna fila se corta entre dos hojas: un resultado partido a la
         mitad es ilegible. */
      .valores tr { break-inside: avoid; }
      .valores th:nth-child(2), .valores td:nth-child(2) { width: 22mm; }
      .valores th:nth-child(3), .valores td:nth-child(3) { width: 20mm; }
      .valores th:nth-child(4), .valores td:nth-child(4) { width: 46mm; }
      .valores__dato { font-weight: 700; color: var(--azul); }

      /* Fuera de rango: en el papel no hay color garantizado —muchas se
         imprimen en blanco y negro—, así que además del tono va una
         flecha. Lo que se imprime tiene que leerse en una fotocopia. */
      .valores__dato[data-fuera] { color: var(--rojo); }
      .valores__flecha { font-size: 7.5pt; margin-left: 3px; }

      /* La firma va ENCIMA de la línea, no en lugar de ella: el renglón
         sigue estando por si alguien quiere firmar al lado. */
      .firma__imagen {
        display: block;
        max-width: 46mm;
        max-height: 16mm;
        margin: 0 auto -2mm;
        object-fit: contain;
      }
      /* Solo para quien lee con un lector de pantalla: la flecha sola no
         dice si el valor está alto o bajo. */
      .oculto {
        position: absolute; width: 1px; height: 1px;
        overflow: hidden; clip-path: inset(50%); white-space: nowrap;
      }

      /* El subtítulo de bloque, como en las hojas del laboratorio: pegado a
         la izquierda, sin rango al lado y sin la línea que separa los
         resultados entre sí. El :nth-child de los anchos no lo toca porque
         ocupa las cuatro columnas de una vez. */
      .valores__seccion th {
        padding: 9px 6px 3px;
        border-bottom: 1px solid var(--tinta);
        text-align: left;
        text-transform: none;
        letter-spacing: 0;
        font-size: 9.5pt;
        font-weight: 700;
        color: var(--tinta);
      }
      .valores__seccion:first-child th { padding-top: 3px; }

      /* Cada examen, su bloque (16-11). El nombre del examen pedido va
         grande, en banda, y sus partes —macroscópico, químico,
         microscópico— debajo, como subtítulos. Entre un examen y el
         siguiente, aire y una línea: «dos dedos». */
      /* Un examen no se parte entre dos hojas ni entre dos columnas. Entre
         uno y el siguiente, aire: «dos dedos» a lo ancho, algo menos en
         columnas. */
      .valores__grupo { break-inside: avoid; margin: 0 0 7mm; }
      .valores__grupo:last-child { margin-bottom: 0; }
      .examenes--dos { display: grid; grid-template-columns: 1fr 1fr; column-gap: 7mm; align-items: start; }
      .examenes__col { min-width: 0; }
      .examenes--dos .valores__grupo { margin-bottom: 5mm; }
      .examenes--dos .valores th { font-size: 7pt; padding: 3px 4px; }
      .examenes--dos .valores td { font-size: 8.5pt; padding: 2.5px 4px; }
      .examenes--dos .valores th:nth-child(2), .examenes--dos .valores td:nth-child(2) { width: 19mm; }
      .examenes--dos .valores th:nth-child(3), .examenes--dos .valores td:nth-child(3) { width: 10mm; }
      .examenes--dos .valores th:nth-child(4), .examenes--dos .valores td:nth-child(4) { width: 27mm; }
      .examenes--dos .valores__examen th { font-size: 9.5pt; padding: 4px 6px; }
      .examenes--dos .valores__seccion th { font-size: 8pt; padding: 5px 4px 2px; }
      .examenes--dos .valores__grupo--titulado td:first-child { padding-left: 8px; }
      .valores__examen th {
        padding: 5px 7px;
        border-top: 1.5px solid var(--tinta);
        border-bottom: 1px solid var(--tinta);
        background: #eef1f6;
        -webkit-print-color-adjust: exact; print-color-adjust: exact;
        text-align: left;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        font-size: 11pt;
        font-weight: 700;
        color: var(--tinta);
        break-after: avoid;
      }
      .valores__grupo--titulado .valores__seccion th { padding-left: 10px; font-size: 9.5pt; }
      .valores__grupo--titulado td:first-child { padding-left: 14px; }


      .suelto { margin: 4px 0 0; font-size: 10pt; line-height: 1.5; }
      .suelto--ojo { margin-top: 8px; color: var(--gris); font-size: 9pt; }

      .acciones__otro {
        padding: 0 14px;
        border: 1px solid var(--linea);
        border-radius: 7px;
        background: #fff;
        color: var(--azul) !important;
        font-weight: 600;
      }
      .acciones__otro:hover { border-color: var(--azul); }

      .acciones a {
        display: inline-flex;
        align-items: center;
        min-height: 44px;
        color: var(--azul);
        font-size: 10pt;
        text-decoration: none;
      }
      .acciones a:hover { text-decoration: underline; }
      .acciones__grupo { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; }
      .acciones__rotulo { font-size: 9pt; color: var(--gris); font-weight: 600; }

      .papel {
        display: inline-flex;
        border: 1px solid #bcc4d6;
        border-radius: 7px;
        overflow: hidden;
        background: #fff;
      }
      .papel button {
        display: flex;
        flex-direction: column;
        justify-content: center;
        gap: 1px;
        min-height: 44px;
        padding: 7px 14px;
        border: 0;
        background: transparent;
        color: var(--gris);
        font: inherit;
        font-size: 9.5pt;
        font-weight: 600;
        line-height: 1.25;
        text-align: left;
        cursor: pointer;
      }
      .papel button + button { border-left: 1px solid #bcc4d6; }
      .papel button em { font-style: normal; font-size: 7.5pt; font-weight: 400; opacity: 0.75; }
      .papel button[aria-checked='true'] { background: var(--azul); color: #fff; }

      .papel { display: inline-flex; gap: 8px; flex-wrap: wrap; }
      /* El juego completo es lo que más se usa: va en rojo, los otros dos
         como alternativa. */
      .acciones__imprimir--todo { background: var(--rojo); color: #fff; }

      .acciones__imprimir {
        min-height: 44px;
        padding: 10px 20px;
        border: 0;
        border-radius: 7px;
        background: var(--papel);
        color: var(--azul);
        border: 1px solid #bcc4d6;
        font: inherit;
        font-size: 10pt;
        font-weight: 600;
        cursor: pointer;
      }
      .acciones__imprimir--todo { border-color: var(--rojo); }

      @media (max-width: 760px) {
        .acciones { flex-direction: column; align-items: flex-start; }
      }

      .aviso {
        max-width: 215mm;
        margin: 0 auto 14px;
        padding: 10px 14px;
        border-radius: 7px;
        background: #fdf0d9;
        border: 1px solid #e8c98a;
        color: #7a5200;
        font-size: 10pt;
      }

      /* Solo en pantalla: en papel un ancestro con overflow puede recortar
         la paginación. La hoja conserva sus 215 mm y se desplaza acá dentro. */
      @media screen {
        .lienzo { overflow-x: auto; padding-bottom: 4px; }
      }

      /* El relleno de acá es el MISMO margen que @page le da al papel, para
         que lo que se ve en pantalla sea lo que sale impreso. Si se cambian,
         se cambian los dos. El alto lo pone el script según el papel elegido. */
      .hoja {
        width: 215mm;
        min-height: var(--alto-papel, 279mm);
        margin: 0 auto 20px;
        padding: 13mm 14mm;
        background: #fff;
        box-shadow: 0 2px 14px rgba(0, 0, 0, 0.14);
      }

      .enc {
        break-inside: avoid;
        break-after: avoid;
        display: grid;
        grid-template-columns: auto 1fr auto;
        gap: 12px;
        align-items: center;
        padding-bottom: 10px;
        border-bottom: 2.5px solid var(--azul);
      }
      .enc img { border-radius: 50%; }
      .enc__marca { display: flex; flex-direction: column; line-height: 1.25; }
      .enc__marca strong { font-size: 16pt; font-weight: 800; color: var(--azul); letter-spacing: -0.02em; }
      .enc__marca span { font-size: 9pt; color: var(--rojo); font-weight: 600; }
      .enc__marca small { font-size: 7.5pt; color: var(--gris); }
      .enc__titulo { display: flex; flex-direction: column; align-items: flex-end; line-height: 1.3; }
      .enc__titulo span { font-size: 9pt; text-transform: uppercase; letter-spacing: 0.05em; color: var(--gris); font-weight: 600; }
      .enc__titulo strong { font-size: 15pt; color: var(--azul); font-weight: 800; }
      .enc__titulo small { font-size: 9pt; color: var(--gris); }

      .cabecera { width: 100%; border-collapse: collapse; margin-top: 12px; break-inside: avoid; }
      .cabecera th, .cabecera td { border: 1px solid var(--linea); padding: 5px 8px; font-size: 9.5pt; text-align: left; }
      .cabecera th { width: 88px; background: #f2f4f9; color: var(--gris); font-weight: 600; font-size: 8pt; text-transform: uppercase; letter-spacing: 0.03em; }

      .vitales { margin-top: 14px; break-inside: avoid; }
      .vitales ul { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0; border: 1px solid var(--linea); }
      .vitales li { flex: 1 1 auto; min-width: 80px; padding: 6px 10px; border-right: 1px solid var(--linea); display: flex; flex-direction: column; }
      .vitales li:last-child { border-right: 0; }
      .vitales span { font-size: 7.5pt; text-transform: uppercase; letter-spacing: 0.04em; color: var(--gris); font-weight: 600; }
      .vitales strong { font-size: 11pt; color: var(--azul); }
      .vitales em { font-style: normal; font-size: 8pt; font-weight: 400; color: var(--gris); }

      h2 {
        break-after: avoid; /* el título no se queda solo al pie de la hoja */
        margin: 0 0 6px;
        font-size: 9pt;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        color: var(--azul);
        font-weight: 700;
      }

      /* El bloque entero NO lleva break-inside: avoid. Lo tenía, y es lo que
         hacía que el corte saliera mal: un bloque con un diagnóstico largo no
         cabe en lo que queda de hoja, el navegador lo empuja completo a la
         siguiente y deja media página en blanco. Lo que no se puede partir es
         cada renglón y el título junto a lo que titula; el resto fluye. */
      .bloque { margin-top: 13px; }

      /* El informe del laboratorio, apretado para aprovechar el papel
         (16-11): «lo que quiere es aprovechar el papel». El pie con la firma,
         el timbre y el QR se repite en cada hoja, así que todo lo que se le
         saca a él se gana en cada hoja; el encabezado y los datos del
         paciente, en la primera. Medido en carta: pie 36 → ~22 mm,
         encabezado y paciente 47 → ~32 mm. */
      .hoja--lab .enc { gap: 10px; padding-bottom: 6px; border-bottom-width: 2px; }
      .hoja--lab .enc img { width: 44px; height: 44px; }
      .hoja--lab .enc__marca { line-height: 1.15; }
      .hoja--lab .enc__marca strong { font-size: 13pt; }
      .hoja--lab .enc__marca span { font-size: 8pt; }
      .hoja--lab .enc__marca small { font-size: 6.5pt; }
      .hoja--lab .enc__titulo { line-height: 1.15; }
      .hoja--lab .enc__titulo span, .hoja--lab .enc__titulo small { font-size: 7.5pt; }
      .hoja--lab .enc__titulo strong { font-size: 13pt; }
      .hoja--lab .cabecera { margin-top: 6px; }
      .hoja--lab .cabecera th, .hoja--lab .cabecera td { padding: 2px 6px; font-size: 8.5pt; }
      .hoja--lab .cabecera th { font-size: 6.5pt; width: 70px; }
      .hoja--lab .bloque { margin-top: 7px; }
      .hoja--lab .bloque h2 { margin-bottom: 3px; }
      .hoja--lab .valores__grupo { margin-bottom: 4mm; }
      .hoja--lab .examenes--dos .valores__grupo { margin-bottom: 3.5mm; }
      .hoja--lab .valores__examen th { padding: 3px 6px; }
      .hoja--lab .valores__seccion th { padding-top: 4px; }
      .hoja--lab .cierre { margin-top: 4mm; gap: 6mm; }
      .hoja--lab .cierre .firma__linea span { font-size: 8.5pt; padding-bottom: 1px; }
      .hoja--lab .cierre .firma__linea small { font-size: 7pt; padding-bottom: 2px; }
      .hoja--lab .cierre .firma__linea em { font-size: 7pt; padding-top: 2px; }
      .hoja--lab .cierre .firma__imagen { max-height: 12mm; }
      .bloque dl { margin: 0; border-top: 1px solid var(--linea); }
      .bloque dl > div {
        display: grid;
        grid-template-columns: 150px 1fr;
        gap: 10px;
        padding: 4px 0;
        border-bottom: 1px solid #eee;
        break-inside: avoid;
      }
      .bloque dt { font-size: 8.5pt; color: var(--gris); }
      .bloque dd { margin: 0; font-size: 9.5pt; white-space: pre-wrap; }
      .valores__texto { white-space: pre-wrap; overflow-wrap: anywhere; }
      .agregados { margin-top: 18px; }

      .receta { margin-top: 18px; break-inside: avoid; }
      .receta p {
        margin: 0;
        min-height: 60mm;
        padding: 10px 12px;
        border: 1px solid var(--linea);
        font-size: 11pt;
        line-height: 1.7;
        white-space: pre-wrap;
      }
      .receta + .receta p { min-height: 40mm; }

      .firma {
        /* Eran 26 mm. Con el hueco tan grande, un informe que termina cerca
           del pie de la hoja se llevaba las firmas solas a la hoja siguiente. */
        margin-top: 16mm;
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 30px;
        break-inside: avoid;
      }
      /* Una sola firma ocupa menos: con dos exámenes por hoja, los 16 mm
         de aire mandaban la firma sola a una segunda hoja (16-11). */
      .firma--una { grid-template-columns: 1fr; max-width: 70mm; margin-top: 9mm; }
      .firma__linea { display: flex; flex-direction: column; align-items: center; text-align: center; }
      .firma__linea span { font-size: 10pt; font-weight: 600; padding-bottom: 3px; }
      .firma__linea small { font-size: 8pt; color: var(--gris); padding-bottom: 5px; border-bottom: 1px solid var(--tinta); width: 100%; }
      .firma__linea em { font-style: normal; font-size: 8pt; color: var(--gris); padding-top: 4px; }
      /* ---------- media hoja por examen (16-11) ---------- */
      /* Por defecto salen las medias hojas; la hoja completa, si se elige. */
      .hoja--con-medias { display: none; }
      body[data-formato='completa'] .hoja--con-medias { display: block; }
      body[data-formato='completa'] .hoja--medias,
      body[data-formato='completa'] [data-solo-medias] { display: none; }

      /* Cada media mide la mitad del alto útil del papel: carta 279 mm u
         oficio 330 mm, menos los 26 mm de margen, entre dos, y 2 mm de
         holgura para que dos entren siempre en la hoja. */
      .media {
        min-height: calc((var(--alto-papel, 279mm) - 26mm) / 2 - 2mm);
        display: flex;
        flex-direction: column;
        gap: 2mm;
        padding: 1mm 0 2mm;
        break-inside: avoid;
        box-sizing: border-box;
      }
      /* La línea por donde se corta. */
      .media--arriba { border-bottom: 1px dashed #8a93a6; margin-bottom: 2mm; }
      .media[data-fuera] { opacity: 0.3; }

      .media__enc { display: grid; grid-template-columns: auto 1fr auto; gap: 8px; align-items: center; padding-bottom: 3px; border-bottom: 1.5px solid var(--azul); }
      .media__enc img { border-radius: 50%; }
      .media__marca { display: flex; flex-direction: column; line-height: 1.15; }
      .media__marca small { font-size: 6.5pt; color: var(--gris); text-transform: uppercase; letter-spacing: 0.04em; }
      .media__marca strong { font-size: 11pt; color: var(--azul); font-weight: 800; }
      .media__num { display: flex; flex-direction: column; align-items: flex-end; line-height: 1.15; }
      .media__num small { font-size: 6.5pt; color: var(--gris); }
      .media__num strong { font-size: 11pt; color: var(--azul); }

      .media__paciente { width: 100%; border-collapse: collapse; }
      .media__paciente th, .media__paciente td { border: 1px solid var(--linea); padding: 2px 5px; font-size: 8.5pt; text-align: left; }
      .media__paciente th { background: #f2f4f9; color: var(--gris); font-size: 6.5pt; font-weight: 600; text-transform: uppercase; white-space: nowrap; width: 1%; }

      .media__titulo {
        margin: 0; padding: 2px 6px; text-align: center; font-size: 10pt; font-weight: 800;
        text-transform: uppercase; letter-spacing: 0.05em; color: var(--tinta);
        background: #eef1f6; border-top: 1px solid var(--tinta); border-bottom: 1px solid var(--tinta);
        -webkit-print-color-adjust: exact; print-color-adjust: exact;
      }
      .media__cuerpo { display: grid; gap: 6mm; align-items: start; }
      .media__cuerpo--dos { grid-template-columns: 1fr 1fr; }
      .media__tabla { width: 100%; border-collapse: collapse; }
      .media__tabla th { text-align: left; font-size: 6.5pt; font-weight: 600; text-transform: uppercase; color: var(--gris); padding: 1px 4px; border-bottom: 1px solid var(--tinta); }
      .media__tabla td { font-size: 8.5pt; padding: 1.5px 4px; border-bottom: 1px solid #edf0f5; }
      .media__tabla td:nth-child(2) { width: 22%; }
      .media__tabla td:nth-child(3) { width: 13%; }
      .media__tabla td:nth-child(4) { width: 30%; }
      .media__seccion th { font-size: 7.5pt; font-weight: 700; color: var(--tinta); padding-top: 3px; border-bottom: 1px solid var(--linea); }

      .media__pie { margin-top: auto; display: flex; justify-content: space-between; align-items: flex-end; gap: 6mm; }
      .media__qr { display: flex; align-items: center; gap: 6px; font-size: 6.5pt; color: var(--gris); line-height: 1.3; }
      .media__qr-img { flex: none; width: 13mm; height: 13mm; }
      .media__qr-img svg { width: 100%; height: 100%; display: block; }
      .media__firma { width: 62mm; }
      .media__firma span { font-size: 8.5pt; padding-bottom: 1px; }
      .media__firma small { font-size: 7pt; padding-bottom: 2px; }
      .media__firma em { font-size: 7pt; padding-top: 2px; }
      .media__firma .firma__imagen { max-height: 11mm; }
      .media__centro {
        margin: 0; padding: 2px 6px; text-align: center; font-size: 7pt; color: var(--tinta);
        border: 1px solid var(--azul); border-radius: 5px;
      }
      .media .corregido { margin: 0; }

      .cortes { display: flex; flex-wrap: wrap; gap: 6px 14px; margin: 0 auto 14px; max-width: 215mm; padding: 10px 14px; border: 1px solid var(--linea); border-radius: 8px; background: #fff; font-size: 10pt; }
      .cortes legend { font-weight: 600; font-size: 9pt; color: var(--gris); padding: 0 4px; }
      .cortes label { display: inline-flex; align-items: center; gap: 6px; min-height: 36px; cursor: pointer; }

      .corregido { margin-top: 8px; font-size: 8pt; font-style: italic; color: #555; text-align: right; }

      /* El cierre del informe de laboratorio va en el pie que se repite en
         cada hoja: la firma y el timbre del bioanalista a un lado y el QR al
         otro. «La idea es que la firma y el timbre queden en todas las hojas
         con el QR» (16-11): cada hoja vale sola. */
      .cierre { display: flex; justify-content: space-between; align-items: flex-end; gap: 8mm; margin-top: 7mm; }
      .cierre .firma { margin-top: 0; flex: none; width: 70mm; }
      .cierre .corregido { margin: 0; align-self: flex-end; }

      .cifra { font-variant-numeric: tabular-nums; }

      /* La tabla no se ve: es solo el andamio que repite el pie en cada hoja.
         table-layout fijo para que la columna no se encoja al contenido. */
      .corrida { width: 100%; border-collapse: collapse; table-layout: fixed; }
      .corrida > tbody > tr > td,
      .corrida > tfoot > tr > td { padding: 0; border: 0; vertical-align: top; }

      /* En pantalla el pie y el sello sobran: la hoja ya se ve entera y con
         su membrete, y el QR es para el papel. */
      .pie, .sello { display: none; }


      /* ---------- impresión ---------- */
      /* El margen del papel va en @page, no en el relleno de .hoja.
         Antes era @page { margin: 0 }: el navegador armaba la página de borde
         a borde y el margen de verdad se lo acababa poniendo la impresora, que
         no recorta lo mismo arriba que abajo. De ahí el corte descentrado.
         La regla @page vive en su propia hoja de estilo (#papel) porque no se
         puede cambiar con una clase: para elegir carta u oficio hay que
         reescribirla. */

      @media print {
        body { background: #fff; padding: 0; }
        /* Que no quede un renglón suelto de un lado del corte. */
        .hoja { orphans: 3; widows: 3; }
        /* Los grises de las tablas son parte del formulario, no decoración:
           sin esto se pierden si la impresora trae los fondos apagados. */
        .cabecera th, .vitales { print-color-adjust: exact; -webkit-print-color-adjust: exact; }
        .acciones, .aviso { display: none; }
        .hoja {
          width: auto;
          min-height: auto;
          margin: 0;
          padding: 0; /* el margen ya lo da @page */
          box-shadow: none;
        }
        .hoja--recipe { break-before: page; }

        /* Solo una de las dos hojas. La que queda sola pierde el salto de
           página de adelante: si no, sale una hoja en blanco primero. */
        body[data-solo-imprime='informe'] .hoja--recipe { display: none; }
        body[data-solo-imprime='recipe'] .hoja:not(.hoja--recipe) { display: none; }
        body[data-solo-imprime='recipe'] .hoja--recipe { break-before: auto; }

        .pie {
          display: flex;
          justify-content: space-between;
          gap: 10mm;
          padding: 2mm 0 0;
          margin-top: 6mm;
          border-top: 1px solid var(--linea);
          color: var(--gris);
          font-size: 7.5pt;
        }
        .pie strong { color: var(--azul); }

        .sello {
          display: flex;
          align-items: center;
          gap: 9px;
          margin-top: 3mm;
          padding-top: 2mm;
          border-top: 1px dashed var(--linea);
        }
        /* Sin :global(). Esta hoja ya es is:global, y ahí :global() no es
           un selector válido: la regla se descartaba entera y el SVG salía a
           su tamaño natural —unos 35 mm— desbordando su caja y tapando el
           texto de al lado. Se veía solo en el papel. */
        .sello__qr { flex: none; width: 17mm; height: 17mm; }
        .sello__qr svg { width: 100%; height: 100%; display: block; }
        .sello__texto { display: flex; flex-direction: column; gap: 1px; font-size: 7pt; color: var(--gris); }
        .sello__texto strong { color: var(--azul); font-size: 7.5pt; }
        .sello__texto b { color: var(--tinta); letter-spacing: 0.08em; }
        .cierre .sello { margin-top: 0; padding-top: 0; border-top: 0; max-width: 92mm; }
        .hoja--lab .cierre .sello__qr { width: 14mm; height: 14mm; }
        .hoja--lab .pie { margin-top: 2mm; padding-top: 1mm; font-size: 7pt; }
        /* Al papel: el corte destildado no sale, y la caja de cortes tampoco. */
        .media[data-fuera] { display: none; }
        .cortes { display: none; }
      }
    </style>

    <!-- La regla @page la reescribe el script, así que esta hoja tiene que
         seguir siendo un elemento del HTML: sin is:inline Astro se la lleva al
         CSS empaquetado, el id desaparece y el script no encuentra nada.
         El valor de acá es el que vale si el navegador no corre JavaScript:
         carta, que es el caso normal. -->
    <style id="papel" is:inline>@page { size: letter; margin: 13mm 14mm; }</style>

    <script>
      /* Carta u oficio. En Venezuela el oficio es de 21,6 × 33 cm, que no es
         el "legal" de 21,6 × 35,6 cm del que hablan los navegadores: hay que
         darlo en milímetros o el PDF sale del tamaño equivocado. */
      const PAPELES = {
        carta: { medida: 'letter', alto: '279mm' },
        oficio: { medida: '216mm 330mm', alto: '330mm' },
      };
      const MARGEN = '13mm 14mm'; // el mismo relleno que .hoja en pantalla
      const RECUERDO = 'atenmefa:papel';

      const estilo = document.getElementById('papel');
      const botones = Array.from(document.querySelectorAll('[data-papel]'));

      function elegir(cual) {
        const papel = PAPELES[cual];
        estilo.textContent = `@page { size: ${papel.medida}; margin: ${MARGEN}; }`;
        document.body.style.setProperty('--alto-papel', papel.alto);
        for (const boton of botones) {
          boton.setAttribute('aria-checked', String(boton.dataset.papel === cual));
        }
        try {
          localStorage.setItem(RECUERDO, cual);
        } catch {
          /* navegación privada: se queda con lo elegido en esta visita */
        }
      }

      for (const boton of botones) {
        boton.addEventListener('click', () => elegir(boton.dataset.papel));
      }

      /* Qué hoja sale. Se marca el <body> antes de imprimir y se desmarca
         después: si quedara puesto, la próxima impresión saldría recortada
         sin que nadie entienda por qué. El media print del CSS es el que
         esconde la hoja que no toca. */
      for (const boton of document.querySelectorAll('[data-imprimir]')) {
        boton.addEventListener('click', () => {
          document.body.dataset.soloImprime = boton.dataset.imprimir;
          window.print();
        });
      }
      addEventListener('afterprint', () => { delete document.body.dataset.soloImprime; });

      /* En el teléfono la hoja —215 mm— no cabe y había que deslizarla de
         lado: el paciente la abre desde el correo (16-11). Se achica hasta
         caber; al imprimir o guardar en PDF vuelve a su tamaño. */
      const lienzo = document.querySelector('.lienzo');
      function ajustar() {
        if (!lienzo) return;
        const hojas = Array.from(lienzo.querySelectorAll('.hoja'));
        for (const h of hojas) h.style.zoom = '';
        const visible = hojas.find((h) => h.offsetWidth > 0);
        if (!visible) return;
        const z = lienzo.clientWidth / visible.offsetWidth;
        if (z < 1) for (const h of hojas) h.style.zoom = String(Math.max(z, 0.35));
      }
      addEventListener('resize', ajustar);
      addEventListener('beforeprint', () => {
        if (lienzo) for (const h of lienzo.querySelectorAll('.hoja')) h.style.zoom = '';
      });
      addEventListener('afterprint', ajustar);

      /* Media hoja o hoja completa, en el informe del laboratorio. Se
         recuerda en este navegador; sin elegir, media hoja. */
      const FORMATO = 'atenmefa:formato-lab';
      const formatos = Array.from(document.querySelectorAll('[data-formato]'));
      function formato(cual) {
        document.body.dataset.formato = cual;
        if (typeof ajustar === 'function') ajustar();
        for (const b of formatos) b.setAttribute('aria-checked', String(b.dataset.formato === cual));
        try { localStorage.setItem(FORMATO, cual); } catch { /* sin recuerdo */ }
      }
      for (const b of formatos) b.addEventListener('click', () => formato(b.dataset.formato));
      if (formatos.length) {
        let antes = null;
        try { antes = localStorage.getItem(FORMATO); } catch { /* nada */ }
        formato(antes === 'completa' ? 'completa' : 'medias');
      }
      for (const c of document.querySelectorAll('[data-corte]')) {
        c.addEventListener('change', () => {
          const media = document.querySelector(`.media[data-media="${c.dataset.corte}"]`);
          if (media) media.toggleAttribute('data-fuera', !c.checked);
        });
      }

      let guardado = null;
      try {
        guardado = localStorage.getItem(RECUERDO);
      } catch {
        /* sin localStorage no hay nada que recordar */
      }
      /* hasOwn y no `in`: `in` también acierta con 'constructor' y compañía. */
      elegir(guardado && Object.hasOwn(PAPELES, guardado) ? guardado : 'carta');
      ajustar();
    </script>
  </body>
</html>
