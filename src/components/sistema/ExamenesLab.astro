---
/**
 * Qué exámenes se le van a hacer, con lo que cuestan.
 *
 * El cliente lo pidió entero en una frase: «colocando ya preseleccionados
 * los exámenes del laboratorio y poder ir seleccionando todo lo que se va a
 * hacer, y que les genere el precio en bolívar y en dólares,
 * automáticamente, y esa persona se encarga de cobrar».
 *
 * Marcar un examen acá ES cargarlo a la cuenta: no hay una lista de lo que
 * se le hace y otra de lo que se le cobra. El total en bolívares se calcula
 * con la tasa del BCV del día, que es la misma que usa el resto del
 * sistema, y se dice con su fecha: un monto en bolívares sin fecha no
 * significa nada a la semana siguiente.
 */
import { dinero } from '../../sistema/lib/cobro';
import type { ExamenDelCatalogo } from '../../sistema/lib/laboratorio';
import type { Tasa } from '../../sistema/lib/tasa';


interface Perfil {
  id: string;
  nombre: string;
  examenes: { id: string; nombre: string }[];
}

interface Props {
  catalogo: readonly ExamenDelCatalogo[];
  /** Los combos: marcan varios de un golpe y se puede destildar cualquiera. */
  perfiles?: readonly Perfil[];
  /** Los que ya están pedidos en esta orden. */
  marcados: readonly string[];
  tasa: Tasa | null;
  /** Para avisar a quien puede resolverlo que el catálogo está vacío. */
  puedeEditarCatalogo: boolean;
  /** Cuántos exámenes trae el archivo del laboratorio, para el aviso. */
  cuantosEnElArchivo?: number;
}
const {
  catalogo, perfiles = [], marcados, tasa, puedeEditarCatalogo, cuantosEnElArchivo = 0,
} = Astro.props;
const yaEsta = new Set(marcados);

/* Un examen cargado en cero no tiene precio todavía: se puede marcar —queda
   registrado qué se le hizo— pero no suma. Mostrarlo como «0,00» haría
   pensar que es gratis. */
const sinPrecio = (e: ExamenDelCatalogo) => Number(e.precio) === 0;
const cuantosSinPrecio = catalogo.filter(sinPrecio).length;

const fechaTasa = tasa
  ? new Date(`${tasa.fecha}T12:00:00`).toLocaleDateString('es-VE', { day: '2-digit', month: '2-digit' })
  : '';
---

{catalogo.length === 0 ? (
  /* Catálogo vacío: la orden se registra igual, escribiendo los exámenes
     abajo. Lo que no se hace es inventarles un precio.

     Los nombres los tenemos —son las hojas del archivo del laboratorio— así
     que esto no es «escríbalos usted»: es un botón en Servicios y precios
     que los carga de un golpe. Acá se señala el camino. */
  <div class="vacio">
    <strong>Todavía no hay exámenes en el catálogo.</strong>
    <p>
      La orden se puede registrar igual escribiendo los exámenes en
      «Otros exámenes», pero no sale la cuenta.
      {puedeEditarCatalogo ? (
        <> Los {cuantosEnElArchivo} del archivo del laboratorio se cargan de
          una vez desde <a href="/sistema/servicios">Servicios y precios</a>.</>
      ) : (
        <> Administración los carga desde Servicios y precios: son los
          {' '}{cuantosEnElArchivo} del archivo del laboratorio y entran de
          una vez.</>
      )}
    </p>
  </div>
) : (
  <fieldset class="ex" data-tasa={tasa?.bolivares ?? ''}>
    <legend>Qué se le va a hacer</legend>

    {/* Los perfiles: un toque marca los suyos y después se destilda lo que
        no haga falta. El cliente lo explicó con una hamburguesa: «un combo
        con papas y Coca-Cola, pero si un perfil tiene 5 exámenes y yo solo
        quiero 3, se deben poder deseleccionar».

        No tienen precio propio a propósito: lo que se cobra es la suma de
        los que queden marcados, porque si el combo tuviera precio fijo,
        quitarle uno lo cobraría igual. */}
    {perfiles.length > 0 && (
      <ul class="ex__perfiles" data-perfiles={JSON.stringify(perfiles)}>
        {perfiles.map((p) => (
          <li>
            <button type="button" class="ex__perfil" data-perfil={p.id}>
              {p.nombre}
              <em>{p.examenes.length}</em>
            </button>
          </li>
        ))}
      </ul>
    )}

    {/* Con ciento cuarenta exámenes la lista no se recorre con el dedo: se
        filtra. Lo marcado NO se esconde al filtrar —ver el script—, porque
        perder de vista lo que uno ya eligió es como se cobra de menos. */}
    {catalogo.length > 12 && (
      <div class="ex__filtro">
        <input type="search" id="ex-filtro" placeholder="Filtrar: glicemia, orina, hemo…"
               aria-label="Filtrar exámenes" autocomplete="off" />
        <span class="ex__cuantos" id="ex-filtrados"></span>
      </div>
    )}

    <ul class="ex__lista">
      {catalogo.map((e) => (
        <li data-busca={e.nombre.toLocaleLowerCase('es')}>
          <label>
            <input
              type="checkbox" name="examen" value={e.id}
              checked={yaEsta.has(e.id)}
              data-precio={e.moneda === 'USD' && !sinPrecio(e) ? e.precio : ''}
              data-moneda={e.moneda}
              data-sin-precio={sinPrecio(e) ? '' : undefined}
            />
            <span class="ex__nombre">{e.nombre}</span>
            {sinPrecio(e) ? (
              <span class="ex__precio ex__precio--falta">sin precio</span>
            ) : (
              <span class="ex__precio cifra">
                {e.moneda === 'USD' ? '$' : 'Bs '}{dinero(e.precio)}
              </span>
            )}
          </label>
        </li>
      ))}
    </ul>

    <p class="ex__cuenta" id="ex-cuenta" aria-live="polite">
      <span id="ex-nada">Ninguno marcado todavía.</span>
      <span id="ex-total" hidden>
        <strong><span id="ex-cuantos"></span> · $<span class="cifra" id="ex-usd"></span></strong>
        {tasa && <> = Bs <span class="cifra" id="ex-ves"></span>
          <small> a la tasa del {fechaTasa}</small></>}
      </span>
    </p>

    {cuantosSinPrecio > 0 && (
      <p class="ex__sin-tasa">
        {cuantosSinPrecio === 1
          ? 'Hay un examen sin precio cargado: se puede marcar, queda registrado, y no suma al total.'
          : `Hay ${cuantosSinPrecio} exámenes sin precio cargado: se pueden marcar, quedan registrados, y no suman al total.`}
        {puedeEditarCatalogo && <> <a href="/sistema/servicios">Ponérselo</a>.</>}
      </p>
    )}

    {!tasa && (
      <p class="ex__sin-tasa">
        Sin la tasa del BCV de hoy solo se muestra el monto en dólares.
      </p>
    )}
  </fieldset>
)}

<script>
  /* La cuenta se hace en el navegador para que responda al tildar, y se
     vuelve a hacer en el servidor al guardar: lo que se cobra sale de los
     renglones, no de este número. Acá es para que recepción le pueda decir
     al paciente cuánto es antes de guardar nada. */
  const caja = document.querySelector<HTMLElement>('.ex');
  if (caja) {
    const tasa = Number(caja.dataset.tasa) || 0;
    const casillas = [...caja.querySelectorAll<HTMLInputElement>('input[name="examen"]')];
    const nada = document.getElementById('ex-nada')!;
    const total = document.getElementById('ex-total')!;
    const cuantos = document.getElementById('ex-cuantos')!;
    const usd = document.getElementById('ex-usd')!;
    const ves = document.getElementById('ex-ves');

    const plata = (n: number) =>
      new Intl.NumberFormat('es-VE', { minimumFractionDigits: 2, maximumFractionDigits: 2 }).format(n);

    const recontar = () => {
      const marcados = casillas.filter((c) => c.checked);
      nada.hidden = marcados.length > 0;
      total.hidden = marcados.length === 0;
      if (!marcados.length) return;

      /* Solo se suman los que están en dólares. Un examen cargado en
         bolívares no se puede sumar al mismo total: serían dos monedas en
         un número, que es exactamente lo que el resto del sistema evita. */
      const suma = marcados.reduce((t, c) => t + (Number(c.dataset.precio) || 0), 0);
      const enBs = marcados.some((c) => c.dataset.moneda !== 'USD');
      const faltan = marcados.filter((c) => c.dataset.sinPrecio !== undefined).length;

      const aclara = [
        enBs ? 'los cargados en bolívares' : '',
        faltan ? `${faltan} sin precio` : '',
      ].filter(Boolean);

      cuantos.textContent = `${marcados.length} ${marcados.length === 1 ? 'examen' : 'exámenes'}`;
      usd.textContent = plata(suma) + (aclara.length ? ` + ${aclara.join(' y ')}` : '');
      if (ves && tasa) ves.textContent = plata(suma * tasa);
    };

    casillas.forEach((c) => c.addEventListener('change', () => { recontar(); pintarPerfiles(); }));

    /* ---------- los perfiles ---------- */

    type Perfil = { id: string; nombre: string; examenes: { id: string; nombre: string }[] };
    const listaPerfiles = caja.querySelector<HTMLElement>('.ex__perfiles');
    let perfiles: Perfil[] = [];
    try { perfiles = JSON.parse(listaPerfiles?.dataset.perfiles ?? '[]'); } catch { perfiles = []; }

    const porId = new Map(casillas.map((c) => [c.value, c]));

    /* El botón dice en qué estado está el perfil: todos marcados, algunos, o
       ninguno. Sin eso, con cinco exámenes marcados de los cinco el botón se
       ve igual que sin ninguno y no se sabe si ya se tocó. */
    const pintarPerfiles = () => {
      for (const p of perfiles) {
        const boton = caja.querySelector<HTMLButtonElement>(`[data-perfil="${p.id}"]`);
        if (!boton) continue;
        const suyos = p.examenes.map((e) => porId.get(e.id)).filter(Boolean) as HTMLInputElement[];
        const puestos = suyos.filter((c) => c.checked).length;
        boton.dataset.estado = puestos === 0 ? 'nada' : puestos === suyos.length ? 'todo' : 'parte';
        boton.setAttribute('aria-pressed', String(puestos > 0));
        boton.title = puestos === 0
          ? `Marca sus ${suyos.length} exámenes. Después se puede quitar el que no haga falta.`
          : puestos === suyos.length
            ? `Los ${suyos.length} están marcados. Tocar otra vez los quita.`
            : `${puestos} de ${suyos.length} marcados.`;
      }
    };

    for (const p of perfiles) {
      const boton = caja.querySelector<HTMLButtonElement>(`[data-perfil="${p.id}"]`);
      if (!boton) continue;
      boton.addEventListener('click', () => {
        const suyos = p.examenes.map((e) => porId.get(e.id)).filter(Boolean) as HTMLInputElement[];
        if (!suyos.length) return;
        /* Si ya están todos, el mismo botón los quita: es el camino de
           vuelta cuando uno se equivocó de perfil. */
        const quitar = suyos.every((c) => c.checked);
        for (const c of suyos) c.checked = !quitar;
        recontar();
        pintarPerfiles();
      });
    }

    /* ---------- el filtro ---------- */

    const filtro = document.getElementById('ex-filtro') as HTMLInputElement | null;
    const cuantosFiltrados = document.getElementById('ex-filtrados');

    const filtrar = () => {
      const q = (filtro?.value ?? '').trim().toLocaleLowerCase('es')
        .normalize('NFD').replace(/[\u0300-\u036f]/g, '');
      let visibles = 0;
      for (const c of casillas) {
        const li = c.closest('li') as HTMLElement | null;
        if (!li) continue;
        const nombre = (li.dataset.busca ?? '').normalize('NFD').replace(/[\u0300-\u036f]/g, '');
        /* Lo marcado se queda siempre a la vista: esconder un examen ya
           elegido porque no calza con el filtro es como se cobra de menos. */
        const calza = !q || nombre.includes(q) || c.checked;
        li.hidden = !calza;
        if (calza) visibles++;
      }
      if (cuantosFiltrados) {
        cuantosFiltrados.textContent = q
          ? `${visibles} de ${casillas.length}`
          : `${casillas.length} exámenes`;
      }
    };

    filtro?.addEventListener('input', filtrar);

    recontar();
    pintarPerfiles();
    filtrar();
  }
</script>

<style>
  .ex {
    margin: 0 0 20px;
    padding: 16px;
    border: 1px solid var(--linea);
    border-radius: 12px;
    background: var(--papel);
  }
  .ex legend {
    padding: 0 6px;
    font-family: var(--titulares);
    font-size: var(--u-base);
    font-weight: 600;
    color: var(--azul);
  }

  /* Los perfiles, arriba y a la vista: son el atajo de todos los días. */
  .ex__perfiles {
    list-style: none;
    margin: 0 0 12px;
    padding: 0 0 12px;
    border-bottom: 1px solid var(--linea-tenue);
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .ex__perfil {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    padding: 0 13px;
    border: 1px solid var(--linea);
    border-radius: 999px;
    background: var(--papel);
    color: var(--tinta);
    font: inherit;
    font-family: var(--ui);
    font-size: var(--u-sm);
    text-align: left;
    cursor: pointer;
  }
  .ex__perfil:hover { border-color: var(--azul-medio); background: var(--bruma); }
  .ex__perfil em {
    font-style: normal;
    font-size: var(--u-xs);
    font-weight: 700;
    color: var(--tinta-tenue);
  }
  .ex__perfil[data-estado='todo'] { border-color: var(--azul); background: var(--azul); color: #fff; }
  .ex__perfil[data-estado='todo'] em { color: rgb(255 255 255 / 0.72); }
  /* A medias se ve a medias: con el borde marcado y el fondo claro. */
  .ex__perfil[data-estado='parte'] { border-color: var(--azul); background: var(--azul-tenue); color: var(--azul); }
  .ex__perfil[data-estado='parte'] em { color: var(--azul); }

  .ex__filtro { display: flex; align-items: center; gap: 10px; margin-bottom: 10px; }
  .ex__filtro input {
    flex: 1 1 220px;
    min-width: 0;
    min-height: 44px;
    padding: 8px 12px;
    border: 1px solid var(--linea);
    border-radius: 8px;
    background: var(--papel);
    font: inherit;
    font-family: var(--ui);
    font-size: var(--u-sm);
  }
  .ex__cuantos { flex: none; font-size: var(--u-xs); color: var(--tinta-tenue); }

  .ex__lista { list-style: none; margin: 0; padding: 0; display: grid; gap: 2px; }
  .ex__lista li[hidden] { display: none; }
  /* Con muchos exámenes la lista se desplaza dentro de su caja en vez de
     estirar la página hasta lo imposible. */
  .ex__lista { max-height: 44vh; overflow-y: auto; }
  @media (min-width: 760px) { .ex__lista { grid-template-columns: 1fr 1fr; gap: 2px 18px; } }

  .ex__lista label {
    display: flex;
    align-items: center;
    gap: 11px;
    /* 44 px de alto: se marca con el dedo, de pie y en el mesón. */
    min-height: 44px;
    padding: 0 10px;
    border-radius: 8px;
    cursor: pointer;
    font-size: var(--u-sm);
  }
  .ex__lista label:hover { background: var(--bruma); }
  .ex__lista input { width: 20px; height: 20px; flex: none; accent-color: var(--azul); }
  .ex__nombre { flex: 1; min-width: 0; }
  .ex__precio { flex: none; color: var(--tinta-tenue); font-size: var(--u-xs); }
  .ex__precio--falta { color: #7a5200; font-weight: 700; }
  .ex__lista input:checked ~ .ex__nombre { font-weight: 600; color: var(--azul); }
  .ex__lista input:checked ~ .ex__precio { color: var(--tinta); }

  .ex__cuenta {
    margin: 12px 0 0;
    padding-top: 12px;
    border-top: 1px solid var(--linea-tenue);
    font-size: var(--u-sm);
    color: var(--tinta-suave);
  }
  .ex__cuenta strong { color: var(--azul); font-family: var(--titulares); }
  .ex__cuenta small { color: var(--tinta-tenue); font-size: var(--u-xs); }
  .ex__sin-tasa { margin: 8px 0 0; font-size: var(--u-xs); color: var(--tinta-tenue); }

  .vacio {
    margin: 0 0 20px;
    padding: 16px;
    border: 1px dashed var(--linea);
    border-radius: 12px;
    background: var(--bruma);
  }
  .vacio strong { display: block; color: var(--azul); font-size: var(--u-sm); }
  .vacio p { margin: 7px 0 0; font-size: var(--u-sm); color: var(--tinta-suave); line-height: 1.5; }
</style>
