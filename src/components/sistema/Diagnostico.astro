---
/**
 * El campo del diagnóstico: un buscador de la CIE-10 que deja escribir.
 *
 * El cliente lo pidió en una frase: «un seleccionador de diagnóstico, y si
 * es que se necesita escribir algo». Las dos mitades importan y la segunda
 * tanto como la primera: un médico frente a un paciente no puede quedarse
 * trabado porque el catálogo no tiene la palabra que él usa.
 *
 * Por eso esto NO es un <select>. Es un campo de texto normal —escribe lo
 * que quiera y se guarda— con una lista que aparece debajo mientras teclea.
 * Si elige de la lista, además del nombre viaja el código.
 *
 * LA REGLA QUE SOSTIENE TODO
 *
 * El código y el texto no se pueden separar nunca. Si el médico elige
 * «Infección de vías urinarias (N39.0)» y después borra una letra, el
 * código se va: lo que quedaría es un texto escrito a mano con el código de
 * otra cosa, y eso termina impreso en la planilla de un seguro.
 *
 * Sin JavaScript sigue siendo un campo de texto que se llena a mano, que es
 * exactamente lo que había antes.
 */
import type { Campo } from '../../sistema/historia';
import { marcados } from '../../sistema/lib/diagnosticos';
import { comoSeLee } from '../../sistema/cie10';

interface Props {
  campo: Campo;
  valor?: string;
  /** El código que ya tenía, si se eligió de la lista. */
  codigo?: string;
}
const { campo: c, valor = '', codigo = '' } = Astro.props;
const id = `c-${c.clave}`;
const pistaId = `${id}-pista`;

/* Los frecuentes se consultan acá, en el componente, y no se pasan por
   props desde la pantalla. El campo cuelga de Pasos → Seccion → Campo, que
   son genéricos: hacerles cruzar un dato que solo usa uno de los campos los
   ensucia a los tres. Es una consulta indexada de un puñado de filas.

   Van VISIBLES y no escondidos en el desplegable. Es la mitad de lo que el
   cliente pidió —«que aparezcan de primero»— y es lo que hace que esto se
   use: lo de todos los días se toca una vez, sin escribir nada. El
   desplegable queda para lo demás. */
const frecuentes = (await marcados()).slice(0, 12);
---

<div class:list={['campo', `campo--${c.ancho ?? 4}`]} data-dx>
  <label for={id}>
    {c.rotulo}
    {c.exigido && <abbr title="Obligatorio para cerrar la atención">*</abbr>}
  </label>

  {/* Dos columnas: a la izquierda los de todos los días, a la derecha el
      catálogo entero. Antes los frecuentes eran una fila de pastillas
      encima del campo y la búsqueda caía en un desplegable flotante que
      tapaba el formulario: no se entendía qué era cada cosa ni dónde
      estaba uno parado.

      Abajo, el campo de verdad. Es el que se guarda, se puede escribir a
      mano y se ve siempre: lo elegido tiene que quedar a la vista aunque
      se siga buscando otra cosa. */}
  <div class="dx__dos">
    <div class="dx__col">
      <h4 class="dx__rotulo">Los de siempre</h4>
      {frecuentes.length > 0 ? (
        <ul class="dx__rapidos">
          {frecuentes.map((d) => (
            <li>
              <button type="button" class="dx__rapido"
                      data-codigo={d.codigo} data-nombre={comoSeLee(d.nombre)}>
                <span>{comoSeLee(d.nombre)}</span>
                <em class="cifra">{d.codigo}</em>
              </button>
            </li>
          ))}
        </ul>
      ) : (
        <p class="dx__sin">
          Todavía no hay ninguno marcado. Se marcan desde
          Administración → Diagnósticos frecuentes, y son los que más se
          usan en el centro.
        </p>
      )}
    </div>

    <div class="dx__col dx__col--busca">
      <h4 class="dx__rotulo">Buscar en la CIE-10</h4>
      <div class="dx__caja">
        <input type="search" class="dx__buscar" id={`${id}-buscar`}
               placeholder="Dolor abdominal, J02, hipertensión…"
               autocomplete="off" aria-controls={`${id}-lista`} />
      </div>
      <ul class="dx__lista" id={`${id}-lista`} role="listbox"></ul>
      <p class="dx__nada" id={`${id}-nada`}>
        Escriba al menos tres letras. Si no está en el catálogo, se puede
        escribir a mano abajo y se guarda igual.
      </p>
    </div>
  </div>

  <div class="dx">
    <label class="dx__sub" for={id}>Diagnóstico que queda escrito</label>
    <div class="dx__campo">
      <input
        type="text" id={id} name={c.clave} value={valor}
        required={c.exigido} autocomplete="off" aria-describedby={pistaId}
      />
      {/* El código viaja aparte y oculto. Se vacía solo en cuanto alguien
          toca el texto: ver el script. */}
      <input type="hidden" name={`${c.clave}_codigo`} id={`${id}-codigo`} value={codigo} />

      <p class="dx__elegido" id={`${id}-elegido`} hidden={!codigo}>
        <span class="dx__chapa cifra">{codigo}</span>
        <button type="button" class="dx__quitar" id={`${id}-quitar`}
                aria-label="Quitar el código y dejar solo el texto">×</button>
      </p>
    </div>
  </div>

  <span class="pista" id={pistaId}>
    Escriba y elija del catálogo CIE-10 para que lleve su código. También
    puede escribirlo a mano: se guarda igual.
  </span>
</div>

<script>
  /* Un solo control por pantalla, pero se busca por el atributo y no por un
     id fijo para no atarse al nombre del campo. */
  const caja = document.querySelector<HTMLElement>('[data-dx]');

  if (caja) {
    const texto = caja.querySelector<HTMLInputElement>('input[type="text"]')!;
    const busca = caja.querySelector<HTMLInputElement>('.dx__buscar')!;
    const oculto = caja.querySelector<HTMLInputElement>('input[type="hidden"]')!;
    const lista = caja.querySelector<HTMLUListElement>('.dx__lista')!;
    const nada = caja.querySelector<HTMLParagraphElement>('.dx__nada')!;
    const chapa = caja.querySelector<HTMLElement>('.dx__chapa')!;
    const quitar = caja.querySelector<HTMLButtonElement>('.dx__quitar')!;

    let reloj: ReturnType<typeof setTimeout> | undefined;
    let pedido = 0;
    let marcado = -1;
    type Dx = { codigo: string; nombre: string; oficial: string; sexo: string | null; frecuente: boolean; usos: number };
    let encontrados: Dx[] = [];

    /* Lo que está elegido del catálogo, con el texto EXACTO que se puso en
       el campo. Es lo único que permite saber si el texto se editó después:
       si ya no coincide, el código dejó de corresponder y se va.

       Arranca con lo que mandó el servidor: una recarga o un guardado que
       rebota vuelven a pintar el nombre y el código, y el código tiene que
       sobrevivir a eso. */
    let elegido: { codigo: string; nombre: string } | null =
      oculto.value ? { codigo: oculto.value, nombre: texto.value } : null;

    /* Qué sexo tiene cargado el paciente, para avisar si el diagnóstico no
       le corresponde. Se lee en el momento y no al cargar: el médico puede
       llenar el sexo después del diagnóstico. */
    const sexoDelPaciente = () =>
      (document.getElementById('c-sexo') as HTMLSelectElement | null)?.value ?? '';

    /* El frecuente que está puesto se ve puesto. Sin esto, con el campo ya
       lleno los botones se veían todos iguales y no había forma de saber
       cuál se eligió. */
    const marcarRapidos = () => {
      caja.querySelectorAll<HTMLButtonElement>('.dx__rapido').forEach((b) => {
        const puesto = Boolean(oculto.value) && b.dataset.codigo === oculto.value;
        b.setAttribute('aria-pressed', String(puesto));
      });
    };

    const mostrarCodigo = (codigo: string) => {
      oculto.value = codigo;
      chapa.textContent = codigo;
      caja.querySelector<HTMLElement>('.dx__elegido')!.hidden = !codigo;
      marcarRapidos();
      marcarLista();
    };

    /* La lista vive siempre en su columna: no se abre ni se cierra, se
       llena o se vacía. Un desplegable flotante encima del formulario era
       la mitad del problema. */
    const vaciar = (pista: string) => {
      lista.replaceChildren();
      nada.textContent = pista;
      nada.hidden = false;
      marcado = -1;
    };

    const elegir = (d: Dx) => {
      /* Se guarda el nombre LEGIBLE y no el oficial en mayúsculas: es lo
         que se imprime en el informe y lo que el médico acaba de leer. El
         código es el que identifica, y viaja aparte. */
      texto.value = d.nombre;
      elegido = { codigo: d.codigo, nombre: d.nombre };
      mostrarCodigo(d.codigo);
      marcarLista();
      /* El formulario se guarda solo escuchando 'input', y poner el valor
         desde el script no lo dispara. */
      texto.dispatchEvent(new Event('input', { bubbles: true }));
    };

    /* El renglón elegido se ve elegido, también en la lista de la derecha:
       sin eso, después de elegir uno la lista seguía igual y no se sabía
       cuál se había tocado. */
    const marcarLista = () => {
      lista.querySelectorAll<HTMLLIElement>('li').forEach((li) => {
        li.dataset.puesto = String(Boolean(oculto.value) && li.dataset.codigo === oculto.value);
      });
    };

    const pintar = () => {
      lista.replaceChildren();
      const sexo = sexoDelPaciente();

      encontrados.forEach((d, i) => {
        const li = document.createElement('li');
        li.setAttribute('role', 'option');
        li.setAttribute('aria-selected', String(i === marcado));
        if (i === marcado) li.dataset.marcado = '';

        /* El nombre primero y el código al final: se busca leyendo el
           nombre, el código es para confirmar. Al revés obligaba a saltarse
           cinco caracteres en cada renglón para empezar a leer. */
        const nombre = document.createElement('span');
        nombre.className = 'dx__nombre';
        nombre.textContent = d.nombre;

        const cod = document.createElement('em');
        cod.className = 'dx__cod cifra';
        cod.textContent = d.codigo;

        li.append(nombre, cod);

        /* El aviso del sexo. No bloquea: el catálogo no trae la restricción
           en todas las rúbricas, así que bloquear con un dato incompleto
           dejaría afuera diagnósticos legítimos. */
        if (d.sexo && sexo && d.sexo !== sexo) {
          const ojo = document.createElement('em');
          ojo.className = 'dx__ojo';
          ojo.textContent = `solo ${d.sexo.toLowerCase()}`;
          li.append(ojo);
        }

        li.dataset.codigo = d.codigo;
        li.addEventListener('click', () => elegir(d));
        lista.append(li);
      });

      if (encontrados.length) nada.hidden = true;
      marcarLista();
    };

    const buscar = async () => {
      const q = busca.value.trim();
      if (q.length < 3) {
        vaciar('Escriba al menos tres letras. Si no está en el catálogo, se '
          + 'puede escribir a mano abajo y se guarda igual.');
        return;
      }
      const mio = ++pedido;
      try {
        const r = await fetch(`/sistema/api/diagnosticos?q=${encodeURIComponent(q)}`);
        if (!r.ok || mio !== pedido) return;   // llegó una respuesta vieja
        const d = await r.json();
        encontrados = d.diagnosticos ?? [];
        marcado = -1;
        pintar();
        if (!encontrados.length) {
          vaciar('Nada en el catálogo con eso. Escríbalo a mano abajo: se guarda igual, sin código.');
        }
      } catch {
        /* Sin red no se dice nada: el campo sigue siendo de texto y lo que
           se escriba se guarda. Un error acá no puede trabar la consulta. */
        vaciar('No se pudo consultar el catálogo. Escriba el diagnóstico a mano abajo.');
      }
    };

    busca.addEventListener('input', () => {
      /* Se invalida lo que esté en vuelo: la respuesta de la tecla
         anterior llegaba después y repintaba la lista con otra cosa. */
      pedido++;
      clearTimeout(reloj);
      reloj = setTimeout(buscar, 250);
    });

    busca.addEventListener('keydown', (e) => {
      if (!encontrados.length) return;
      if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
        e.preventDefault();
        marcado = e.key === 'ArrowDown'
          ? Math.min(marcado + 1, encontrados.length - 1)
          : Math.max(marcado - 1, 0);
        pintar();
        lista.children[marcado]?.scrollIntoView({ block: 'nearest' });
      } else if (e.key === 'Enter' && marcado >= 0) {
        e.preventDefault();   // no enviar el formulario con Enter acá
        elegir(encontrados[marcado]);
      }
    });

    texto.addEventListener('input', () => {
      /* Lo primero y lo más importante: si el texto ya no es el del
         diagnóstico elegido, el código dejó de corresponder y se va. Un
         código que dice una cosa al lado de un nombre que dice otra termina
         impreso en la planilla de un seguro. */
      if (elegido && texto.value !== elegido.nombre) {
        elegido = null;
        mostrarCodigo('');
      }

    });

    /* Los botones de los frecuentes: un toque y queda puesto, sin escribir
       ni esperar una búsqueda. Es para lo que se marcan. */
    caja.querySelectorAll<HTMLButtonElement>('.dx__rapido').forEach((b) => {
      b.addEventListener('click', () => {
        elegir({
          codigo: b.dataset.codigo!,
          nombre: b.dataset.nombre!,
          oficial: b.dataset.nombre!,
          sexo: null,
          frecuente: true,
          usos: 0,
        });
      });
    });
    marcarRapidos();

    /* Soltar el código y quedarse con el texto: pasa cuando el médico
       encontró algo parecido pero no es eso, y prefiere escribirlo él. */
    quitar.addEventListener('click', () => {
      elegido = null;
      mostrarCodigo('');
      texto.focus();
    });
  }
</script>

<style>
  .campo { display: flex; flex-direction: column; gap: 8px; grid-column: span 4; min-width: 0; }
  label {
    display: flex;
    align-items: baseline;
    gap: 6px;
    font-size: var(--u-sm);
    font-weight: 600;
    color: var(--tinta-suave);
  }
  label abbr { color: var(--rojo); text-decoration: none; }

  /* Dos columnas en pantalla ancha, una debajo de otra en el teléfono y
     con los frecuentes primero: ahí es donde está casi todo lo del día. */
  .dx__dos { display: grid; gap: 14px; }
  @media (min-width: 900px) {
    .dx__dos { grid-template-columns: minmax(190px, 0.8fr) 1.2fr; gap: 18px; }
  }

  .dx__col {
    display: flex;
    flex-direction: column;
    min-width: 0;
    padding: 12px;
    border: 1px solid var(--linea);
    border-radius: 10px;
    background: var(--papel);
  }

  .dx__rotulo {
    margin: 0 0 9px;
    font-family: var(--ui);
    font-size: var(--u-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--tinta-tenue);
  }

  .dx__rapidos { list-style: none; margin: 0; padding: 0; display: grid; gap: 4px; max-height: 300px; overflow-y: auto; }
  .dx__rapido {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    width: 100%;
    /* 44 px: la regla de la casa para todo lo que se toca. */
    min-height: 44px;
    padding: 6px 10px;
    border: 1px solid var(--linea);
    border-radius: 8px;
    background: var(--papel);
    color: var(--tinta);
    font: inherit;
    font-family: var(--ui);
    font-size: var(--u-sm);
    text-align: left;
    cursor: pointer;
  }
  .dx__rapido span { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .dx__rapido em { flex: none; font-style: normal; font-size: var(--u-xs); color: var(--tinta-tenue); }
  .dx__rapido:hover { border-color: var(--azul-medio); background: var(--bruma); }
  .dx__rapido[aria-pressed='true'] { border-color: var(--azul); background: var(--azul); color: #fff; }
  .dx__rapido[aria-pressed='true'] em { color: rgb(255 255 255 / 0.72); }

  .dx__sin { margin: 0; font-size: var(--u-xs); line-height: 1.55; color: var(--tinta-tenue); }

  .dx__caja { margin-bottom: 8px; }
  .dx__buscar {
    width: 100%;
    min-height: 44px;
    padding: 8px 11px;
    border: 1px solid var(--linea);
    border-radius: 8px;
    background: var(--papel);
    font: inherit;
    font-family: var(--ui);
    font-size: var(--u-sm);
  }
  .dx__buscar:focus { border-color: var(--azul-medio); outline: none; }

  /* La lista vive en su columna y se desplaza ahí: no flota encima del
     formulario, que era lo que tapaba los campos de abajo. */
  .dx__lista {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 2px;
    max-height: 252px;
    overflow-y: auto;
  }
  /* `:global` porque estos renglones los crea el script: Astro le pone su
     atributo de alcance a lo que está en la plantilla, y lo que nace del
     JavaScript no lo lleva. Sin esto el `display: flex` no se aplicaba y
     el código quedaba pegado al nombre, sin separación. */
  .dx__lista :global(li) {
    display: flex;
    align-items: center;
    gap: 10px;
    min-height: 40px;
    padding: 6px 10px;
    border-radius: 7px;
    cursor: pointer;
    font-size: var(--u-sm);
  }
  .dx__lista :global(li:hover),
  .dx__lista :global(li[data-marcado]) { background: var(--bruma); }
  .dx__lista :global(li[data-puesto='true']) { background: var(--azul-tenue); }
  .dx__lista :global(.dx__nombre) {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .dx__lista :global(.dx__cod) {
    flex: none;
    font-style: normal;
    font-size: var(--u-xs);
    font-weight: 700;
    color: var(--tinta-tenue);
  }
  .dx__lista :global(.dx__ojo) {
    flex: none;
    font-style: normal;
    font-size: var(--u-xs);
    color: #8a5a00;
  }

  .dx__nada { margin: 8px 0 0; font-size: var(--u-xs); line-height: 1.5; color: var(--tinta-tenue); }

  /* El campo de verdad: el que se guarda. Va abajo y a la vista siempre. */
  .dx { display: flex; flex-direction: column; gap: 5px; }
  .dx__sub { font-size: var(--u-xs); font-weight: 600; color: var(--tinta-tenue); }
  .dx__campo { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
  .dx__campo input[type='text'] {
    flex: 1 1 260px;
    min-width: 0;
    min-height: 46px;
    padding: 9px 12px;
    border: 1px solid var(--linea);
    border-radius: 9px;
    background: var(--papel);
    font: inherit;
    font-family: var(--ui);
    font-size: var(--u-base);
  }
  .dx__campo input[type='text']:focus { border-color: var(--azul); outline: none; }

  .dx__elegido { display: flex; align-items: center; gap: 6px; margin: 0; flex: none; }
  .dx__elegido[hidden] { display: none; }
  .dx__chapa {
    padding: 6px 10px;
    border-radius: 7px;
    background: var(--azul);
    color: #fff;
    font-size: var(--u-sm);
    font-weight: 700;
  }
  .dx__quitar {
    width: 34px;
    height: 34px;
    border: 1px solid var(--linea);
    border-radius: 7px;
    background: var(--papel);
    color: var(--tinta-tenue);
    font-size: 1.1rem;
    line-height: 1;
    cursor: pointer;
  }
  .dx__quitar:hover { border-color: var(--rojo); color: var(--rojo); }

  .pista { font-size: var(--u-xs); color: var(--tinta-tenue); line-height: 1.5; }
</style>
