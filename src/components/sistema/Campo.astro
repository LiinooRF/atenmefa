---
/**
 * Un campo del formulario de atención. Se dibuja solo a partir del modelo
 * de src/sistema/historia.ts: agregar un campo allá lo hace aparecer acá,
 * sin tocar esta pantalla.
 */
import type { Campo } from '../../sistema/historia';
import Diagnostico from './Diagnostico.astro';

interface Props {
  campo: Campo;
  valor?: string;
  /** Solo para el campo del diagnóstico: su código CIE-10. */
  codigo?: string;
}
const { campo: c, valor = '', codigo = '' } = Astro.props;
const id = `c-${c.clave}`;
const pistaId = c.pista ? `${id}-pista` : undefined;
const comun = {
  id,
  name: c.clave,
  required: c.exigido,
  'aria-describedby': pistaId,
};
---

{/* El diagnóstico no es un campo más: es un buscador del catálogo CIE-10
    que además deja escribir a mano, y lleva su propio código en un segundo
    valor. Vive en su componente para no llenar éste de excepciones. */}
{c.tipo === 'diagnostico' ? (
  <Diagnostico campo={c} valor={valor} codigo={codigo} />
) : (
<div class:list={['campo', `campo--${c.ancho ?? 2}`]}>
  <label for={id}>
    {c.rotulo}
    {c.exigido && <abbr title="Obligatorio para cerrar la atención">*</abbr>}
    {c.unidad && <span class="campo__unidad">{c.unidad}</span>}
  </label>

  {c.tipo === 'parrafo' ? (
    <textarea {...comun} rows="3">{valor}</textarea>
  ) : c.tipo === 'opcion' ? (
    <select {...comun}>
      <option value="">—</option>
      {c.opciones?.map((o) => <option value={o} selected={valor === o}>{o}</option>)}
    </select>
  ) : c.tipo === 'si-no' ? (
    <select {...comun}>
      <option value="">—</option>
      <option value="si" selected={valor === 'si'}>Sí</option>
      <option value="no" selected={valor === 'no'}>No</option>
    </select>
  ) : (
    <input
      {...comun}
      type={
        c.tipo === 'fecha' ? 'date'
        : c.tipo === 'hora' ? 'time'
        : c.tipo === 'numero' ? 'number'
        : c.tipo === 'telefono' ? 'tel'
        : c.tipo === 'correo' ? 'email'
        : 'text'
      }
      value={valor}
      inputmode={
        c.tipo === 'numero' ? 'decimal'
        : c.tipo === 'telefono' ? 'tel'
        : c.tipo === 'correo' ? 'email'
        : undefined
      }
      step={c.tipo === 'numero' ? 'any' : undefined}
      autocomplete="off"
    />
  )}

  {c.pista && <span class="pista" id={pistaId}>{c.pista}</span>}
</div>
)}

<style>
  .campo { display: flex; flex-direction: column; gap: 6px; grid-column: span 4; min-width: 0; }

  /* En tablet y escritorio los campos comparten fila según su ancho. */
  @media (min-width: 720px) {
    .campo--1 { grid-column: span 1; }
    .campo--2 { grid-column: span 2; }
    .campo--3 { grid-column: span 3; }
    .campo--4 { grid-column: span 4; }
  }

  label {
    display: flex;
    align-items: baseline;
    gap: 6px;
    font-size: var(--u-sm);
    font-weight: 600;
    color: var(--tinta-suave);
  }
  abbr { color: var(--rojo); text-decoration: none; font-weight: 700; }
  .campo__unidad { margin-left: auto; font-size: var(--u-xs); font-weight: 400; color: var(--tinta-tenue); }

  input, select, textarea {
    width: 100%;
    min-height: 44px;
    padding: 9px 12px;
    border: 1px solid var(--linea);
    border-radius: 8px;
    background: var(--papel);
    color: var(--tinta);
    font: inherit;
    font-family: var(--ui);
    font-size: var(--u-base);
  }
  textarea { min-height: 76px; resize: vertical; line-height: 1.5; }
  input:hover, select:hover, textarea:hover { border-color: #bcc7dd; }
  input:focus, select:focus, textarea:focus {
    outline: 2px solid var(--azul-medio);
    outline-offset: 0;
    border-color: var(--azul-medio);
  }
  input[aria-invalid='true'], textarea[aria-invalid='true'], select[aria-invalid='true'] {
    border-color: var(--rojo);
  }
  .pista { font-size: var(--u-xs); color: var(--tinta-tenue); }
</style>

<script>
  /* La edad se llena sola cuando se escribe la fecha de nacimiento: es el
     dato que menos cambia de un paciente, y con él la edad deja de quedar
     vieja en la ficha. Sigue editable encima, porque hay quien llega sin
     saber el año exacto y una edad aproximada escrita a mano vale más que
     nada.

     Vive en Campo y no en cada pantalla porque los dos campos existen en la
     historia clínica y en la orden de laboratorio, y este componente es el
     único que saben dibujar los tres formularios. El script se incluye una
     vez por página aunque haya muchos campos: Astro lo agrupa. */
  const nacimiento = document.getElementById('c-nacimiento') as HTMLInputElement | null;
  const edad = document.getElementById('c-edad') as HTMLInputElement | null;

  if (nacimiento && edad) {
    /** Los años cumplidos, con la misma cuenta que aniosCumplidos en
        lib/fechas.ts. Se repite mínima acá porque el navegador no puede
        importar los módulos del servidor; si una cambia, cambia la otra. */
    const aniosCumplidos = (nac: string): number | null => {
      /* La fecha de la atención si el formulario la trae; si no, hoy en
         el calendario local de quien escribe. */
      const campoFecha = document.getElementById('c-fecha') as HTMLInputElement | null;
      const hoy = new Date();
      const ref = campoFecha?.value.trim() ||
        `${hoy.getFullYear()}-${String(hoy.getMonth() + 1).padStart(2, '0')}-${String(hoy.getDate()).padStart(2, '0')}`;
      const [na, nm, nd] = nac.split('-').map(Number);
      const [ha, hm, hd] = ref.split('-').map(Number);
      if (![na, nm, nd, ha, hm, hd].every(Number.isFinite)) return null;
      let anios = ha - na;
      if (hm < nm || (hm === nm && hd < nd)) anios--;
      return anios >= 0 ? anios : null;
    };

    const calcular = () => {
      const nac = nacimiento.value.trim();
      if (!nac) return;
      const anios = aniosCumplidos(nac);
      if (anios === null) return;
      edad.value = String(anios);
      /* Asignar .value no dispara 'input', y el guardado automático del
         formulario se entera por los eventos: sin esto, la edad recién
         calculada se quedaba en la pantalla sin llegar a la base. */
      edad.dispatchEvent(new Event('input', { bubbles: true }));
    };

    nacimiento.addEventListener('input', calcular);
    nacimiento.addEventListener('change', calcular);
  }
</script>
