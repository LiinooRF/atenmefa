---
import { clinica, wa } from '../data/clinica';
import Falta from './Falta.astro';
import { enRevision } from '../lib/revision';
import Icono from './Icono.astro';

const d = clinica.direccion;
const tel = clinica.contacto.fijo ?? clinica.contacto.whatsapp;
/* Con coordenadas el mapa centra y clava el pin; con texto, Google aproxima
   y en Venezuela suele caer lejos. */
const punto = d.lat !== null && d.lng !== null ? `${d.lat},${d.lng}` : null;
const consulta = punto ?? encodeURIComponent(`${d.calle}, ${d.ciudad}, ${d.estado}, Venezuela`);
const mapa =
  d.fichaGoogle ??
  (punto
    ? `https://www.google.com/maps/search/?api=1&query=${punto}`
    : `https://www.google.com/maps/search/?api=1&query=${consulta}`);

/* Un solo número para llamar y para WhatsApp: se muestra una vez, con las
   dos acciones, en vez de repetir la misma cifra en dos filas. */
const contactos = [
  { icono: 'telefono', rotulo: clinica.ambulancia24h ? 'Llamar · 24 horas' : 'Llamar',
    texto: tel.visible, href: `tel:${tel.e164}`, externo: false },
  ...(clinica.contacto.segundo
    ? [{ icono: 'telefono' as const, rotulo: 'Segunda línea', texto: clinica.contacto.segundo.visible,
         href: `tel:${clinica.contacto.segundo.e164}`, externo: false }]
    : []),
  { icono: 'whatsapp', rotulo: 'WhatsApp, el mismo número', texto: 'Escribir por WhatsApp', href: wa('Hola, necesito información.'), externo: true },
  { icono: 'instagram', rotulo: 'Instagram', texto: `@${clinica.contacto.instagram}`, href: `https://instagram.com/${clinica.contacto.instagram}`, externo: true },
  { icono: 'correo', rotulo: 'Correo', texto: clinica.contacto.correo, href: `mailto:${clinica.contacto.correo}`, externo: false },
];
---

<section class="seccion" id="ubicacion">
  <div class="contenedor">
    <div class="titulo-seccion">
      <h2>Cómo llegar y cómo comunicarse</h2>
    </div>

    <div class="ubi">
      <div class="ubi__columna">
        <div class="ubi__bloque">
          <h3>Dirección</h3>
          <p class="ubi__direccion">{d.calle}<br />{d.ciudad}, estado {d.estado}</p>
        </div>

        <div class="ubi__bloque">
          <h3>Contacto</h3>
          <ul class="ubi__contactos">
            {contactos.map((c) => (
              <li>
                <a href={c.href} target={c.externo ? '_blank' : undefined} rel={c.externo ? 'noopener' : undefined}>
                  <Icono nombre={c.icono} tam={19} />
                  <span>
                    <small>{c.rotulo}</small>
                    <strong>{c.texto}</strong>
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </div>

        {/* El bloque entero desaparece si no hay dato, no solo su relleno:
            un <h3>Horario</h3> con nada debajo se lee como una página rota.
            En la copia de revisión sí sale, con el hueco a la vista. */}
        {(clinica.horariosTexto || enRevision) && (
          <div class="ubi__bloque">
            <h3>Horario</h3>
            {clinica.horariosTexto ? (
              <p>{clinica.horariosTexto}</p>
            ) : (
              <Falta que="horario de atención, día por día" />
            )}
          </div>
        )}

        {!clinica.contacto.fijo && enRevision && (
          <div class="ubi__bloque">
            <h3>Teléfono fijo</h3>
            <Falta que="teléfono fijo del local" />
          </div>
        )}

        <div class="ubi__bloque">
          <h3>Formas de pago</h3>
          <ul class="ubi__pagos">
            {clinica.pagos.map((p) => <li>{p}</li>)}
          </ul>
        </div>
      </div>

      <div class="ubi__mapa-caja">
        <iframe
          class="ubi__iframe"
          src={`https://maps.google.com/maps?q=${consulta}&hl=es&z=17&output=embed`}
          title="Mapa con la ubicación de Atenmefa en Ciudad Bolívar"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          allowfullscreen
        ></iframe>
        <a class="ubi__abrir" href={mapa} target="_blank" rel="noopener">
          <Icono nombre="ubicacion" tam={18} />
          Abrir en Google Maps
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .ubi { display: grid; grid-template-columns: minmax(0, 1fr); gap: clamp(28px, 4vw, 52px); }
  @media (min-width: 940px) { .ubi { grid-template-columns: 1fr 0.86fr; align-items: start; } }

  .ubi__columna { display: grid; grid-template-columns: minmax(0, 1fr); gap: 30px; align-content: start; }
  .ubi__bloque h3 { margin-bottom: 10px; }
  .ubi__direccion { color: var(--tinta-suave); font-size: var(--t-md); }

  .ubi__contactos { list-style: none; margin: 0; padding: 0; display: grid; gap: 2px; }
  .ubi__contactos a {
    display: flex;
    align-items: center;
    gap: 13px;
    min-height: 56px;
    padding: 8px 10px;
    margin-inline: -10px;
    border-radius: var(--radio-sm);
    text-decoration: none;
    color: var(--tinta);
    transition: background-color 180ms ease;
  }
  .ubi__contactos a:hover { background: var(--bruma); }
  .ubi__contactos :global(svg) { color: var(--rojo); flex: none; }
  .ubi__contactos span { display: flex; flex-direction: column; line-height: 1.25; min-width: 0; }
  .ubi__contactos small {
    font-size: var(--t-xs);
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--tinta-tenue);
    font-weight: 600;
  }
  .ubi__contactos strong {
    font-family: var(--titulares);
    font-weight: 700;
    font-size: 1.02rem;
    color: var(--azul);
    word-break: break-word;
  }

  .ubi__pagos { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .ubi__mapa-caja {
    position: relative;
    border-radius: var(--radio);
    overflow: hidden;
    border: 1px solid var(--linea);
    min-height: 420px;
    display: grid;
  }
  @media (min-width: 940px) { .ubi__mapa-caja { min-height: 100%; } }

  .ubi__iframe { width: 100%; height: 100%; min-height: 420px; border: 0; display: block; }

  .ubi__abrir {
    position: absolute;
    left: 14px; bottom: 14px;
    display: inline-flex;
    align-items: center;
    gap: 9px;
    min-height: 44px;
    padding: 10px 17px;
    background: var(--papel);
    color: var(--azul);
    border-radius: 999px;
    font-family: var(--titulares);
    font-weight: 700;
    font-size: var(--t-sm);
    text-decoration: none;
    box-shadow: var(--flota);
    transition: background-color 180ms ease;
  }
  .ubi__abrir:hover { background: var(--azul); color: #fff; }
  .ubi__abrir :global(svg) { color: var(--rojo); }
  .ubi__abrir:hover :global(svg) { color: #fff; }

  .ubi__pagos li {
    background: var(--azul-tenue);
    color: var(--azul);
    border-radius: 999px;
    padding: 7px 14px 6px;
    font-size: var(--t-sm);
    font-weight: 600;
  }
</style>
