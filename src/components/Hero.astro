---
import { clinica, wa } from '../data/clinica';
import Icono from './Icono.astro';
import Hueco from './Hueco.astro';

const tel = clinica.contacto.fijo ?? clinica.contacto.whatsapp;
---

<section class="portada">
  <div class="contenedor portada__rejilla">
    <div class="portada__texto">
      <h1>Consulta, laboratorio y ambulancia en Ciudad Bolívar.</h1>

      <p class="portada__bajada">
        Atendemos en el local del C.C. Santa Catalina y también a domicilio.
        Para traslados salimos con paramédico a bordo, dentro de Ciudad
        Bolívar y a cualquier estado del país.
      </p>

      <a class="urgencia" href={`tel:${tel.e164}`}>
        <span class="urgencia__icono"><Icono nombre="ambulancia" tam={28} /></span>
        <span class="urgencia__texto">
          <small>Emergencias y ambulancia · 24 horas</small>
          <strong class="cifra">{tel.visible}</strong>
        </span>
        <span class="urgencia__flecha"><Icono nombre="flecha" tam={21} /></span>
      </a>

      <div class="portada__secundarias">
        <a class="boton boton--contorno" href={wa('Hola, necesito información sobre sus servicios.')} target="_blank" rel="noopener">
          <Icono nombre="whatsapp" tam={19} />
          Escribir por WhatsApp
        </a>
        <a class="boton boton--contorno" href="#ubicacion">
          <Icono nombre="ubicacion" tam={19} />
          Cómo llegar
        </a>
      </div>
    </div>

    <div class="portada__imagen">
      <Hueco
        ancho={960}
        alto={1080}
        nota="Foto vertical de la ambulancia o de la fachada del local. Luz de día, sin texto encima."
      />
    </div>
  </div>
</section>

<style>
  .portada {
    background:
      radial-gradient(130% 110% at 88% -10%, var(--azul-tenue) 0%, transparent 62%),
      var(--papel);
    padding-block: clamp(40px, 7vw, 86px) clamp(48px, 8vw, 96px);
  }

  .portada__rejilla {
    display: grid;
    gap: clamp(34px, 5vw, 62px);
    align-items: center;
  }
  @media (min-width: 960px) {
    .portada__rejilla { grid-template-columns: 1.12fr 0.88fr; }
  }

  .portada__bajada {
    margin-top: 22px;
    font-size: var(--t-md);
    color: var(--tinta-suave);
    max-width: min(52ch, 100%);
  }

  /* ----- el objeto principal de la página ----- */
  .urgencia {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-top: 32px;
    padding: 16px 22px 16px 18px;
    background: var(--rojo);
    color: #fff;
    border-radius: var(--radio);
    text-decoration: none;
    box-shadow: var(--flota);
    transition: background-color 200ms ease, transform 200ms ease, box-shadow 200ms ease;
    max-width: 440px;
  }
  .urgencia:hover {
    background: var(--rojo-hondo);
    transform: translateY(-2px);
    box-shadow: var(--flota-alta);
  }
  .urgencia:active { transform: translateY(0); }

  .urgencia__icono {
    display: grid;
    place-items: center;
    width: 52px; height: 52px;
    border-radius: 12px;
    background: rgba(255, 255, 255, 0.16);
  }

  .urgencia__texto { display: flex; flex-direction: column; line-height: 1.15; flex: 1; }
  .urgencia__texto small {
    font-size: var(--t-xs);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #fff;
    font-weight: 600;
  }
  .urgencia__texto strong {
    font-family: var(--titulares);
    font-size: clamp(1.5rem, 4.6vw, 1.85rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    margin-top: 3px;
  }

  .urgencia__flecha { opacity: 0.75; transition: transform 200ms ease; }
  .urgencia:hover .urgencia__flecha { transform: translateX(4px); opacity: 1; }

  .portada__secundarias {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 18px;
  }
  .portada__secundarias .boton { min-height: 48px; padding: 11px 20px; font-size: 0.95rem; }

  /* En móvil manda el texto: quien llega con una urgencia tiene que ver el
     titular y el botón de emergencia sin desplazar. La foto va después y
     con altura acotada para no comerse la pantalla. */
  .portada__imagen :global(.hueco) { max-height: 46vh; }
  @media (min-width: 960px) { .portada__imagen :global(.hueco) { max-height: none; } }
</style>
