---
/**
 * El resultado de verificar un documento, en las dos entradas: la del QR
 * (con el id) y la que se escribe a mano (con el N° de atención).
 *
 * Lo que muestra está acotado a propósito y vale la pena repetirlo donde se
 * dibuja: esta página es pública y NO enseña una línea de la historia
 * clínica. Confirma que el documento existe, de qué fecha es, quién lo firmó
 * y si sigue vigente.
 */
import Icono from './Icono.astro';
import { comoSeLee } from '../sistema/lib/documento';
import { clinica } from '../data/clinica';
import type { Documento } from '../sistema/lib/verificacion';
import { fueraDeRango, comoSeDice } from '../sistema/rangos';

interface Props { doc: Documento }
const { doc } = Astro.props;

const fechaLarga = (f: string) =>
  new Date(`${f}T12:00:00`).toLocaleDateString('es-VE', {
    day: 'numeric', month: 'long', year: 'numeric',
  });
---

<div class:list={['tarjeta', doc.anulada && 'tarjeta--anulada']}>
  <p class="tarjeta__sello">
    <Icono nombre="escudo" tam={20} />
    {doc.anulada
      ? 'Documento emitido por Atenmefa, pero ANULADO'
      : 'Documento emitido por Atenmefa'}
  </p>

  {doc.anulada && (
    <p class="tarjeta__nota">
      Esta atención fue anulada después de emitirse. El papel existió, pero no
      debe usarse: pida uno al día al centro.
    </p>
  )}

  <dl class="tarjeta__datos">
    <div><dt>Atención</dt><dd class="cifra">N.° {doc.numero}</dd></div>
    <div><dt>Fecha</dt><dd>{fechaLarga(doc.fecha)}</dd></div>
    <div><dt>Paciente</dt><dd>{doc.paciente}</dd></div>
    <div><dt>Documento</dt><dd class="cifra">{comoSeLee(doc.tipoDoc, doc.documentoPaciente)}</dd></div>
    {doc.medico && (
      <div>
        <dt>Firmado por</dt>
        <dd>
          {doc.medico}
          {/* "C.M." es el Colegio de Médicos: ponérselo al colegio de un
              bioanalista sería decir que firmó un médico. */}
          {doc.colegiatura && ` · ${doc.firmaDe === 'medico' ? `C.M. ${doc.colegiatura}` : doc.colegiatura}`}
        </dd>
      </div>
    )}
    <div><dt>Contiene</dt><dd>{doc.hojas.join(' y ')}</dd></div>
  </dl>

  {/* Los resultados del laboratorio sí se muestran: quien llegó hasta acá
      escribió la cédula Y el PIN de su propia hoja, que es lo mismo que
      hace falta para que el centro se los entregue por el mesón. Lo que
      no se muestra es una línea de la historia clínica. */}
  {doc.resultados.length > 0 && (
    <section class="res">
      <h3>Resultados</h3>
      <div class="res__tablon">
        <table>
          <thead>
            <tr><th>Examen</th><th>Resultado</th><th>Unidad</th><th>Valor de referencia</th></tr>
          </thead>
          <tbody>
            {doc.resultados.map((r) => (
              <tr data-fuera={fueraDeRango(r.valor, r.referencia, doc.sexo) ?? undefined}>
                <td>{r.examen}</td>
                <td class="res__dato">
                  {r.valor}
                  <span class="res__oculto">
                    {' '}{comoSeDice(fueraDeRango(r.valor, r.referencia, doc.sexo))}
                  </span>
                </td>
                <td>{r.unidad}</td>
                <td>{r.referencia}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="res__ojo">
        Lo marcado está fuera del valor de referencia del laboratorio. Eso no
        es un diagnóstico: un valor puede salirse del rango y no significar
        nada, y solo su médico puede leerlo junto con el resto.
      </p>
    </section>
  )}

  {/* Lo que esta página NO dice, dicho en voz alta: quien verifica a veces
      espera ver el diagnóstico y conviene explicar por qué no está. */}
  <p class="tarjeta__limite">
    Esta comprobación no muestra el contenido clínico. El diagnóstico y el
    tratamiento son del paciente y de su médico; para pedirlos, hable con el
    centro al {clinica.contacto.whatsapp.visible}.
  </p>
</div>

<style>
  .res { margin-top: 18px; }
  .res h3 { font-size: 1rem; margin: 0 0 10px; color: #14603a; }
  /* La tabla se desplaza dentro de su caja: en el teléfono, cuatro
     columnas no entran y la página no se puede mover de lado. */
  .res__tablon {
    overflow-x: auto;
    border: 1px solid #cfe8da;
    border-radius: 10px;
    background: #fff;
  }
  .res table { width: 100%; min-width: 440px; border-collapse: collapse; font-size: 0.88rem; }
  .res th {
    text-align: left;
    padding: 8px 12px;
    border-bottom: 1px solid #cfe8da;
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: #4a6b5b;
  }
  .res td { padding: 8px 12px; border-bottom: 1px solid #e8f2ec; }
  .res tbody tr:last-child td { border-bottom: 0; }
  .res__dato { font-weight: 700; }
  .res tr[data-fuera] .res__dato { color: #b3261e; }
  .res tr[data-fuera] .res__dato::after { content: ' ▲'; font-size: 0.75em; }
  .res tr[data-fuera='bajo'] .res__dato::after { content: ' ▼'; }
  .res__ojo { margin: 10px 0 0; font-size: 0.78rem; line-height: 1.55; color: #4a6b5b; }
  .res__oculto {
    position: absolute; width: 1px; height: 1px;
    overflow: hidden; clip-path: inset(50%); white-space: nowrap;
  }

  .tarjeta {
    border: 1px solid #a9d6bb;
    border-left: 4px solid #1b7f4b;
    border-radius: 12px;
    background: #f4fbf7;
    padding: 20px 22px;
  }
  .tarjeta--anulada { border-color: #e8c98a; border-left-color: #a9742a; background: #fdf7ea; }

  .tarjeta__sello {
    display: flex;
    align-items: center;
    gap: 9px;
    margin: 0 0 14px;
    font-weight: 700;
    color: #15603a;
  }
  .tarjeta--anulada .tarjeta__sello { color: #7a5200; }
  .tarjeta__nota { margin: 0 0 14px; color: #7a5200; line-height: 1.5; }

  .tarjeta__datos { margin: 0; display: grid; gap: 1px; }
  .tarjeta__datos > div {
    display: grid;
    grid-template-columns: minmax(7rem, auto) 1fr;
    gap: 12px;
    padding: 7px 0;
    border-bottom: 1px solid rgba(0, 0, 0, 0.06);
  }
  .tarjeta__datos dt { color: var(--tinta-suave); font-size: var(--u-sm); }
  .tarjeta__datos dd { margin: 0; font-weight: 600; color: var(--tinta); }

  .tarjeta__limite {
    margin: 16px 0 0;
    font-size: var(--u-sm);
    color: var(--tinta-suave);
    line-height: 1.5;
  }
</style>
