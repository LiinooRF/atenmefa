---
/**
 * La portada de la demostración.
 *
 * El sitio público no se publica —el folleto es del centro real y no de
 * quien está mirando la demo—, así que la raíz es una tapa con el logo y
 * la puerta al sistema. Es lo que se comparte por enlace: tiene que
 * explicarse sola en tres segundos.
 */
import { marca, variablesDeLaMarca } from '../data/marca';
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{marca.nombre}</title>
    <link rel="icon" href={marca.logo} />
    <style set:html={`:root{${variablesDeLaMarca()}}`}></style>
  </head>
  <body>
    <main class="tapa">
      <img src={marca.logo} width="86" height="86" alt="" />
      <h1>{marca.nombre}</h1>
      <p>{marca.bajada}</p>
      <a href="/sistema/entrar">Entrar al sistema</a>
    </main>
  </body>
</html>

<style is:global>
  :root { color-scheme: light; }
  body { margin: 0; }

  .tapa {
    min-height: 100dvh;
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 6px;
    padding: 24px;
    text-align: center;
    font-family: system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
    color: #fff;
    background:
      radial-gradient(90% 70% at 50% 0%, var(--azul-medio) 0%, transparent 62%),
      var(--azul-profundo);
  }
  .tapa img { border-radius: 50%; margin-bottom: 14px; }
  .tapa h1 { margin: 0; font-size: clamp(2rem, 6vw, 2.9rem); letter-spacing: -0.03em; }
  .tapa p { margin: 0 0 26px; opacity: 0.7; font-size: 1rem; }
  .tapa a {
    /* 44 px de alto: la misma regla de toque del resto del sistema. */
    display: inline-flex;
    align-items: center;
    min-height: 48px;
    padding: 0 26px;
    border-radius: 999px;
    background: #fff;
    color: var(--azul-profundo);
    font-weight: 700;
    text-decoration: none;
  }
  .tapa a:hover { background: var(--azul-tenue); }
</style>
