---
/**
 * Hueco para una imagen que todavía no entregó el cliente.
 * Reserva la relación de aspecto real: cuando llegue la foto se cambia por
 * <Image> y la página no se mueve ni un pixel.
 */
import { enRevision } from '../lib/revision';

interface Props {
  ancho: number;
  alto: number;
  /** Qué foto va acá. No se muestra: alimenta el texto alternativo. */
  nota: string;
}
const { ancho, alto, nota } = Astro.props;
---

<div class="hueco" style={`aspect-ratio: ${ancho} / ${alto};`} role="img" aria-label={`Espacio reservado para imagen: ${nota}`}>
  <div class="hueco__cuerpo">
    {/* El rótulo es lenguaje del encargo: queda en la revisión. Afuera va
        la medida y nada más, que es lo que se pidió. */}
    {enRevision && <span class="hueco__sello">Falta imagen</span>}
    <span class="hueco__medida cifra">{ancho} × {alto} px</span>
  </div>
</div>

<style>
  .hueco {
    width: 100%;
    border: 1.5px dashed var(--linea);
    border-radius: var(--radio);
    background: var(--bruma);
    display: grid;
    place-items: center;
    padding: 22px;
    text-align: center;
  }

  .hueco__cuerpo { display: flex; flex-direction: column; align-items: center; gap: 2px; max-width: min(32ch, 100%); }

  .hueco__medida {
    font-family: var(--titulares);
    font-size: clamp(1.2rem, 3vw, 1.6rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    color: var(--azul);
  }

  .hueco__sello {
    font-family: var(--titulares);
    font-size: var(--t-sm);
    font-weight: 600;
    color: var(--tinta-suave);
  }

  .hueco__nota { font-size: var(--t-sm); line-height: 1.5; color: var(--tinta-suave); }
</style>
