---
/**
 * Las catorce especialidades y las áreas del laboratorio.
 *
 * Es la sección que más tráfico puede traer y la que no existía: nadie
 * busca «centro médico», busca «oftalmólogo pediátrico en Ciudad Bolívar»
 * o «dónde me hacen una eco transvaginal». Cada renglón de estas listas es
 * una búsqueda que hoy no llega porque el sitio no la nombraba.
 *
 * Son listas y no tarjetas a propósito: catorce tarjetas con un ícono
 * inventado cada una ocupan tres pantallas y no dicen más que catorce
 * renglones que se leen de un vistazo.
 */
import { especialidades, areasDeLaboratorio, ecosonografias } from '../data/clinica';
import Icono from './Icono.astro';

const bloques = [
  {
    icono: 'estetoscopio',
    titulo: 'Especialidades médicas',
    pie: 'Consultas con especialista en el local de la Av. Sucre.',
    cosas: especialidades,
  },
  {
    icono: 'laboratorio',
    titulo: 'Áreas del laboratorio',
    pie: 'El laboratorio está dentro del centro y también va a domicilio.',
    cosas: areasDeLaboratorio,
  },
  {
    icono: 'latido',
    titulo: 'Ecosonografías',
    pie: 'Estudios de imagen que se hacen en el mismo local.',
    cosas: ecosonografias,
  },
] as const;
---

<section class="seccion seccion--bruma" id="especialidades">
  <div class="contenedor">
    <div class="titulo-seccion">
      <h2>Especialidades y estudios</h2>
      <p class="guia">
        Lo que se atiende y lo que se procesa, por nombre. Si busca algo que
        no esté en esta lista, se puede preguntar por WhatsApp.
      </p>
    </div>

    <div class="esp">
      {bloques.map((b) => (
        <div class="esp__bloque">
          <h3>
            <Icono nombre={b.icono} tam={20} />
            {b.titulo}
          </h3>
          <ul>
            {b.cosas.map((c) => <li>{c}</li>)}
          </ul>
          <p class="esp__pie">{b.pie}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .esp {
    margin-top: clamp(26px, 4vw, 38px);
    display: grid;
    gap: clamp(22px, 3vw, 32px);
  }
  @media (min-width: 900px) {
    .esp { grid-template-columns: repeat(3, 1fr); }
  }

  .esp__bloque {
    display: flex;
    flex-direction: column;
    padding: clamp(18px, 2.4vw, 26px);
    border: 1px solid var(--linea);
    border-radius: 14px;
    background: var(--papel);
  }

  .esp__bloque h3 {
    display: flex;
    align-items: center;
    gap: 9px;
    margin: 0 0 14px;
    padding-bottom: 12px;
    border-bottom: 1px solid var(--linea-tenue);
    font-family: var(--titulares);
    font-size: var(--u-base);
    font-weight: 700;
    color: var(--azul);
  }

  .esp__bloque ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 7px;
  }
  .esp__bloque li {
    position: relative;
    padding-left: 16px;
    font-size: var(--u-sm);
    line-height: 1.5;
    color: var(--tinta-suave);
  }
  /* Un punto y no una viñeta de lista: con catorce renglones, la viñeta
     del navegador se come el margen y desalinea las tres columnas. */
  .esp__bloque li::before {
    content: '';
    position: absolute;
    left: 2px;
    top: 0.62em;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--rojo);
  }

  .esp__pie {
    /* Pegado abajo: las tres columnas tienen distinto largo y la línea de
       arriba del pie quedaba a tres alturas distintas. */
    margin: 14px 0 0;
    margin-top: auto;
    padding-top: 12px;
    border-top: 1px solid var(--linea-tenue);
    font-size: var(--u-xs);
    line-height: 1.55;
    color: var(--tinta-tenue);
  }
</style>
